package MemberData; 

import weblogic.jws.control.JwsContext;
import center.*;

/**
 * @jws:target-namespace namespace="abc.edit.library.com"
 */
public class GetMemberData
{ 

    /**
     * @jws:control
     */
    private MemberDataControl MemberData;
    /** @jws:context */ 
    JwsContext context; 

    /**
     * @jws:operation
     */
    public  user_profile GetMemberDataByUsername(String key)
    {
        return MemberData.selectMemberDataByUsername(key);
    }



    /**
     * @jws:operation
     */
    public user_profile GetMemberDataByID(int key)
    {
        return MemberData.selectMemberDataByID(key);
    }


    /**
     * @jws:operation
     */
    public void edit_data(String username,String passwd,String name,String lastname,String sex,String status,
        String work_address, String ID, String years, String home_number, String lane, String village, String moo,
        String road,String district, String amphur,String province, String zip_code, String phone1,String phone2,
        String email,String category, String email_way,String application_way, String level)
    {
        MemberData.update_data(username,name,lastname,sex,status,work_address,ID,years,home_number,lane,village,moo,road,district,amphur,province,zip_code,phone1,email,category,email_way,application_way, level);
    }
} 
