package DataBook; 

import weblogic.jws.control.JwsContext;
import center.book_list;
import center.book;

public class DataFromBook
{ 

    /**
     * @jws:control
     */
     
    private DBControl DB;
    /** @jws:context */ 
    JwsContext context; 

    /**
     * @jws:operation
     */
    public book_list[] getBookTitleByCall_num(String keyCall_num)
    {   
        keyCall_num=keyCall_num+"%";
        book_list temp[] = DB.selectBookTitleByCall_num(keyCall_num);
        int x = temp.length;
        book_list temp1[] = new book_list[x];
        for (int i=0; i < x ; i++)
        {   
            temp1[i] = temp[i];
            temp1[i].setLibrary("ABC");
        }
        return temp;
        //return DB.selectBookTitleByCall_num(keyCall_num);
    }

