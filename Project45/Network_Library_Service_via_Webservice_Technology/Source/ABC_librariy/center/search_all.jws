    /**
     * @jws:operation
     */
    public book selectBookByBook_record(String key_book_record,String library)
    {   
        book BK=new book();
        if(library.equalsIgnoreCase("ABC")) BK = abc.getBookByBookRecord(key_book_record);
        if (library.equalsIgnoreCase("xyz")) BK = xyz.getBookByBookRecord(key_book_record);
        return BK;
    }
