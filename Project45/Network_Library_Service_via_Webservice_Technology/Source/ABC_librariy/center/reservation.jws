    /**
     * @jws:operation
     */
    public int add_reservation(String library ,String member_num,String receive_date,String book_record,String comment)
    {
        int answer = 0; 
        if (library.equalsIgnoreCase("ABC")) answer = ABCreservation.addReservation(member_num,receive_date,book_record,comment);
        if (library.equalsIgnoreCase("xyz")) answer = XYZreservation.addReservation(member_num,receive_date,book_record,comment);
        return answer;
    }
    

    /**
     * @jws:operation
     */
    public reservation_show_data check_reservation(String library,String member_num,String book_record,String comment)
    {   
        reservation_show_data data = new reservation_show_data();
        if (library.equalsIgnoreCase("ABC"))  data= ABCreservation.checktReservation(member_num,book_record,comment);
        if (library.equalsIgnoreCase("xyz"))  data= XYZreservation.checktReservation(member_num,book_record,comment);
        return data;
    }

