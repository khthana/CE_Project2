     }
    /**
     * @jws:sql statement::
     *     insert into inner_member ( username, passwd,name,lastname,sex,
     *                 status, work_address, ID, years, home_number,lane,village,
     *                 moo, road, district, amphur, province, zip_code,
     *                 phone1,phone2,email,category,email_way,
     *                 application_way) 
     *     values ({a},password({passwd}),{b},{c},{d},{e},{f},{g},{h},{i},{j},{k},{l},
     *            {m},{n},{o},{p},{q},{r},{s},{t},{u},{v},{w})
     * ::
     */
    public int InsertMemberToDB(String a,String passwd,String b,String c,String d,String e,String f, String g,String h,String i,String j,String k, String l,String m,String n,String o,String p, String q, String r, String s,String t,String u,String v,String w);

    /**
     * @jws:sql statement::
     *     update inner_member
     *     set passwd=password({new_password})
     *     where username={username} and password({old_password})=passwd
     * ::
     */
    public int update_password(String username, String old_password, String new_password);

    /**
     * @jws:sql statement::
     *     select username
     *     from inner_member
     *     where username={username}
     * ::
     */
    public String check_username(String username);
}