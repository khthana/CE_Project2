    /**
     * @jws:operation
     */
    public book selectBookByBook_record(String key_book_record,String library)
    {   
        if(library.equals("ABC library"))
        {   book BK = BookService.getBookByBookRecord(key_book_record);
            return BK;
        }
        
        else  
        {   book BK = OtherBookService.getBookByBookRecord(key_book_record);
            return BK;
        }
