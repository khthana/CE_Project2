package center; 

import weblogic.jws.control.JwsContext;
import DataBook.DataFromBookControl;
import center.book_list;
import center.book;

public class search_all
{ 

    /**
     * @jws:control
     */
    private DataFromBookControl BookService;

    /**
     * @jws:control
     */
    private center.DataFromBookControl OtherBookService;












    /** @jws:context */ 
    JwsContext context; 

    /**
     * @jws:operation
     */
    public book_list[] searchBookByTitle(String key_title)
    {
        book_list[] BK = BookService.getBookTitleByTitle(key_title);
        book_list[] BK_other = OtherBookService.getBookTitleByTitle(key_title);
        System.out.println("BK " + BK[0].getBook_record());
        System.out.println("BK_other " + BK_other[0].getBook_record());
        
        int x =BK.length;
        int y =BK_other.length;
        int k = x+y;
        int i=0;
        book_list[] BK_all = new book_list[k+1];
        
        for (i = 0; i<x; i++)
        {   BK_all[i] = new book_list();
            BK_all[i].setAuthor(BK[i].getAuthor());
            BK_all[i].setTitle(BK[i].getTitle());
            BK_all[i].setBook_record(BK[i].getBook_record());
            BK_all[i].setLibrary(BK[i].getLibrary());   
        }
        
        for(int j = 0; j<y; j++)
        {   BK_all[j+i] = new book_list();
            BK_all[j+i].setAuthor(BK_other[j].getAuthor());
            BK_all[j+i].setTitle(BK_other[j].getTitle());
            BK_all[j+i].setBook_record(BK_other[j].getBook_record());
            BK_all[j+i].setLibrary(BK_other[j].getLibrary());  
        } 
        return BK_all;
    }

