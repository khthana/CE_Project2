    return count;
  }


  public void GenCode(int ID, int flag, String data) {
    String status;
    status = "";
    if ((flag & 0x40) == 0x00) {
      status = "Data";
    }
    else {
      if (((int)data.charAt(2)) == 0) {
        status = "Report";
      }
      else if (((int)data.charAt(2)) == 1) {
        status = "Error";
      }
      else if (((int)data.charAt(2)) == 2) {
        status = "Ack";
      }
      else if (((int)data.charAt(2)) == 3) {
        status = "Req";
      }
      else if (((int)data.charAt(2)) == 4) {
        status = "Chg";
      }
    }
    java.util.Date now = new java.util.Date();
    str = now.toString();
    time = str.substring(11, 13);
    time += str.substring(14, 16);
    day = str.substring(8, 10);
    Insert(Integer.toString(ID), status , time, day);
  }

  public void GenCodeWithStatus(int ID, String message) {
    String status;
    status = message;
    java.util.Date now = new java.util.Date();
    str = now.toString();
    time = str.substring(11, 13);
    time += str.substring(14, 16);
    day = str.substring(8, 10);
    Insert(Integer.toString(ID), status , time, day);
  }

  private int getSTime() {
    String s = Integer.toString(HistoryTab.shourvar.getValue()) + Integer.toString(HistoryTab.sminutevar.getValue());
    return Integer.parseInt(s);
  }

  private int getETime() {
    String e = Integer.toString(HistoryTab.ehourvar.getValue()) + Integer.toString(HistoryTab.eminutevar.getValue());
    return Integer.parseInt(e);
  }

  private int getSDay() {
    return HistoryTab.sdayvar.getValue();
  }

  private int getEDay() {
  return HistoryTab.edayvar.getValue();
}


  private void DBInsert(String stringtoinsert)   {
    try {
      stmt = connection.createStatement( );
      stmt.execute("INSERT INTO CAN values (" + stringtoinsert + ");" );
      stmt.close( );
    }

    catch ( Exception e) {
      System.err.println( "Error: Found some problems with inserting new data !" );
      e.printStackTrace( );
    }
  }
}