class DatabaseHandle {

  private Statement stmt = null;
  public static Connection connection = null;
  private String URL = "jdbc:odbc:CANDatabase";
  private ResultSet myset;
  private String str;
  private String time;
  private String day;


  public DatabaseHandle() {
    try {
      Class.forName( "sun.jdbc.odbc.JdbcOdbcDriver" );
      connection = DriverManager.getConnection( URL, "", "" );
      MainFrame.messagestatus.setText(MainFrame.messagestatus.getText() + "Connect to Database successful\n");
    }
    catch ( Exception e ) {
      e.printStackTrace( );
      MainFrame.messagestatus.setText(MainFrame.messagestatus.getText() + "Can't connect to database\n");
      connection = null;
    }
  }

  private void Insert(String ID, String status, String time, String day) {
    DBInsert(" '" + ID + "' , '" + status + "' , '" + time + "' , '" + day + "' ");
  }

  public void Query(String astatus, String stime, String etime, String sday, String eday) {

    String query="SELECT * " +
                 " FROM CAN " +
                 " WHERE Status = " + "'" + astatus + "'" +
                 " and Time between " + stime + " and " +  etime +
                 " and Day between " + sday + " and " +  eday +
                 "";

    try {
      Statement viewlist = connection.createStatement();
      myset = viewlist.executeQuery(query);

      while( myset.next( ) ) {
        String getID = myset.getString(1);
        String status = myset.getString(2);
        String gettime = myset.getString(3);
        String day = myset.getString(4);
        System.out.println("ID : " + getID + " status : " + status + " Time : " + gettime + " day : " + day);
      }

      viewlist.close();

      } catch(SQLException e) {
        e.printStackTrace( );
      }
  }

  public int QueryNodeCount(String node) {

    int count;
    count = 0;
    String query = "SELECT COUNT(*) " +
        " FROM CAN " +
        " WHERE ID = " + node +
        " and Time BETWEEN " + getSTime() + " and " + getETime() +
        " and Day BETWEEN " + getSDay() + " and " + getEDay() +
        "";

    try {
      Statement viewlist = connection.createStatement();
      myset = viewlist.executeQuery(query);
      while (myset.next()) {
        count = Integer.parseInt(myset.getString(1));
      }

      viewlist.close();

    }
    catch (SQLException e) {
      e.printStackTrace();
    }
    return count;
  }

  public int QueryStatus(String node, String status) {

    int count;
    count = 0;
    String query = "SELECT COUNT(*) " +
        " FROM CAN " +
        " WHERE Status = " + "'" + status +"'" +
        " and ID = " + node +
        " and Time BETWEEN " + getSTime() + " and " + getETime() +
