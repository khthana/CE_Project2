  private void cpkey(boolean function)  {
    if (function) {
      for (int i = 0; i < 32; i++)
        dc.ek[i] = KnL[i];
    }
    else {
      for (int i = 0; i < 32; i++)
        dc.dk[i] = KnL[i];
    }
  }

  private void usekey()  {
    for (int i = 0; i < 32; i++)
      KnL[i] = dough[i];
  }

  private void cookey()  {
    int raw0, raw1;
    int cookcount = 0;

    raw1 = 0;

    for( int i = 0; i < 16; i++, raw1++ ) {
      raw0 = raw1++;
      dough[cookcount] = (kn[raw0] & 0x00fc0000L) << 6;
      dough[cookcount] |= (kn[raw0] & 0x00000fc0L) << 10;
      dough[cookcount] |= (kn[raw1] & 0x00fc0000L) >> 10;
      dough[cookcount++] |= (kn[raw1] & 0x00000fc0L) >> 6;
      dough[cookcount] = (kn[raw0] & 0x0003f000L) << 12;
      dough[cookcount] |= (kn[raw0] & 0x0000003fL) << 16;
      dough[cookcount] |= (kn[raw1] & 0x0003f000L) >> 4;
      dough[cookcount++] |= (kn[raw1] & 0x0000003fL);
    }
    usekey();
  }

  private void deskey(short edf)  {
    int i, j, l, m, n;

    for ( j = 0; j < 56; j++ ) {
      l = pc1[j];
      m = l & 07;
      pc1m[j] = ((key[l >> 3] & bytebit[m]) != 0) ? (char)1 : (char)0;
    }
    for( i = 0; i < 16; i++ ) {
      if( edf == DE1 ) m = (15 - i) << 1;
      else             m = i << 1;
      n = m + 1;
      kn[m] = kn[n] = 0L;
      for( j = 0; j < 28; j++ ) {
        l = j + totrot[i];
        if( l < 28 )
          pcr[j] = pc1m[l];
        else
          pcr[j] = pc1m[l - 28];
      }
      for( j = 28; j < 56; j++ ) {
        l = j + totrot[i];
        if( l < 56 )
          pcr[j] = pc1m[l];
        else
          pcr[j] = pc1m[l - 28];
      }
      for( j = 0; j < 24; j++ ) {
        if( pcr[pc2[j]] != 0)
          kn[m] |= bigbyte[j];
        if( pcr[pc2[j+24]] != 0)
          kn[n] |= bigbyte[j];
      }
    }
    cookey();
  }

  private void scrunch()  {
    work[0] = (cp[0] & 0xffL) << 24;
    work[0] |= (cp[1] & 0xffL) << 16;
    work[0] |= (cp[2] & 0xffL) << 8;
    work[0] |= (cp[3] & 0xffL);
    work[1] = (cp[4] & 0xffL) << 24;
    work[1] |= (cp[5] & 0xffL) << 16;
    work[1] |= (cp[6] & 0xffL) << 8;
    work[1] |= (cp[7] & 0xffL);
  }

  private void unscrun()  {
    cp[0] = (char)((work[0] >> 24) & 0xffL);
    cp[1] = (char)((work[0] >> 16) & 0xffL);
    cp[2] = (char)((work[0] >>  8) & 0xffL);
    cp[3] = (char)((work[0]) & 0xffL);
    cp[4] = (char)((work[1] >> 24) & 0xffL);
    cp[5] = (char)((work[1] >> 16) & 0xffL);
    cp[6] = (char)((work[1] >>  8) & 0xffL);
    cp[7] = (char)(work[1]     & 0xffL);
  }

  private void desfunc(boolean function)  {
    long fval, right, leftt;
    int round;

    leftt = work[0];
    right = work[1];
    work1ocal = ((leftt >> 4) ^ right) & 0x0f0f0f0fL;
    right ^= work1ocal;
    leftt ^= (work1ocal << 4);
    work1ocal = ((leftt >> 16) ^ right) & 0x0000ffffL;
    right ^= work1ocal;
    leftt ^= (work1ocal << 16);
    work1ocal = ((right >> 2) ^ leftt) & 0x33333333L;
    leftt ^= work1ocal;
    right ^= (work1ocal << 2);
    work1ocal = ((right >> 8) ^ leftt) & 0x00ff00ffL;
    leftt ^= work1ocal;
    right ^= (work1ocal << 8);
    right = ((right << 1) | ((right >> 31) & 1L)) & 0xffffffffL;
    work1ocal = (leftt ^ right) & 0xaaaaaaaaL;
    leftt ^= work1ocal;
    right ^= work1ocal;
    leftt = ((leftt << 1) | ((leftt >> 31) & 1L)) & 0xffffffffL;

    int i = 0;

    for( round = 0; round < 8; round++ ) {
      work1ocal  = (right << 28) | (right >> 4);
      if (function)
        work1ocal ^= dc.ek[i++];
      else
        work1ocal ^= dc.dk[i++];
      fval  = SP7[(int)(work1ocal & 0x3fL)];
      fval |= SP5[(int)((work1ocal >>  8) & 0x3fL)];
      fval |= SP3[(int)((work1ocal >> 16) & 0x3fL)];
      fval |= SP1[(int)((work1ocal >> 24) & 0x3fL)];
      if (function)
        work1ocal  = right ^ dc.ek[i++];
      else
        work1ocal  = right ^ dc.dk[i++];
      fval |= SP8[(int)(work1ocal & 0x3fL)];
      fval |= SP6[(int)((work1ocal >>  8) & 0x3fL)];
      fval |= SP4[(int)((work1ocal >> 16) & 0x3fL)];
      fval |= SP2[(int)((work1ocal >> 24) & 0x3fL)];
      leftt ^= fval;
      work1ocal  = (leftt << 28) | (leftt >> 4);
      if (function)
        work1ocal ^= dc.ek[i++];
      else
        work1ocal ^= dc.dk[i++];
      fval  = SP7[(int)(work1ocal & 0x3fL)];
      fval |= SP5[(int)((work1ocal >>  8) & 0x3fL)];
      fval |= SP3[(int)((work1ocal >> 16) & 0x3fL)];
      fval |= SP1[(int)((work1ocal >> 24) & 0x3fL)];
      if (function)
        work1ocal  = leftt ^ dc.ek[i++];
      else
        work1ocal  = leftt ^ dc.dk[i++];
      fval |= SP8[(int)(work1ocal & 0x3fL)];
      fval |= SP6[(int)((work1ocal >>  8) & 0x3fL)];
      fval |= SP4[(int)((work1ocal >> 16) & 0x3fL)];
      fval |= SP2[(int)((work1ocal >> 24) & 0x3fL)];
      right ^= fval;
    }

    right = (right << 31) | (right >> 1);
    work1ocal = (leftt ^ right) & 0xaaaaaaaaL;
    leftt ^= work1ocal;
    right ^= work1ocal;
    leftt = (leftt << 31) | (leftt >> 1);
    work1ocal = ((leftt >> 8) ^ right) & 0x00ff00ffL;
    right ^= work1ocal;
    leftt ^= (work1ocal << 8);
    work1ocal = ((leftt >> 2) ^ right) & 0x33333333L;
    right ^= work1ocal;
    leftt ^= (work1ocal << 2);
    work1ocal = ((right >> 16) ^ leftt) & 0x0000ffffL;
    leftt ^= work1ocal;
    right ^= (work1ocal << 16);
    work1ocal = ((right >> 4) ^ leftt) & 0x0f0f0f0fL;
    leftt ^= work1ocal;
    right ^= (work1ocal << 4);
    work[0] = right;
    work[1] = leftt;
  }

  private void des_key(){
    deskey(EN0);
    cpkey(true);
    deskey(DE1);
    cpkey(false);
  }

  private void des_enc(){
    cp = x;
    scrunch();
    desfunc(true);
    unscrun();
  }

  private void des_dec(){
    scrunch();
    desfunc(false);
    unscrun();
  }

  public void DESKey(char keyarg[]) throws CANException{
    if (keyarg.length == 8) {
      key = keyarg;
      des_key();
    }
    else {
      throw new CANException("DESSerice Exception in Encryption Method : Key length is invalid");
    }
  }

  public char[] Encryption(char[] cleartext) {
    char[] ciphertext = null;
    try {
      x = cleartext;
      des_enc();
      ciphertext = cp;
    }
    catch (Exception e) {
      System.out.println("Exception from DESService (Encryption) : " + e);
    }
    return ciphertext;
  }

  public char[] Decryption(char[] ciphertext) {
    char[] cleartext = null;
    try {
      x = ciphertext;
      des_dec();
      cleartext = cp;
    }
    catch (Exception e) {
      System.out.println("Exception from DESService (Decryption) : " + e);
    }
    return cleartext;
  }
