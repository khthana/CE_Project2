 647          void StatusReportService(unsigned char type, unsigned char description) {
 648   1      
 649   1              unsigned int checksum;
 650   1              unsigned char i;
 651   1      
 652   1              Bx[2].id = 0x02;                                                                // ID = 2
 653   1              Bx[2].flag = 0x40;                                                              // Status Protocol
 654   1              Bx[2].str[3] = type;
