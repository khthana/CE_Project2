 491          void ShiftOut(unsigned char dbuf)
 492          {
 493   1              unsigned char  i, x;
 494   1              for(i = 0; i < 8; i++)
 495   1              {               
 496   2                      x = dbuf;
 497   2                      x &= 0x80;
 498   2                      switch(x) {                                               
 499   3                              case 0x80: SI = 1; break;
 500   3                              case 0x00: SI = 0; break;
 501   3                              default: SI = 1;                                // All '1' Error
 502   3                      }
 503   2                      SCK = 0;                                                // sck=0
 504   2                      dbuf = dbuf<<1;                                         // shift data 1 bit
 505   2                      SCK = 1;                                                // sck=1
 506   2              }
 507   1      }
 508          
 509          unsigned char ShiftIn(unsigned char number)
 510          {
 511   1              unsigned char  i, x, dbuf = 0;
 512   1              for(i = 0; i < 8; i++)
 513   1              {
 514   2                      SCK = 0;                                                        // sck=0
 515   2                      switch(number) {
 516   3                              case 0: x = SX0;  break;
 517   3                              case 1: x = SX1; break;
 518   3                              default: x = 1;                                 // All '1' Error
 519   3                      }
 520   2                      SCK = 1;                                                        // sck=1
 521   2                  dbuf = dbuf << 1;                                   // shift data 1 bit
 522   2                  dbuf |= x;
 523   2              }
 524   1              return(dbuf);
 525   1      }
 526          
 527          unsigned char ReadByte(unsigned char addr, unsigned char number)
 528          {
 529   1              unsigned char  dbuf;
 530   1              switch(number) {
 531   2                      case 0: CS0 = 0; break;
 532   2                      case 1: CS1 = 0; break;
 533   2                      default: CS0 = CS1 = 1;                         // All '1' Error
 534   2              }
 535   1              ShiftOut(0x03);                                                 // send instruction
 536   1              ShiftOut(addr);                                                 // send address
 537   1              dbuf=ShiftIn(number);                                   // receive data
 538   1              CS0 = CS1 = 1;                                                  // CS=1
 539   1              return(dbuf);
 540   1      }
 541          
 542          void WriteByte(unsigned char addr1, unsigned char info, unsigned char number)
 543          {
 544   1              switch(number) {
 545   2                      case 0: CS0 = 0; break;
 546   2                      case 1: CS1 = 0; break;
 547   2                      default: CS0 = CS1 = 1;                         // All '1' Error
 548   2              }
 549   1              ShiftOut(0x02);                                         // send instruction
C51 COMPILER V6.21  CAN                                                                    03/26/2003 19:56:58 PAGE 10  

 550   1              ShiftOut(addr1);                                                // send address
 551   1              ShiftOut(info);                                                 // send data
 552   1              CS0 = CS1 = 1;                                          // CS=1
 553   1      }
 554          
 555          void BitModify(unsigned char addr, unsigned char mask, unsigned char info, number)
 556          {
 557   1              switch(number) {
 558   2                      case 0: CS0 = 0; break;
 559   2                      case 1: CS1 = 0; break;
 560   2                      default: CS0 = CS1 = 1;                         // All '1' Error
 561   2              }
 562   1              ShiftOut(0x05);                                                 // send instruction
 563   1              ShiftOut(addr);                                                 // send address
 564   1              ShiftOut(mask);                                                 // send mask
 565   1              ShiftOut(info);                                                 // send data
 566   1              CS0 = CS1 = 1;                                                  // CS1=1
 567   1      }
 568          
 569          void RequestToSend(unsigned char info, unsigned char number)
 570          {
 571   1              switch(number) {
 572   2                      case 0: CS0 = 0; break;
 573   2                      case 1: CS1 = 0; break;
 574   2                      default: CS0 = CS1 = 1;                         // All '1' Error
 575   2              }
 576   1              ShiftOut(info);                                                 // send instruction
 577   1              CS0 = CS1 = 1;                                  // CS1=1
 578   1      }
 579          
 580          unsigned char ReadStatus(unsigned char number)
 581          {
 582   1              unsigned char  dbuf;
 583   1              switch(number) {
 584   2                      case 0: CS0 = 0; break;
 585   2                      case 1: CS1 = 0; break;
 586   2                      default: CS0 = CS1 = 1;                         // All '1' Error
 587   2              }
 588   1              ShiftOut(0xa0);                                                 // send instruction
 589   1              dbuf = ShiftIn(number);                                 // receive data
 590   1              dbuf = ShiftIn(number);                                 // receive data again
 591   1              CS0 = CS1 = 1;                                                  // CS=1
 592   1              return(dbuf);
 593   1      }
