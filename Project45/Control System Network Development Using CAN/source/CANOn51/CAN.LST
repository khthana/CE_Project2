 616          void initCAN(unsigned char number) {
 617   1              WriteByte(CANCTRL, 0x80, number);                                       // 8 is set configuration mode,
 618   1          WriteByte(CNF1, 0x04, number);                                              // Baud rate prescaler
 619   1          WriteByte(CNF2, 0xf1, number);
 620   1          WriteByte(CNF3, 0x05, number);
 621   1              WriteByte(CANINTE, 0x01, number);                                       // Receive Buffer 0 Full Interrupt Enable
 622   1          WriteByte(TXRTSCTRL, 0x00, number);                                 // Pin control and status register : read as 0 when pin is in 
             -request to send mode, digital input
 623   1          WriteByte(RXB0CTRL, 0x04, number);                                  // Receive all valid message using either standard or extended 
             -identifies that meet fillter criteria, No remote tranfer request receive, roll over enable, acceptance filter 0
 624   1          WriteByte(RXB1CTRL, 0x00, number);                                  // Receive all valid message using either standard or extended 
             -identifies that meet fillter criteria, No remote tranfer request receive, acceptance filter 0
 625   1          WriteByte(RXF0SIDH, 0x82, number);                                  // Set acceptance filter n standard identifier high to all '1' 
             -s
 626   1          WriteByte(RXF0SIDL, 0xe0, number);                                  // Set acceptance filter n standard identifier low to all '1' s
 627   1          WriteByte(RXM0SIDH, 0xff, number);                                  // Set acceptance filter mask n standard identifier high all '0
             -' s so filter must not match every bit
 628   1          WriteByte(RXM0SIDL, 0x00, number);                                  // Set acceptance filter mask n standard identifier low all '0'
             - s so filter must not match every bit
 629   1          WriteByte(RXM0EID8, 0x00, number);                                  // Set acceptance filter mask n extended identifier high all '0
             -' s so filter must not match every bit
 630   1          WriteByte(RXM0EID0, 0x00, number);                                  // Set acceptance filter mask n extended identifier low all '0'
             - s so filter must not match every bit
 631   1          WriteByte(TXB0CTRL, 0x03, number);                                  // Transmit buffer n control register : Highest message priorit
             -y
 632   1          WriteByte(CANCTRL, 0x00, number);                                   // 0x00 : Normal Mode, 0x40 : Loop back Mode
 633   1      }
