 743   2                      for (i = 2; i < 16; i++) {
 744   3                              checksum += Bx.str[i];
 745   3                      }       
 746   2              }
 747   1              else {
 748   2                      checksum += (Bx.str[0] * 256);
 749   2                      for (i = 1; i < 16; i++) {
 750   3                              checksum += Bx.str[i];
 751   3                      }       
 752   2              }
