  private void CAN0RX() {
    if (can.isRX0IF(0))
      {
        try
        {
          str = "";
//          ID = (can.readByte(can.RXB0SIDH, 0) & 0x7f) >> 2;
//          canbuffer.setID(ID);
          canbuffer.setID(can.readByte(can.RXB0SIDH, 0) & 0x7f);
          flag = can.readByte(can.RXB0SIDL, 0);
          canbuffer.setFlag(flag);
          datalength = can.readByte(can.RXB0DLC, 0);
          datalength &= 0x0f;
          for (int j = 0; j < datalength; j++)
          {
            str += (char) (can.readByte(can.RXB0DB0 + j, 0));
          }
          canbuffer.setData(str);
          MainFrame.Rx.setShareData(canbuffer);                                 // Rx is Only one buffer for Receive
          can.clearRX0IF(0);
          if (clear == true)
            MainFrame.status.setText("");
          if ((canbuffer.getFlag() & 0x80) == 0x00) {
            clear = true;
          }
          else
            clear = false;
          str = MainFrame.status.getText();
          MainFrame.status.setText(str + "CAN0 RX0 ID : " + canbuffer.getID() + " Flag : " + canbuffer.getFlag() + " Data : " + canbuffer.getData() + "\n");
        }
        catch (Exception e)
        {
          System.out.println("CAN Thread throw : " + e);
        }
      }
      if (can.isRX1IF(0))
      {
        try
        {
          str = "";
//          ID = (can.readByte(can.RXB1SIDH, 0) & 0x7f) >> 2;
//          canbuffer.setID(ID);
