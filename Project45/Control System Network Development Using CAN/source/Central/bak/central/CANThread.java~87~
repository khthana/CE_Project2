          }
          canbuffer.setData(str);
          MainFrame.Rx.setShareData(canbuffer);                                 // Rx is Only one buffer for Receive
          can.clearRX1IF(0);
          if (clear == true)
            MainFrame.status.setText("");
          if ((canbuffer.getFlag() & 0x80) == 0x00) {
            clear = true;
          }
          else
            clear = false;
          str = MainFrame.status.getText();
          MainFrame.status.setText(str + "CAN0 RX1 ID : " + canbuffer.getID() + " Flag : " + canbuffer.getFlag() + " Data : " + canbuffer.getData() + "\n");
        }
        catch (Exception e)
        {
          System.out.println("CAN Thread throw : " + e);
        }
      }
    }

