  private void CAN0TX() {
    if (MainFrame.Tx.readable())                                                // Tx is only one buffer for transmit data
    {
      try
      {
        str = "";
        canbuffer = MainFrame.Tx.getShareData();
        can.writeByte(can.TXB0SIDH, canbuffer.getID() | 0x80 , 0);
        can.writeByte(can.TXB0SIDL, canbuffer.getFlag(), 0);
        can.writeByte(can.TXB0DLC, canbuffer.getData().length(), 0);
        str = canbuffer.getData();
        for (int a = 0; a < str.length(); a++)
        {
          can.writeByte(can.TXB0DB0 + a, (int) str.charAt(a), 0);
        }
        can.requestToSend(0x81, 0);
        if (clear == true)
          MainFrame.status.setText("");
        if ((canbuffer.getFlag() & 0x80) == 0x00) {
          clear = true;
        }
        else
          clear = false;
        str = MainFrame.status.getText();
        MainFrame.status.setText(str + "CAN0 TX0 ID : " + (canbuffer.getID() | 0x80) + " Flag : " + canbuffer.getFlag() + " Data : " + canbuffer.getData() + "\n");
      }
      catch (Exception e)
      {
        System.out.println("CAN Thread throw : " + e);
      }
    }
  }

  private void CAN1TX() {
    if (MainFrame.Tx.readable())
    {
      try
      {
        str = "";
        canbuffer = MainFrame.Tx.getShareData();
        can.writeByte(can.TXB0SIDH, canbuffer.getID() | 0x80 , 1);
        can.writeByte(can.TXB0SIDL, canbuffer.getFlag(), 1);
        can.writeByte(can.TXB0DLC, canbuffer.getData().length(), 1);
        str = canbuffer.getData();

        for (int a = 0; a < str.length(); a++)
        {
          can.writeByte(can.TXB0DB0 + a, (int) str.charAt(a), 1);
        }
        can.requestToSend(0x81, 1);
        if (clear == true)
          MainFrame.status.setText("");
        if ((canbuffer.getFlag() & 0x80) == 0x00) {
          clear = true;
        }
        else
          clear = false;
        str = MainFrame.status.getText();
        MainFrame.status.setText(str + "CAN1 TX0 ID : " + (canbuffer.getID() | 0x80) + " Flag : " + canbuffer.getFlag() + " Data : " + canbuffer.getData() + "\n");
      }
      catch (Exception e)
      {
        System.out.println("CAN Thread throw : " + e);
      }
    }
  }

  private void CAN0CLEARTX() {
    long starttime = System.currentTimeMillis();
    long limittime = starttime + 10;                                            // if can't send data within 10 mSec try to another Bus

    if (can.isTX0IF(0)) {
      can.clearTX0IF(0);                                                        // clear Tx buffer empty flag
    }

    while ((can.readStatus(0) & 0x04) == 0x04) {
      starttime = System.currentTimeMillis();
      if (limittime < starttime) {
        if (getCANActive() == 0) {
          setCANActive(1);                                                      // Chang to Bus B
//          MainFrame.sendstatus.sendStatus(1, 4, 1);                             // Send command
//          CAN1TX();
//          MainFrame.sendstatus.sendStatus(2, 4, 1);
//          CAN1TX();
//          try {
//            MainFrame.Tx.setShareData(canbuffer);
//          }
//          catch(Exception e) {}
          MainFrame.sendstatus.sendStatus(canbuffer.getID(), 0x04, 0x01);
          MainFrame.messagestatus.setText(MainFrame.messagestatus.getText() + "Change Bus to : B\n");
          can.resetCAN0();
          can.initCAN0();
          break;
        }
        else {
          setCANActive(0);                                                      // Chang to Bus A
//          MainFrame.sendstatus.sendStatus(1, 4, 0);
//          CAN0TX();
//          MainFrame.sendstatus.sendStatus(2, 4, 0);
//          CAN0TX();
//          try {
//            MainFrame.Tx.setShareData(canbuffer);
//          }
//          catch(Exception e) {}
          MainFrame.sendstatus.sendStatus(canbuffer.getID(), 0x04, 0x00);
          MainFrame.messagestatus.setText(MainFrame.messagestatus.getText() + "Change Bus to : A\n");
          can.resetCAN1();
          can.initCAN1();
          break;
        }
      }
    }

    if (can.isTX0IF(0)) {
      can.clearTX0IF(0);                                                        // clear Tx buffer empty flag
    }
  }

