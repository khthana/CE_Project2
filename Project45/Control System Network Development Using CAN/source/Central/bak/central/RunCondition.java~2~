class RunCondition {

  private boolean run;

  public RunCondition() {
    run = true;
  }

  public synchronized void setShareData() {
    while (!run) {
      try {
        wait();                                                                 // wait if buffer is not get yet
      }
      catch (InterruptedException e) {
        e.printStackTrace();
      }
    }
    run = false;
    notify();
  }

  public synchronized void getShareData() {
    while (run) {
      try {
        wait();                                                                 // wait if buffer is not get yet
      }
      catch (InterruptedException e) {
        e.printStackTrace();
      }
    }
    run = true;
    notify();
  }
}