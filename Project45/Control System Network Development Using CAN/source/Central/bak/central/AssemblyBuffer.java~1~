package central;

/*
Buffer that keep data for Assembly
Largeest data is 256 Byte
*/

class AssemblyBuffer {

  private int ID, Flag;
  private String str;

  AssemblyBuffer() {
    ID = -1;
    str = "";
    ID = 0;
  }

  public void setID(int id) {
    ID = id;
  }

  public int getID() {
    return ID;
  }

  public void setFlag(int idflag) {
    idflag &= 0xe0;
    Flag = idflag;
  }

  public int getFlag() {
    return Flag;
  }

  public void addData(String s) throws CANException{
    if ((str.length() + s.length()) > 256)
      throw new CANException("Assembly Buffer Data is too big");
    else {
      str += s;
    }
  }

  public void clearData() {
    str = "";
  }

  public String getData(){
    return str;
  }
}