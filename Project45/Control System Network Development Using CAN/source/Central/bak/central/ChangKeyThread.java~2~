class ChangKeyThread extends Thread{

  private static int time;

  public ChangKeyThread(String s, int timearg) {
    super(s);
    time = timearg;
  }

  public void setTime(int timearg){
    time = timearg;
  }

  public void run() {
    try{
      sleep(time);
    }
    catch(Exception e) {}
  }
}