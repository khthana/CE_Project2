class TimeOutHandle {

  private Vector vector = new Vector();

  public TimeOutHandle() {

  }

  public void SetTimeout(int sequence, int timeout, int nodenumber) {
    vector.addElement(new TimeOutThread("Timeout Thread", sequence, timeout, nodenumber));
  }

  public void ClearTimeout(int sequence) {
    for (int i = 0; i < vector.size(); i++) {
      TimeOutThread t = (TimeOutThread) vector.elementAt(i);
      if (t.getSequence() == sequence) {
        t.setSequencr(-1);
      }
    }
  }

}