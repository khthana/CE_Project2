class KeyManageThread extends Thread{

  private static int time;
  private static KeySpec newkey[] = { new KeySpec(MainFrame.Des[0].getKey()), new KeySpec(MainFrame.Des[1].getKey()), new KeySpec(MainFrame.Des[2].getKey()) };
  private static HighLayerBuffer highbuffer;

  public KeyManageThread(String s, int timearg) {
    super(s);
    time = timearg * 1000;
    highbuffer = new HighLayerBuffer();
  }

  public void setTime(int timearg){
    time = timearg;
  }

  public void run() {
    try{
      sleep(time);
    }
    catch(Exception e) {}

    // chang new key here

    for (int i = 0; i < 3; i++) {
      try {
        String keystr = "";
        int sum = 0;
        sum += 5;
        sum += 0;
        sum ^= 0xff;
        sum += 1;
        sum &= 0x0ff;
        keystr += (char) sum;
        keystr += (char) 5;
        keystr += (char) 0;
        char k[] = newkey[i].getKey();
        for (int j = 0; j < 8; j++) {
          keystr += k[i];
        }
        highbuffer.setID(i + 1);
        highbuffer.setFlag(0x40);
        highbuffer.setData(keystr);
        MainFrame.TBx.setShareData(highbuffer);
      }
      catch (Exception e) {
        System.out.println("Exception from KeyManage Thread : " + e);
      }
    }
  }
}