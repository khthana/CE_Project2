  MCP2510(int portaddr) {
    this.can = new ParallelPort(portaddr);
    this.port = portaddr;

    resetCAN0();
    resetCAN1();
    initCAN0();
    initCAN1();

    MainFrame.messagestatus.setText(MainFrame.messagestatus.getText() + "CAN configuration successful" + "\n");

  }

  public void resetCAN0() {
    pbuf = 0xf7;
    can.writeOneByte(port, pbuf);
    try
    {
      Thread.sleep(20);
    }
    catch (Exception e)	{ }
    pbuf = 0xfd;
    can.writeOneByte(port, pbuf);
  }

  public void resetCAN1() {
    pbuf = 0x7f;
    can.writeOneByte(port, pbuf);
    try
    {
      Thread.sleep(20);
    }
    catch (Exception e)	{ }
    pbuf = 0xdf;
    can.writeOneByte(port, pbuf);
  }

  public void initCAN0() {
    writeByte(CANCTRL, SetConfigurationMode, 0);			        // 8 is set configuration mode,
    writeByte(CNF1, 0x04, 0);							// Baud rate prescaler
    writeByte(CNF2, 0xf1, 0);
    writeByte(CNF3, 0x05, 0);
    writeByte(TXRTSCTRL, 0x00, 0);						// Pin control and status register : read as 0 when pin is in request to send mode, digital input
    writeByte(RXB0CTRL, 0x04, 0);						// Receive all valid message using either standard or extended identifies that meet fillter criteria, No remote tranfer request receive, roll over enable, acceptance filter 0
    writeByte(RXB1CTRL, 0x00, 0);						// Receive all valid message using either standard or extended identifies that meet fillter criteria, No remote tranfer request receive, acceptance filter 0
    writeByte(RXF0SIDH, 0x83, 0);						// Set acceptance filter n standard identifier high to all '1' s
    writeByte(RXF0SIDL, 0xe0, 0);						// Set acceptance filter n standard identifier low to all '1' s
    writeByte(RXM0SIDH, 0x00, 0);						// Set acceptance filter mask n standard identifier high all '0' s so filter must not match every bit
    writeByte(RXM0SIDL, 0x00, 0);						// Set acceptance filter mask n standard identifier low all '0' s so filter must not match every bit
    writeByte(RXM0EID8, 0x00, 0);						// Set acceptance filter mask n extended identifier high all '0' s so filter must not match every bit
    writeByte(RXM0EID0, 0x00, 0);						// Set acceptance filter mask n extended identifier low all '0' s so filter must not match every bit
    writeByte(TXB0CTRL, 0x03, 0);						// Transmit buffer n control register : Highest message priority
    writeByte(CANCTRL, SetNormalMode, 0);					// Set normal operation mode
  }

  public void initCAN1() {
    writeByte(CANCTRL, SetConfigurationMode, 1);			        // 8 is set configuration mode,
    writeByte(CNF1, 0x04, 1);							// Baud rate prescaler
    writeByte(CNF2, 0xf1, 1);
    writeByte(CNF3, 0x05, 1);
    writeByte(TXRTSCTRL, 0x00, 1);						// Pin control and status register : read as 0 when pin is in request to send mode, digital input
    writeByte(RXB0CTRL, 0x04, 1);						// Receive all valid message using either standard or extended identifies that meet fillter criteria, No remote tranfer request receive, roll over enable, acceptance filter 0
    writeByte(RXB1CTRL, 0x00, 1);						// Receive all valid message using either standard or extended identifies that meet fillter criteria, No remote tranfer request receive, acceptance filter 0
    writeByte(RXF0SIDH, 0x81, 1);						// Set acceptance filter n standard identifier high to all '1' s
    writeByte(RXF0SIDL, 0xe0, 1);						// Set acceptance filter n standard identifier low to all '1' s
    writeByte(RXM0SIDH, 0x00, 1);						// Set acceptance filter mask n standard identifier high all '0' s so filter must not match every bit
    writeByte(RXM0SIDL, 0x00, 1);						// Set acceptance filter mask n standard identifier low all '0' s so filter must not match every bit
    writeByte(RXM0EID8, 0x00, 1);						// Set acceptance filter mask n extended identifier high all '0' s so filter must not match every bit
    writeByte(RXM0EID0, 0x00, 1);						// Set acceptance filter mask n extended identifier low all '0' s so filter must not match every bit
    writeByte(TXB0CTRL, 0x03, 1);						// Transmit buffer n control register : Highest message priority
    writeByte(CANCTRL, SetNormalMode, 1);
  }

// Data register
// bit7, bit6, bit5, bit4, bit3, bit2, bit1, bit0
// RESET1, CS1,	SO1, SCK1, RESET0, CS0,	SO0, SCK0

// Status register
// bit7, bit6, bit5, bit4, bit3, bit2, bit1, bit0
// SI1,  SI0,  null, null, null, null, null, null

  private void shiftOut(int dbuf, int number){
    int i, x;
    if (number == 0)
    {
      for (int j =0; j<=7; j++)
      {
        x = dbuf;
        x &= 0x80;
        x = x >> 6;
        pbuf &= 0xfd;
        pbuf |= x;								// send si
        can.writeOneByte(port, pbuf);
        pbuf &= 0xfe;								// sck = 0
        can.writeOneByte(port, pbuf);
        pbuf |= 0x01;								// sck = 1
        can.writeOneByte(port, pbuf);
        dbuf = dbuf << 1;							// shift data 1 bit
      }
    }
    else if (number == 1)
    {
      for (int j =0; j<=7; j++)
      {
        x = dbuf;
        x &= 0x80;
        x = x >> 2;
        pbuf &= 0xdf;
        pbuf |= x;								// send si
        can.writeOneByte(port, pbuf);
        pbuf &= 0xef;								// sck = 0
        can.writeOneByte(port, pbuf);
        pbuf |= 0x10;								// sck = 1
        can.writeOneByte(port, pbuf);
        dbuf = dbuf << 1;							// shift data 1 bit
      }
    }
  }

  private int shiftIn(int number){
    int i, x = 0, dbuf;
    dbuf = 0;
    if (number == 0)
    {
      for (int j =0; j<=7; j++)
      {
        pbuf &= 0xfe;								// sck = 0
        can.writeOneByte(port, pbuf);
        pbuf |= 0x01;								// sck = 1
        can.writeOneByte(port, pbuf);
        x = can.readOneByte(port + 1);				                // receive so
        x &= 0x40;
        if (x == 0x40)
          x = 1;
        else
          x = 0;
        dbuf = dbuf << 1;							// shift data 1 bit
        dbuf |= x;
      }
    }
    else if (number == 1)
    {
      for (int j =0; j<=7; j++)
      {
        pbuf &= 0xef;								// sck = 0
        can.writeOneByte(port, pbuf);
        pbuf |= 0x10;								// sck = 1
        can.writeOneByte(port, pbuf);
        x = can.readOneByte(port + 1);				                // receive so
        x &= 0x80;
        if (x == 0x80)
          x = 0;
        else
          x = 1;
        dbuf = dbuf << 1;							// shift data 1 bit
        dbuf |= x;
      }
    }
    return dbuf;
  }

  public int readByte(int addr, int number){
    int dbuf = 0;
    if (number == 0)
      pbuf &= 0xfb;								// cs = 0
    else if (number == 1)
      pbuf &= 0xbf;								// cs = 0
    can.writeOneByte(port, pbuf);
    shiftOut(0x03, number);						        // send instruction
    shiftOut(addr, number);							// send address
    dbuf = shiftIn(number);							// receive data
    pbuf |= 0x44;								// cs = 1
    can.writeOneByte(port, pbuf);
    return dbuf;
  }

  public void writeByte(int addr, int data, int number) {
    if (number == 0)
      pbuf &= 0xfb;								// cs = 0
    else if (number == 1)
      pbuf &= 0xbf;								// cs = 0
    can.writeOneByte(port, pbuf);
    shiftOut(0x02, number);							// send instruction
    shiftOut(addr, number);							// send address
    shiftOut(data, number);							// send data
    pbuf |= 0x44;								// cs = 1
    can.writeOneByte(port, pbuf);
  }

  public void bitModify(int addr, int mask, int data, int number){
    if (number == 0)
      pbuf &= 0xfb;								// cs = 0
    else if (number == 1)
      pbuf &= 0xbf;								// cs = 0
    can.writeOneByte(port, pbuf);
    shiftOut(0x05, number);							// send instruction
    shiftOut(addr, number);							// send address
    shiftOut(mask, number);							// send mask
    shiftOut(data, number);							// send data
    pbuf |= 0x44;								// cs = 1
    can.writeOneByte(port, pbuf);
  }

  public void requestToSend(int data, int number){
    if (number == 0)
      pbuf &= 0xfb;								// cs = 0
    else if (number == 1)
      pbuf &= 0xbf;								// cs = 0
    can.writeOneByte(port, pbuf);
    shiftOut(data, number);							// send instruction
    pbuf |=0x44;								// cs = 1
    can.writeOneByte(port, pbuf);
  }

  public int readStatus(int number){
    int dbuf = 0;
    if (number == 0)
      pbuf &= 0xfb;								// cs = 0
    else if (number == 1)
      pbuf &= 0xbf;								// cs = 0
    can.writeOneByte(port, pbuf);
    shiftOut(0xa0, number);							// send instruction
    dbuf = shiftIn(number);							// receive data
    dbuf = shiftIn(number);							// receive data again
    pbuf |= 0x44;								// cs = 1
    can.writeOneByte(port, pbuf);
    return dbuf;
  }

  public int readFlag(int number) {
    return readByte(CANINTF, number);
  }

  public int readICOD(int number) {
    return readByte(CANSTAT, number);
  }

  public void clearMERRF(int number) {
    bitModify(CANINTF, 0x80, 0, number);
  }

  public void clearWAKIF(int number) {
    bitModify(CANINTF, 0x40, 0, number);
  }

  public void clearERRIF(int number) {
    bitModify(CANINTF, 0x20, 0, number);
  }

  public boolean isTX0IF(int number) {						// check TX0 Interrupt
    if ((readStatus(number) & 0x08) == 0x08)
      return true;
    else
      return false;
  }

  public void clearTX0IF(int number) {						// clear TX0 Frag
    bitModify(CANINTF, 0x04, 0, number);
  }

  public boolean isRX1IF(int number) {						// check RX1 Interrupt
    if ((readStatus(number) & 0x02) == 0x02)
      return true;
    else
      return false;
  }

  public void clearRX1IF(int number) {						// clear RX1 Frag
    bitModify(CANINTF, 0x02, 0, number);
  }

  public boolean isRX0IF(int number) {						// check RX0 Interrupt
    if ((readStatus(number) & 0x01) == 0x01)
      return true;
    else
      return false;
  }

  public void clearRX0IF(int number) {						// clear RX0 Frag
    bitModify(CANINTF, 0x01, 0, number);
  }
