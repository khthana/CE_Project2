class IntLoop {

  private int count;
  private int looplimit;

  public IntLoop() {
    count = -1;
    looplimit = 2;
  }

  public int getValue()  {
    ++count;
    if (count > looplimit) {
      count = 0;
    }
    return count;
  }

}