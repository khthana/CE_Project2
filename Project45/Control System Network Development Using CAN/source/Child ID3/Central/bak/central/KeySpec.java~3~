class KeySpec {

  private char key[] = new char[8];

  public KeySpec(char key[]) {
    for (int i = 0; i < 8; i++)
      key[i] = (char)i;
  }

  public char[] getKey() {
    return key;
  }

  public void randomKey() {
    for (int i = 0; i < 8; i++)
      key[i] = (char)i;
  }
}