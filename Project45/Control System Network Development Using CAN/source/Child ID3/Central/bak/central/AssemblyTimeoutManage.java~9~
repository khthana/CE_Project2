class AssemblyTimeoutManage {

  private Vector vector = new Vector();

  public AssemblyTimeoutManage() {
  }

  public void SetTimeout(int timeout, int nodenumber) {
    AssemblyTimeoutThread assemthread = new AssemblyTimeoutThread("Assembly Timeout Thread", timeout, nodenumber);
    vector.addElement(assemthread);
    assemthread.start();
  }

  public void ClearTimeout(int nodenumber, int flag) {
    for (int i = 0; i < vector.size(); i++) {
      AssemblyTimeoutThread assemthread = (AssemblyTimeoutThread) vector.elementAt(i);
      if (assemthread.getNodeNumber() == nodenumber) {
        assemthread.clearActive();
        vector.removeElementAt(i);
      }
    }
  }
}