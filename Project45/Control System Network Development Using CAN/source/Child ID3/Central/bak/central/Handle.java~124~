class SendButtonHandling implements ActionListener {				// Handle send button

 private HighLayerBuffer highbuffer = new HighLayerBuffer();

 SendButtonHandling() {
 }

 public void actionPerformed(ActionEvent e) {
   try
   {
     if (!SendTab.ptypetxt.isEditable()) {									// For Data
       String str = "";
       highbuffer.setID( (char) (int) Integer.parseInt(SendTab.pidtxt.getText()));
       highbuffer.setFlag(0x00);
       str += (char) (int) Integer.parseInt(SendTab.ptotallengthtxt.getText());
       str += (char) (int) Integer.parseInt(SendTab.pchecksumtxt.getText());
       str += SendTab.pdatatxt.getText();
       highbuffer.setData(str);
       MainFrame.TBx.setShareData(highbuffer);
//       MainFrame.retransmit.setBuffer(highbuffer);
     }
     else {																// For status
       String str = "";
       highbuffer.setID( (char) (int) Integer.parseInt(SendTab.pidtxt.getText()));
       highbuffer.setFlag(0x40);
       str += (char) (int) Integer.parseInt(SendTab.pchecksumtxt.getText());
       str += (char) (int) Integer.parseInt(SendTab.ptypetxt.getText());
       str += (char) (int) Integer.parseInt(SendTab.pcodetxt.getText());
       highbuffer.setData(str);
       MainFrame.TBx.setShareData(highbuffer);
//       MainFrame.retransmit.setBuffer(highbuffer);
     }
   }
   catch (CANException eee) {
     System.out.println("SendButtonHandling throw : " + eee);
   }
   catch (Exception ee)
   {
     JOptionPane.showMessageDialog(null, "Input Error", "Error", JOptionPane.WARNING_MESSAGE);
     System.out.println("SendButtonHandling throw : " + ee);
   }
 }
}

