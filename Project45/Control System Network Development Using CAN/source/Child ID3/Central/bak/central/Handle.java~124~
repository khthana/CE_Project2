class DataChecksumHandling implements KeyListener {                             // Provide checksum

 DataChecksumHandling() {
 }
 public void keyPressed(KeyEvent e) {
 }
 public void keyReleased(KeyEvent e) {
   try {
   String txt = "";
   txt += (char) (int) Integer.parseInt(SendTab.ptotallengthtxt.getText());
   txt += (char) 0;
   txt += SendTab.pdatatxt.getText();
   int sum = 0;
   for (int i = 0; i < txt.length(); i++)
   {
     sum += (int) txt.charAt(i);
     sum &= 0x0ff;
   }
   sum ^= 0xff;
   sum += 1;
   sum &= 0x0ff;
   SendTab.pchecksumtxt.setText(Integer.toString(sum));
   }
   catch(Exception ee) {
     SendTab.pchecksumtxt.setText("0");
   }
 }
 public void keyTyped(KeyEvent e) {
 }
}

