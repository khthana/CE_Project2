IDD_GAMEOPTION_DIALOG DIALOG DISCARDABLE  0, 0, 233, 63
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Game Option Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,122,42,50,14
