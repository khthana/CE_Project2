IDR_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&New Game\tCtrl+N",           IDM_NEWGAME
        MENUITEM "&Load Game\tCtrl+L",          IDM_LOADGAME
        MENUITEM "&Save Game\tCtrl+S",          IDM_SAVEGAME
        MENUITEM SEPARATOR
        MENUITEM "Game &Option\t Ctrl+O",       IDM_GAMEOPTION
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+X",                IDM_EXIT
    END
    POPUP "&Neural"
    BEGIN
        MENUITEM "&Load Neural",                IDM_LOADNEURAL
        MENUITEM "&Save Neural",                IDM_SAVENEURAL
        MENUITEM "&Train Neural",               IDM_TRAINNEURAL
        MENUITEM SEPARATOR
        MENUITEM "Train &Option",               IDM_TRAINOPTION
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toggle Fullscreen\tAlt+Tab", IDM_TOGGLEFULLSCREEN
    END
END


