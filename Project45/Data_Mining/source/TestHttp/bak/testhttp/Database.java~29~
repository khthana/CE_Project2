                                           "where day_trade = ? and "+
                                           "stock_code = ? ", ResultSet.TYPE_SCROLL_SENSITIVE, ResultSet.CONCUR_UPDATABLE);

    // refer sql Insert
    sqlInsert = connection.prepareStatement("insert into Intraday "+
        "( day_trade,stock_code,flag,mkt_status,"+
          "price_last,price_change,per_change,bid_price1,"+
          "bid_price2,bid_price3,bid_vol1,bid_vol2,"+
