    connection.setAutoCommit(false);

    // refer find Stock Code
    sqlFind = connection.prepareStatement("select stock_code from NGEE "+
                                          "order by stock_code ASC", ResultSet.TYPE_FORWARD_ONLY, ResultSet.CONCUR_UPDATABLE);

