          "sell_vol,volume,amount,price_open1,"+
          "price_open2,price_high,price_low,price_avg,"+
          "price_prior,deciss) values"+
        "( ?,?,?,?,"+
          "?,?,?,?,"+
          "?,?,?,?,"+
          "?,?,?,?,"+
          "?,?,?,?,"+
          "?,?,?,?,"+
          "?,?,?,?,"+
          "?,?) ");

    // refer sql Update
    sqlUpdate = connection.prepareStatement("update Intraday set "+
                                            "flag = ? ,"+
                                            "mkt_status = ? , "+
                                            "price_last = ? , "+
                                            "price_change = ? , "+
                                            "per_change = ? , "+
                                            "bid_price1 = ? , "+
                                            "bid_price2 = ? , "+
                                            "bid_price3 = ? , "+
                                            "bid_vol1 = ? , "+
                                            "bid_vol2 = ? , "+
                                            "bid_vol3 = ? , "+
                                            "offer_price1 = ? , "+
