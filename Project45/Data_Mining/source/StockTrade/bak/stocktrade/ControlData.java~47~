  public Vector findMaxMin( Vector dat ){
    double max,min,j;
    String temp;
    Vector vv = new Vector();
    vv = dat;
    try{
    max = Double.parseDouble( dat.elementAt(0).toString() );
    min = max;
    for( int w=0;w<dat.size();w++ ){
      temp = dat.elementAt(w).toString();
       if( max < Double.parseDouble( temp ) )
          max = Double.parseDouble( temp );
        if( min > Double.parseDouble( temp ) )
          min = Double.parseDouble( temp );
    }
    j = max - min;
    if( j>=0 && j<=0.40 )
      j=0.10;
    else j=j/4;

    max = max+j;
    min = min-j;
    vv.add( new Double(max) );
    vv.add( new Double(min) );
    return vv;
