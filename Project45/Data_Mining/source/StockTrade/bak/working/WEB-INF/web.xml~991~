<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>
  <servlet>
    <servlet-name>connecdata</servlet-name>
    <servlet-class>stocktrade.ConnecData</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>newintradaychartservlet</servlet-name>
    <servlet-class>stocktrade.NewIntradayChartServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>predicservlet</servlet-name>
    <servlet-class>stocktrade.PredicServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>servlet1</servlet-name>
    <servlet-class>stocktrade.Servlet1</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>connecdata</servlet-name>
    <url-pattern>/connecdata</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>newintradaychartservlet</servlet-name>
    <url-pattern>/newintradaychartservlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>predicservlet</servlet-name>
    <url-pattern>/predicservlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>servlet1</servlet-name>
    <url-pattern>/servlet1</url-pattern>
  </servlet-mapping>
</web-app>
