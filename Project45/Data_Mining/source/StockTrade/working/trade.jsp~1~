<%@ page contentType="text/html; charset=MS874" %>
<html>
<head>
<title>
trade
</title>
</head>
<jsp:useBean id="tradeBeanId" scope="session" class="stocktrade.tradeBean" />
<jsp:setProperty name="tradeBeanId" property="*" />
<body>
<h1>
JBuilder Generated JSP
</h1>
<applet code="linegraph.class" codebase="/stocktrade/" width=420 height=320>
  <param name=title value="Price (k$) / Demand">
   <param name=NumberOfVals value=0>
   <param name=xmax value=70000>
   <param name=xmin value=0>
   <param name=ymax value=5000>
   <param name=ymin value=0>
   <param name=mode value=1>
   <param name=LineColor_R value=51>
   <param name=LineColor_G value=153>
   <param name=LineColor_B value=51>
   <param name=Grid value="true">
  </applet>
<form  action="servlet/stocktrade.ConnecData" method="post">
<br>Enter new value   :  <input name="sample"><br>
<br><br>
<input type="submit" name="Submit" value="Submit">
<input type="reset" value="Reset">
<br>
Value of Bean property is :<jsp:getProperty name="tradeBeanId" property="sample" />
</form>
</body>
</html>
