<jsp:useBean id="GraphstBeanId" scope="session" class="stocktrade.GraphsBean" />
<jsp:setProperty name="GraphsBeanId" property="*" />
<body>
<form name="SelectGraph" action="Graphs.jsp" method="post">
<table width="600" border="0" cellspacing="0" cellpadding="0">
  <tr>
  <td valign="top" align="center">
    <table width="100%" border="0" cellspacing="0" cellpadding="0" align="center">
      <tr> 
        <td><font color="#999933" face="Courier New, Courier, mono"><strong>¥Ÿ°√“ø√“§“ÀÿÈπ</strong></font></td>
