  public void setSETValue( String ddma, String ddmi ){
    this.set_value = new Vector();
    try{
      ResultSet rs = database.findSETValue( ddma,ddmi );
      if( rs != null ){
        while( rs.next() ){
          this.set_value.addElement( new Float(rs.getFloat(1)) );
        }
      }
      rs.close();
    }
    catch( Exception e ){
      e.printStackTrace();
      System.out.println(" find SET Value ");
    }
  }
