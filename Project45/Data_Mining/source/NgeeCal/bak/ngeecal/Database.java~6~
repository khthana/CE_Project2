  public ResultSet RangeTest( String stock_code, String dmax, String dmin )
      throws DataException{
    try{
      PreparedStatement sqlRange;
      sqlRange = connection.prepareStatement("select distinct(p1.day_trade), p1.z_close, ((z_high+z_low)/2), "+
                                             "p2.range, p1.deciss "+
                                             "from "+stock_code+" p1, volume_range p2 "+
                                             "where p1.day_trade <= '"+dmax+"' "+
                                             "and p1.day_trade >= '"+dmin+"' "+
                                             "and p2.volume = "+
                                             "( select max(p3.volume) "+
                                             "from volume_range p3 "+
                                             "where p3.volume <= p1.z_volume*10 ) "+
                                             "order by day_trade DESC",ResultSet.TYPE_FORWARD_ONLY, ResultSet.CONCUR_UPDATABLE);
      ResultSet rs = sqlRange.executeQuery();
      if( rs != null ){
        return rs;
      }
      else return null;

    }
    catch( SQLException ex ){
        throw new DataException( ex );
      }
  }
