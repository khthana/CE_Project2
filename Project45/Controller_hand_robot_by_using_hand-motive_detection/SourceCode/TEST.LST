     0000              1	        ORG 0000H        
     6800=             2	        Port1A EQU 06800H
     6801=             3	        Port1B EQU 06801H
     6802=             4	        Port1C EQU 06802H
     A800=             5	        Port2A EQU 0A800H
     A801=             6	        Port2B EQU 0A801H
     A802=             7	        Port2C EQU 0A802H
     C800=             8	        Port3A EQU 0C800H
     C801=             9	        Port3B EQU 0C801H
     C802=            10	        Port3C EQU 0C802H
     00A4=            11	        ST_ADC EQU P2.4
     00A3=            12	        OUT_EN EQU P2.3
     0060=            13	        D_Buff EQU 60H
                      14	;****** Main Program **********
     0000             15	MAIN:
                      16	
     0000 90A802      17	M_DRV:  MOV DPTR,#Port2C
     0003 7411        18	        MOV A,#00010001B
     0005 F0          19	        MOVX @DPTR,A
     0006 12001D      20	        CALL DELAY
     0009 7422        21	        MOV A,#00100010B
     000B F0          22	        MOVX @DPTR,A
     000C 12001D      23	        CALL DELAY
     000F 7444        24	        MOV A,#01000100B
     0011 F0          25	        MOVX @DPTR,A
     0012 12001D      26	        CALL DELAY
     0015 7488        27	        MOV A,#10001000B
     0017 F0          28	        MOVX @DPTR,A
     0018 12001D      29	        CALL DELAY
     001B 80E3        30	        JMP MAIN
                      31	
                      32	;**********DELAY**********
     001D 78FF        33	DELAY:  MOV R0,#0FFH                    
     001F 7904        34	DELAY2: MOV R1,#04H                    
     0021 D9FE        35	DELAY1: DJNZ R1,DELAY1
     0023 D8FA        36	        DJNZ R0,DELAY2
     0025 22          37		RET
     0000=            38		END

