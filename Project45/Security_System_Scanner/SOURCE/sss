#---------------1. unowned files----------------------------
sub unowned{
print ("Checking unowned files .......... ");
open(TEMP,">unowned.tmp");
open(PIPEFROM,"find / \\( -nouser -o -nogroup \\) -ls | ");

  	@line = <PIPEFROM>;
   	print TEMP @line;
close PIPEFROM;
close TEMP;
   	if (-s "unowned.tmp")
   	{
	 	$sentence = "<*****>\t You have unowned file ( file that don't know who is owner (userid or groupid)) We recommend you should delete or change owner file (chown (uid/gid) filename) Please look at [unowned.tmp]\n ";
    		print OUTPUT wrap("> ","> ",$sentence) ;

    		print LOG wrap("> ","> ",$sentence) ;
		open(TEMPP,"unowned.tmp");
		while(<TEMPP>)
		{
			$line=$_;
			chomp($line);    #---cut \n
    		   	print LOG $line ;
                }
		close TEMPP;

  	}
}
#---------------2. symbolic link----------------------------
sub symbolic {
print ("Checking symbolic link .......... ");
open(TEMP,">tmpsymbolic");
open(PIPEFROM," find / -type l | ");
  	@line = <PIPEFROM>;
   	print TEMP @line;
close PIPEFROM;
close TEMP;

open(TEMP3,">symbolic.tmp");   						#-----------files output " symbolic.tmp "
open(TEMP2,"<tmpsymbolic");      					#------------read tmpsymbolic for check owner file
     	while(<TEMP2>)
	{
    		$line = $_  ;             				#-------------get each line in file
        	chomp($line);        					#-------------cut new line
		$flagerror =0;
		$endlink ="";
		if ($line ne "")			#-------------cause last line of file is "" can't use it
             	{
			$startlink = ($line);
                        
			if ($startlink !~ /\/proc/)     #-------------not check from /proc 
			{
                       	 			
                        while ($flagerror ==0)
			{
				if ((-e readlink($startlink))&& (! -l readlink($startlink))) 
				{
					$endlink = readlink($startlink);
					last;
				}

				elsif (-l readlink($startlink))   #-----case  a-->b-->c 
				{
					$startlink = readlink($startlink);

					if (substr($startlink,0,1) ne "/")
					{	$name= dirname($line)."/"."$startlink";}
					else {$name = $startlink;}				
	
					$startlink = $name;
					if ($name eq "$line")    #-----case  a-->b-->a ( loop)  
					{
						$flagerror = 1;
						print TEMP3 $line."\t\t loop link ";
						last;
					}
				}
				else 
					{
						if ((! -e $startlink)&& (! -f $startlink))
						{	
							$flagerror =1;
							$endlink = readlink($startlink);	#						print "$startlink $endlink  linkerror";  # 
							print TEMP3 $line."\t\t badlink";
							last;
						}
						else { $endlink = readlink($startlink);last;}
					}
			} 

                 	if (( -e "$endlink")&&($flagerror ==0))
                  	{
              
				$uid= (lstat($line))[4];
		 		if ($uid == 0 )
				{
                         		$mode = (lstat($endlink))[2] & 07777;#----get permission files linked to
					
					$check_end_uid= (lstat($endlink))[4]  ;  

                         		if ($mode & 2)  		     #----check files linked is world writable
					{ 	print TEMP3 $line."\t\t root -----> world writeable";}#-----write files to output
					
					elsif ($check_end_uid != 0)   	     #---- check root link to non-root
					{	print TEMP3 $line."\t\t root ----->noneroot";}
                 		}

                		elsif ($uid != 0 )			     #----check nonroot link to root 
		    		{
		                  	if ((lstat($endlink))[4] == 0 )
			  		{ 	print TEMP3 $line."\t\t noneroot ----->to root";} #-----and write this file to symbolic.tmp
                     		        else {}
				}
				else{}

			}							#--------if (-e )
			else {};

		} 								#------ if not /proc       	
	}									#-------if ($line ne "")
    	} 									#------while
close TEMP3;
close TEMP2;
	if (-s "symbolic.tmp") 							#------if file have size
    	{
		$sentence = "<*****>\t You have symbolic file Hole.This symbolic files link to world-writeable or link to root's files Please look at [symbolic.tmp]\n " ;
    		print OUTPUT wrap("> ","> ",$sentence) ;

    		print LOG wrap("> ","> ",$sentence) ;
		open(TEMPP,"symbolic.tmp");
		while(<TEMPP>)
		{
			$line=$_;
			chomp($line);    #---cut \n
    		   	print LOG $line ;
                }
		close TEMPP;
    	}
}
