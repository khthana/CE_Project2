 #--------------4. World-Writable ---------------------------
sub world{
print ("Checking World-Writeable .......... ");

open(TEMP,">world.tmp");
open(PIPEFROM," find / \\( -perm -2 ! -type l -uid 0 \\) -ls | ");
	while (<PIPEFROM>)
	{	
		$line = $_;
		chomp($line);	
	
		if (($line !~ /\/dev/)&&($line !~ /\/proc/))   
		{ 	print TEMP $line;}
  	}
close PIPEFROM;
close TEMP;
	if ( -s "world.tmp")
	{ 	$sentence =  "<*****>\t You have world-writeable file. You shouldn't have more bcz it is a hole someone can write something in this file. Remove it by (chmod o-w filename). Please look at [world.tmp]\n" ;
    		print OUTPUT wrap("> ","> ",$sentence) ;

    		print LOG wrap("> ","> ",$sentence) ;
		open(TEMPP,"world.tmp");
		while(<TEMPP>)
		{
			$line=$_;
			chomp($line);    #---cut \n
    		   	print LOG $line ;
                }
		close TEMPP;
	}
}
#--------------------------------------- 5. check /etc/securetty
sub securetty{
print"Checking /etc/securetty...";
open(GETTTY,">securetty.tmp");
open(TEMP,"</etc/securetty") or die "Can't read /etc/securetty : $! \n";
  	while(<TEMP>)
 	{
    		$line = $_;
    		chomp($line);

    		@tty= &shellwords($line)  	;
    		$i=0;
    		foreach(@tty)
     		{     						#------- =~/ttyp/
			if (($tty[$i] =~ /ttyp/ ) && ($i==0) && ($tty[$i] !~ /\#ttyp/ ))#case ttyp* and must not have "#"
         		{
				print GETTTY $tty[$i] ;		#---- print unsecure tty to securetty.tmp
	 		}
        		$i=$i+1;
    		}
  	}
close TEMP;
close GETTTY;
    	if (-s "securetty.tmp")      
    	{ 
		$sentence = "<*****>\t Please look at /etc/securetty you should not permit root login with ttyp*.Please look at [securetty.tmp]\n";
    		print OUTPUT wrap("> ","> ",$sentence) ;

    		print LOG wrap("> ","> ",$sentence) ;
		open(TEMPP,"securetty.tmp");
		while(<TEMPP>)
		{
			$line=$_;
			chomp($line);    #---cut \n
    		   	print LOG $line ;
                }
		close TEMPP;
   	}
}
#-------------------------------------------6.Check Xinetd
sub xinetd{
