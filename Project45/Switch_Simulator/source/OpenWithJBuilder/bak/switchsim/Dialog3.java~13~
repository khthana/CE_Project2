package switchsim;

import java.awt.*;
import java.util.*;
import javax.swing.*;
import com.borland.jbcl.layout.*;
import java.awt.event.*;

public class Dialog3 extends JDialog {
  Switch sw = new Switch();
  Workstation com = new Workstation();
  InterfaceImg intimg;
  String inf;
  JPanel panel1 = new JPanel();
  XYLayout xYLayout1 = new XYLayout();
  JList jList1 = new JList();
  JLabel jLabel1 = new JLabel();
  JLabel jLabel2 = new JLabel();
  JLabel jLabel3 = new JLabel();
  JButton jButton1 = new JButton();
  JButton jButton2 = new JButton();
  JScrollPane jScrollPane1 = new JScrollPane();

  public Dialog3(Frame frame, String title, boolean modal) {
    super(frame, title, modal);
//    try {
//      jbInit();
//      pack();
//    }
//    catch(Exception ex) {
//      ex.printStackTrace();
//    }
  }

  public Dialog3() {
    this(null, "Connection", true);
  }
  void jbInit() throws Exception {
    panel1.setLayout(xYLayout1);
    jLabel1.setFont(new java.awt.Font("Dialog", 1, 12));
    jLabel1.setHorizontalAlignment(SwingConstants.CENTER);
    jLabel1.setHorizontalTextPosition(SwingConstants.LEADING);
    jLabel1.setText(sw.getName());
    jLabel2.setFont(new java.awt.Font("Dialog", 1, 12));
    jLabel2.setHorizontalAlignment(SwingConstants.CENTER);
    jLabel2.setHorizontalTextPosition(SwingConstants.CENTER);
    jLabel2.setText(com.getName());
    jButton1.setBackground(new Color(223, 223, 223));
    jButton1.setText("Connect");
    jButton1.addActionListener(new java.awt.event.ActionListener() {
      public void actionPerformed(ActionEvent e) {
        jButton1_actionPerformed(e);
      }
    });
    jButton2.setBackground(new Color(223, 223, 223));
    jButton2.setText("Close");
    jButton2.addActionListener(new java.awt.event.ActionListener() {
      public void actionPerformed(ActionEvent e) {
        jButton2_actionPerformed(e);
      }
    });
    this.getContentPane().setBackground(new Color(223, 223, 223));
    panel1.setBackground(new Color(223, 223, 223));
    jScrollPane1.getViewport().setBackground(new Color(223, 223, 223));
    getContentPane().add(panel1);
    panel1.add(jLabel1,           new XYConstraints(50, 20, 90, 25));
    panel1.add(jLabel2,        new XYConstraints(200, 20, 90, 25));
    panel1.add(jButton1,            new XYConstraints(50, 200, 100, 25));
    panel1.add(jButton2,        new XYConstraints(190, 200, 100, 25));
    panel1.add(jLabel3,            new XYConstraints(0, 0, 340, 250));
    panel1.add(jScrollPane1,      new XYConstraints(50, 50, 90, 120));
    jScrollPane1.getViewport().add(jList1, null);
    }

  public void showDialog3(InterfaceImg iimg) {
    for (int i=0; i<Frame1.vSwitch.size(); i++) {
      Switch sw_tmp = (Switch)Frame1.vSwitch.elementAt(i);
      for (int j=0; j<sw_tmp.getVIntCom().size(); j++) {
        Interface inf = (Interface)sw_tmp.getVIntCom().elementAt(j);
        if (inf.equals(iimg.getInt1())) {
          this.sw = sw_tmp;
          j=sw_tmp.getVIntCom().size();
        }
      }
    }
    intimg=iimg;
    com = iimg.getWorkstation();
    jLabel1.setText(sw.getName());
    jLabel2.setText(com.getName());
    inf=iimg.getInt1().getNameInt();
    showDialog3();

    if (!this.isVisible()) {
      Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize();
      Dimension frameSize = this.getSize();
      if (frameSize.height > screenSize.height) {
        frameSize.height = screenSize.height;
      }
      if (frameSize.width > screenSize.width) {
        frameSize.width = screenSize.width;
      }
      this.setLocation((screenSize.width - frameSize.width) / 2, (screenSize.height - frameSize.height) / 2);
      this.setVisible(true);
    }
  }

  public void showDialog3() {
    Vector list = new Vector();
    for (int i=0; i<sw.getVIntSort().size(); i++) {
      Interface itmp = (Interface)sw.getVIntSort().elementAt(i);
//      System.out.println(i);
      if (((itmp.getCom()==null) && (itmp.getSwitch()==null)) || (inf.equals(itmp.getNameInt()))) {
        list.addElement(itmp.getNameInt());
//        System.out.print(itmp.getNameInt()+" ");
      }
    }
    jList1.setListData(list);
    jList1.setSelectedValue(inf,false);
    try {
      jbInit();
      pack();
    }
    catch(Exception ex) {
      ex.printStackTrace();
    }
  }

  void jButton1_actionPerformed(ActionEvent e) {
    Interface newint = new Interface();
    for (int i=0; i<sw.getVIntCom().size(); i++) {
      Interface itmp = (Interface)sw.getVIntCom().elementAt(i);
      if (itmp.getNameInt().equalsIgnoreCase(inf)) {
        sw.getVIntCom().removeElementAt(i);
        itmp.setConnectStatus("down");
        itmp.setSwitchInt(null);
        i=sw.getVIntCom().size();
      }
    }
    for (int i=0; i<sw.getVInt().size(); i++) {
      Interface itmp = (Interface)sw.getVInt().elementAt(i);
      if (itmp.getNameInt().equalsIgnoreCase((String)jList1.getSelectedValue())) {
        newint = itmp;
        i=sw.getVInt().size();
      }
    }
    newint.addNewIntCom(sw,newint.getNameInt(),com);
    intimg.setInt1(newint);
    this.dispose();
  }

  void jButton2_actionPerformed(ActionEvent e) {
    this.dispose();
  }

  /**Overridden so we can exit when window is closed*/
  protected void processWindowEvent(WindowEvent e) {
    super.processWindowEvent(e);
    if (e.getID() == WindowEvent.WINDOW_CLOSING) {
      this.dispose();
    }
  }
}