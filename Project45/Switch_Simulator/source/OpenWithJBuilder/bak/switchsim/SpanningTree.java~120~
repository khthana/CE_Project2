  public Switch getRootBridge() {
    Switch temp = new Switch();
    Switch ret = new Switch();
    String bid, rb = "";
    for (int i = 0; i < Frame1.vSwitch.size(); i++) {
      temp = (Switch)Frame1.vSwitch.elementAt(i);
      bid = temp.getBridgeID();
      rb = temp.getRootBridge();
      if (bid.equals(rb)) {
        ret = temp;
        i = Frame1.vSwitch.size();
      }
    }
    return ret;
  }

  public String compareBridgeID(String str1, String str2) {
    String result = "";
    for (int k = 0; k < 25; k++) {
      if ((k != 5) && (k != 10) && (k != 15)) {
        if (str1.charAt(k) < str2.charAt(k)) {
          result = "less";
          k = 25;
        }
        else if (str1.charAt(k) > str2.charAt(k))  {
          result = "more";
          k = 25;
        }
      }     // end if k
    }       // end for k
    return result;
  }

  public boolean checkSuccedOfSTP(Vector vName) {
    int x;
    String rb1, rb2 = "";
    boolean notDone = true;
    for (int y = 1; y < vName.size(); y++) {
        x = y - 1;
        rb1 = (String)vName.elementAt(x);
        rb2 = (String)vName.elementAt(y);
        if (rb1.equals(rb2)) {
          notDone = false;
        }
    }
    return notDone;
  }

  public void setPortForAllSwitch(Vector allSwitch) {
    Switch sender = new Switch();
    Switch temp = new Switch();
    Vector vInt = new Vector();
    Interface interf = new Interface();
    String str, tmpBID, rootPort, port = "";
    String STPstatus = "";
    int dist;

    for (int i = 0; i < allSwitch.size(); i++) {
      sender = (Switch)allSwitch.elementAt(i);
      STPstatus = sender.getSTPstatus();
//      System.out.println("STPstatus: " + i + " " + STPstatus);
      if (STPstatus.equals(sRB)) {
        System.out.println("Root Bridge = " + sender.getBridgeID());
        sender.setForRootBridge();
      }     // end if
      else if(STPstatus.equals(sNRB)) {
        str = sender.getDistance();
        dist = Integer.parseInt(str);
        for (int j = 0; j < allSwitch.size(); j++) {
          temp = (Switch)allSwitch.elementAt(j);
          vInt = temp.getVIntSwitch();
          tmpBID = temp.getBridgeID();
          rootPort = sender.findRootPort();
          if (dist > 1) {
            if (tmpBID.equals(rootPort)) {
              temp.receiveMessage(sender.sendMessage());
            }     // end if ==
          }       // end if > 1
        }         // end for j
      }           // end else if
    }             // end for i

    for (int a = 0; a < allSwitch.size(); a++) {
      temp = (Switch)allSwitch.elementAt(a);
      vInt = temp.getVIntSwitch();
//      System.out.println("***" + temp.getName());
      for (int b = 0; b < vInt.size(); b++) {
        interf = (Interface)vInt.elementAt(b);
//        System.out.println(interf.getSwitchName() + ":" + interf.getSTPport());
        port = interf.getSTPport();
        if (!(port.equals(sRP) || port.equals(sDP))) {
          interf.setSTPport(sNDP);
        }     // end if ||
      }       // end for b
    }         // end for a
  }

  public void setPortForVlanSwitch(Vlan v) {
    Switch temp = new Switch();
    Vector vInt = new Vector();
    Interface interf = new Interface();
    String str, tmpBID, rootPort, port = "";
    String STPstatus = "";
    int dist, pos;

    Vector swVlan = new Vector();
    Vector infVlan = new Vector();
    Switch sw1 = new Switch();
    Switch sw2 = new Switch();

    swVlan = v.getSwitchMember();
    for (int i = 0; i < swVlan.size(); i++) {
      sw1 = (Switch)swVlan.elementAt(i);
      pos = sw1.getVlanPostionInVlist(v);
//      System.out.println("STPstatus: " + i + " " + STPstatus);
      if (sw1.getvSTPstatus(pos).equals(sRB)) {
        sw1.setForVRootBridge(v);
      }     // end if
      else if (sw1.getvSTPstatus(pos).equals(sNRB)) {
        str = sw1.getvDistance(pos);
        dist = Integer.parseInt(str);
        for (int j = 0; j < swVlan.size(); j++) {
          sw2 = (Switch)swVlan.elementAt(j);
          rootPort = sw1.getvRootBridge(pos);
          if ((dist > 1) && (sw2.getBridgeID().equals(rootPort))) {
            sw2.receiveMessage(sw1.sendMessage());
          }
        }
      }
    }

    for (int i = 0; i < swVlan.size(); i++) {
      sw1 = (Switch)swVlan.elementAt(i);
      infVlan = sw1.getVlanIntSwitch(v.getVlanID());
      for (int j = 0; j < infVlan.size(); j++) {
        interf = (Interface)infVlan.elementAt(j);
        port = interf.getSTPport();
        if (!(port.equals(sRP) || port.equals(sDP))) {
          interf.setSTPport(sNDP);
        }     // end if ||
      }
    }
  }

  public void setLoopPort(Vector allSwitch) {
    Switch temp = new Switch();
    Vector vInt = new Vector();
    Interface interf = new Interface();
    String swBID, intBID, result, port = "";

    for (int a = 0; a < allSwitch.size(); a++) {
      temp = (Switch)allSwitch.elementAt(a);
      swBID = temp.getBridgeID();
      vInt = temp.getVIntSwitch();
      for (int b = 0; b < vInt.size(); b++) {
        interf = (Interface)vInt.elementAt(b);
        intBID = interf.getSwitchBridgeID();
        port = interf.getSTPport();
        if (port.equals(sNDP)) {
          result = compareBridgeID(swBID, intBID);
          if (result.equals("less")) {
            interf.setSTPport(sDP);
            interf.setSTPstate(liS);
          }
        }         // end if port.equals
      }           // end for b
    }             // end for a
  }

  public void setVlanLoopPort(Vlan v) {
    Vector swVlan = new Vector();
    Vector vIntVlan = new Vector();
    Switch sw = new Switch();
    Interface interf = new Interface();
    String result = "";
//    String swBID, intBID, result, port = "";

    swVlan = v.getSwitchMember();
    for (int i = 0; i < swVlan.size(); i++) {
      sw = (Switch)swVlan.elementAt(i);
      vIntVlan = sw.getVlanIntSwitch(v.getVlanID());
      for (int j = 0; j < vIntVlan.size(); j++) {
        interf = (Interface)vIntVlan.elementAt(j);
        if (interf.getSTPport().equals(sNDP)) {
          result = compareBridgeID(sw.getBridgeID(), interf.getSwitchBridgeID());
          if (result.equals("less")) {
            interf.setSTPport(sDP);
            interf.setSTPstate(liS);
          }
        }
      }
    }
  }

