  public void enablePerVLANSpanningTree(Vlan v) {
    Vector member = new Vector();
    Vlan vlan = new Vlan();
    Switch sw1 = new Switch();
    Switch sw2 = new Switch();

    Frame1.learn.suspendLearning();
    System.out.println("Suspend Address Learning...");

    disableCommonSTP();
    setStatus("enabled");
    Frame1.flag = 2;

    vlan = v.findVlan(v.getVlanID());
    member = vlan.getSwitchMember();
    for (int i = 0; i < member.size(); i++) {
      sw1 = (Switch)member.elementAt(i);
      for (int j = 0; j < Frame1.vSwitch.size(); j++) {
        sw2 = (Switch)Frame1.vSwitch.elementAt(j);
        if(sw1.getName().equals(sw2.getName())) {
          sw1.setStartVlan(vlan);
          sw2.setStartVlan(vlan);
        }
      }
    }

    Vector swVlan = new Vector();
    Vector vName = new Vector();
    Switch sender = new Switch();
    boolean notDone = true;
    int pos;

    swVlan = v.getSwitchMember();
    do {
      vName.removeAllElements();
      for (int i = 0; i < swVlan.size(); i++) {
        sender = (Switch)swVlan.elementAt(i);
        sender.doPerVLANSpanningTree(v);
        pos = sender.getVlanPostionInVlist(v);
        vName.addElement(sender.getvRootBridge(pos));
      }   // end for i
      notDone = checkSuccedOfSTP(vName);
    } while (notDone);
    setPortForVlanSwitch(v);
    setVlanLoopPort(v);
    setVlanPortForwarding(v);

    Frame1.updateAllStatus();

//------------------- check vlan --------------------
    System.out.println("-------------- check VLAN --------------------");
    Vector vInterf = new Vector();
    Vector vsw = new Vector();
    Interface interf = new Interface();
    Switch sw = new Switch();
    int p;

    vsw = v.getSwitchMember();
    vInterf = v.getInterfMem();

//    System.out.println("---- vlan " + v.getVlanID() + " ---");
//    System.out.println(sw.getName() + ": " + interf.getNameInt());

    for (int i = 0; i < vsw.size(); i++) {
      interf = (Interface)vInterf.elementAt(i);
      sw = (Switch)vsw.elementAt(i);

      p = sw.getVlanPosition(v.getVlanID());
      System.out.println("---- Switch " + sw.getName() + " ----");
      System.out.println("Root Bridge vlan " + v.getVlanID() + ": " + sw.getvRootBridge(p));
      System.out.println("Status: " + sw.getvSTPstatus(p));
    }
//----------------------------------------------------

    if (Frame1.learn.isAlive()){
      Frame1.learn.resume();
      System.out.println("Resume Address Learning...");
    }
    else{
      Frame1.learn.start();
      System.out.println("Start Address Learning...");
    }
  }               // end class

