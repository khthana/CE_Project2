    disableCommonSTP();
    setStatus("enabled");
    Frame1.flag = 1;

    for (int i = 0; i < Frame1.vSwitch.size(); i++) {
      sw = (Switch)Frame1.vSwitch.elementAt(i);
      sw.setStart();
    }

    Vlan v = new Vlan();
    for (int i = 0; i < Frame1.vVlan.size(); i++) {
      v = (Vlan)Frame1.vVlan.elementAt(i);
      v.getPVSTP().disablePerVLANSTP(v);
    }

    Switch sender = new Switch();
    Switch temp = new Switch();
    Vector vName = new Vector();
    boolean notDone = true;
    String rb1, rb2;
    int x;

    do {
      vName.removeAllElements();
      for (int i = 0 ; i < Frame1.vSwitch.size(); i++) {
        sender = (Switch)Frame1.vSwitch.elementAt(i);
        sender.doCommonSpanningTree();
        vName.addElement(sender.getRootBridge());
      }   // end for i
      notDone = checkSuccedOfSTP(vName);
    } while (notDone);

    setPortForAllSwitch(Frame1.vSwitch);
    setLoopPort(Frame1.vSwitch);
    setPortForwarding(Frame1.vSwitch);
