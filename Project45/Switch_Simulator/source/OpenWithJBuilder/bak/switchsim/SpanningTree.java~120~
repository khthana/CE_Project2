  public void tc_change_vlan(int vid) {
    String str = "";
    Vlan vlan = new Vlan();
    SpanningTree pvstp = new SpanningTree();

    for (int i =0; i < Frame1.vVlan.size(); i++) {
      vlan = (Vlan)Frame1.vVlan.elementAt(i);
      if (vlan.getVlanID() == vid) {
        pvstp = vlan.getPVSTP();
        str = pvstp.getStatus();
        if (str.equals("enabled")) {
          pvstp.enablePerVLANSpanningTree(vlan);
        }
      }
    }
  }

