  void connectDone() {
    for (int i=0; i<sw.getVInt().size(); i++) {
      Interface intf = (Interface)sw.getVInt().elementAt(i);
      if ((jCheckBox1.isSelected()) && (intf.getNameInt().equals(jComboBox2.getSelectedItem()))) {
        Workstation com = new Workstation(jCheckBox1.getText());
        com.genMACAddress();
        boolean insert = false;
//        System.out.println("com 1 : "+com.getMACAddress());
        for (int j=0; j<Frame1.vWorkstation.size(); j++) {
          Workstation com_tmp = (Workstation)Frame1.vWorkstation.elementAt(j);
          if (Integer.parseInt(com.getName().substring(8))<Integer.parseInt(com_tmp.getName().substring(8))) {
            Frame1.vWorkstation.insertElementAt(com,j);
            insert = true;
          }
        }
        if (!insert)
          Frame1.vWorkstation.addElement(com);
        intf.addNewIntCom(sw,(String)jComboBox2.getSelectedItem(),com);
      }
      if ((jCheckBox2.isSelected()) && (intf.getNameInt().equals(jComboBox3.getSelectedItem()))) {
        Workstation com = new Workstation(jCheckBox2.getText());
        com.genMACAddress();
