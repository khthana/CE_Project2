      cbListen3 = false;
      jComboBox2.removeAllItems();
      jComboBox3.removeAllItems();
      jComboBox4.removeAllItems();
      System.out.println("ComboBox1 : "+jComboBox1.getSelectedItem());
      if (!jComboBox1.getSelectedItem().equals("Select Switch")) {
        for (int i=0; i<Frame1.vSwitch.size(); i++) {
          Switch sw_tmp = (Switch)Frame1.vSwitch.elementAt(i);
          if (sw_tmp.getName().equals(jComboBox1.getSelectedItem())) {
            sw = sw_tmp;
            for (int j=0; j<sw.getVInt().size(); j++) {
              Interface intf = (Interface)sw.getVInt().elementAt(j);
              if ((intf.getCom()==null) && (intf.getSwitch()==null)) {
                jComboBox2.addItem(intf.getNameInt());
                jComboBox3.addItem(intf.getNameInt());
                jComboBox4.addItem(intf.getNameInt());
              }
            }
          }
        }
      }
      else sw = sw_init;
      cbListen1 = true;
      cbListen2 = true;
      cbListen3 = true;
    }
  }

