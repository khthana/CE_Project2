  public String compareRB(String newOne, String oldOne) {
    String result = "";
//    System.out.println("newOne = " + newOne + " --- " + oldOne);
    if (!newOne.equals(oldOne)) {
      for (int k = 0; k < 25; k++) {
        if ((k != 5) && (k != 10) && (k != 15)) {
          if (newOne.charAt(k) < oldOne.charAt(k)) {
            result = "less";
            k = 25;
          }
          else if (newOne.charAt(k) > oldOne.charAt(k))  {
            result = "more";
            k = 25;
          }
        }     // end if k
      }       // end for k
    }         // end if equals
    else
      result = "equal";
    return result;
  }         // end method

