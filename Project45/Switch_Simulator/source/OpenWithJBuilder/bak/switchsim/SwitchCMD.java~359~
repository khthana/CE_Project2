  public void novlancmd(Switch sw, int v) {
    Vlan vl = new Vlan();
    Vector swVlan = new Vector();
    Vector vList = new Vector();
    Switch member = new Switch();

    if (sw.getMode()==3) {
      if (v!=1 && v!=1002 && v!=1003 && v!=1004 && v!=1005) {
        for (int i=0; i<sw.getVlanDB().size(); i++) {
          VlanDatabase tmp = (VlanDatabase)sw.getVlanDB().elementAt(i);
          if (tmp.getVlanID()==v) {
            sw.getVlanDB().removeElementAt(i);
            i--;
          }
        }
      }
    }
    else { // Mode = 5
      boolean found = false;
      if (v!=1 && v!=1002 && v!=1003 && v!=1004 && v!=1005) {
        for (int i=0; i<sw.getVlanDB().size(); i++) {
          VlanDatabase tmp = (VlanDatabase)sw.getVlanDB().elementAt(i);
          if (tmp.getVlanID()==v) {
            found = true;
            sw.getVlanDB().removeElementAt(i);
            i--;
          }
        }
        if (found)
          SwitchConsole.output += "Deleting VLAN "+v+"...\n";
        else SwitchConsole.output += "VLAN "+v+" does not exist\n";
      }
      else SwitchConsole.output+="A default VLAN may not be deleted.\n";
    }

    //---------------- remove Vlan from Frame1.vVlan -------------------------------
    for (int x = 0; x < Frame1.vVlan.size(); x++) {
      vl = (Vlan)Frame1.vVlan.elementAt(x);
      if (vl.getVlanID() == v) {
        swVlan = vl.getSwitchMember();
        if (swVlan.size() == 0) {
          Frame1.vVlan.removeElementAt(x);
        }
        else {
          for (int y = 0; y < swVlan.size(); y++) {
            member = (Switch)swVlan.elementAt(y);
            if (member.getName().equals(sw.getName())) {
              swVlan.removeElementAt(y);
              vl.getPVSTP().enablePerVLANSpanningTree(vl);
            }
          }
        }
      }
    }
//---------------- remove Vlan from vlanList (attr of Switch)-------------------
    vList = sw.getVlanList();
    for (int x = 0; x < vList.size(); x++) {
      vl = (Vlan)vList.elementAt(x);
      if (vl.getVlanID() == v) {
        vList.removeElementAt(x);
        x--;
      }
    }
  }

