    if (found) {
      if ((vdb.getVlanID()!=1) && (vdb.getVlanID()!=1002) && (vdb.getVlanID()!=1003) && (vdb.getVlanID()!=1004) && (vdb.getVlanID()!=1005)) {
        vdb.setVlanName(n);
        SwitchConsole.output += "VLAN "+vdb.getVlanID()+" modified:\n    Name: "+vdb.getVlanName()+"\n";
      }
      else SwitchConsole.output += "A default VLAN may not have its name changed.\n";
    }
    else {
      vdb.addVlan(sw, v, n);
      SwitchConsole.output += "VLAN "+v+" added:\n    Name: "+n+"\n";
    }
  }
  public void delvlandbcmd(Switch sw, int v){
    for (int i=0; i<sw.getVlanDB().size(); i++) {
      VlanDatabase tmp = (VlanDatabase)sw.getVlanDB().elementAt(i);
      if (tmp.getVlanID()==v) {
        sw.getVlanDB().removeElementAt(i);
        i--;
      }
    }
    SwitchConsole.output += "Deleting VLAN "+v+"...\n";
  }

