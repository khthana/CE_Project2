          sw_tmp.getVIntSwitch().removeElementAt(j);
          inf.setSwitchInt(null);
          j=sw_tmp.getVIntSwitch().size();
        }
        else if (inf.equals(new1)) {
          sw1 = sw_tmp;
          j=sw_tmp.getVIntSwitch().size();
        }
        else if (inf.equals(new2)) {
          sw2 = sw_tmp;
          j=sw_tmp.getVIntSwitch().size();
        }
      }
    }

    new1.addNewIntSwitch(sw1,new1.getNameInt(),sw2);
    new2.addNewIntSwitch(sw2,new2.getNameInt(),sw1);
    intimg.setInt1(new1);
    intimg.setInt2(new2);
  }

  boolean canConnect(Switch sw1, Switch sw2) {
    for (int j=0; j<sw1.getVIntSwitch().size(); j++) {
      Interface inf = (Interface)sw1.getVIntSwitch().elementAt(j);
      if (inf.getSwitch().equals(sw2)) {
        return false;
      }
    }
    return true;
  }

