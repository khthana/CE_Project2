  void jInterfaceButton_actionPerformed(ActionEvent e) {
    if (jInterfaceButton.isSelected()) {
      this.drawInt=true;
    }
    else this.drawInt=false;
  }

  void jComButton_actionPerformed(ActionEvent e) {
    if (drawInt) {
      drawInt = false;
      jInterfaceButton.setSelected(false);
    }
    if (Frame1.vWorkstation.size() < Frame1.maxWorkstation) {
      boolean dup = true;
      boolean found = false;
      String str="";
      int i=1;
      while(dup){
        str = "Computer" + i;
        found = false;
        for(int a=0; a < Frame1.vWorkstation.size(); a++){
          String alreadyName = ((Workstation)Frame1.vWorkstation.elementAt(a)).getName();
          if (alreadyName.equalsIgnoreCase(str)){
            found = true;
          }//end if
        }//end for
        i++;
        dup = found;
      }//end while
      String mac = m.getMACAddress();
      Workstation com = new Workstation(str,mac);
      ComImg cimg = new ComImg();
      Frame1.vWorkstation.addElement(com);
      Panel2.vImgCom.addElement(cimg);
      panel.repaintView();
    }
  }

  public void setjInterfaceButton(boolean selected) {
    jInterfaceButton.setSelected(selected);
  }

  void jSwitchButton_actionPerformed(ActionEvent e) {
    Switch sw;
    SwitchImg simg;
    if (drawInt) {
      drawInt = false;
      jInterfaceButton.setSelected(false);
    }
    if (Frame1.vSwitch.size() < Frame1.maxSwitch){
        boolean dup = true;
        boolean found = false;
        String str="";
        int i=1;
        while(dup){
          str = "Switch" + i;
          found = false;
          for(int a=0; a < Frame1.vSwitch.size(); a++){
            String alreadyName = ((Switch)Frame1.vSwitch.elementAt(a)).getName();
            if (alreadyName.equalsIgnoreCase(str)){
              found = true;
            }//end if
          }//end for
          i++;
          dup = found;
        }//end while
        sw = new Switch(str);
//        sw.setPriority("0000" + i-1);
        sw.setMACaddress(m.getMACAddress(Frame1.vSwitch.size()+1));
        sw.setDefaultVlanDB();
//        r1.setModel(type);
        SwitchConsole scon = new SwitchConsole(sw);
        Frame1.vSwitch.addElement(sw);
        simg = new SwitchImg();
        Panel2.vImgSwitch.addElement(simg);
//        for (int a=1; a<sw.getMaxEth()+1; a++) {
//          Interface intf = new Interface();
//          intf.addNewInt(sw,"Ethernet0/"+a);
//        }
        for (int a=1; a<sw.getMaxFast()+1; a++) {
          Interface intf = new Interface();
          intf.addNewInt(sw,"Fa0/"+a);
        }
        for (int a=1; a<sw.getMaxGig()+1; a++) {
          Interface intf = new Interface();
          intf.addNewInt(sw,"Gi0/"+a);
        }
        Frame1.vConsole.addElement(scon);
///        Frame1.jTabbedPane1.addTab(str,scon);
//        Frame1.jTabbedPane1.setSelectedIndex(Frame1.vSwitch.size()-1);
    }
    panel.repaintView();
  }
