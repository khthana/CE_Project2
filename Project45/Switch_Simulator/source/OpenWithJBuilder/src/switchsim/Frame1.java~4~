    }
    view.setLocation((screenSize.width - frameSize.width) / 2, (screenSize.height - frameSize.height) / 2);
    view.setVisible(true);
  }


 void jTabbedPane1_keyPressed(KeyEvent e) {
    int keyCode = e.getKeyCode();
    if (keyCode == 10){
      int num = jTabbedPane1.getSelectedIndex();
      sw = (Switch)Frame1.vSwitch.elementAt(num);
      SwitchConsole scon = (SwitchConsole)vConsole.elementAt(num);
      scon.enterKey(sw);
    }
  }

  void jDelButton_actionPerformed(ActionEvent e) {
    learn.suspendLearning();
    System.out.println("Suspend Address Learning...");
    int numdel = jTabbedPane1.getSelectedIndex();
    if (jTabbedPane1.getTabCount() > 1){
      Switch delswitch = (Switch)vSwitch.elementAt(numdel);
      Vector vinterface = new Vector();
      for (int a=0; a<delswitch.getVIntSwitch().size(); a++){
        Interface inf = (Interface)delswitch.getVIntSwitch().elementAt(a);
        Switch sw = inf.getSwitch();
        for (int b=0; b<sw.getVIntSwitch().size(); b++) {
          Interface inf_tmp = (Interface)sw.getVIntSwitch().elementAt(b);
          if (inf_tmp.getSwitch().equals(delswitch)) {
            sw.getVIntSwitch().removeElementAt(b);
            inf_tmp.removeSwitchInt();
            inf.setConnectStatus("down");
            b--;
          }
        }
      }
      for (int a=0; a<delswitch.getVIntCom().size(); a++) {
        Interface inf = (Interface)delswitch.getVIntCom().elementAt(a);
        for (int b=0; b<vWorkstation.size(); b++) {
          if (inf.getCom().equals(vWorkstation.elementAt(b))) {
            vWorkstation.removeElementAt(b);
            Panel2.vImgCom.removeElementAt(b);
            inf.removeComInt();
            inf.setConnectStatus("down");
            delswitch.getVIntCom().removeElementAt(a);
            b=vWorkstation.size();
            a--;
          }
        }
      }
      jTabbedPane1.removeTabAt(numdel);
      vSwitch.removeElementAt(numdel);
      vConsole.removeElementAt(numdel);
      Panel2.vImgSwitch.removeElementAt(numdel);
    }
    if (learn.isAlive()){
      learn.resume();
      System.out.println("Resume Address Learning...");
    }
    else{
      learn.start();
      System.out.println("Start Address Learning...");
    }
  }


