  public void accessMACAddressTable(String mac, Interface port) {
    String tuple[] = new String[2];
    String tmp[] = new String[2];
    boolean exist=false;
    boolean insert=false;
    tuple[0]=mac;
    tuple[1]=port.getNameInt();
    // Check MAC-Address is in MAC-Address Table but different Port
    for (int j=0; j<MACTable.size(); j++) {
      try {
        tmp=(String[])MACTable.elementAt(j);
        if (tmp[0].equals(tuple[0])) {
          if (!tmp[1].equals(tuple[1])) {
            MACTable.removeElementAt(j) ;
            MACTable.insertElementAt(tuple,j);
          }
          exist=true;
        }
      }
      catch (Exception e) {
      }
    }
    // MAC-Address is not in MAC-Address Table
    if (!exist) {
      for (int j=0; j<MACTable.size(); j++) {
        tmp=(String[])MACTable.elementAt(j);
        for (int k=0; k<14; k++) {
          if ((k!=4)&&(k!=9)) {
            if(tuple[0].charAt(k)<tmp[0].charAt(k)) {
              MACTable.insertElementAt(tuple,j);
              insert=true;
              k=14;
              j=MACTable.size();
            }
            else if(tuple[0].charAt(k)>tmp[0].charAt(k)) {
              k=14;
            }
          }
        }
      }
      if (!insert) {
        MACTable.addElement(tuple);
      }
    }
  }

  public void sendFrame(String frame, String port) {
    Interface int_rc = new Interface(); // Interface that received frame
    boolean sent = false;
    MACAddress mac = new MACAddress();
    boolean isVlan = false;
    int vlan = 1; // VLAN of Source Computer
    for (int i=0; i<this.vInt.size(); i++) {
      Interface int_tmp = (Interface)vInt.elementAt(i);
      if (int_tmp.getNameInt().equals(port)) {
        int_rc = int_tmp;
        vlan = int_rc.getVLAN();
      }
    }
    if (frame.length()>96) {
      vlan = Integer.parseInt(frame.substring(96),2);
      isVlan = true;
    }
    // Check MAC-Address Table
    for (int i=0; i<this.MACTable.size(); i++) {
      String[] tuple = (String[])MACTable.elementAt(i);
      if (tuple[0].equals(mac.cBinToHex(frame.substring(48,96)))) {
        // COMPUTER Receive
        for (int j=0; j<this.vIntCom.size(); j++) {
          Interface intCom = (Interface)this.vIntCom.elementAt(j);
          if (intCom.getStatus().equals("up")) {
            // VLAN Frame ==> Check Access Link && VLAN number && MAC-Address
            if ((isVlan) && (intCom.getVLANLink()==0) && (intCom.getVLAN()==vlan) && (intCom.getNameInt().equals(tuple[1]))) {
              Workstation com_rc = (Workstation)intCom.getCom();
              System.out.println(this.getName()+" is sending Frame to "+com_rc.getName()+" at "+tuple[1]);
              com_rc.receiveFrame(frame.substring(0,96));
              sent = true;
            }
            // Ethernet Frame ==> Check MAC-Address
            else if ((!isVlan) && (intCom.getVLANLink()==0) && (intCom.getNameInt().equals(tuple[1]))) {
              Workstation com_rc = (Workstation)intCom.getCom();
              System.out.println(this.getName()+" is sending Frame to "+com_rc.getName()+" at "+tuple[1]);
              com_rc.receiveFrame(frame.substring(0,96));
              sent = true;
            }
          }
        }
        // SWITCH Receive
        for (int j=0; j<this.vIntSwitch.size(); j++) {
          Interface intSw = (Interface)this.vIntSwitch.elementAt(j);
          if (intSw.getStatus().equals("up")) {
            // VLAN Frame & Access Link ==> Check VLAN number & MAC-Address
            if ((isVlan) && (intSw.getVLANLink()==0) && (intSw.getVLAN()==vlan) && (intSw.getNameInt().equals(tuple[1]))) {
              Switch sw_rc = (Switch)intSw.getSwitch();
              System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName()+" at "+tuple[1]);
              sw_rc.receiveFrameSwitch(frame.substring(0,96), this);
              sent = true;
            }
            // VLAN Frame & Trunk Link ==> Check VLAN allowed & MAC-Address
            else if ((isVlan) && (intSw.getVLANLink()==1) && (intSw.VLANIsAllowed(vlan)) && (intSw.getNameInt().equals(tuple[1]))) {
              Switch sw_rc = (Switch)intSw.getSwitch();
              System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName()+" at "+tuple[1]);
              sw_rc.receiveFrameSwitch(frame, this);
              sent = true;
            }
            // Ethernet Frame & Access Link ==> Check MAC-Address
            else if ((!isVlan) && (intSw.getVLANLink()==0) && (intSw.getNameInt().equals(tuple[1]))) {
              Switch sw_rc = (Switch)intSw.getSwitch();
              System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName()+" at "+tuple[1]);
              sw_rc.receiveFrameSwitch(frame.substring(0,96), this);
              sent = true;
            }
            // Ehernet Frame & Trunk Link ==> Check VLAN allowed && MAC-Address
            else if ((!isVlan) && (intSw.getVLANLink()==1) && (intSw.VLANIsAllowed(vlan)) && (intSw.getNameInt().equals(tuple[1]))) {
              Switch sw_rc = (Switch)intSw.getSwitch();
              System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName()+" at "+tuple[1]);
              String vlan_s = Integer.toBinaryString(int_rc.getVLAN());
              String pad = "";
              for (int k=vlan_s.length(); k<16; k++) {
                pad = pad+"0";
              }
              vlan_s = pad+vlan_s;
              sw_rc.receiveFrameSwitch(frame+vlan_s, this);
              sent = true;
            }
          }
        }
      }
    }
    // NOT FOUND in MAC-Address Table
    // BROADCAST through all port
    if (!sent) {
      // broadcast to all computer
      for (int i=0; i<this.vIntCom.size(); i++) {
        Interface intCom = (Interface)this.vIntCom.elementAt(i);
        // VLAN Frame ==> Check Access Link & VLAN number & not sending port
        if (intCom.getStatus().equals("up")) {
          if ((isVlan) && (intCom.getVLANLink()==0) && (intCom.getVLAN()==vlan) && (!intCom.getNameInt().equals(port))) {
            Workstation com_rc = (Workstation)intCom.getCom();
            System.out.println(this.getName()+" is sending Frame to "+com_rc.getName());
            com_rc.receiveFrame(frame.substring(0,96));
          }
          // Ethernet Frame ==> Check Access Link & VLAN number & not sending port
          else if ((!isVlan) && (intCom.getVLANLink()==0) && (intCom.getVLAN()==int_rc.getVLAN()) && (!intCom.getNameInt().equals(port))) {
            Workstation com_rc = (Workstation)intCom.getCom();
            System.out.println(this.getName()+" is sending Frame to "+com_rc.getName());
            com_rc.receiveFrame(frame.substring(0,96));
          }
        }
      }
      // broadcast to all switch
      for (int i=0; i<this.vIntSwitch.size(); i++) {
        Interface intSw = (Interface)this.vIntSwitch.elementAt(i);
        if (intSw.getStatus().equals("up")) {
          if (!intSw.getNameInt().equals(port)) {
            Switch sw_rc = (Switch)intSw.getSwitch();
            // Trunk Link ==> Check VLAN allowed
            if ((intSw.getVLANLink()==1) && (intSw.VLANIsAllowed(vlan))) {
              // VLAN Frame
              if (isVlan) {
                System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName());
                sw_rc.receiveFrameSwitch(frame, this);
              }
              // Ethernet Frame ==> encapsulate Ethernet Frame to VLAN Frame
              else {
                String vlan_s = Integer.toBinaryString(int_rc.getVLAN());
                String pad = "";
                for (int j=vlan_s.length(); j<16; j++) {
                  pad = pad+"0";
                }
                vlan_s = pad+vlan_s;
                System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName());
                sw_rc.receiveFrameSwitch(frame+vlan_s, this);
              }
            }
            // Access Link && Check VLAN number
            else if ((intSw.getVLANLink()==0) && (intSw.getVLAN()==vlan)){
              System.out.println(this.getName()+" is sending Frame to "+sw_rc.getName());
              sw_rc.receiveFrameSwitch(frame.substring(0,96), this);
            }
          }
        }
      }
    }
  }

