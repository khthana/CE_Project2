  public void addvlandbcmd(Switch sw, int v, String n){
    VlanDatabase vdb = new VlanDatabase();
    vdb.addVlan(sw, v, n);
    for (int i=0; i<sw.getVlanDB().size(); i++) {
      VlanDatabase tmp = (VlanDatabase)sw.getVlanDB().elementAt(i);
      if (tmp.getVlanID()==v) {
        vdb = tmp;
      }
    }
    SwitchConsole.output += "VLAN "+vdb.getVlanID()+" added:\n    Name: "+vdb.getVlanName()+"\n";
  }
  public void delvlandbcmd(Switch sw, int v){
    for (int i=0; i<sw.getVlanDB().size(); i++) {
      VlanDatabase tmp = (VlanDatabase)sw.getVlanDB().elementAt(i);
      if (tmp.getVlanID()==v) {
        sw.getVlanDB().removeElementAt(i);
        i--;
      }
    }
    SwitchConsole.output += "Deleting VLAN "+v+"...\n";
  }

