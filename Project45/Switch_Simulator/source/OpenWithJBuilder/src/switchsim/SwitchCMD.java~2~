  // ==================================== User EXEC ====================================
  public void enablecmd(Switch sw){
    SwitchConsole.output = "";
    if (!sw.getEnablePasswd()){
      sw.setMode(2);
    }
    else {
      sw.setMode(10);
    }
  }

