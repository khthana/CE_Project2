  public void receiveBPDU(Vector bp) {
    String rb, dist, sender = "";
    String intBridgeID, compare, thisRB, intStatus = "";
    Interface interf = new Interface();
    Interface tmp = new Interface();

    rb = (String)bp.elementAt(0);
    dist = (String)bp.elementAt(1);
    sender = (String)bp.elementAt(2);

    for (int i = 0; i < vIntSwitch.size(); i++) {                   // i = number of port
      interf = (Interface)vIntSwitch.elementAt(i);
      intBridgeID = interf.getSwitchBridgeID();
      intStatus = interf.getStatus();

      if (intStatus.equals("up")) {
        if (intBridgeID == sender) {
          thisRB = this.getRootBridge();
//        System.out.println(sender + " send BPDU to " + this.getBridgeID());
          compare = "";
          compare = compareRB(rb, thisRB);
          if (compare == "less") {                                      // --- set new Root Bridge ---
            this.setRootBridge(rb);
            this.setSTPstaus(sNRB);
            for (int z = 0; z < vIntSwitch.size(); z++) {
              tmp = (Interface)vIntSwitch.elementAt(z);
              tmp.setSTPport("");
            }  // end for z
            interf.setSTPport(sRP);
            interf.setSTPstate(liS);
            this.distance = incrementDist(dist);
//          System.out.println(this.getBridgeID() + ": " + this.distance);
//          System.out.println(interf.getSwitchName() + " is now a " + interf.getSTPport());
          }   // end if compare
        }     // end if check for interface
      }       // end if check interface's staus --- up or down
    }         // end for i
  }           // end method

  public String compareRB(String newOne, String oldOne) {
    String result = "";
    for (int k = 6; k < 20; k++) {
      if ((k != 10) && (k != 15)) {
//        System.out.println("newOne = " + newOne + " --- " + k);
        if (newOne.charAt(k) < oldOne.charAt(k)) {
          result = "less";
          k = 20;
        }
        else  { // if (newOne.charAt(k) > oldOne.charAt(k))
          result = "more";
          k = 20;
        }
      }     // end if k
    }       // end for k
    return result;
  }         // end method

