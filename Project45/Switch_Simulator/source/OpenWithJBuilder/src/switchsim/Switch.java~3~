//    System.out.println(this.getName()+" is receiving Frame.");
    for (int i=0; i<this.vIntCom.size(); i++) {
      Interface intCom = (Interface)this.vIntCom.elementAt(i);
      if ((intCom.getStatus().equals("up")) && (!intCom.getSTPport().equals("Nondesignated Port")) && (mac.cBinToHex(frame.substring(0,48)).equals(intCom.getCom().getMACAddress()))) {
        String[] frame_r = new String[2];
        port_r = intCom.getNameInt();
        frame_r[0] = frame;
        frame_r[1] = port_r;
        this.vFrame.addElement(frame_r);
        try {
          this.accessMACAddressTable(mac.cBinToHex(frame.substring(0,48)), intCom);
        }
        catch (Exception e) {
        }
      }
    }
  }

  public void receiveFrameSwitch(String frame, Switch sw_s) {
    String port_r = new String();
    Interface int_s = new Interface();
    MACAddress mac = new MACAddress();
    boolean isVlan = false;
    int vlan = 1;
    if (frame.length()>96) {
      isVlan = true;
    }
    for (int i=0; i<sw_s.vIntSwitch.size(); i++) {
      Interface int_tmp = (Interface)sw_s.vIntSwitch.elementAt(i);
      if ((int_tmp.getSwitch().equals(this))) {
        int_s = int_tmp;
        vlan = int_s.getVLAN();
      }
    }
    for (int i=0; i<this.vIntSwitch.size(); i++) {
      try {
        Interface int_rc = (Interface)this.vIntSwitch.elementAt(i);
        if ((int_rc.getStatus().equals("up")) && (!int_rc.getSTPport().equals("Nondesignated Port")) && (sw_s.equals(int_rc.getSwitch()))) {
          if (((isVlan) && (int_rc.getVLANLink()==1) && (int_rc.VLANIsAllowed(vlan))) ||
              ((!isVlan) && (int_rc.getVLANLink()==0) && (int_rc.getVLAN()==vlan))) {
//          System.out.println(this.getName()+" is receiving Frame.");
          String[] frame_r = new String[2];
          port_r = int_rc.getNameInt();
          frame_r[0] = frame;
          frame_r[1] = port_r;
          this.vFrame.addElement(frame_r);
          this.accessMACAddressTable(mac.cBinToHex(frame.substring(0,48)), int_rc);
          }
        }
      }
      catch (Exception e) {
      }
    }
  }

