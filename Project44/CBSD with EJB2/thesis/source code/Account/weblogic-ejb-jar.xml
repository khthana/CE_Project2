<weblogic-ejb-jar>
    <weblogic-enterprise-bean>
        <ejb-name>Account</ejb-name>
        <reference-descriptor>
            <resource-description>
                <res-ref-name>jdbc/OlalaDB</res-ref-name>
                <jndi-name>OlalaDB</jndi-name>
            </resource-description>
        </reference-descriptor>
        <jndi-name>Account</jndi-name>
    </weblogic-enterprise-bean>
</weblogic-ejb-jar>
