          if (this.elem[i].getIsHighlight()){
                destination = this.elem[i].getLinkTo();
            String[] name = new String[elem[i].getNumattr()];
            String[] value = new String[elem[i].getNumattr()];
            name = this.elem[i].getAttrbName();
            value = this.elem[i].getAttrbValue();
                  int k=i;
            }
      } // end for
      this.enter_press(destination);
  }
  // --------------------------------------------------- Soft Right
  void jButton8_actionPerformed(ActionEvent e) {
      String destination ="";
      for (int i=0;i<this.numallnode;i++){
        if((this.elem[i].getIsDo()) & (this.elem[i].getCanshow())){

          if(this.elem[i].getName().equalsIgnoreCase("go")){
            for (int j=0;j<this.elem[i].getNumattr();j++){
              if (this.attrbname(i,j).equalsIgnoreCase("href")){
                destination = this.attrbvalue(i,j);
              }
            }
            this.enter_press(destination);
          }// end tag go
          else if(this.elem[i].getName().equalsIgnoreCase("prev")){
             String st = new String();
             if (!this.history.empty()){
              st = this.history.pop().toString();
              if ((st==this.des) & (!this.history.empty())){
              st = this.history.pop().toString();
             }
            }
            if (this.history.empty()){
            this.history.push(st);
            }
            this.des = st;
            this.showall();
          } // end tag prev
        }// end if do
      }// end for
  }
// ------------------------------- Method

public void UrlInfo(String st1){
    try{
    String st;
    URL url = new URL(st1);
    this.protocol = url.getProtocol().trim();
    this.hostname = url.getHost().trim();
//    this.port = url.getPort();
    st = url.getFile();
    if (st1.lastIndexOf('#') != -1){
    this.anchor = st1.substring(st1.lastIndexOf('#')+1,st1.length()).trim();
    }
    else this.anchor="";
      if (st.lastIndexOf('/') != -1){
        this.file = st.substring(st.lastIndexOf('/'),st.length()).trim();
        this.path = st.substring(0,st.lastIndexOf('/')).trim();
      }
    }
     catch (MalformedURLException e){
      this.jEditorPane1.setText(e.getMessage());
    }

}

String attrbname(int i,int j){
    String[] st = new String[this.numallnode];
    st = this.elem[i].getAttrbName();
    return st[j];
}
String attrbvalue(int i,int j){
    String[] st = new String[this.numallnode];
    st = this.elem[i].getAttrbValue();
    return st[j];
}

public void getnumallnode(Element e){	//get number of all node in the tree
  for (Iterator i=e.getChildren().iterator(); i.hasNext(); ) {
    this.numallnode=++this.numallnode;
    Element child = (Element)i.next();
    getnumallnode(child);
  }
}                                                       //end getnumallnode

void getAttrb(String st){
    this.attrbname=st.substring(12,st.indexOf("=")).trim();
    this.attrbvalue=st.substring(st.indexOf('"')+1,st.length()-2).trim();
}

void getRoot() throws JDOMException,NullPointerException{
    SAXBuilder builder= new SAXBuilder();
    Document doc = builder.build(this.des);
    this.e = doc.getRootElement();
}// end getRoot

void par(Element e) throws IOException, JDOMException {
    String st = new String();
    st =e.getName();  //element name
                              this.elem[this.j] =new ElementInfo(st,e.getAttributes().size(),e.getTextTrim());
                                    String[] tmp1 = new String[e.getAttributes().size()];
                                    String[] tmp2 = new String[e.getAttributes().size()];
                               for (int i=0; i<=e.getAttributes().size()-1;++i){
                                          Object[] ob = e.getAttributes().toArray();
                                          getAttrb(ob[i].toString());
                                            tmp1[i]=this.attrbname;
                                            tmp2[i]=this.attrbvalue;
                                            this.elem[this.j].setnumchild(e.getChildren().size());
                                };                        //end for
                              this.elem[this.j].setAttrbName(tmp1);
                              this.elem[this.j].setAttrbValue(tmp2);
                              if(!e.isRootElement()){
                              this.elem[this.j].setParent(e.getParent().getName());
                              }
                              else {this.elem[this.j].setIsRoot(true);}
                              for (Iterator i=e.getChildren().iterator(); i.hasNext(); ) {
                              Element child = (Element)i.next();
                              this.j++;
                              par(child);		 //Recursive

                      }                           //end for

  }   //end par()


private int findWidth(String st,FontMetrics  fm)  {
    int i = 0;
    for (int j=0;j < st.length();j++){
        i = i + fm.charWidth(st.charAt(j));
    }
    return i;
}


private void copyStyle(ElementInfo[] elem,int i,int j){
      elem[j].setI(elem[i].getI());
      elem[j].setB(elem[i].getB());
      elem[j].setU(elem[i].getU());
      elem[j].setSmall(elem[i].getSmall());
      elem[j].setBig(elem[i].getBig());
      elem[j].setPosition(elem[i].getPosition());
      elem[j].setCanshow(elem[i].getCanshow());
      elem[j].setIsLink(elem[i].getIsLink());
      elem[j].setIsAnchor(elem[i].getIsAnchor());
      elem[j].setIsDo(elem[i].getIsDo());
      elem[j].setIsTable(elem[i].getIsTable());
  }   //end copyStyle


void setStyle(){
      boolean bol=false;
      boolean bol2 = false;
      String st="";
      JTextField l = new JTextField();
      l.setFont(this.myFont);
      FontMetrics fm=l.getFontMetrics(myFont);

      for(int i=0;i<this.numallnode;i++){
      // ----Copy From Parent

//      if (!this.elem[i].getContent().equals("")){
//        this.elem[i].setContent(this.speacialChar(this.elem[i].getContent()));
//      }
      if  (!this.elem[i].getIsRoot()){
      int k=i-1;
        while (!this.elem[i].getParent().equalsIgnoreCase(this.elem[k].getName())){
         k--;
        } // end while
        copyStyle(this.elem,k,i);
      }   // end if


      //------- Set Element by itself

      // tag img
      if (this.elem[i].getName().equalsIgnoreCase("img")) {
        String image="";
        for(int j =0; j < this.elem[i].getNumattr() ; j++){
          if (this.attrbname(i,j).equalsIgnoreCase("src")){
            image = this.attrbvalue(i,j);
          }
          if (!image.substring(0,7).equalsIgnoreCase("http://")){
            image = this.protocol+"://"+this.hostname+this.path+'/'+image;
          }
          try{
          URL urlImage = new URL(image);
          Icon icon = new ImageIcon(urlImage);
          this.elem[i].setWidth(icon.getIconWidth()); // set width of image
          this.elem[i].setHeight(icon.getIconHeight()); // set height of image
          }
          catch (MalformedURLException e){
          this.jEditorPane1.setText(e.getMessage());
          }
        }
      }
      else{
        this.elem[i].setWidth(this.findWidth(this.elem[i].getContent(),fm)); // set width of text
        this.elem[i].setHeight(this.height);      // set height of text
      }
      // end tag img

      // tag table
      if(this.elem[i].getName().equalsIgnoreCase("table")){ // find number of column of this table
        this.elem[i].setIsTable(true);
        String col="";
        for (int j=0;j< this.elem[i].getNumattr();j++){
          if (this.attrbname(i,j).equalsIgnoreCase("columns")){
            col = this.attrbvalue(i,j);
          }
        }
        this.elem[i].setColumn(Integer.parseInt(col)); // set num column table
        int j=i;
        while (!this.elem[j].getName().equalsIgnoreCase("tr")){
          j++;
        }
        int postr = j;
        j++;
        int numrow=0;
        while(this.elem[j].getName().equalsIgnoreCase("td")){
          numrow++;
          j++;
        }
        this.elem[i].setRow(numrow); // set num row of table

        int temp[] = new int[this.elem[i].getColumn()];
        int intial = 0;
        for(int m=0;m<this.elem[i].getColumn();m++){ // to find the maximun width of column
          int postd = postr+1;
          System.out.println("test");
          System.out.println(postd);
          System.out.println(postr);
          System.out.println(this.elem[postd].getName());
          System.out.println(this.elem[postr].getName());
          if ((this.elem[postr].getName().equalsIgnoreCase("tr"))){
            int maxwidth = this.findWidth(this.elem[postd].getContent(),fm);
            postd++;
            for(int n=0;n < this.elem[i].getRow()-1;n++){
              System.out.println(this.findWidth(this.elem[postd].getContent(),fm));
              if(this.findWidth(this.elem[postd].getContent(),fm) > maxwidth){
                maxwidth = this.findWidth(this.elem[postd].getContent(),fm);
                postd++;
              }
            }// end for n
            temp[intial] = maxwidth;
            System.out.println(maxwidth);
            System.out.println(intial);
            intial++;
          }// end if
          this.elem[i].setColumnWidth(temp);
          postr = postd;
        }// end for m
      }
      // end tag table

      String[] name1 = new String[this.elem[i].getNumattr()];
      String[] value = new String[this.elem[i].getNumattr()];
      name1 = this.elem[i].getAttrbName();
      value = this.elem[i].getAttrbValue();
      if (this.elem[i].getName().equalsIgnoreCase("card")){
        if (this.anchor.equals("")){
          if (bol2 == false){
            this.elem[i].setCanshow(true);
            bol2 = true;
          }
       }
        else {
           for (int j = 0;j < this.elem[i].getNumattr();j++)
           {
            if (name1[j].equalsIgnoreCase("id"))
            st = value[j];
           } // end for
            if (this.anchor.equals(st)){
            this.elem[i].setCanshow(true);

            }
        }// end else
      }

      if ((this.elem[i].getName().equalsIgnoreCase("a")) | (this.elem[i].getName().equalsIgnoreCase("anchor"))){
          this.elem[i].setIsLink(true);
          if(this.elem[i].getName().equalsIgnoreCase("anchor")){
            this.elem[i].setIsAnchor(true);
          }

      }// End TAG A
      if(this.elem[i].getName().equalsIgnoreCase("table")){
        this.elem[i].setIsTable(true);
      }
      // set highlight
      if ((bol == false) &(this.elem[i].getIsLink())&(!this.elem[i].getContent().equals(""))&(this.elem[i].getCanshow())){
          this.elem[i].setIsHighlight(true);
          bol = true;
      }
      if (this.elem[i].getName().equalsIgnoreCase("do")){
          this.elem[i].setIsDo(true);
      }
      if (this.elem[i].getName().equalsIgnoreCase("p")){
            if (this.elem[i].getNumattr() != 0){
                for(int k=0;k<this.elem[i].getNumattr();k++){
                      if (name1[k].equalsIgnoreCase("align")){
                        this.elem[i].setPosition(value[k]);
                      };
                };
            }
      }     //TAG P


        if ((this.elem[i].getName().equalsIgnoreCase("b")) |(this.elem[i].getName().equalsIgnoreCase("emphasis"))){
            this.elem[i].setB(true);
        }   //TAG B

        else if ((this.elem[i].getName().equalsIgnoreCase("i")) |(this.elem[i].getName().equalsIgnoreCase("strong"))){
            this.elem[i].setI(true);
        }   //TAG I
        else if (this.elem[i].getName().equalsIgnoreCase("u")){
            this.elem[i].setU(true);
        }
        else if (this.elem[i].getName().equalsIgnoreCase("big")){
            this.elem[i].setBig(true);
        }
        else if (this.elem[i].getName().equalsIgnoreCase("small")){
            this.elem[i].setSmall(true);
        }
      }     // end for
  }   //end setStyle


void setCo(){
        int inity = 5;int x=0;int y=0;int maxHeight=0;
        for (int i =0 ; i < this.numallnode ; i++){
    if (this.elem[i].getCanshow()){
       //  if ((this.elem[i].getIsTable()) & !(this.elem[i].getContent().equals(""))){
       //  }
          if ((this.elem[i].getName().equalsIgnoreCase("p")) | (this.elem[i].getName().equalsIgnoreCase("br"))){
                  int z=0;// number of component to add in a line
                  int w=0;// length total for a line
                  y=i+1;
                  if (y < this.numallnode){
                   maxHeight = 0;
                   while (!(this.elem[y].getName().equalsIgnoreCase("p")) & !(this.elem[y].getName().equalsIgnoreCase("br"))){
                    z++;
                    w = w + this.elem[y].getWidth();
                    if (this.elem[y].getHeight() > maxHeight){
                        maxHeight = this.elem[y].getHeight();
                    }
                    y++;
                    if (y == this.numallnode)
                    break;
                   }// end while
                 }
                  inity = inity + maxHeight;
                  if (this.elem[i].getPosition().equalsIgnoreCase("center")){
                  x=(172 -w)/2;
                      if (x<0) x=0;
                  }
                  else if (this.elem[i].getPosition().equalsIgnoreCase("right")){
                  x=(172-w);
                    if (x<0) x=0;
                  }
                  else if (this.elem[i].getPosition().equalsIgnoreCase("left")){
                  x=0;
                  }
                    y=i+1;
                   this.elem[y].setCo_x(x);
                   this.elem[y].setCo_y(inity-this.elem[y].getHeight());

                  for (int j=0;j<z-1;j++){
                    y++;
                    if (y == this.numallnode)
                    break;
                    x = x + elem[y-1].getWidth();
                    this.elem[y].setCo_x(x);
                    this.elem[y].setCo_y(inity-this.elem[y].getHeight());
                  }
              } // end if P
          }
        }
} // end setCo

