  JButton jButton1 = new JButton();
  JLabel imageControl1 = new JLabel();
  JPanel insetsPanel3 = new JPanel();
  JLabel label4 = new JLabel();
  JPanel insetsPanel2 = new JPanel();
  JLabel label3 = new JLabel();
  JLabel label2 = new JLabel();
  JLabel label1 = new JLabel();
  GridLayout gridLayout1 = new GridLayout();
  FlowLayout flowLayout1 = new FlowLayout();
  BorderLayout borderLayout2 = new BorderLayout();

  public eDialog(Frame frame, String title, boolean modal) {
    super(frame, title, modal);
    try {
      jbInit();
      pack();
    }
    catch(Exception ex) {
      ex.printStackTrace();
    }
  }

  public eDialog() {
    this(null, "", false);
  }
  void jbInit() throws Exception {
    panel1.setLayout(borderLayout1);
    jButton1.setText("OK");
    jButton1.addActionListener(new java.awt.event.ActionListener() {
      public void actionPerformed(ActionEvent e) {
        jButton1_actionPerformed(e);
      }
    });
    insetsPanel3.setLayout(gridLayout1);
    insetsPanel3.setBorder(new EmptyBorder(10, 60, 10, 10));
    label4.setText("BY ICL Lab");
    insetsPanel2.setLayout(flowLayout1);
    insetsPanel2.setBorder(new EmptyBorder(10, 10, 10, 10));
    label3.setText("Copyright (c) 2001");
    gridLayout1.setRows(4);
    gridLayout1.setColumns(1);
    jPanel1.setLayout(borderLayout2);
    gridLayout1.setRows(4);
    gridLayout1.setColumns(1);
    label2.setToolTipText("");
    label1.setText("Thai WAP Browser 2");
    getContentPane().add(panel1);
    panel1.add(jPanel1, BorderLayout.CENTER);
    insetsPanel3.add(label1, null);
    insetsPanel3.add(label2, null);
    insetsPanel3.add(label3, null);
    insetsPanel3.add(label4, null);
    jPanel1.add(insetsPanel2, BorderLayout.NORTH);
    insetsPanel2.add(imageControl1, null);
    jPanel1.add(insetsPanel3,  BorderLayout.CENTER);
    panel1.add(jPanel2, BorderLayout.SOUTH);
    jPanel2.add(jButton1, null);
    this.setDefaultCloseOperation(WindowConstants.DISPOSE_ON_CLOSE);
    this.setLocation(300,230);
