static public void getnumallnode(Element e){	//get number of all node in the tree
  for (Iterator i=e.getChildren().iterator(); i.hasNext(); ) {
    numallnode=++numallnode;
    Element child = (Element)i.next();
    getnumallnode(child);
  }
}                                                       //end getnumallnode

static void getAttrb(String st){
    attrbname=st.substring(12,st.indexOf("=")).trim();
    attrbvalue=st.substring(st.indexOf('"')+1,st.length()-2).trim();
}

