  void jButtonOpt_actionPerformed(ActionEvent e) {

    if (InputArea.getText().substring(0,7).compareTo("http://")==0){
      try{
        URL url = new URL(InputArea.getText());
        InputStream in = url.openStream();
        DataInputStream dis = new DataInputStream(url.openConnection().getInputStream());
        Reader reader = new InputStreamReader(in);
        BufferedReader bufferedReader = new BufferedReader(reader);
        String line;
        String tline = new String("");
        while((line = bufferedReader.readLine()) != null ) {tline += line; tline+='\n';}
        f2.jTextPane1.setText(tline);
        bufferedReader.close();
      }
      catch(UnknownHostException ex){f2.jTextPane1.setText("Cannot Resolve: "+ex);/*System.err.println("Cannot Resolve: "+ex);*/  }
      catch(IOException ex){f2.jTextPane1.setText("IOException : "+ex); /*System.err.println("IOException : "+ex);*/ }
    }
    else{
      byte buff[] = new byte [1000];
        try {
          InputStream fileIn = new FileInputStream(InputArea.getText());
          int i = fileIn.read(buff);
          String s = new String(buff);
          f2.jTextPane1.setText(s);
        }
      catch(FileNotFoundException ex) {f2.jTextPane1.setText("Cannot Resolve: "+ex);}
      catch(IOException ex) {f2.jTextPane1.setText("IOException : "+ex);}
    }//end else

    xmlParser xmlparser = new xmlParser(InputArea.getText());
    try{
    Element element=xmlparser.par();
    //jTextPane2.setText(xmlparser.getnumallnode(element)+xmlparser.printElements(element));
    jEditorPane1.setText(xmlparser.getnumallnode(element)+xmlparser.printElements(element));
    }
    catch (JDOMException ex){
    xmlparser.setstring(ex.getMessage());
    //jTextPane2.setText(xmlparser.getstring());
    jEditorPane1.setText(xmlparser.getstring()) ;
    }
    catch (IOException ex){
    xmlparser.setstring(ex.getMessage());
    //jTextPane2.setText(xmlparser.getstring());
    jEditorPane1.setText(xmlparser.getstring());
    }
    catch (NullPointerException ex){
    xmlparser.setstring(ex.getMessage());
    //jTextPane2.setText(xmlparser.getstring());
    jEditorPane1.setText(xmlparser.getstring());
    }
  InputArea.setVisible(false);
  jEditorPane1.setVisible(true);
  f2.jTextField1.setText(InputArea.getText());
  }


