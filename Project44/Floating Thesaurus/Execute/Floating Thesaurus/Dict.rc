/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&Program"
    BEGIN
        MENUITEM "&Floating Thesaurus",         ID_MENU_FLOAT
        MENUITEM "&Game Tutor",                 ID_DEMO_GIF
        MENUITEM SEPARATOR
        MENUITEM "Enable Search Online",        ID_EN_ONLINE
        MENUITEM "Disable Search Online",       ID_DIS_ONLINE
        MENUITEM SEPARATOR
        MENUITEM "Enable Game Tutor",           ID_EN_GAME
        MENUITEM "Disable Game Tutor",          ID_DIS_GAME
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Show",                       IDC_SHOW_ICON
        MENUITEM "&Hide",                       IDC_HIDE_ICON
        MENUITEM SEPARATOR
        MENUITEM "Maximise",                    ID_DEMO_MAXIMISE
        MENUITEM "Minimise",                    ID_DEMO_MINIMISE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Floating Thesaurus",   ID_APP_ABOUT
    END
END

IDR_POPUP_MENU MENU DISCARDABLE 
BEGIN
    POPUP "POPUP"
    BEGIN
        MENUITEM "Floating Thesaurus",          ID_FLOAT
        MENUITEM "Game Tutor",                  ID_HANGMAN
        MENUITEM SEPARATOR
        MENUITEM "Enable Search Online",        ID_PEN_ONLINE
        MENUITEM "Disable Search Online",       ID_PDIS_ONLINE
        MENUITEM SEPARATOR
        MENUITEM "Enable Game Tutor",           ID_PEN_GAME
        MENUITEM "Disable Game Tutor",          ID_PDIS_GAME
        MENUITEM SEPARATOR
        MENUITEM "Maximise",                    ID_DEMO_MAXIMISE
        MENUITEM "Minimise",                    ID_DEMO_MINIMISE
        MENUITEM SEPARATOR
        MENUITEM "About Floating ..",           ID_POPUP_ABOUTFLOATING
        MENUITEM "Exit",                        ID_APP_EXIT
    END
END


