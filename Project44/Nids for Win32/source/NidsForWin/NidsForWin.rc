IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 235, 61
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NidsForWin"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "IsagNids For Win32  Ver. 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2001 By ISAG",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
    LTEXT           "Contact as  isag@ce.kmitl.ac.th",IDC_STATIC,40,41,119,8,
                    SS_NOPREFIX
END

IDD_NIDSFORWIN_DIALOG DIALOGEX 0, 0, 369, 199
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "IsagNids For Win32"
MENU IDR_MAINMENU
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "Stop",IDOK,295,10,50,14
    PUSHBUTTON      "Exit",IDCANCEL,295,40,50,14
    CONTROL         "List1",IDC_LIST,"SysListView32",LVS_REPORT | WS_BORDER | 
                    WS_TABSTOP,11,10,270,175
END

IDD_SELECT_ADAP DIALOG DISCARDABLE  0, 0, 322, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,265,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,265,23,50,14
    CONTROL         "List1",IDC_LIST_ADAP,"SysListView32",LVS_REPORT | 
                    WS_BORDER | WS_TABSTOP,14,7,243,133
END


