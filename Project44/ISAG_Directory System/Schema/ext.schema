#%>Obj Section;

#s_agentgroup;
objectclass (1.3.6.1.4.3.1 NAME 'AgentGroup'
	SUP top STRUCTURAL
	MUST (AgentType)
	MAY description)
#e_agentgroup;

#s_Firewall;
objectclass (1.3.6.1.4.3.3 NAME 'Firewall'
	SUP top STRUCTURAL
	MUST (AgentID$IP$StartTime$Refresh$Source$Destination$Service$Action$Status$SStartTime$SRefresh)
	MAY description)
#e_Firewall;

#s_Stateful;
objectclass (1.3.6.1.4.3.6 NAME 'Stateful'
	SUP top STRUCTURAL
	MUST (AgentID$IP$StartTime$Refresh$IPCap$PortCap$Status$SStartTime$SRefresh)
	MAY description)
#e_Stateful;

#s_NIDS;
objectclass (1.3.6.1.4.3.7 NAME 'NIDS'
	SUP top STRUCTURAL
	MUST(Refresh$AgentID$IP$StartTime$source$destination$attacktype$atime$Status$SStartTime$SRefresh)
	MAY description)
#e_NIDS;
#%>End Obj;


