<wml> 
	
  <!-- Login --> 
  <card id="login" title="Insurance system" newcontext="true"> 
	<do type ="onenterforward" label="Next" >
		<go href ="checkpwd.php">
		<postfield name="Anick" value="$Anick"/>
		<postfield name="Apwd" value="$Apwd"/>
		</go>
	</do> 
    <p align="center"> 
			Login :<input type="text" name="Anick"/><br/>
			Password :<input type="password" name="Apwd"/><br/> 
    </p> 
  </card> 
	<!-- Agent Profile --> 
