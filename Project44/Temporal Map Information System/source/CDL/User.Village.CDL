	method GetArea(AtDate:%Library.Date)
	{
		returntype = User.Area;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			NEW id,VillageID,ListID,area
			// ?? ID ????????????  Village ???????????????????????????????????????? VillageID
			
			Set ListID = ##this.%Oid()		
			Set VillageID = $LIst(ListID,1)			
			
			// ?? ID ???????????? Area  ??????????? Village ???????????????????????????? AtDate ?????????? VTS ??? VTE	
			
			&sql(SELECT ID into :id FROM SQLUser.Area WHERE (Village = :VillageID) AND
			(CAST(:AtDate AS INTEGER) BETWEEN CAST(VTS AS INTEGER) AND CAST(VTE AS INTEGER)))		
			
			// ????????????? Area ??? ID ????????????????????????????????????????? Area
			SET area=##class(Area).%OpenId(id)	
			QUIT area  
		]
	}

	method GetPopulation(AtDate:%Library.Date)
	{
		returntype = User.Population;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
