			; Add method code here				
			NEW id,VillageID,ListID
			Set ListID = ##this.%Oid()		
			Set VillageID = $LIst(ListID,1)	
			
			&sql(SELECT ID into :id FROM SQLUser.Population WHERE (Village = :VillageID) AND (CAST(:AtDate AS INTEGER) BETWEEN CAST(VTS AS INTEGER) AND CAST(VTE AS INTEGER)))		
			SET MyPopulation=##class(Population).%OpenId(id)	
			QUIT MyPopulation
			
		]
	}

	method SetArea(Area:%Library.Float,AtDate:%Library.Date)
	{
		returntype = %Library.Integer;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			NEW SQLCODE,VillageID,ListID,village,areaarry,area,id
			// ???????  ID ????????????  Village ???????????????????????????????????????? VillageID
			Set ListID = ##this.%Oid()		
			Set VillageID = $LIst(ListID,1)			
			
			// ?????????????????????????? AtDate ???????????????? ValidTimeStart ??????????????????????????		
			&sql(SELECT ID FROM SQLUser.Area WHERE 
			(VTS=(SELECT VTS FROM SQLUser.Area WHERE (VTE=(SELECT MAX(VTE) FROM SQLUser.Area))) AND 
			(Village = :VillageID)) AND
			(CAST(:AtDate As Integer) > CAST(VTS As Integer)))
			
			// ?????????????? AtDate ???????????????? ValidTimeStart ???????????????????
			If (SQLCODE=0) {
			// ?????????? ValidTime Stop ????????? Area ?????????????????????????? ValidTime Start ????????? Area ???????? 1 ???
			&sql(UPDATE SQLUser.Area SET VTE=CAST(DATEADD('dd',-1,:AtDate) As DATE)	WHERE 
			(ID =(SELECT ID FROM SQLUser.Area WHERE VTE = (SELECT MAX(VTE) FROM SQLUser.Area)) AND 
			(Village = :VillageID))) 	
						
			// ??????????? Area ?????????????????????	    
			&sql(INSERT INTO SQLUser.Area VALUES(CAST('9999-12-31 00:00:00' As Date),CAST(CAST(:AtDate As Integer) As Date),:VillageID,:Area))
			
			// ???????????????? Area ?????????????????? AreaTemp ???????????? Village		
			&sql(SELECT MAX(ID) into :id FROM SQLUser.Area)		
			Set area=##class(Area).%OpenId(id)		
			Set village = ##class(Village).%OpenId(VillageID)	
			Set areaarry = village.AreaTempGet()		
			DO areaarry.SetAt(area,areaarry.Count()+1)		
			DO village.AreaTempSet(areaarry)  
			DO village.%Save()	
			DO areaarry.%Close()	
			DO village.%Close()			
			Quit 1
			} 
			// ?????????????? AtDate ????????????????? ValidTimeStart ???????????????????
			Else 
			{
			Quit 0
			}
		]
	}

	method SetPopulation(Population:%Library.Float,AtDate:%Library.Date)
	{
		returntype = %Library.Integer;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			; Add method code here	
			NEW SQLCODE,VillageID,ListID,village,populationarry,population,id
			Set ListID = ##this.%Oid()		
			Set VillageID = $LIst(ListID,1)
			//Temporal Constraint		
			&sql(SELECT VTS FROM SQLUser.Population WHERE 
			VTS=(SELECT VTS FROM SQLUser.Population WHERE VTE=(SELECT MAX(VTE) FROM SQLUser.Population) AND (Village = :VillageID))
			AND CAST(:AtDate As Integer) > CAST(VTS As Integer))
			//End Temporal Constraint Result In SQLCODE
			If (SQLCODE=0) //
			{
			&sql(UPDATE SQLUser.Population SET VTE=CAST(DATEADD('dd',-1,:AtDate) As DATE)	
			WHERE ID =(SELECT ID FROM SQLUser.Population WHERE VTE=(SELECT MAX(VTE) FROM SQLUser.Population)AND (Village = :VillageID)))				
			&sql(INSERT INTO SQLUser.Population VALUES(CAST('9999-12-31 00:00:00' As Date),CAST(CAST(:AtDate As Integer) As Date),:VillageID,:Population))
			//
			&sql(SELECT MAX(ID) into :id FROM SQLUser.Population)		
			Set population=##class(Population).%OpenId(id)		
			Set village = ##class(Village).%OpenId(VillageID)	
			Set populationarry = village.PopulationTempGet()		
			DO populationarry.SetAt(population,populationarry.Count()+1)		
			DO village.PopulationTempSet(populationarry)  
			DO village.%Save()	
			DO populationarry.%Close()	
			DO village.%Close()			
			Quit 1
			}
			Else //
			{
			Quit 0
			}
		]
	}

	method TemporalSearch(SearchExpr:%Library.String,AtDate:%Library.String)
	{
		returntype = %Library.List;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			
			NEW dquery,ok,colcount,rowcount,col,datenum,areachk,populationchk,tempexpr,areaexpr,populationexpr,sqlcmd  	   		
			Set datenum = $ZDATEH(AtDate,5)	   	   	   	   
			Set dquery=##class(%Library.ResultSet).%New("%Library.DynamicQuery:SQL") 
				   	     	   	   
			// ???????????????????????????????????????????????????????????????????????	   	   	   
			Set areachk = $Find(SearchExpr,"VillageArea")
			Set populationchk = $Find(SearchExpr,"VillagePopulation")	   
			Set areaexpr = "("_datenum_" BETWEEN (CAST(Area.VTS AS INTEGER)) AND (CAST(Area.VTE AS INTEGER)))" 
			Set populationexpr = "("_datenum_" BETWEEN (CAST(Population.VTS AS INTEGER)) AND (CAST(Population.VTE AS INTEGER)))" 
			Set tempstr = ""	   
			if (areachk '= 0) //found VillageArea Expr
			{
			Set tempstr = areaexpr
			}	   
			if (populationchk '= 0) //found VillagePopulation Expr
			{
			if (tempstr '= "") 
			{
				Set tempstr = tempstr_" AND "
			}	   	
			Set tempstr = tempstr_populationexpr	   		   
			}	   	   	   
			
			// ????????? SQL ???????????????????????????????  	   	   
			Set sqlcmd = "SELECT DISTINCT Area.Village FROM Area,Population WHERE (Area.Village = Population.Village) AND ("_SearchExpr_") AND ("_tempstr_")"	   
			Set ok = dquery.Prepare(sqlcmd)
			Set ok = dquery.Execute() 	   	   
			
			// ??????? OID ???????????????????????????
			Set colcount=dquery.GetColumnCount() 	  	
			Set idlist = $ListBuild()	    
			Set rowcount = 0
			for  
			{ 
			quit:'dquery.Next() 
			//write ! 
			Set rowcount=rowcount+1	   	
			for col=1:1:colcount 
			{ 
				Set $LIst(idlist,rowcount) = dquery.GetData(col)	       		
			}	   	
			}	
			Set ok=dquery.%Close() 
			if rowcount>0
			{
			quit idlist
			}	   
		]
	}

