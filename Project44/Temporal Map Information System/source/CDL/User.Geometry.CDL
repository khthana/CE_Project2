	array attribute PointSetTemp { type = User.PointSet; calculated = 0; not final; multidimensional = 0; public; not required; sqlcomputed = 0; transient = 0; }

	method GetGeometry(AtDate:%Library.Date)
	{
		returntype = User.PointSet;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			; Add method code here	
			NEW id,GeometryID,ListID
			Set ListID = ##this.%Oid()		
			Set GeometryID = $LIst(ListID,1)
			
			&sql(SELECT ID into :id FROM SQLUser.PointSet WHERE (Geometry = :GeometryID) AND (CAST(:AtDate AS INTEGER) BETWEEN CAST(VTS AS INTEGER) AND CAST(VTE AS INTEGER)))		
			SET MyPointSet=##class(PointSet).%OpenId(id)	
			QUIT MyPointSet
		]
	}

	method SetGeometry(PSet:User.PointSet,AtDate:%Library.Date)
	{
		returntype = %Library.Integer;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			; Add method code here	
			NEW SQLCODE,GeoID,ListID,geometry,pointsetarry,pointset,id
			Set ListID = ##this.%Oid()		
			Set GeoID = $LIst(ListID,1)	
			//Check Temporal Constraint
			&sql(SELECT ID FROM SQLUser.PointSet WHERE 
			VTS = (SELECT VTS FROM SQLUser.PointSet WHERE (VTE=(SELECT MAX(VTE) FROM SQLUser.PointSet)) AND (Geometry = :GeoID))
			AND CAST(:AtDate As Integer) > CAST(VTS As Integer))
			//End Temporal Constraint Result In SQLCODE		     
			If (SQLCODE=0) {			
			SET X1 = $ListBuild()
			SET X2 = $ListBuild()
			SET Y1 = $ListBuild()
			SET Y2 = $ListBuild()
			SET Count = (PSet.X2Get).Count()
			FOR i=1:1:Count
			{	
				Set $LIst(X1,i) = PSet.X1Get().GetAt(i) 
				Set $LIst(X2,i) = PSet.X2Get().GetAt(i) 
				Set $LIst(Y1,i) = PSet.Y1Get().GetAt(i) 
				Set $LIst(Y2,i) = PSet.Y2Get().GetAt(i) 
			}
			//		
			&sql(UPDATE SQLUser.PointSet SET VTE=CAST(DATEADD('dd',-1,:AtDate) As DATE)			
			WHERE ID =(SELECT ID FROM SQLUser.PointSet WHERE (VTE =(SELECT MAX(VTE) FROM SQLUser.PointSet)) AND (Geometry = :GeoID)))						
			&sql(INSERT INTO SQLUser.PointSet VALUES(:GeoID,CAST('9999-12-31 00:00:00' As Date),CAST(CAST(:AtDate As Integer) As Date),:X1,:X2,:Y1,:Y2))
			//
			&sql(SELECT MAX(ID) into :id FROM SQLUser.PointSet)		
			Set pointset=##class(PointSet).%OpenId(id)		
			Set geometry = ##class(Geometry).%OpenId(GeoID)	
			Set pointsetarry = geometry.PointSetTempGet()		
			DO pointsetarry.SetAt(pointset,pointsetarry.Count()+1)		
			DO geometry.PointSetTempSet(pointsetarry)  
			DO geometry.%Save()	
			DO pointsetarry.%Close()	
			DO geometry.%Close()			
			Quit 1
			
			}
			Else //
			{
			Quit 0
			}
			
		]
	}

