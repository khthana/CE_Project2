	method SetRoadLong(RLong:%Library.Float,AtDate:%Library.Date)
	{
		returntype = %Library.Integer;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			; Add method code here		
			NEW SQLCODE,RoadID,ListID,road,longarry,roadlong,id
			Set ListID = ##this.%Oid()		
			Set RoadID = $LIst(ListID,1)
			//Temporal Constraint		
			&sql(SELECT VTS FROM SQLUser.RoadLong WHERE 
			VTS=(SELECT VTS FROM SQLUser.RoadLong WHERE VTE=(SELECT MAX(VTE) FROM SQLUser.RoadLong) AND (Road = :RoadID))
			AND CAST(:AtDate As Integer) > CAST(VTS As Integer))
			//End Temporal Constraint Result In SQLCODE	
			If (SQLCODE=0) //
			{
			//
			&sql(UPDATE SQLUser.RoadLong SET VTE=CAST(DATEADD('dd',-1,:AtDate) As DATE)	
			WHERE ID =(SELECT ID FROM SQLUser.RoadLong WHERE VTE=(SELECT MAX(VTE) FROM SQLUser.RoadLong) AND (Road = :RoadID)))				
			&sql(INSERT INTO SQLUser.RoadLong VALUES(:RLong,:RoadID,CAST('9999-12-31 00:00:00' As Date),CAST(CAST(:AtDate As Integer) As Date)))
			//
			&sql(SELECT MAX(ID) into :id FROM SQLUser.RoadLong)		
			Set roadlong=##class(RoadLong).%OpenId(id)		
			Set road = ##class(Road).%OpenId(RoadID)	
			Set longarry = road.RoadLongTempGet()		
			DO longarry.SetAt(roadlong,longarry.Count()+1)		
			DO road.RoadLongTempSet(longarry)  
			DO road.%Save()	
			DO longarry.%Close()	
			DO road.%Close()	
			Quit 1
			}
			Else //
			{
			Quit 0
			}
		]
	}

