	method TemporalSearch(SearchExpr:%Library.String,AtDate:%Library.String)
	{
		returntype = %Library.List;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			new dquery,ok,colcount,rowcount,col,datenum,rlongchk,rtrafficchk,rtypechk,tempexpr,rtypeexpr,rlongexpr,rtrafficexpr,sqlcmd  	   		
			set datenum = $ZDATEH(AtDate,5)	   	   	   	   
			set dquery=##class(%Library.ResultSet).%New("%Library.DynamicQuery:SQL") 	   	     	   	   
			//	   	   	   
			set rlongchk = $Find(SearchExpr,"Long")
			set rtrafficchk = $Find(SearchExpr,"Traffic")	   
			set rtypechk = $Find(SearchExpr,"Type")	   
			set rlongexpr = "("_datenum_" BETWEEN (CAST(RoadLong.VTS AS INTEGER)) AND (CAST(RoadLong.VTE AS INTEGER)))" 
			set rtrafficexpr = "("_datenum_" BETWEEN (CAST(RoadTraffic.VTS AS INTEGER)) AND (CAST(RoadTraffic.VTE AS INTEGER)))" 
			set rtypeexpr = "("_datenum_" BETWEEN (CAST(RoadType.VTS AS INTEGER)) AND (CAST(RoadType.VTE AS INTEGER)))" 
			set tempstr = ""	   
			if (rlongchk '= 0) //found Long Expr
			{
				set tempstr = rlongexpr
			}	   
			if (rtrafficchk '= 0) //found Traffic Expr
			{
				if (tempstr '= "") 
				{
				 	set tempstr = tempstr_" AND "
				}	   	
				set tempstr = tempstr_rtrafficexpr
			}	   	   
			if (rtypechk '= 0) //found Type Expr
			{
				if (tempstr '= "") 
				{
				 	set tempstr = tempstr_" AND "
				}	   	
				set tempstr = tempstr_rtypeexpr	   		   
			}	   	   
			//	   	   
			set sqlcmd = "SELECT DISTINCT RoadLong.Road FROM RoadLong,RoadType,RoadTraffic WHERE ((RoadLong.Road = RoadTraffic.Road) AND (RoadTraffic.Road = RoadType.Road)) AND ("_SearchExpr_") AND ("_tempstr_")"	   	
			set ok = dquery.Prepare(sqlcmd)
			set ok = dquery.Execute() 	   	   
			//Get Number of returned columns 
			set colcount=dquery.GetColumnCount() 	  
			//Get each row and write out the query column data 	  
			set idlist = $ListBuild()	    
			set rowcount = 0
			for  
			{ 
				quit:'dquery.Next() 
				//write ! 
				set rowcount=rowcount+1	   	
				for col=1:1:colcount 
				{ 
					set $LIst(idlist,rowcount) = dquery.GetData(col)	       		
				}	   	
			}
			//Close the resultset object and quit 
			set ok=dquery.%Close() 
			if rowcount>0
			{
				quit idlist
			}	   
			
		]
	}

