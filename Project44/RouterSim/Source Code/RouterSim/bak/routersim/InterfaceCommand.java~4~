package routersim;
import java.util.*;

public class InterfaceCommand implements Enumeration{
  String s[];
  int i = 0;
  InterfaceCommand(String s[]){
    this.s = s;
  }
  public boolean hasMoreElements(){
    return i < s.length;
  }
  public Object nextElement(){
    if (i < s.length)
      return s[i++];
    return null;
  }
}