  public void setIpInterface(Router r,String ip,String subnet){
    Interface i = (Interface)r.getVInt().elementAt(r.getVInt().size()-1);
    if ((i.isIp(ip))&&(i.isIp(subnet))){
      r.getVInt().removeElementAt(r.getVInt().size()-1);
      i.setIpAddress(ip);
      i.setSubnet(subnet);
      i.setNetAdd(i.findNetAdd(ip,subnet));
      r.getVInt().addElement(i);
      int j = 0;
      while (j < r.getTable().getrTable().size()){
        RoutingTable rt = (RoutingTable)r.getTable().getrTable().elementAt(0);
        rt  = (RoutingTable)r.getTable().getrTable().elementAt(j);
        if ((rt.getInterface().getNameInt().charAt(0) == i.getNameInt().charAt(0)) && (rt.getInterface().getNameInt().charAt(rt.getInterface().getNameInt().length()-1) == i.getNameInt().charAt(i.getNameInt().length()-1))){
          r.getTable().getrTable().removeElementAt(j);
        }// end if
        j++;
      }//end while
      ipRoute(r,ip,subnet);
    }// end if
  }
