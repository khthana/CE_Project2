  //work set ip route 161.246.7.0 255.255.255.0 161.246.7.1
  public void ipRoute(Router r,String des,String subnet,String gw){
    r.getTable().setFlag('s');
    RoutingTable rt = new RoutingTable();
    int i=0;
    Interface intf=null;
    boolean con = true;
    if (r.getVInt().size() > 0){
      intf = (Interface)r.getVInt().elementAt(i);
    }
    while ((!(intf.getIpAddress().equalsIgnoreCase(gw)))&&(con)){
      i++;
      if (i < r.getVInt().size()){
        intf = (Interface)r.getVInt().elementAt(i);
      }
      else {con = false;}
    }//end while
    if (con){
      rt.setIpDestination(des);
      rt.setGateway(gw);
      rt.setSubnet(subnet);
      rt.setMatrice(0);
      rt.setRouteType('s');
      rt.setInterface(intf);
      r.getTable().getrTable().addElement(rt);
      System.out.println("finish ip route\n");
    }
    else {System.out.println("wrong route\n");}
  }
  public void noipRoute(Router r,String des,String subnet,String gw){
    int i=0;
    Table t = (Table)r.getTable();
    Vector v = t.getrTable();
    RoutingTable rt=null;
    if (v.size() > 0){
      rt = (RoutingTable)v.elementAt(0);
    }
    boolean found = rt.getIpDestination().equalsIgnoreCase(des) && rt.getSubnet().equalsIgnoreCase(subnet) && rt.getGateway().equalsIgnoreCase(gw);
    while ((!found) && (i < v.size())){
      i++;
      if (i < v.size()){
        rt = (RoutingTable)v.elementAt(i);
        found = rt.getIpDestination().equalsIgnoreCase(des) && rt.getSubnet().equalsIgnoreCase(subnet) && rt.getGateway().equalsIgnoreCase(gw);
      }
    }//end while
    if (found){
      v.removeElementAt(i);
      System.out.println(" finish del\n");
    }
    else {System.out.println("wrong del\n");}
  }
  //work config Routing Table with direct connected
  public void ipRoute(Router r,String ip,String subnet){
    RoutingTable rt = new RoutingTable();
    Interface i = (Interface)r.getVInt().elementAt(r.getVInt().size()-1);
    String netAdd = i.findNetAdd(ip,subnet);
    int j=0;
    Interface intf = (Interface)r.getVInt().elementAt(j);
    while (!(intf.getIpAddress().equalsIgnoreCase(ip))){
      j++;
      intf = (Interface)r.getVInt().elementAt(j);
    }//end while
    rt.setIpDestination(netAdd);
    rt.setGateway(ip);
    rt.setMatrice(0);
    rt.setSubnet(subnet);
    rt.setInterface(intf);
    r.getTable().getrTable().addElement(rt);
  }
