  public void addNewInterface(Router r,String s){
    Interface intf = new Interface();
    boolean found = false;
    Interface oldintf = new Interface();
    if (r.getVInt().size() > 0){
      oldintf = (Interface)r.getVInt().elementAt(0);
    }
    int i = 0,j=0;
    String old = "";
    while (i < r.getVInt().size()){
      oldintf = (Interface)r.getVInt().elementAt(i);
      if ((oldintf.getNameInt().charAt(0) == s.charAt(0)) && (oldintf.getNameInt().charAt(oldintf.getNameInt().length()-1) == s.charAt(s.length()-1))){
        intf = (Interface)r.getVInt().elementAt(i);
        r.getVInt().removeElementAt(i);
      }// end if
      i++;
    }//end while
    s = s.toLowerCase();
    Vector v = r.getVInt();
    intf.setNameInt(s);
    switch (s.charAt(0)){
      case 'e' : intf.setType("Ethernet");break;
      case 's' : intf.setType("Serial");break;
      case 't'  : intf.setType("TokenRing");break;
      default : intf.setType("None");
    }
    r.getVInt().addElement(intf);
  }
