package routersim;

import java.awt.*;
import java.awt.event.*;
import javax.swing.*;
import javax.swing.ImageIcon;
import com.borland.jbcl.layout.*;

public class Frame2 extends JFrame {
  JPanel contentPane;
  JPanel jPanel1 = new JPanel();
  XYLayout xYLayout1 = new XYLayout();
  /**Construct the frame*/
  public Frame2() {
    enableEvents(AWTEvent.WINDOW_EVENT_MASK);
    try {
      jbInit();
    }
    catch(Exception e) {
      e.printStackTrace();
    }
  }
  /**Component initialization*/
  private void jbInit() throws Exception  {
//    setIconImage(Toolkit.getDefaultToolkit().createImage(Frame1.class.getResource("openfile.gif")));
    contentPane = (JPanel) this.getContentPane();
    contentPane.setLayout(xYLayout1);
    this.setSize(new Dimension(690, 379));
    this.setTitle("Network View");
//    contentPane.add(new Panel2());
    jPanel1.setBackground(Color.black);
    jPanel1.setAlignmentX((float) 0.0);
    jPanel1.setAlignmentY((float) 0.0);
    jPanel1.setSize(690,379);
    contentPane.add(jPanel1, new XYConstraints(0, 0, 691, 380));
    jPanel1.add(new Panel2());
  }
  /**Overridden so we can exit when window is closed*/
  protected void processWindowEvent(WindowEvent e) {
    super.processWindowEvent(e);
    if (e.getID() == WindowEvent.WINDOW_CLOSING) {
      System.exit(0);
    }
  }
}