  //----------Read StartUp-------------------//
  public void readStartUp(){
    try{
      FileReader fin = new FileReader(filename);
      BufferedReader bin = new BufferedReader(fin);
      String s;
      Router r=null;
      Interface i1=new Interface();
      int linenum=0;
      //while not End of File
      while ((s = bin.readLine()) != null){
        linenum++;
        //while not end of Router
        StringTokenizer st = new StringTokenizer(s);
        if (s.startsWith("hostname")){
          //set Name of Router
          if (st.hasMoreTokens()){
            String name = (String)st.nextToken();
            name = (String)st.nextToken();
            r = new Router(name);
//            Frame1.addTab(name,r);
          }//end if
        }//end if
        //add new Interface
        else if (s.startsWith("interface")){
          String name1 = (String)st.nextToken();
          name1 = (String)st.nextToken();
          i1.AddNewInt(r,name1);
        }
        //set ip address
        else if (s.startsWith("ip address")){
          String name1 = (String)st.nextToken();
          name1 = (String)st.nextToken();
          String ip = (String)st.nextToken();
          String subnet = (String)st.nextToken();
          i1.setIpAddress(r,ip,subnet);
        }
        //no shut
        else if (s.startsWith("shutdown")){
          i1 = (Interface)r.getVInt().lastElement();
          i1.shutInt(r);
        }
        else if (s.startsWith("no shutdown")){
          i1 = (Interface)r.getVInt().lastElement();
          i1.noshutInt(r);
        }
        else if (s.startsWith("router rip")){
          Rip ripf = (Rip)r.getRIP();
          ripf.start();
          r.setFlag('r');
        }
        else if (s.startsWith("router ospf")){
          Ospf ospff = (Ospf)r.getOSPF();
          ospff.start();
          r.setFlag('o');
        }
        else if (s.startsWith("ip route")){
          String name1 = (String)st.nextToken();
          name1 = (String)st.nextToken();
          String des = (String)st.nextToken();
          String subnet = (String)st.nextToken();
          String gw = (String)st.nextToken();
          String intip = (String)st.nextToken();
          String nameint = (String)st.nextToken();
          String netAdd = (String)st.nextToken();
          String status = (String)st.nextToken();
          String intsubnet = (String)st.nextToken();
          String inttype = (String)st.nextToken();
          RoutingTable rt = new RoutingTable();
          rt.setIpRoute(r,des,subnet,gw,intip,nameint,netAdd,status,intsubnet,inttype);
          r.setFlag('s');
        }
        else if (s.startsWith("type")){
          //--------- Type Here---------------//
          String t = (String)st.nextToken();
          t = st.nextToken();
          int type;
          try{
            type = Integer.parseInt(t);
            switch (type){
              case 1 : r.setMaxEth(1);
                       r.setMaxSerial(2);
                       r.setMaxToken(0);
                       break;
              case 2 : r.setMaxEth(0);
                       r.setMaxSerial(2);
                       r.setMaxToken(1);
                       break;
              case 3 : r.setMaxEth(1);
                       r.setMaxSerial(1);
                       r.setMaxToken(2);
                       break;
              case 4 : r.setMaxEth(2);
                       r.setMaxSerial(2);
                       r.setMaxToken(0);
                       break;
              case 5 : r.setMaxEth(0);
                       r.setMaxSerial(2);
                       r.setMaxToken(2);
                       break;
              case 6 : r.setMaxEth(10);
                       r.setMaxSerial(10);
                       r.setMaxToken(10);
                       break;
              default : break;
            }
            r.setModel(type);
            Frame1.addTab(r.getName(),r);
          }
          catch (ArithmeticException exp){
            type = 0;
          }
        }
        //end Router
        else {
        }
      }
    }//end try
    catch (IOException exp){
      System.out.println("Error with File");
    }
  }
