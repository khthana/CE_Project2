            case 3 : RouterConsole.output += "2513\t";break;
            case 4 : RouterConsole.output += "2514\t";break;
            case 5 : RouterConsole.output += "2515\t";break;
            default : RouterConsole.output += "2500\t";
          }//end switch
          RouterConsole.output += inf.getType() + inf.getNum() +"\n";
        }
      }//same router
    }//router
    RouterConsole.output += "\n";
  }
