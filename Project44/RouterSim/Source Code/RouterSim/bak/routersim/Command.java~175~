          }//interface
          b++;
        }//interface remote
        if (found){
          RouterConsole.output += router.getName() + "\t" + icon.getType() + icon.getNum() + "\t" + router.getCdp().getHoldTimePacket() + "\tR\t";
          switch (router.getModel()){
