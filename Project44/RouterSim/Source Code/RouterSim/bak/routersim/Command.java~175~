        int b=0;
        while ((b < router.getVInt().size())&&(!found)){
          Interface iremote = (Interface)router.getVInt().elementAt(b);
          int c=0;
          while ((c < r.getVInt().size())&&(!found)){
            Interface i = (Interface)r.getVInt().elementAt(c);
