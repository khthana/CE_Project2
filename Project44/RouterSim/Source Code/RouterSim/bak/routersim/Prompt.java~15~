  //----------------------traceroute cmd-----------------//
  public void traceroute(Router r,String des){
    int i=0;
    RoutingTable rt=null;
    Router tmp = null;
    Interface inf=(Interface)r.getVInt().elementAt(0);
    String nextgw = "";
    String outtext = "";
    boolean found = true;
    if (r.getTable().getrTable().size() > 0){
      rt = (RoutingTable)r.getTable().getrTable().elementAt(i);
    }
    //search path from routing table when des = des from user command
    while ((i < r.getTable().getrTable().size()) &&(!rt.getIpDestination().equalsIgnoreCase(inf.findNetAdd(des,rt.getSubnet())))){
      rt = (RoutingTable)r.getTable().getrTable().elementAt(i);
      i++;
      //gateway is interface that adj
      nextgw = rt.getGateway();
    }
    //if found in routing table
    if (rt.getIpDestination().equalsIgnoreCase(inf.findNetAdd(des,rt.getSubnet()))){//if found
      //find router that have interface of gateway value
      for (int j=0;j < Frame1.vRouter.size(); j++){
        //Router 1
        tmp = (Router)Frame1.vRouter.elementAt(j);
        //Interface 1 of Router 1
        for(int k=0; k < tmp.getVInt().size(); k++){
          Interface intf = (Interface)tmp.getVInt().elementAt(k);
          String i1 = intf.getIpAddress();
          //////////////////////////////////that here///////////////////////////////////////////////
          if (intf.getIpAddress().equalsIgnoreCase(nextgw)){
            r = tmp;
          }//end if found interface
        }//end for serch interface
      }//end for search router
    }//end if search in routing table
    else {//Not found in routing table
      found = false;
    }
    i = 0;
    rt = (RoutingTable)r.getTable().getrTable().elementAt(i);
    while ((i < r.getTable().getrTable().size()) &&(!inf.findNetAdd(rt.getIpDestination(),rt.getSubnet()).equalsIgnoreCase(inf.findNetAdd(des,rt.getSubnet())))){
      rt = (RoutingTable)r.getTable().getrTable().elementAt(i);
      i++;
    }//search gw
    if(!nextgw.equalsIgnoreCase("0.0.0.0")){
      Rt1.output = Rt1.output + nextgw + "\n";
    }
    if (!rt.getGateway().equalsIgnoreCase("0.0.0.0") && (found)){
//      Rt1.output = Rt1.output + nextgw + "\n";
      traceroute(r,des);
    }
    //when finish
    else {
      if (found){
        Rt1.output = Rt1.output + des + "\n complete \n";
      }
      else {
        if (!found){
          Rt1.output = Rt1.output + "Incorrect Destination\n";
        }
      }
    }
  }
