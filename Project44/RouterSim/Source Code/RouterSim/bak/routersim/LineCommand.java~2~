package routersim;
import java.util.*;

public class LineCommand implements Enumeration{
  String s[];
  int i = 0;
  LineCommand(String s[]){
    this.s = s;
  }
  public boolean hasMoreTokens(){
    return i < s.length;
  }
  public Object nextTokens(){
    if (i < s.length)
      return s[i++];
    return null;
  }
}