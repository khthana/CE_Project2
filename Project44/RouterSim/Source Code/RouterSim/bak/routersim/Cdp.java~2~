package routersim;

public class Cdp {
  private int timer;
  private int holdTime;
  //--Function---//
  public void setTimer(int t){
    if ((t > 4)&&(t < 901)){
      timer = t;
    }
  }
  public int getTimer(){
    return timer;
  }
  //------hold time-----//
  public void setHoldTime(int t){
    holdTime = t;
  }
  public int getHoldTime(){
    return holdTime;
  }
  public Cdp() {
    timer = 90;
    holdTime = 180;
  }
}