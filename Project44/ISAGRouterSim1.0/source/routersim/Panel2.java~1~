  void this_mouseDragged(MouseEvent e) {
    if (pressin){
      // in  Frame
      dx = e.getX();
      dy = e.getY();
      if ((dx < this.getWidth()-60) &&(dx >= 0)&& (dy < this.getHeight()-69) && (dy >= 0)){
        //setposition
        rimg.setXPos(e.getX());
        rimg.setYPos(e.getY());
        repaint();
      }
    }
  }
