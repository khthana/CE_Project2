  //----------Read StartUp-------------------//
  public void readStartUp(){
    try{
      FileReader fin = new FileReader(filename);
      BufferedReader bin = new BufferedReader(fin);
      String s;
      Router r=null;
      Interface i1=new Interface();
      //while not End of File
      while ((s = bin.readLine()) != null){
        //while not end of Router
        StringTokenizer st = new StringTokenizer(s);
        if (s.startsWith("hostname")){
          //set Name of Router
          if (st.hasMoreTokens()){
            String name = (String)st.nextToken();
            name = (String)st.nextToken();
            r = new Router(name);
            Frame1.addTab(name,r);
          }//end if
        }//end if
        //add new Interface
        else if (s.startsWith("interface")){
          String name = (String)st.nextToken();
          name = (String)st.nextToken();
          i1.AddNewInt(r,name);
        }
        //set ip address
        else if (s.startsWith("ip address")){
          String name = (String)st.nextToken();
          name = (String)st.nextToken();
          String ip = (String)st.nextToken();
          String subnet = (String)st.nextToken();
          i1.setIpAddress(r,ip,subnet);
        }
        //no shut
        else if (s.startsWith("shutdown")){
          i1 = (Interface)r.getVInt().lastElement();
          i1.shutInt(r);
        }
        else if (s.startsWith("no shutdown")){
          i1 = (Interface)r.getVInt().lastElement();
          i1.noshutInt(r);
        }
        else if (s.startsWith("router rip")){
          Rip ripf = (Rip)r.getRIP();
          ripf.start();
        }
        //end Router
        else {
        }
      }
    }//end try
    catch (IOException exp){
      System.out.println("Error with File");
    }
  }
  //---------Erase Startup----------------//
  public void eraseStartUp(Router r){
    try{
      FileReader fin = new FileReader(filename);
      BufferedReader bin = new BufferedReader(fin);
      String s="";
      String newstr="";
      String strRouter="";
      boolean flag=false;//flag true when found router destination
      //while not End of File
      while ((s = bin.readLine()) != null){
        if (s.startsWith("&")){
          if (strRouter.length() != 0){
            strRouter += "&\n";
          }
          if (flag){
            newstr += strRouter;
            strRouter = "";
            flag = false;
          }//end if
          else{
            newstr += strRouter;
            strRouter = "";
          }
        }//end if
        else if (!flag){
          StringTokenizer st = new StringTokenizer(s);
          if (s.startsWith("hostname")){
            String name = (String)st.nextToken();
            name = (String)st.nextToken();
            if (r.getName().equalsIgnoreCase(name)){
              strRouter ="";
              flag = true;
            }
            else {
              s += "\n";
              strRouter += s;
            }
            //set Name of Router
          //not router
          }
          else {
            s += "\n";
            strRouter += s;
          }
        }//end if
      }//end while
      bin.close();
      FileWriter fout = new FileWriter("history.dat");
      BufferedWriter bout = new BufferedWriter(fout);
      PrintWriter pout = new PrintWriter(bout);
      pout.print(newstr);
      pout.close();
//    System.out.println(newstr);
    }
    catch (IOException exp){
    }
  }
  //----------Show Startup------------------//
  public void showStartUp(Router r){
    try{
      String str = "history.dat";
      FileReader fin = new FileReader(str);
      BufferedReader bin = new BufferedReader(fin);
      String s="";
      String newstr="";
      String strRouter="";
      boolean flag=true;//true means read
      //while not End of File
      while ((s = bin.readLine()) != null){
        if (s.startsWith("&")){
          if (!flag){
            flag = true;
            strRouter = "";
          }//end if
          else{
            newstr += strRouter;
          }
        }//end if
         else if (flag){
          StringTokenizer st = new StringTokenizer(s);
          if (s.startsWith("hostname")){
            String name = (String)st.nextToken();
            name = (String)st.nextToken();
            if (!r.getName().equalsIgnoreCase(name)){
              strRouter ="";
              flag = false;
            }//end if
            else {
              s += "\n";
              strRouter += s;
            }//end else
          }
          else {
            s += "\n";
            strRouter += s;
          }
        }//end if
      }//end while
      bin.close();
      if (newstr.length() == 0){
        Rt1.output += "%% Non-volatile configuration memory has not been set up or has bad checksum";
      }
      else {
        Rt1.output += newstr;
      }
    }
    catch (IOException exp){
    }
  }
