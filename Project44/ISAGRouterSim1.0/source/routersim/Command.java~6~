  //----------------Traceroute-----------------//
  public void trace(Router r,String des){
    int i=0;
    RoutingTable rt = null;
    Router tmp = null;
    Interface inf = (Interface)r.getVInt().elementAt(0);
    String nextgw="";
    boolean found = false;
    if (r.getVrt().size() > 0){
      rt = (RoutingTable)r.getVrt().elementAt(i);
    }//end if
    //search path from routing table when des = des from user command
    while((i < r.getVrt().size())&&(!rt.getIpDestination().equalsIgnoreCase(inf.findNetAdd()))){
      rt = (RoutingTable)r.getVrt().elementAt(i);
      //gateway is interface that adj
      nextgw = rt.getGateway();
      i++;
    }//end while
    //if found in routing table
    if (rt.getIpDestination().equalsIgnoreCase(inf.findNetAdd())){
      //find route that have interface of gateway value
      for (int j=0; j < Frame1.vRouter.size(); j++){
        //Router 1
        tmp = (Router)Frame1.vRouter.elementAt(j);
        //Interface 1 of Router 1
        for(int k=0; k < tmp.getVInt().size(); k++){
          Interface intf = (Interface)tmp.getVInt().elementAt(k);
          String i1 = intf.getIpAddress();
          if (intf.getIpAddress().equalsIgnoreCase(nextgw)){
            r = tmp;
          }//end if
        }//end for
      }//end for
    }//end if
    else{
      found = false;
    }//end else
    i = 0;
    rt = (RoutingTable)r.getVrt().elementAt(i);
    while ((i < r.getVrt().size())&&(!inf.findNetAdd(rt.getIpDestination(),rt.getSubnet()).equalsIgnoreCase(inf.findNetAdd(des,rt.getSubnet())))){
      rt = (RoutingTable)r.getVrt().elementAt(i);
      i++;
    }//end while
    if(!nextgw.equalsIgnoreCase("0.0.0.0")){
      Rt1.output = Rt1.output + nextgw + "\n";
    }//end if
    if ((!rt.getGateway().equalsIgnoreCase("0.0.0.0"))&&(found)){
      trace(r,des);
    }//end if
    else{
      if (found){
        Rt1.output = Rt1.output + des + "complete\n";
      }//end if
      else {
        Rt1.output = Rt1.output + "Incorrect Destination\n";
      }//end else
    }//end else
  }
  //----------------Ping------------//
  public void ping(Router r,String des){
    int i=0;
    RoutingTable rt = null;
    Router tmp = null;
    Interface inf = (Interface)r.getVInt().elementAt(0);
    String nextgw="";
    boolean found = false;
    if (r.getVrt().size() > 0){
      rt = (RoutingTable)r.getVrt().elementAt(i);
    }//end if
    //search path from routing table when des = des from user command
    while((i < r.getVrt().size())&&(!rt.getIpDestination().equalsIgnoreCase(inf.findNetAdd()))){
      rt = (RoutingTable)r.getVrt().elementAt(i);
      //gateway is interface that adj
      nextgw = rt.getGateway();
      i++;
    }//end while
    //if found in routing table
    if (rt.getIpDestination().equalsIgnoreCase(inf.findNetAdd())){
      //find route that have interface of gateway value
      for (int j=0; j < Frame1.vRouter.size(); j++){
        //Router 1
        tmp = (Router)Frame1.vRouter.elementAt(j);
        //Interface 1 of Router 1
        for(int k=0; k < tmp.getVInt().size(); k++){
          Interface intf = (Interface)tmp.getVInt().elementAt(k);
          String i1 = intf.getIpAddress();
          if (intf.getIpAddress().equalsIgnoreCase(nextgw)){
            r = tmp;
          }//end if
        }//end for
      }//end for
    }//end if
    else{
      found = false;
    }//end else
    i = 0;
    rt = (RoutingTable)r.getVrt().elementAt(i);
    while ((i < r.getVrt().size())&&(!inf.findNetAdd(rt.getIpDestination(),rt.getSubnet()).equalsIgnoreCase(inf.findNetAdd(des,rt.getSubnet())))){
      rt = (RoutingTable)r.getVrt().elementAt(i);
      i++;
    }//end while
    if ((!rt.getGateway().equalsIgnoreCase("0.0.0.0"))&&(found)){
      ping(r,des);
    }//end if
    else{
      if (found){
        Rt1.output += "Type escape sequence to abort.\n";
        Rt1.output += "Sending 5, 100-byte ICMP Echos to 161.246.6.1 timeout is 2 seconds:\n";
        Rt1.output += "....";
        Rt1.output += "Success rate is 0 percent (0/5)";
//        Rt1.output = Rt1.output + des + " is alive\n";
      }//end if
      else {
        Rt1.output = Rt1.output + "Incorrect Destination\n";
      }//end else
    }//end else
  }
