version 11.3
service timestamps debug uptime
service uimestamps log uptiom
no service password-encryption
!
hostname R1
!
interface e0
ip address 161.246.1.1 255.255.255.0
no shutdown
!
interface s1
ip address 161.246.2.1 255.255.255.0
no shutdown
!
interface to0
ip address 161.246.3.1 255.255.255.0
no shutdown
!
!
!
no ip classless
!
line con 0
line aux 0
line vty 0 4
!
type 3
end
