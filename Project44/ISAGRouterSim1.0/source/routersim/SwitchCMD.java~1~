  public void sendCMD(Router router,String cmdline){
    Prompt p = new Prompt();
    Command c = new Command();
    Config conf = new Config();
    Rt1 rt = new Rt1();
    String[] arrCMD= new String[6];
    arrCMD = splitCMD(cmdline);
//    output = "dear";
    if (cmdline.startsWith("?")){
      switch (router.getMode()){
        case 1 : c.showCMD1();break;
        case 2 : c.showCMD2();break;
        case 3 : c.showCMD3();break;
        case 4 : c.showCMD4();break;
        default : c.showCMD1();
      }//end switch
    }
    else if (arrCMD[0].startsWith("en")){
      if (p.enable(router.getPrompt())){
        router.setMode(2);
        router.setPrompt("#");
        Rt1.output="";
      }//end if
    }
    else if(arrCMD[0].startsWith("dis")){
      if (p.disable(router.getPrompt())){
        router.setMode(1);
        router.setPrompt(">");
        Rt1.output="";
      }//end if
    }
    else if((arrCMD[0].startsWith("config"))&&(arrCMD[1].startsWith("t"))){
      if(p.configT(router.getPrompt())){
        router.setMode(3);
        router.setPrompt("(config)#");
        Rt1.output="Enter configuration commands, one per line. End with CNTL/Z.\n";
      }//end if
    }
    else if(arrCMD[0].startsWith("exit")){
      if(p.exitcmd(router.getPrompt())){
        switch (router.getMode()){
          case 3 : router.setMode(2);router.setPrompt("#");Rt1.output="%SYS-5-CONFIG_I: Configured from console by console\n";break;
          case 4 : router.setMode(3);router.setPrompt("(config)#");Rt1.output="";break;
          case 5 : router.setMode(2);router.setPrompt("#");Rt1.output="%SYS-5-CONFIG_I: Configured from console by console\n";break;
          default : router.setMode(2);router.setPrompt("#");Rt1.output="";
        }//end switch
      }//end if
    }
    else if((arrCMD[0].startsWith("int"))&&(arrCMD[1].length() != 0)){
      if ((router.getMode() == 3) || (router.getMode() == 4)){
        router.setMode(4);
        router.setPrompt("(config-if)#");
        conf.addNewInterface(router,arrCMD[1]);
        Rt1.output="";
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if ((arrCMD[0].startsWith("ip"))&&(arrCMD[1].startsWith("add"))){
      if (router.getMode() == 4){
        if ((arrCMD[2].length() != 0)&&(arrCMD[3].length() != 0)){
          conf.setIpInterface(router,arrCMD[2],arrCMD[3]);
          Rt1.output="";
        }//have value
      }//in proper mode
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("no"))&&(arrCMD[1].startsWith("shut"))){
      if (router.getMode() == 4){
        Interface inf = (Interface)router.getVInt().lastElement();
        conf.noShutInt(inf);
        Rt1.output="%LINEPROTO-5-UPDOWN: Line protocol on Interface "+inf.getType() + inf.getNameInt().charAt(inf.getNameInt().length()-1)+", changed state to up\n%LINK-3-UPDOWN: Interface "+inf.getType() + inf.getNameInt().charAt(inf.getNameInt().length()-1)+", changed state to up\n";
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if(arrCMD[0].startsWith("shut")){
      if (router.getMode() == 4){
        Interface inf = (Interface)router.getVInt().lastElement();
        conf.shutInt(inf);
        Rt1.output="%LINEPROTO-5-UPDOWN: Line protocol on Interface "+inf.getType() + inf.getNameInt().charAt(inf.getNameInt().length()-1)+", changed state to down\n%LINK-3-UPDOWN: Interface"+ inf.getType() + inf.getNameInt().charAt(inf.getNameInt().length()-1)+", changed state to administratively down\n";
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("hostname"))&&(arrCMD[1].length() != 0)){
      if (router.getMode() == 3){
        conf.setHostname(router,arrCMD[1]);
        Rt1.output="";
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("no"))&&(arrCMD[1].startsWith("ip"))&&(arrCMD[2].startsWith("route"))){
      if (router.getMode() == 3){
        if ((arrCMD[3].length() != 0)&&(arrCMD[4].length() != 0)&&(arrCMD[5].length() != 0)){
          conf.noipRoute(router,arrCMD[3],arrCMD[4],arrCMD[5]);
          Rt1.output = "";
        }
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("ip"))&&(arrCMD[1].startsWith("route"))){
      if (router.getMode() == 3){
        if ((arrCMD[2].length() != 0)&&(arrCMD[3].length() != 0)&&(arrCMD[4].length() != 0)){
          conf.ipRoute(router,arrCMD[2],arrCMD[3],arrCMD[4]);
          Rt1.output = "";
        }
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if ((arrCMD[0].startsWith("sh"))&&(arrCMD[1].startsWith("int"))){
      if (router.getMode() < 3){
        c.showInterface(router);
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("sh"))&&(arrCMD[1].startsWith("ip"))&&(arrCMD[2].startsWith("route"))){
      if (router.getMode() < 3){
        c.showIpRoute(router);
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("router"))&&(arrCMD[1].startsWith("rip"))){
      if (router.getMode() == 3){
        router.getTable().setFlag('r');
        router.setMode(5);
        router.setPrompt("(config-router)#");
        Rt1.output="";
        Rip ripf = new Rip(router);
        ripf.start();
      }
      else {Rt1.output = "%  Invalid input detected at '^' marker. \n";}
    }
    else if((arrCMD[0].startsWith("no")) && (arrCMD[1].startsWith("router")) && (arrCMD[2].startsWith("rip"))){
      if (router.getMode() == 3){
        router.getTable().setFlag('s');
        router.setMode(5);
        router.setPrompt("(config-router)#");
        Rt1.output = "";
      }
    }
    else if ((arrCMD[0].startsWith("trace"))&&(arrCMD[1].length() != 0)){

    }
    else {Rt1.output="%  Invalid input detected at '^' marker. \n";}
  }
