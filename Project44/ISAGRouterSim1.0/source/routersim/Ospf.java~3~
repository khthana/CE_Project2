  private boolean checkRedunce(Vector v,Router r){
    boolean check=false;
    int i=0;
    while  ((i<v.size())&&(!check)){
      Hello h=(Hello)v.elementAt(i);
      if (h.getDesRouter().getName().equalsIgnoreCase(r.getName())){
              check=true;
      }else{}
      i++;
    }
    return check;
  }

