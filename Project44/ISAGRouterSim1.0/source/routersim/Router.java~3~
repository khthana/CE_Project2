  public void recieveHelloTable(Vector h,String rname){
        boolean found=false;
        int i=0;

        while ((!found)&&(i<vHello.size())&&(h.size()>0))
        {
            Vector vh = (Vector)vHello.elementAt(i);
            Hello h2 = (Hello)vh.elementAt(0);
            if (h2.getStartRouter().getName().equalsIgnoreCase(rname)){
              found=true;
            }else{}
            i++;
        }
        if (!found){
            vHello.addElement(h);
        }else {};
  }
