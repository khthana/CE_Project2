     if (Button3.Caption = 'หยุด')and ((CWFlag = true)or(CWFlag = true))then
     begin
          cutWords.Suspend;
          fileMergeType.Suspend;
          Button3.Caption := 'ต่อไป';
     end
     else
     if (Button3.Caption = 'ต่อไป') then
     begin
          cutWords.Resume;
          fileMergeType.Resume;
          Button3.Caption := 'หยุด';
     end;
end;

