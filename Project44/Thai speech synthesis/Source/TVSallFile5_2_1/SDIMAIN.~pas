procedure TMainForm.FormClose(Sender: TObject; var Action: TCloseAction);
begin
     DeleteCriticalSection(cs);
     if CWFlag = true then
     begin
         cutWords.destroy;
         CWFlag := false;
     end;
     if FMFlag = true then
     begin
         fileMergeType.destroy;
         FMFlag := false;
     end;
end;

procedure TMainForm.Button3Click(Sender: TObject);
