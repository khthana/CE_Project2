Public Sub UpdateScreen()

On Error GoTo UpdateScreen_Error
    
    pViewport.Clear
    pViewport.Render Scene
    Dev.Update
    Exit Sub

UpdateScreen_Error:
    Debug.Print "UpdateScreen"; Now; " "; Err.Number; " "; Err.Description
    Resume
    
End Sub

Public Sub Create3DWorld()
Dim a As Integer

    For a = 1 To 17
      pD3drm.CreateMeshBuilder Hand_Builder(a)
      With Hand_Builder(a)
         .Load App.Path & "\" & Filename(a) & ".x", 0, 0, 0, 0
         .Scale 10, 5, 5
         .SetColorRGB 0.88, 0.67, 0.53
         .CreateMesh hand_mesh(a)
      End With
      Hand_Builder(a).CreateMesh hand_mesh(a)
    Next
    
End Sub

Private Sub Form_Paint()
    
    Call UpdateScreen
    
End Sub

Private Sub Form_Resize()
    
    Dim FormWidth As Long
    Dim formHeight As Long
    
    FormWidth = ScaleX(ScaleWidth, ScaleMode, vbPixels)
    formHeight = ScaleY(ScaleHeight, ScaleMode, vbPixels)
    
    If Not (pViewport Is Nothing) Then Set pViewport = Nothing
    If Not (pClipper Is Nothing) Then Set pClipper = Nothing
    
    DirectDrawCreateClipper 0, pClipper, Nothing
    pClipper.SetHWnd 0, hWnd
    pD3drm.CreateDeviceFromClipper pClipper, ByVal 0&, FormWidth, formHeight, Dev
    pD3drm.CreateViewport Dev, Camera, 0, 0, FormWidth, formHeight, pViewport
    With Dev
        .SetDither 1
        .SetQuality D3DRMLIGHT_ON Or D3DRMFILL_SOLID Or D3DRMSHADE_GOURAUD
    End With
    
    Call UpdateScreen
    
End Sub

Private Sub Form_Unload(Cancel As Integer)
Dim a As Integer

    Set pD3drm = Nothing
    Set Scene = Nothing
    Set pClipper = Nothing
    Set Camera = Nothing
    Set pViewport = Nothing
    Set Dev = Nothing
    Set l1 = Nothing
    Set l2 = Nothing
    Set Lights = Nothing
    For a = 1 To 17
       Set Hand_Builder(a) = Nothing
       Set hand_mesh(a) = Nothing
       Set Hand(a) = Nothing
       Set Parent(a) = Nothing
    Next a
    
End Sub

Private Sub MSComm1_OnComm()
On Error GoTo Com_Error
    If mode Then
        If check < 4 Then
            buffer(check) = MSComm1.Input
            num(check) = Asc(buffer(check))
            If check = 3 Then
                If num(2) = num(0) + 1 Then mode = False
            End If
        Else
            buffer(0) = MSComm1.Input
            mode = False
        End If
    Else
        buffer(0) = MSComm1.Input
        If check > 1 Then
            num(0) = Asc(buffer(0))
            check = 0
        Else
            If Save_Before Then
               Before(num(0) + 1) = Asc(buffer(0))
               Text1(num(0)).Text = Asc(buffer(0))
            Else: Display num(0) + 1, Asc(buffer(0))
            End If
        End If
    End If
    check = check + 1
    Exit Sub
Com_Error:
   check = 0
   mode = True
   Exit Sub
End Sub

Private Sub Initial()
Dim a As Integer
    
    Direct3DRMCreate pD3drm
    pD3drm.CreateFrame Nothing, Scene
    pD3drm.CreateFrame Scene, Camera
    pD3drm.CreateFrame Scene, Lights
    Camera.SetPosition Scene, 0, 0, 0
    Lights.SetPosition Scene, 10, 10, -10
    pD3drm.CreateLightRGB D3DRMLIGHT_POINT, 1, 1, 1, l1
    Lights.AddLight l1
    pD3drm.CreateLightRGB D3DRMLIGHT_AMBIENT, 0.5, 0.5, 0.5, l2
    Scene.AddLight l2
    Call Create3DWorld
    Camera.SetPosition Scene, 0, 0, -25
    pD3drm.CreateFrame Scene, Hand(17)
    Hand(17).AddVisual hand_mesh(17)
    pD3drm.CreateFrame Hand(17), Hand(16)
    Hand(16).AddVisual hand_mesh(16)
    For a = 11 To 15
       pD3drm.CreateFrame Hand(16), Hand(a)
       Hand(a).AddVisual hand_mesh(a)
    Next a
    For a = 6 To 10
       pD3drm.CreateFrame Hand(a + 5), Hand(a)
       Hand(a).AddVisual hand_mesh(a)
    Next a
    For a = 1 To 5
       pD3drm.CreateFrame Hand(a + 5), Hand(a)
       Hand(a).AddVisual hand_mesh(a)
    Next a
