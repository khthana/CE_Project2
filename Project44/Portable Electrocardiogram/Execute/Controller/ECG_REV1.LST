                     159	;*                Input  : ACC  (ASCII)             		*
                     160	;*                Output : Data bus LCD             	*
                     161	;******************************************************
     00C6 C002       162	WR_LCD:PUSH	02H	
     00C8 F5F0       163		MOV     	B,A
     00CA 54F0       164	            	ANL     	A,#0F0H
     00CC D2B7       165	            	SETB   	RS_LCD		;RS HI
     00CE FA         166	            	MOV     	R2,A
     00CF E580       167	            	MOV     	A,P0
     00D1 540F       168	            	ANL     	A,#00001111B
     00D3 4A         169	            	ORL     	A,R2
     00D4 F580       170	           	MOV     	P0,A
     00D6 12013D     171	            	LCALL   	EN_LCD
     00D9 E5F0       172	            	MOV     	A,B             	;Low byte
     00DB C4         173	            	SWAP    	A
     00DC 54F0       174	            	ANL     	A,#0F0H
     00DE D2B7       175	            	SETB   	RS_LCD		;RS HI
     00E0 FA         176	            	MOV     	R2,A

