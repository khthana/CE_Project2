                      38	
     0040             39	        org	0040h    
     0040 758140      40	MAIN:   mov	sp,#40h	
     0043 D2B6        41		SETB    	CS_LCD        	; initial LCD
     0045 1203B2      42	            	LCALL   	DELAY         	; initial delay
     0048 12011C      43	            	LCALL   	INIT_LCD      	; initial LCD
     004B 753200      44		MOV	TIMER_H,#00
     004E 753300      45		MOV	TIMER_L,#00
     0051 D2A2        46		SETB    	I2C_WPT                 ; Enable I2C Write Protect
     0053 C2A1        47	            	CLR     	I2C_SCL                 	; Initial Bus For Stop
     0055 C2A0        48	            	CLR     	I2C_SDA
     0057 D2A1        49	            	SETB    	I2C_SCL
     0059 D2A0        50	            	SETB    	I2C_SDA                 	; Stop Condition (SCL=1,SDA=1)
     005B 753800      51		MOV	POS,#00H
     005E 853839      52		MOV	TIME_H,POS
     0061 85383A      53		MOV	TIME_L,POS
     0064             54	START:   	
     0064 758921      55	        	MOV     	TMOD,#21H        	;SET TIMER1 MODE2(AUTO RE-LOAD)
                      56					;SET TIMER0 MODE1(16 BIT)
     0067 758DFD      57	        	MOV     	TH1,#0FDH        	;SET BAUD RATE=9600(1200=E8,2400=F4,4800=FA,600=D0,300=A0)
     006A 758CFC      58		MOV     	TH0,#0FCH	;5 msec TIMER #0EE00H

