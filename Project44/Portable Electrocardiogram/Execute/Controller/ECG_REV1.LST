                     185	;******************************************************
                     186	;*                Write Instruction LCD             	*
                     187	;*                Input  : ACC (Command)            	*
                     188	;*                Output : Data bus LCD             	*
                     189	;******************************************************
     00EE C002       190	WR_INS:	PUSH	02H
     00F0 F5F0       191		MOV     	B,A
     00F2 54F0       192	            	ANL     	A,#0F0H
     00F4 FA         193	            	MOV     	R2,A
     00F5 E580       194	            	MOV     	A,P0
     00F7 540F       195	            	ANL     	A,#00001111B    	;else bit
     00F9 C2B7       196	            	CLR   	RS_LCD		;RS LOW
     00FB 4A         197	            	ORL     	A,R2
     00FC F580       198	            	MOV     	P0,A            	; High byte
     00FE 12013D     199	            	LCALL   	EN_LCD
     0101 E5F0       200	            	MOV     	A,B             	; Low byte
     0103 C4         201	            	SWAP    	A
     0104 54F0       202	            	ANL     	A,#0F0H
     0106 FA         203	            	MOV     	R2,A
     0107 E580       204	            	MOV     	A,P0
     0109 540F       205	            	ANL    	A,#00001111B
     010B C2B7       206	            	CLR   	RS_LCD		;RS LOW
     010D 4A         207	            	ORL     	A,R2
     010E F580       208	            	MOV     	P0,A
     0110 12013D     209	            	LCALL   	EN_LCD
     0113 D002       210		POP	02H
     0115 22         211	            	RET
                     212	
                     213	;******************************************************
                     214	;*                 Goto position of LCD             	*
                     215	;*                 Input : ACC (addr.)              		*
                     216	;******************************************************
     0116            217	GOTO_LCD:   
     0116 D2E7       218		SETB    	ACC.7
     0118 1200EE     219	            	LCALL   	WR_INS
     011B 22         220	            	RET
                     221	
                     222	;******************************************************
                     223	;*                      Initial LCD                 		*
                     224	;*                      4-Bit Interface             		*
                     225	;******************************************************
     011C            226	INIT_LCD:   
     011C C2B7       227		CLR     	RS_LCD
     011E 7433       228	            	MOV     	A,#33H          	; Set DL = 1 3-time
     0120 1200EE     229	            	LCALL   	WR_INS
     0123 7432       230	            	MOV     	A,#32H          	; Clear DL = 0 1-time
     0125 1200EE     231	            	LCALL   	WR_INS
     0128 7420       232	            	MOV     	A,#20H          	; Function set  (28)
     012A 1200EE     233	            	LCALL   	WR_INS          	; DL=0 4Bit,N=1 2Line,F=0 5X7
     012D 740C       234	            	MOV     	A,#0CH
     012F 1200EE     235	            	LCALL   	WR_INS          	; Entry display,cursor off,cursor not blink

8051 Cross-Assembler (1.3)   (C) 1987, 1989 Binary Technology                                                              Page   5
ECG_rev1.ASM                                    

     0132 7406       236	            	MOV     	A,#06H          	; Entry mode set
     0134 1200EE     237	            	LCALL   	WR_INS          	; I/D=1 Increment,S=0 cursor shift
     0137 7401       238	            	MOV     	A,#01H          	; Clear display
     0139 1200EE     239	            	LCALL   	WR_INS          	; Clear display,set DD RAM address=0
     013C 22         240	            	RET
                     241	;******************************************************
                     242	;*                    Enable Pin E LCD              	*
                     243	;*                    Active Chip select            		*
                     244	;******************************************************
     013D C2B6       245	EN_LCD:	CLR     	CS_LCD          	; Enable LCD
     013F 120145     246	            	LCALL   	BUSY            	; Busy delay time
     0142 D2B6       247	            	SETB    	CS_LCD          	; Disable LCD
     0144 22         248	            	RET
                     249	
                     250	;******************************************************
                     251	;*                Delay time for Busy               	* 
                     252	;*                  Wait LCD Ready                  	*
                     253	;******************************************************
     0145 C007       254	BUSY:    	PUSH  	07H
     0147 C006       255	            	PUSH    	06H
     0149 7E05       256	            	MOV     	R6,#05H
     014B 7FFF       257	BUSY1: 	MOV     	R7,#0FFH
     014D DFFE       258	            	DJNZ    	R7,$
     014F DEFA       259	            	DJNZ    	R6,BUSY1
     0151 D006       260	            	POP     	06H
     0153 D007       261	            	POP     	07H
     0155 22         262	            	RET
