     0176 33         295	            	RLC     	A                       	; Write MSB First
     0177 92A0       296	            	MOV     	I2C_SDA,C             	; Write Bit Data to SDA Signal
     0179 00         297	            	NOP
     017A 00         298	            	NOP
     017B 00         299	            	NOP
