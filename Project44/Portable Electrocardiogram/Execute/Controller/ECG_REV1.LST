                     266	;/* I2C-BUS 24LC256 Interface */;
                     267	;/* Write Data to I2C-EEPROM  */;
                     268	;/* Input  : DPTR (Address)   */;
                     269	;/*        : ACC (Data)       */;
                     270	;/*****************************/;
                     271	;
     0156            272	I2C_WRITE:  
     0156 C0F0       273		PUSH    	B                       	; Save Register
     0158 C0E0       274	            	PUSH    	ACC                     	; Save Data to Write
     015A C2A2       275	            	CLR     	I2C_WPT                 ; Disable Write Protect
     015C C2A1       276	            	CLR     	I2C_SCL                 	; Initial Bus For Start
     015E D2A0       277	            	SETB    	I2C_SDA                 
     0160 D2A1       278	            	SETB    	I2C_SCL
     0162 00         279	            	NOP                             	; TSU:STA Delay (5us)
     0163 00         280	            	NOP
     0164 00         281	            	NOP
     0165 00         282	            	NOP
     0166 00         283	            	NOP
     0167 C2A0       284	            	CLR     	I2C_SDA                 	; Start Condition
     0169 00         285	            	NOP                             	; THD:STA Delay (4us)
     016A 00         286	            	NOP
     016B 00         287	            	NOP
     016C 00         288	            	NOP
                     289	            ;/* Ready to Start 1st Byte Send */;
     016D 75F008     290	            	MOV     	B,#8                    	; Write Control Byte 8-Bit Count
     0170 74A0       291	            	MOV     	A,#10100000B        	; 1010-Slave000,Write
     0172            292	I2C_WR1:    
     0172 C2A1       293		CLR     	I2C_SCL                 	;/* Change Data to SDA Signal */;
     0174 D2A0       294	            	SETB    	I2C_SDA                 	; Release Data Line

