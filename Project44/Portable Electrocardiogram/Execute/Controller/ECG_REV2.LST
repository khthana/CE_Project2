                     374	;/* I2C-BUS 24LC256 Interface */;
                     375	;/* Read Data From I2C-EEPROM */;
                     376	;/* -I2C_READ1 = Random Read  */;
                     377	;/*  Input  : DPTR (Address)  */;
                     378	;/*  Output : ACC (Data)      */;
                     379	;/* -I2C_READ2 = Current Read */;
                     380	;/*  Input  : None (Continue) */;
                     381	;/*  Output : ACC (Data)      */;
                     382	;/*****************************/;
                     383	;
     0237            384	I2C_READ1:  
     0237 C0F0       385		PUSH    	B                       	; Save Register
     0239 C2A1       386	            	CLR     	I2C_SCL                 	; Initial Bus For Start
     023B D2A0       387	            	SETB    	I2C_SDA                 
     023D D2A1       388	            	SETB    	I2C_SCL
     023F 00         389	            	NOP                             	; TSU:STA Delay (5us)
     0240 00         390	            	NOP
     0241 00         391	            	NOP
     0242 00         392	            	NOP
     0243 00         393	            	NOP
     0244 C2A0       394	            	CLR     	I2C_SDA                 	; Start Condition
     0246 00         395	            	NOP                             	; THD:STA Delay (4us)
     0247 00         396	            	NOP
     0248 00         397	            	NOP
