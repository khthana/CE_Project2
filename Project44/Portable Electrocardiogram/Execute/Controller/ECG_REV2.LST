                     215	;/* I2C-BUS 24LC256 Interface */;
                     216	;/* Write Data to I2C-EEPROM  */;
                     217	;/* Input  : DPTR (Address)   */;
                     218	;/*        : ACC (Data)       */;
                     219	;/*****************************/;
                     220	;
     0153            221	I2C_WRITE:  
     0153 C0F0       222		PUSH    	B                       	; Save Register
     0155 C0E0       223	            	PUSH    	ACC                     	; Save Data to Write
     0157 C2A2       224	            	CLR     	I2C_WPT                 ; Disable Write Protect
     0159 C2A1       225	            	CLR     	I2C_SCL                 	; Initial Bus For Start
     015B D2A0       226	            	SETB    	I2C_SDA                 
     015D D2A1       227	            	SETB    	I2C_SCL
     015F 00         228	            	NOP                             	; TSU:STA Delay (5us)
     0160 00         229	            	NOP
     0161 00         230	            	NOP
     0162 00         231	            	NOP
     0163 00         232	            	NOP
     0164 C2A0       233	            	CLR     	I2C_SDA                 	; Start Condition
     0166 00         234	            	NOP                             	; THD:STA Delay (4us)
     0167 00         235	            	NOP

