                       1	;******************************************************
                       2	;*          Program Test 4 Bits LCD                 	*
                       3	;*          Dot Matrix LCD 16X1                  	*
                       4	;*          HardWare :Project SAN       		*
                       5	;*          Complier : SXA51                        	*
                       6	;******************************************************
     00B6=             7	CS_LCD 	EQU 	P3.6          	; E  LCD (Pin WR)
     00B7=             8	RS_LCD 	EQU    	P3.7          	; RS LCD (Pin RD)
     00A2=             9	I2C_WPT EQU     	P2.2                    	; I2C-Bus Write Protect
     00A1=            10	I2C_SCL  EQU     	P2.1                    	; I2C-Bus Clock  >P2.1
     00A0=            11	I2C_SDA  EQU     	P2.0                    	; I2C-Bus Data  >P2.0
     0031=            12	NUM	EQU	31H
     0032=            13	TIMER_H	EQU	32H
     0033=            14	TIMER_L	EQU	33H
     0034=            15	TIM1_H	EQU	34H
     0035=            16	TIM1_L	EQU	35H
     0036=            17	TIM2_H	EQU	36H
     0037=            18	TIM2_L	EQU	37H
     0038=            19	POS	EQU	38H
     0039=            20	TIME_H	EQU	39H	
     003A=            21	TIME_L	EQU	3AH
     003B=            22	ADDRL	EQU	3BH
     003C=            23	ADDRH	EQU	3CH
     003D=            24	DISNUM	EQU	3DH
     0000=            25	BITC	EQU	00H
     0001=            26	bitA	EQU	01H
     0000             27	        ORG     0000H
     0000 020040      28	        LJMP   	MAIN
                      29		
     000B             30		ORG	000BH       	;INTERRUPT TIMER0
     000B 0203C0      31	        LJMP	TIME0
                      32	
     0023             33		ORG	0023H
     0023 02046C      34		LJMP	SEND
                      35	
     0040             36	        org	0040h    
     0040 758140      37	MAIN:   mov	sp,#40h	
     0043 D2B6        38		SETB    CS_LCD        	; initial LCD
     0045 1203AF      39	        LCALL   DELAY         	; initial delay
     0048 120119      40	        LCALL   INIT_LCD      	; initial LCD
     004B 753200      41		MOV	TIMER_H,#00
     004E 753300      42		MOV	TIMER_L,#00
     0051 D2A2        43		SETB    I2C_WPT         ; Enable I2C Write Protect
     0053 C2A1        44	        CLR     I2C_SCL         ; Initial Bus For Stop
     0055 C2A0        45	        CLR     I2C_SDA
     0057 D2A1        46	        SETB    I2C_SCL
     0059 D2A0        47	        SETB    I2C_SDA         ; Stop Condition (SCL=1,SDA=1)
     005B 753800      48		MOV	POS,#00H
     005E 853839      49		MOV	TIME_H,POS
     0061 85383A      50		MOV	TIME_L,POS
     0064             51	START:   	
     0064 758921      52		MOV     TMOD,#21H        ;SET TIMER1 MODE2(AUTO RE-LOAD)
                      53					;SET TIMER0 MODE1(16 BIT)
     0067 758DFD      54	        MOV     TH1,#0FDH        ;SET BAUD RATE=9600(1200=E8,2400=F4,4800=FA,600=D0,300=A0)
     006A 758CFC      55		MOV     TH0,#0FCH	;5 msec TIMER #0EE00H
     006D 758A67      56		MOV     TL0,#67H	;1 msec TIMER #0FC67H
     0070 759850      57		MOV	SCON,#01010000B
     0073 75A892      58	        MOV     IE,#10010010B    ;SET INTERRUPT ENABLE SERIAL AND TIMER0    (10010011B) INTERRUPT0

