                     134	;******************************************************
                     135	;*                Write Instruction LCD             	*
                     136	;*                Input  : ACC (Command)            	*
                     137	;*                Output : Data bus LCD             	*
                     138	;******************************************************
     00EB C002       139	WR_INS:	PUSH	02H
     00ED F5F0       140		MOV     B,A
     00EF 54F0       141	        ANL     A,#0F0H
     00F1 FA         142	        MOV    	R2,A
     00F2 E580       143	        MOV     A,P0
     00F4 540F       144	        ANL     A,#00001111B   	;else bit
     00F6 C2B7       145	        CLR   	RS_LCD		;RS LOW
     00F8 4A         146	        ORL    	A,R2
     00F9 F580       147	        MOV     P0,A           	; High byte
     00FB 12013A     148	        LCALL   EN_LCD
     00FE E5F0       149	        MOV     A,B             ; Low byte
     0100 C4         150	        SWAP    A
     0101 54F0       151	        ANL    	A,#0F0H
     0103 FA         152	        MOV     R2,A
     0104 E580       153	        MOV     A,P0
     0106 540F       154	        ANL    	A,#00001111B
     0108 C2B7       155	        CLR   	RS_LCD		;RS LOW
     010A 4A         156	        ORL     A,R2
     010B F580       157	        MOV    	P0,A
     010D 12013A     158	        LCALL  	EN_LCD
     0110 D002       159		POP	02H
     0112 22         160	        RET
                     161	
                     162	;******************************************************
                     163	;*                 Goto position of LCD             	*
                     164	;*                 Input : ACC (addr.)              		*
                     165	;******************************************************
     0113            166	GOTO_LCD:   
     0113 D2E7       167		SETB    ACC.7
     0115 1200EB     168	        LCALL   WR_INS
     0118 22         169	        RET
                     170	
