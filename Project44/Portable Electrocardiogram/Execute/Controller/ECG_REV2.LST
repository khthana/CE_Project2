     011B 7433       177	        MOV     A,#33H        	; Set DL = 1 3-time
     011D 1200EB     178	        LCALL  	WR_INS
     0120 7432       179	        MOV     A,#32H         	; Clear DL = 0 1-time
     0122 1200EB     180	        LCALL   WR_INS
     0125 7420       181	        MOV     A,#20H         	; Function set  (28)
     0127 1200EB     182	        LCALL   WR_INS          ; DL=0 4Bit,N=1 2Line,F=0 5X7
     012A 740C       183	        MOV     A,#0CH
     012C 1200EB     184	        LCALL   WR_INS          ; Entry display,cursor off,cursor not blink
     012F 7406       185	        MOV     A,#06H          ; Entry mode set
     0131 1200EB     186	        LCALL   WR_INS          	; I/D=1 Increment,S=0 cursor shift
     0134 7401       187	        MOV     A,#01H          	; Clear display
     0136 1200EB     188	        LCALL   WR_INS          	; Clear display,set DD RAM address=0
     0139 22         189	        RET
                     190	;******************************************************
                     191	;*                    Enable Pin E LCD              	*
                     192	;*                    Active Chip select            		*
                     193	;******************************************************
     013A C2B6       194	EN_LCD:	CLR     	CS_LCD          	; Enable LCD
     013C 120142     195	            	LCALL   	BUSY            	; Busy delay time
     013F D2B6       196	            	SETB    	CS_LCD          	; Disable LCD
     0141 22         197	            	RET
                     198	
                     199	;******************************************************
                     200	;*                Delay time for Busy               	* 
                     201	;*                  Wait LCD Ready                  	*
                     202	;******************************************************
     0142 C007       203	BUSY:    	PUSH  	07H
     0144 C006       204	            	PUSH    	06H
     0146 7E05       205	            	MOV     	R6,#05H
     0148 7FFF       206	BUSY1: 	MOV     	R7,#0FFH
     014A DFFE       207	            	DJNZ    	R7,$
     014C DEFA       208	            	DJNZ    	R6,BUSY1
     014E D006       209	            	POP     	06H
     0150 D007       210	            	POP     	07H
     0152 22         211	            	RET
                     212	
