     00D6 E5F0       121	        MOV     A,B             ;Low byte
     00D8 C4         122	        SWAP    A
     00D9 54F0       123	        ANL     A,#0F0H
     00DB D2B7       124	        SETB   	RS_LCD		;RS HI
     00DD FA         125	        MOV     R2,A
