<%


  if ((em==null) && (pwd==null)){
						   %>
	<P>&nbsp;<form action="login.jsp" method="post">		    
<TABLE align="CENTER" cellpadding="3" bordercolor="#66669A" border="1" cellspacing="0" width="95%">
    <TR bgcolor="#66669A" height="24">
	<TD colspan="2" align="left"><FONT COLOR="#F1F0FF"><B>Login เข้าสู่ระบบ</B></FONT></TD>
</TR>
<TR>
	<TD  bgcolor="#FFFFFF" width="50"> รหัส</TD>
	<TD bgcolor="#F1F0FF" ><input type="text" name="username" size="15" maxlength="20"></TD>
</TR>
<TR>
	<TD  bgcolor="#FFFFFF" width="50">รหัสผ่าน</TD>
	<TD bgcolor="#F1F0FF" ><input type="password" name="passwd" size="15" maxlength="15"></TD>
</TR>
<TR>
<TD colspan="2" bgcolor="#F1F0FF" height="35" >
	<CENTER><INPUT TYPE="submit" value="ตกลง">&nbsp;&nbsp; <INPUT TYPE="reset" value="เริ่มใหม่"></CENTER>	
 </TD>
 </TR>	
</table>

</form>
						   <%
						   
						   }else{
		
						   
		try{
System.out.println("yoyo");                         
				DriverManager.registerDriver(new oracle.jdbc.driver.OracleDriver());
				Connection mcon = DriverManager.getConnection("jdbc:oracle:thin:@127.0.0.1:1521:orcl", "sys", "maimee");
				Statement  mstmt = mcon.createStatement();
				                    String mdept=(String) session.getAttribute("dept");
									String mname=(String) session.getAttribute("name");
									String msname=(String) session.getAttribute("sname");
								    String mquery="SELECT REMAIN FROM DEPARTMENT WHERE DEPT_NAME='" +mdept+"'";
System.out.println(mdept);
System.out.println(mname);
System.out.println(msname);
System.out.println(mquery);
									ResultSet mrs=mstmt.executeQuery(mquery);
									mrs.next();
									double remain=mrs.getDouble("REMAIN");
									

				%><P>&nbsp;
									<TABLE valign="middle" align="center" width="95%" cellpadding="3" cellspacing="0" border="1" bordercolor="#66669A">
									<TR bgcolor="#66669A" valign="middle" valign="center">
										<TD><CENTER><FONT COLOR="#F1F0FF"><B>ยินดีต้อนรับ</B></FONT></CENTER></TD>
									</TR>
									<TR bgcolor="#FFFFFF">
										<TD><FONT COLOR="#66669A"><CENTER>คุณ <%=mname%>&nbsp;<%=msname%><BR>แผนก<%=mdept%></CENTER></FONT></TD>
									</TR>
									<TR bgcolor="#66669A" valign="middle" valign="center">
										<TD><CENTER><FONT COLOR="#F1F0FF"><B>งบที่เหลือ &nbsp;<%=remain%>&nbsp;บาท</B></FONT></CENTER></TD>
									</TR>
									</TABLE>
				
				<%

									mrs.close();
									mstmt.close();
									mcon.close();

									}catch(java.sql.SQLException e)  {
															  System.out.println("SQLException:<br>");
															  System.out.println("Message:   " + e.getMessage() + "<br>");
															  System.out.println("SQLState:  " + e.getSQLState() + "<br>");
															  System.out.println("ErrorCode: " + e.getErrorCode() + "<br>");
															  e.printStackTrace();
								} // catch
						   
						   
						   }


%>
