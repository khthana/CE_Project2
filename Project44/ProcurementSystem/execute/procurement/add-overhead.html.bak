<HTML>
<HEAD>
<TITLE>เพิ่มสินค้าประเภทอุปกรณ์นำเสนอและการประชุม</TITLE>
<META NAME="Generator" CONTENT="EditPlus">
<META NAME="Author" CONTENT="Siriporn J.">
<LINK REL="stylesheet" HREF="procurement.css" TYPE="text/css">
</HEAD>
<BODY>
<FORM method="post" action="add-overhead.jsp?cat=8">
<TABLE cellpadding="3" bordercolor="#DF5F2D" border="1" frame="above" rules="rhs" width="300" cellspacing="0">
<TR bgcolor="#DF572D" height="24">
	<TD colspan="2" align="left"><FONT COLOR="#FFF0E1"><B>เพิ่มสินค้าประเภทอุปกรณ์นำเสนอและการประชุม</B></FONT></TD>
</TR>
<TR>
	<TD  bgcolor="#FFFFFF" width="130">รหัสสินค้า :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="code" size="10"><FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD  bgcolor="#FFFFFF" width="130">ชนิด :</TD>
	<TD bgcolor="#FFF0E1" ><SELECT NAME="type">
			  <OPTION VALUE="0" SELECTED> ==== ชนิด ====
			  <OPTION VALUE="overhead">เครื่อง Overhead
			  </SELECT><FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ยี่ห้อ :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="brand" size="20"><FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ขนาดแท่นวางแผ่นใส :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="desktop_size" size="10"></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ความสว่าง :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="elumination" size="5"></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">หลอดไฟสำรอง:</TD>
	<TD bgcolor="#FFF0E1" ><SELECT NAME="spare_light">
			  <OPTION VALUE="0" SELECTED> ==== หลอดไฟสำรอง ====
			  <OPTION VALUE="มี">มี
			  <OPTION VALUE="ไม่มี">ไม่มี
			  </SELECT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">รายละเอียดอื่นๆ :</TD>
	<TD bgcolor="#FFF0E1" ><TEXTAREA NAME="detail" ROWS="7" COLS="40"></TEXTAREA></TD>
</TR>
<TR bgcolor="#FFF0E1" valign="center" align="center">
	<TD colspan="2">
	<pre> <INPUT TYPE="submit" value="เพิ่มข้อมูล"><INPUT TYPE="reset" value="เริ่มกรอกข้อมูลใหม่"></pre>
 	</TD>
</TR>
</TABLE>
</FORM>
</BODY>
</HTML>
