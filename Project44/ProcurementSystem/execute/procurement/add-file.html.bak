<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">
<HTML>
<HEAD>
<TITLE>เพิ่มสินค้าประเภทงแฟ้ม</TITLE>
<META NAME="Generator" CONTENT="EditPlus">
<META NAME="Author" CONTENT="Siriporn J.">
<LINK REL="stylesheet" HREF="procurement.css" TYPE="text/css">
</HEAD>
<BODY>
<FORM method="post" action="add-file.jsp">
<TABLE cellpadding="3" bordercolor="#DF5F2D" border="1" frame="above" rules="rhs" width="300" cellspacing="0">
<TR bgcolor="#DF572D" height="24">
	<TD colspan="2" align="left"><FONT COLOR="#FFF0E1"><B>เพิ่มสินค้าประเภทแฟ้ม</B></FONT></TD>
</TR>
<TR>
	<TD  bgcolor="#FFFFFF" width="80">รหัสสินค้า :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="code" size="10"><FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD  bgcolor="#FFFFFF" width="80">ชนิด :</TD>
	<TD bgcolor="#FFF0E1" ><SELECT NAME="type">
			  <OPTION VALUE="0" SELECTED> ==== ชนิดของแฟ้ม====
			  <OPTION VALUE="แฟ้มสันกว้าง">แฟ้มสันกว้าง
			  <OPTION VALUE="แฟ้มคลิปสปริง">แฟ้มคลิปสปริง
			  <OPTION VALUE="แฟ้ม 2 ห่วง">แฟ้ม 2 ห่วง
			  <OPTION VALUE="แฟ้ม 3 ห่วง">แฟ้ม 3 ห่วง
			  <OPTION VALUE="แฟ้ม 4 ห่วง">แฟ้ม 4 ห่วง
			  <OPTION VALUE="แฟ้มหนีบ">แฟ้มหนีบ
			  <OPTION VALUE="แฟ้มคอมพิวเตอร์">แฟ้มคอมพิวเตอร์
			  <OPTION VALUE="แฟ้มแขวน">แฟ้มแขวน
			  <OPTION VALUE="แฟ้มโชว์เอกสาร">แฟ้มโชว์เอกสาร
			  <OPTION VALUE="ซองอเนกประสงค์">ซองอเนกประสงค์
			  <OPTION VALUE="แฟ้มเจาะ">แฟ้มเจาะ
			  <OPTION VALUE="แฟ้มซอง">แฟ้มซอง
			  <OPTION VALUE="ซองเอกสารพลาสติก">ซองเอกสารพลาสติก
				<OPTION VALUE="แฟ้มกระเป๋า">แฟ้มกระเป๋า
				<OPTION VALUE="แฟ้มหีบเพลง">แฟ้มหีบเพลง
				<OPTION VALUE="แฟ้มพับ">แฟ้มพับ
			  </SELECT><FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ยี่ห้อ :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="brand" size="20"><FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">รุ่น :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="sub" size="10"></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">สี :</TD>
	<TD bgcolor="#FFF0E1" ><SELECT NAME="color">
		<OPTION VALUE="1" SELECTED>==== สี ====
		<OPTION VALUE="ไม่ระบุสี" >ไม่ระบุสี
		<OPTION VALUE="ดำ">ดำ
		<OPTION VALUE="แดง">แดง
		<OPTION VALUE="น้ำเงิน">น้ำเงิน
		<OPTION VALUE="เขียว">เขียว
		<OPTION VALUE="ชมพู">ชมพู
		<OPTION VALUE="ฟ้า">ฟ้า
		<OPTION VALUE="น้ำตาล">น้ำตาล
		<OPTION VALUE="ส้ม">ส้ม
		<OPTION VALUE="เหลือง">เหลือง
		<OPTION VALUE="ม่วง">ม่วง
		<OPTION VALUE="เทา">เทา
		<OPTION VALUE="ครีม">ครีม
		<OPTION VALUE="ชา">ชา
		<OPTION VALUE="ขาว">ขาว
		<OPTION VALUE="ใส">ใส
		
			<OPTION VALUE="เงิน">เงิน
		<OPTION VALUE="ทึบ">ทึบ
		</SELECT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ราคา/หน่วย : </TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="price" size="10">บาท<FONT COLOR="#DF572D">****</FONT></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ขนาดกระดาษ:</TD>
	<TD bgcolor="#FFF0E1" ><SELECT NAME="paper_size">
	<OPTION VALUE="0" SELECTED>==== ขนาดกระดาษที่ใส่ ====
	<OPTION VALUE="A3">A3 (305x408)
	<OPTION VALUE="A4">A4 (216x302)
	<OPTION VALUE="B4">B4 (264x368)
	<OPTION VALUE="B5">B5 (184x262)
	<OPTION VALUE="F"> F
	<OPTION VALUE="สมุดเช็ค">สมุดเช็ค (265x138)
	<OPTION VALUE="ฟุลสแก็ป">ฟุลแก็ป (390x250)
	</SELECT> มม.</TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">ใส่กระดาษหนา:</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="thick" size="5">แผ่น/ซอง</TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">บรรจุ:</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="pack" size="5">ต่อแพ็ค</TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">รูป :</TD>
	<TD bgcolor="#FFF0E1" ><INPUT TYPE="text" NAME="pix" size="15"></TD>
</TR>
<TR>
	<TD bgcolor="#FFFFFF">รายละเอียดอื่นๆ :</TD>
	<TD bgcolor="#FFF0E1" ><TEXTAREA NAME="detail" ROWS="7" COLS="40"></TEXTAREA></TD>
</TR>
<TR bgcolor="#FFF0E1" valign="center" align="center">
	<TD colspan="2">
	<pre> <INPUT TYPE="submit" value="เพิ่มเติม"><INPUT TYPE="reset" value="เริ่มกรอกข้อมูลใหม่"></pre>
 	</TD>
</TR>
</TABLE>
</FORM>
</BODY>
</HTML>
