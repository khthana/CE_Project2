<SCRIPT  language="javascript">
now = new Date();
var thday = new Array ("อาทิตย์","จันทร์","อังคาร","พุธ","พฤหัสบดี","ศุกร์","เสาร์");
var thmonth = new Array ("มกราคม","กุมภาพันธ์","มีนาคม","เมษายน","พฤษภาคม","มิถุนายน","กรกฏาคม","สิงหาคม","กันยายน","ตุลาคม","พฤศจิกายน","ธันวาคม");
document.write("วัน" + thday[now.getDay()] + "ที่ "+ now.getDate()+ " " +thmonth[now.getMonth()]+"  " + (0+now.getYear()+543) + " เวลา " +now.getHours()+":"+now.getMinutes());
</SCRIPT>&nbsp;&nbsp;