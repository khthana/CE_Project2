import java.util.*;

public class  PO_collection{
	private Vector PO_vector;

	/** build empty PR**/

	public PO_collection() {
		PO_vector = new Vector();
	}

	public Vector getPo_vector() {
		return(PO_vector);
	}

	public void add(PO tmp) {
		PO_vector.add(tmp);
	}

	public void remove(int ii) {
		PO_vector.remove(ii);
	}
}