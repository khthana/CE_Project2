End

BeginScript
	WalkToXZ( -50  , 30 )   
	Fire()
	Fire()
	Fire()

	Crouch()
	CreepToXZ( -50,  40 )
	Fire()
	Fire()
	Fire()

	Sit()
	Fire()
	Fire()
	Fire()
	Fire()
	Fire()
	Fire()


        Stand()
        RunToXZ( -50 , 80 )
	Fire()
	Fire()
	Fire()
	Fire()
	Fire()
	Fire()

	
        RunToXZ( -50 , 0 )
	Fire()
	Fire()
	Fire()
    
End

EndFile
