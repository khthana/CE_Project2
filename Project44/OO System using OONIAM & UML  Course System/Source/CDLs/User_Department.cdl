class User.Department
{

	super = User.Dummy;

	persistent;

	parameter CLASSNAME { default = "Department"; not final; }

	attribute EnglishName { type = %Library.String; calculated = 0; not final; multidimensional = 0; public; not required; sqlcomputed = 0; transient = 0; }
	attribute IsOf { type = User.Faculty; calculated = 0; not final; multidimensional = 0; public; required; sqlcomputed = 0; transient = 0; }
	attribute ThaiName { type = %Library.String; calculated = 0; not final; multidimensional = 0; public; not required; sqlcomputed = 0; transient = 0; }


	query QueryCourseCount((deptid:User.Department))
	{
		type = %Library.SQLQuery(CONTAINID=1,ROWSPEC="CourseCnt:%Library.String"); 
		sqlquery =
		[
			:SELECT Count(*) AS CourseCnt
			:FROM Course
			:WHERE (IsOf = :deptid)
			
		]
		sqlproc = 0;
		sqlview = 0;
	}

	query QueryDetails(())
	{
		type = %Library.SQLQuery(CONTAINID=1,ROWSPEC="ID,ThaiName:%Library.String,EnglishName:%Library.String"); 
		sqlquery =
		[
			:SELECT ID, ThaiName, EnglishName
			:FROM Department
			:ORDER BY ThaiName
		]
		sqlproc = 0;
		sqlview = 0;
	}

	query QueryIsOf((facID:User.Faculty))
	{
		type = %Library.SQLQuery(CONTAINID=1,ROWSPEC="ID,ThaiName:%Library.String,EnglishName:%Library.String"); 
		sqlquery =
		[
			:SELECT ID, ThaiName, EnglishName
			:FROM Department
			:WHERE (IsOf = :facID)
			:ORDER BY ThaiName
		]
	}

	query QuerySubjectCount((depid:User.Department))
	{
		type = %Library.SQLQuery(CONTAINID=0,ROWSPEC="SubjectCnt:%Library.String"); 
		sqlquery =
		[
			:SELECT Count(*) AS SubjectCnt
			:FROM Subject
			:WHERE (IsOf = :depid)
		]
		sqlproc = 0;
		sqlview = 0;
	}

	storage Default
	{
		type = %Library.CacheStorage;
		defaultdata = DepartmentDefaultData;
		data CourseBachelors
		{
			structure = subnode;
			value = CourseBachelors;
			subscript = "CourseBachelors";
		}
		data CourseDoctors
		{
			structure = subnode;
			value = CourseDoctors;
			subscript = "CourseDoctors";
		}
		data CourseMasters
		{
			structure = subnode;
			value = CourseMasters;
			subscript = "CourseMasters";
		}
		data DepartmentDefaultData
		{
			structure = listnode;
			subscript = "Department";
			value (1)  = EnglishName;
			value (2)  = ThaiName;
			value (3)  = DepartmentOf;
			value (4)  = Faculty;
			value (5)  = IsOf;
		}
	}

}
