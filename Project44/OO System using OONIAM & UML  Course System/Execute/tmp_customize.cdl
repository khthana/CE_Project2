		[
			quit "Do you want to delete :"_..Thai.Name_" ?"
		]
	}


	query QueryDetails(())
	{
		type = %Library.SQLQuery(CONTAINID=1,ROWSPEC="ID,Name:%Library.String,Name:%Library.String,CourseLevel:%Library.TinyInt"); 
		sqlquery =
		[
			:SELECT ID, Thai_Name, English_Name, CourseLevel
			:FROM CourseBachelor
			:ORDER BY CourseLevel
		]
		sqlproc = 0;
		sqlview = 0;
	}

	query QueryIsOf((departmentid:User.Department))
	{
		type = %Library.SQLQuery(CONTAINID=1,ROWSPEC="ID,Name:%Library.String,Name:%Library.String,CourseLevel:%Library.TinyInt"); 
		sqlquery =
		[
			:SELECT ID, Thai_Name, English_Name, CourseLevel
			:FROM CourseBachelor
			:WHERE (IsOf = :departmentid)
			:ORDER BY CourseLevel
		]
		sqlproc = 0;
		sqlview = 0;
	}

	storage Default
	{
		type = %Library.CacheStorage;
		defaultdata = CourseBachelorDefaultData;
		data CourseBachelorDefaultData
		{
			structure = listnode;
			subscript = "CourseBachelor";
			value (1)  = ParentCourse;
		}
	}

}
