class User.TestCustomize
{

	super = User.CourseBachelor;

	persistent;

	parameter CLASSNAME { default = "User.CourseBachelor"; not final; }
	parameter Level { default = "1"; not final; }
	parameter PARENTCLASSNAME { default = "User.Course"; not final; }

	attribute CourseLevel { type = %Library.TinyInt; calculated = 0; not final; initialexpression = 1; multidimensional = 0; public; required; sqlcomputed = 0; transient = 0; }
	attribute ParentCourse { type = User.CourseBachelor; calculated = 0; not final; multidimensional = 0; public; not required; sqlcomputed = 0; transient = 0; }

	method Examine(studentid:%Library.String,courseid:%Library.String,min1:%Library.Float,min2:%Library.Float)
	{
		returntype = %Library.Integer;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			new avgMajor,avgAll
			new cnt,cntC
			&sql(	SELECT COUNT(*) INTO :cnt
					FROM uGRADE
					WHERE Grade->Weight = 0
					AND StudentId->Id = :studentid)
			quit:cnt>0 0
			&sql(	SELECT COUNT(*) INTO :cntC
					FROM uGrade
					WHERE StudentId->Id = :studentid
					AND Grade->Weight < 2
					AND SubjectId->Id IN
						(SELECT Subjects
						 FROM SQLUser.SubjectGrp_Subjects
						 WHERE SubjectGrp IN
							(SELECT SubjectGrps
							 FROM SQLUser.Category_SubjectGrps
							 WHERE Category IN
								(SELECT Categories
								 FROM SQLUser.Course_Categories
								 WHERE Course = :courseid
								 AND element_key = 2
								 )
							)
						)
					)
			quit:cntC>0 0
			&sql(	SELECT 1.00*(SUM(SubjectId->Credit*Grade->Weight)/SUM(SubjectId->Credit)) INTO :avgMajor
					FROM uGrade
					WHERE StudentId->Id = :studentid
					AND SubjectId->Id IN
						(SELECT Subjects
						 FROM SQLUser.SubjectGrp_Subjects
						 WHERE SubjectGrp IN
							(SELECT SubjectGrps
							 FROM SQLUser.Category_SubjectGrps
							 WHERE Category IN
								(SELECT Categories
								 FROM SQLUser.Course_Categories
								 WHERE Course = :courseid
								 AND element_key = 2
								 )
							)
						)
					)
			quit:avgMajor<min1 0
			&sql(	SELECT 1.00*(SUM(SubjectId->Credit*Grade->Weight)/SUM(SubjectId->Credit)) INTO :avgAll
					FROM uGrade
					WHERE StudentId->Id = :studentid
					AND SubjectId->Id IN
						(SELECT Subjects
						 FROM SQLUser.SubjectGrp_Subjects
						 WHERE SubjectGrp IN
							(SELECT SubjectGrps
							 FROM SQLUser.Category_SubjectGrps
							 WHERE Category IN
								(SELECT Categories
								 FROM SQLUser.Course_Categories
								 WHERE Course = :courseid
								 )
							)
						)
					)
			quit:avgAll<..MinAvg 0
			quit 1
		]
	}

	method PrepareDeleting()
	{
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			quit
		]
	}

