'*ใช้ส่ง message เมื่อมีการคลิกปุ่ม send โดยถูกเรียกจาก send
Sub SendDisplay(text_t As String) '*text_t ใช้รับค่า text ที่ส่งมาจาก send
    Dim i As Integer
    Dim l As Integer '*เก็บค่าความยาวของข้อความที่จะส่ง
    Dim ch As String
    l = Len(text_t)
    For i = 1 To l
            ch = Mid(text_t, i, 1)
            '*ถ้า ch เป็นตัวอักษรพิเศษใน sendkeys ต้องแปลง ch  ก่อน
            Select Case ch
                Case "{": ch = "{{}"
                Case "}": ch = "{}}"
                Case "[": ch = "{[}"
                Case "]": ch = "{]}"
                Case "~": ch = "{~}"
                Case "+": ch = "{+}"
                Case "^": ch = "{^}"
                Case "%": ch = "{%}"
            End Select
            SendKeys ch
    Next i
End Sub


' ** send text in displat to active window
Private Sub B_send_Click()
    Call SetForegroundWindow(m_hwnd)
    Call StayOnTop(Me.hwnd, True)
    text = TxDisplay.text
    Call SendDisplay(text)
    
    '*ตรวจสอบว่าเป็นคำที่มีอยู่ใน history หรือไม่ ถ้าไม่มีจะเพิ่มไว้ใน list
    If TxDisplay.text <> "" Then
        found_history = Check_history(text)
        If Not found_history Then
            TxDisplay.AddItem (text)  '*เพิ่มคำไว้ใน list
            Call AdodcHis.Recordset.AddNew("History", text)
        End If
        TxDisplay.text = ""
    End If
End Sub

' *********************************************************
' ***** Function of command Control Char Button ******
' *****  T/E, Shift, Caps, Crtl, Alt, Enter, win, tab    ******
' *********************************************************

' **Coloum 1 clicked => T/E, Tab, Capslock, Shift, Ctrl, win, Alt
Private Sub B_co1_Click(Index As Integer)
    Call SetForegroundWindow(m_hwnd)

    Select Case Index
        Case 0: 'key Thai/Eng pressed
            'สั่งกด Alt + Shift เพื่อเปลี่ยนภาษาที่ Taskbar
            'Call keybd_event(vbKeyMenu, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press
            'Call keybd_event(vbKeyShift, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press
            'Call keybd_event(vbKeyShift, 0, KEYEVENTF_KEYUP, 0)   ' release
            'Call keybd_event(vbKeyMenu, 0, KEYEVENTF_KEYUP, 0)   ' release
            'เพื่อความมั่นใจสั่งกด {'} อีกครั้ง ' = 126
            Call keybd_event(126, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press n
            Call keybd_event(126, 0, KEYEVENTF_KEYUP, 0)   ' release n
            
            '*สั่งกด Ctrl + Shift เพื่อเปลี่ยนภาษาที่ Taskbar
'            Call keybd_event(vbKeyControl, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press
'            Call keybd_event(vbKeyShift, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press
'            Call keybd_event(vbKeyShift, 0, KEYEVENTF_KEYUP, 0)   ' release
'            Call keybd_event(vbKeyControl, 0, KEYEVENTF_KEYUP, 0)   ' release
            
            thai = Not thai
            If thai Then SetKeyThai Else SetKeyEng
        Case 1: 'key Tab pressed
            Call SetControlKey '*ตรวจสอบการกดปุ่ม ctrl alt shift ก่อน
            Call keybd_event(vbKeyTab, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press n
            Call keybd_event(vbKeyTab, 0, KEYEVENTF_KEYUP, 0)   ' release n
            Call ClrControlKey '* clear การกด ctrl alt shift
        Case 2: 'key capslock pressed
            Call keybd_event(vbKeyCapital, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press n
            Call keybd_event(vbKeyCapital, 0, KEYEVENTF_KEYUP, 0)   ' release n
            capslock = Not capslock
            If capslock Then
                LabelCaps.ForeColor = vbBlack
                If thai Then SetKeyShiftThai Else SetKeyShiftEng
            Else
                LabelCaps.ForeColor = vbWhite
                If thai Then SetKeyThai Else SetKeyEng
            End If
        Case 3: 'key shift pressed
            If Shift Then
                Shift = False
            Else
                Shift = True
                If thai Then SetKeyShiftThai Else SetKeyShiftEng
            End If
        Case 4: 'key Ctrl pressed
            If ctrl <> True Then
                LabelCtrl.ForeColor = vbBlack
                ctrl = True
            Else
                LabelCtrl.ForeColor = vbWhite
                ctrl = False
            End If
        Case 5: 'key start press
            Call keybd_event(vbKeyControl, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press n
            Call keybd_event(vbKeyEscape, 0, KEYEVENTF_KEYUP, 0)   ' release n
            Call keybd_event(vbKeyEscape, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press n
            Call keybd_event(vbKeyControl, 0, KEYEVENTF_KEYUP, 0)   ' release n
        Case 6: 'key alt
            If alt <> True Then
                LabelAlt.ForeColor = vbBlack
                alt = True
            Else
                LabelAlt.ForeColor = vbWhite
                alt = False
            End If
            Call SetForegroundWindow(m_hwnd)
            Call keybd_event(vbKeyMenu, 0, KEYEVENTF_EXTENDEDKEY, 0)     'press
            Call keybd_event(vbKeyMenu, 0, KEYEVENTF_KEYUP, 0)   ' release
    End Select
End Sub


' **Coloum 2 clicked => backspace
Private Sub B_co2_Click(Index As Integer)
    Call SetForegroundWindow(m_hwnd)
    Call StayOnTop(Me.hwnd, True)
    Select Case Index
        Case 0: 'backspace pressed
            Call SetControlKey '*ตรวจสอบการกดปุ่ม ctrl alt shift ก่อน
            Call keybd_event(vbKeyBack, 0, KEYEVENTF_EXTENDEDKEY, 0)     'press
            Call keybd_event(vbKeyBack, 0, KEYEVENTF_KEYUP, 0)   ' release
            Call ClrControlKey '* clear การกด ctrl alt shift
            
            text = TxDisplay.text
            If text <> "" Then
                text = Left(text, Len(text) - 1)
                TxDisplay.text = text
            End If
            
        Case 1: 'enter pressed
            Call SetControlKey '*ตรวจสอบการกดปุ่ม ctrl alt shift ก่อน
            Call keybd_event(vbKeyReturn, 0, KEYEVENTF_EXTENDEDKEY, 0)     'press
            Call keybd_event(vbKeyReturn, 0, KEYEVENTF_KEYUP, 0)   ' release
            Call ClrControlKey '* clear การกด ctrl alt shift
        Case 2: 'shift pressed
            B_co1_Click (3)
        Case 3: 'crtl pressed
            B_co1_Click (4)
        Case 4: 'start pressed
            B_co1_Click (5)
        Case 5: 'alt pressed
            B_co1_Click (6)
    End Select
End Sub

'******************************************************************************************
'******************************************************************************************
'   ***************                     Group function Auto fill                       ********************
'******************************************************************************************
Function Check_history(text_t As String) As Boolean
    Dim i As Integer
    For i = 1 To TxDisplay.ListCount
        If text_t = TxDisplay.List(i) Then
            Check_history = True
            Exit Function
        End If
    Next i
    Check_history = False
End Function

