    B_numc(5).BackColor = ColorNumlock
End Sub

'* สีเริ่มต้นที่กำหนด
Sub SetColorDefault()
    ColorForm = &H80000001
    ColorEsc = &HFFFF80
    ColorPrint = &H94D885
    ColorTab = &H80FF&
    ColorChar = &H80C0FF
    ColorSpace = &HC0FFFF
    ColorInsert = &HC0FFFF
    ColorNum = &H80FF80
    ColorOperator = &H8080FF
    ColorNumlock = &H80ABD7
End Sub


'* วน check ากรเปลี่ยนแปลงค่าต่างๆของเมาส์และปุ่ม
Private Sub TimerUpdateSetting_Timer()
    If Change = True Then
        Call SetNewValue
        Change = False
    End If
    If Change_col = True Then
        Call SetColorForm
        Call SetColorEsc
        Call SetColorPrint
        Call SetColorTab
        Call SetColorChar
        Call SetColorSpace
        Call SetColorInsert
        Call SetColorNum
        Call SetColorOperator
        Call SetColorNumlock
        Change_col = False
    End If
    If Change_ComPort = True Then
        MSComm1.PortOpen = False
        If ComPort = "1" Then
            MSComm1.CommPort = 1
        Else
            MSComm1.CommPort = 2
        End If
        MSComm1.PortOpen = True
        Change_ComPort = False
    End If
    If Change_History = True Then
        Call LoadListHistory
        Change_History = False
    End If
    If Change_Pg = True Then
        '* ตรวจว่ามีหรือไม่แล้วดูว่ามีใน combo หรือยัง
        If CheckProgram Then
            Call LoadListProgram
        End If
        Change_Pg = False
    End If
End Sub

Function CheckProgram() As Boolean
    Dim filename_t, fname, fpath, fname_t, fpath_t, ch As String
    Dim i, l As Integer
    'หาดูว่ามีโปรแกรมนี้หรือยัง
    filename_t = LabelPG.Caption
    fname_t = LabelPGname.Caption

    LabelPG.Caption = ""
    If AdodcProgram.Recordset.MaxRecords <> 0 Then
        AdodcProgram.Recordset.MoveFirst
        AdodcProgram.Recordset.Find "Path = '" & filename & "'"
    End If
    
    '* ถ้ามี
    If LabelPG.Caption <> "" Then
        CheckProgram = False
        fpath = LabelPG.Caption
    Else 'ถ้าไม่มีให้เพิ่มลงใน combo และ database
        CheckProgram = True
        l = Len(filename)
        ch = Mid(filename, l, 1)
        Do While ch <> "\" 'หาชื่อไฟล์
            l = l - 1
            fname = ch & fname
            ch = Mid(filename, l, 1)
        Loop
        If Len(filename_t) <> 0 Then
            LabelPG.Caption = filename_t
            LabelPGname.Caption = fname_t
            AdodcProgram.Recordset.AddNew
            AdodcProgram.Recordset("Program") = fname
            AdodcProgram.Recordset("Path") = filename
            AdodcProgram.Recordset.Update
        Else
            AdodcProgram.Recordset("Program") = fname
            AdodcProgram.Recordset("Path") = filename
            AdodcProgram.Recordset.AddNew
        End If
    End If
    Shell filename, vbNormalFocus
End Function

'* จะ check ที่ port ว่าม่สัญญาณเข้ามาหรือไม่
Private Sub MSComm1_OnComm()
    Dim ch As String
    Dim i As Integer
    Dim MaxSpeed_t As Double
    Dim sleeptime_t As Double
    ch = MSComm1.Input
    Port_Input = Chr(Asc(ch))
'    Port_Input = Chr(Asc(MSComm1.Input))
    sleeptime_t = SleepTime
    SleepTime = SleepTime * 0
    Call MoveMouseCursor2
    MaxSpeed_t = MaxSpeed
    For i = 1 To 10
        MaxSpeed = MaxSpeed * 20
        Call DoneMoveCursor
    Next i
    MaxSpeed = MaxSpeed_t
    SleepTime = sleeptime_t
End Sub


'* check ค่าที่ได้รับจาก port แล้วเคลื่อนเมาส์
Sub MoveMouseCursor2() ' Start sub
    Dim Count As Integer ' For-next counter
            If Port_Input = "2" Then
                UpDownFlag = True
            ElseIf Port_Input = "1" Then
                LeftRightFlag = True
            Else
                UpDownFlag = False
                LeftRightFlag = False
            End If
            
            If UpDownFlag Then
                Direction = CheckPortUpDown
            ElseIf LeftRightFlag Then
                Direction = CheckPortLeftRight
            Else
                '*clear direction
                If Direction <> "0000" Then
                    OldDirection = Direction
                    Direction = "0000"
                End If
            End If
                
            '*สั่งให้เลื่อนตำแหน่งเมาส์
            Call DoneMoveCursor
    
End Sub


Function CheckPortLeftRight() As String
    Dim click_temp As Boolean '*เก็บ click ก่อน CheckDirection ถ้าไม่มีการกดปุ่ม
        If Port_Input = "1" Then
            TimerPort.Enabled = False
            If StateKeyMoveMouse = True Then 'ถ้ามีการกดมาครั้งหนึ่งแล้ว
                StateKeyMoveMouse = False '* reset StateKeyMoveMouse
                If ((TimerDelayDbPort >= MinTimeDbPort) And (TimerDelayDbPort <= MaxTimeDbPort)) Then 'ถ้ากดอีกครั้งในช่วงเวลาที่กำหนด
                    click = False
                    db = True 'กดในเวลาถือว่าเป็น double click
                    LeftFlag = Not LeftFlag '* กลับทิศ ซ้าย-ขวา
                Else
                    click = True ' กดเกินเวลาถือว่าเป็นคลิกอีกครั้งไม่ติดกัน
                    StateKeyMoveMouse = True ' กำหนดสถานะถือว่าเป็นการกดครั้งใหม่
                End If
                '* ตรวจสอบ directtion แล้วส่งค่า direction กลับ
                Call CheckDirection
                CheckPortLeftRight = Direction
                TimerDelayDbPort = 0 '* ลบค่า TimerDelayDbPort เพราะเพื่อตรวจจับ double click ครั้งต่อไป
                db = False '* เพื่อตรวจจับ double click ครั้งต่อไป
            Else 'ถ้าเพิ่งกดครั้งแรก (StateKeyUpDown=false)
                StateKeyMoveMouse = True  'ไว้บอกสถานะว่าเคยกดแล้วเพื่อใช้ตรวจสอบกับการกดครั้งที่ 2
                click = True  'ให้ถือว่าเป็นการคลิกธรรมดาก่อน
                Call CheckDirection
                CheckPortLeftRight = Direction
            End If

            If StateKeyMoveMouse = True Then
                TimerDelayDbPort = 0
                TimerPort.Enabled = True
            End If
        Else 'ถ้าไม่ได้กดปุ่มให้ clear click ก่อนแล้วเรียก CheckDirection
            Call CheckDirection
            CheckPortLeftRight = Direction
        End If
End Function


Function CheckPortUpDown() As String
    Dim click_temp As Boolean '*เก็บ click ก่อน CheckDirection ถ้าไม่มีการกดปุ่ม
        If Port_Input = "2" Then
            TimerPort.Enabled = False
            If StateKeyMoveMouse = True Then 'ถ้ามีการกดมาครั้งหนึ่งแล้ว
                StateKeyMoveMouse = False '* reset StateKeyMoveMouse
                If ((TimerDelayDbPort >= MinTimeDbPort) And (TimerDelayDbPort <= MaxTimeDbPort)) Then 'ถ้ากดอีกครั้งในช่วงเวลาที่กำหนด
                    click = False
                    db = True 'กดในเวลาถือว่าเป็น double click
                    UpFlag = Not UpFlag '* กลับทิศทาง บน-ล่าง
                Else
                    click = True ' กดเกินเวลาถือว่าเป็นคลิกอีกครั้งไม่ติดกัน
                    StateKeyMoveMouse = True ' กำหนดสถานะถือว่าเป็นการกดครั้งใหม่
                End If
                '* ตรวจสอบ directtion แล้วส่งค่า direction กลับ
                Call CheckDirection
                CheckPortUpDown = Direction
                TimerDelayDbPort = 0 '* ลบค่า TimerDelayDbPort เพราะเพื่อตรวจจับ double click ครั้งต่อไป
                db = False '* เพื่อตรวจจับ double click ครั้งต่อไป
            Else 'ถ้าเพิ่งกดครั้งแรก (StateKeyUpDown=false)
                StateKeyMoveMouse = True  'ไว้บอกสถานะว่าเคยกดแล้วเพื่อใช้ตรวจสอบกับการกดครั้งที่ 2
                click = True  'ให้ถือว่าเป็นการคลิกธรรมดาก่อน
                Call CheckDirection
                CheckPortUpDown = Direction
            End If

            If StateKeyMoveMouse = True Then
                TimerDelayDbPort = 0
                TimerPort.Enabled = True
            End If
        Else 'ถ้าไม่ได้กดปุ่มให้ clear click ก่อนแล้วเรียก CheckDirection
            Call CheckDirection
            CheckPortUpDown = Direction
        End If
End Function

Sub LoadListProgram()
    Dim all_word As Long
    Dim i As Long
        ComboProgram.Clear
        ComboProgram.AddItem ("เลือกโปรแกรม..")
        
        all_word = AdodcProgram.Recordset.RecordCount
        If all_word > 1 Then
            AdodcProgram.Recordset.MoveFirst
            For i = 1 To all_word
                ComboProgram.AddItem (AdodcProgram.Recordset.Fields.Item(1).Value)
                AdodcProgram.Recordset.MoveNext
            Next i
            AdodcProgram.Recordset.MoveFirst
        End If
End Sub

