' *********************************************************
' ***** Function send Char when click Char Button *****
' *********************************************************

'** Char row 1
Private Sub B_r1_Click(Index As Integer)
    ch = B_r1(Index).Caption
    Call SendChar(ch)
End Sub

'** char row 2
Private Sub B_r2_Click(Index As Integer)
    ch = B_r2(Index).Caption
    Call SendChar(ch)
End Sub

'** char row 3
Private Sub B_r3_Click(Index As Integer)
    ch = B_r3(Index).Caption
    Call SendChar(ch)
End Sub

'** char row 4
Private Sub B_r4_Click(Index As Integer)
    ch = B_r4(Index).Caption
    Call SendChar(ch)
End Sub

'** Char spacebar
Private Sub B_space_Click()
    ch = " "
    Call SendChar(ch)
End Sub

' ** Numpad 0-9 and '.'
Private Sub B_num_Click(Index As Integer)
    ch = B_num(Index).Caption
    Call SendChar(ch)
End Sub

' ** Numpad operator and enter
Private Sub B_numc_Click(Index As Integer)
    '*index 0-5 เป็นเครื่องหมายคณิตศาสตร์
    If (Index > 0) And (Index < 5) Then
        ch = B_numc(Index).Caption
        Call SendChar(ch)
    Else
          '* Numlock pressed
        If Index = 0 Then
            Call keybd_event(vbKeyNumlock, 0, KEYEVENTF_KEYUP, 0)   ' release n
            Call keybd_event(vbKeyNumlock, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press n
          '*if enter pressed
        ElseIf Index = 5 Then B_co2_Click (1)
        End If
    End If
End Sub

'***************************** Send char to active window **************************
'* ส่งตัวอักษรไปยัง active window และแสดงที่ txDisplay ด้วย
Sub SendChar(ch As String)
    '* m -> m_hwnd, tx -> txdisplay, parent -> parent hwnd
    Dim tx_hwnd, parent_m, parent_pm As Long
    tx_hwnd = TxDisplay.hwnd
    parent_m = GetParent(m_hwnd)
    parent_pm = GetParent(parent_m)
    Call SetForegroundWindow(m_hwnd)
    Call StayOnTop(Me.hwnd, True)
    
    If (Not ctrl) And (Not alt) Then
        '*ส่ง char ไปที่ display ของ form
        text = TxDisplay.text & ch     '*code เก่า
        TxDisplay.text = text              '*code เก่า
        
        '*ส่ง char ไป active window โดยตรวจสอบก่อนว่าไม่ใช่ TxDisplay
        If ((tx_hwnd <> m_hwnd) And (tx_hwnd <> parent_m) And (tx_hwnd <> parent_pm)) Then
            'PostMessage m_hwnd, &H102, Asc(ch), 0  '*old code
            Call SetForegroundWindow(m_hwnd)
                '*ถ้า ch เป็นตัวอักษรพิเศษใน sendkeys ต้องแปลง ch  ก่อน
            Select Case ch
                Case "{": ch = "{{}"
                Case "}": ch = "{}}"
                Case "[": ch = "{[}"
                Case "]": ch = "{]}"
                Case "~": ch = "{~}"
                Case "+": ch = "{+}"
                Case "^": ch = "{^}"
                Case "%": ch = "{%}"
            End Select
            SendKeys ch
        End If
    End If
    
    '**set key function ต่างๆให้กลับเหมือนเดิม
    Call EscapeFunctionKey(ch)
    
End Sub

Sub EscapeFunctionKey(ch As String)
    
    '*set key กลับเหมือนเดิมในกรณีที่มีการกด shift เพื่อคลาย shift
    If Shift Then
        If thai Then SetKeyThai Else SetKeyEng
        Call keybd_event(vbKeyShift, 0, KEYEVENTF_KEYUP, 0)
        Shift = False
    End If
    
    '*ตรวจสอบว่ามีการกด ctrl หรือ alt หรือไม่
    If ctrl Or alt Then
        Dim ch_code As Integer
        ch_code = Asc(ch) 'แปลงเอาค่า Ascii ของตัวอักษร
           '*a-z จะมีค่าแอสกี 97-122 ต้องลบ 32 เพื่อเป็นค่าแอสกีของ A-Z ซึ่งนำมาใช้เป็น vbkey
        If ch_code > 90 Then ch_code = ch_code - 32
        
        If ctrl Then Call keybd_event(vbKeyControl, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press ctrl
        If alt Then Call keybd_event(vbKeyMenu, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press Alt
        '* clear flag of Ctrl and Alt
        ctrl = False
        alt = False
        Call keybd_event(ch_code, 0, KEYEVENTF_EXTENDEDKEY, 0)
        Call keybd_event(ch_code, 0, KEYEVENTF_KEYUP, 0)
        Call keybd_event(vbKeyControl, 0, KEYEVENTF_KEYUP, 0)
        Call keybd_event(vbKeyMenu, 0, KEYEVENTF_KEYUP, 0)
        LabelCtrl.ForeColor = vbWhite
        LabelAlt.ForeColor = vbWhite
    Else
    End If '*ctrl and alt

End Sub

' ** set control key Ctrl Alt Shift **'
Sub SetControlKey()
    '*ถ้ามีการกด ctrl
    If ctrl Then Call keybd_event(vbKeyControl, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press Ctrl
    '*ถ้ามีการกด alt
    If alt Then Call keybd_event(vbKeyMenu, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press Alt
    '*ถ้ามีการกด shift
    If Shift Then Call keybd_event(vbKeyShift, 0, KEYEVENTF_EXTENDEDKEY, 0) 'press shift
End Sub

' ** clear cintrol key Ctrl Alt Shift
Sub ClrControlKey()
    '* clear การกด ctrl alt shift
    ctrl = False
    alt = False
    Shift = False
    Call keybd_event(vbKeyControl, 0, KEYEVENTF_KEYUP, 0)   ' release ctrl
    Call keybd_event(vbKeyMenu, 0, KEYEVENTF_KEYUP, 0)   ' release Alt
    Call keybd_event(vbKeyShift, 0, KEYEVENTF_KEYUP, 0) ' release Shift
    LabelCtrl.ForeColor = vbWhite
    LabelAlt.ForeColor = vbWhite
End Sub

' ** send function key -> f1-f2, esc, home  ect.
Sub send_function_key(fKey As Byte)
    TextHistory.Visible = False
    Call SetForegroundWindow(m_hwnd)
    Call StayOnTop(Me.hwnd, True)

    Call SetControlKey  ' ** set control key Ctrl Alt Shift

    Call keybd_event(fKey, 0, KEYEVENTF_EXTENDEDKEY, 0)    ' press
    Call keybd_event(fKey, 0, KEYEVENTF_KEYUP, 0)   ' release
    
    Call ClrControlKey '* clear การกด ctrl alt shift
    
End Sub

