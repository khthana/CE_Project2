'**** ส่ง mouse event โดยตรวจดูค่า option  ของ FrameMouseEvent
Private Sub DoMouseEvent()
    
    'ถ้า option คือ left mouse
    If Op_mouse_left.Value = True Then
        If Op_click.Value = True Then
            mouse_click = True
            mouse_press_left
            mouse_release_left
        ElseIf Op_dbclick.Value = True Then
            mouse_click = True
            mouse_press_left
            mouse_release_left
            mouse_press_left
            mouse_release_left
            Op_click = True 'ตั้งให้กลับไปทำ click mouse
        ElseIf Op_drag.Value = True Then
            If mouse_drag = False Then
                mouse_drag = True
                mouse_click = True
                mouse_press_left  ' กด mouse ค้างไว้
            Else
                mouse_drag = False
                mouse_release_left 'คลาย mouse
                Op_click = True 'ตั้งให้กลับไปทำ click mouse
            End If
        End If
    'ถ้า option คือ right mouse
    ElseIf Op_mouse_right.Value = True Then
        If Op_click.Value = True Then
            mouse_click = True
            mouse_press_right
            mouse_release_right
            Op_mouse_left.Value = True 'ตั้งให้กลับไปทำที่ left mouse เหมือนเดิม
        ElseIf Op_dbclick.Value = True Then
            mouse_click = True
            mouse_press_right
            mouse_release_right
            mouse_press_right
            mouse_release_right
            Op_click = True 'ตั้งให้กลับไปทำ click mouse
            Op_mouse_left.Value = True 'ตั้งให้กลับไปทำที่ left mouse เหมือนเดิม
        ElseIf Op_drag.Value = True Then
            If mouse_drag = False Then
                mouse_drag = True
                mouse_click = True
                mouse_press_right  ' กด mouse ค้างไว้
            Else
                mouse_drag = False
                mouse_release_right 'คลาย mouse
                Op_click = True 'ตั้งให้กลับไปทำ click mouse
                Op_mouse_left.Value = True 'ตั้งให้กลับไปทำที่ left mouse เหมือนเดิม
            End If
        End If
    End If
End Sub

'**** Timer จับเวลาเพื่อส่ง event คลิกเมาส์
Private Sub TimerClickMouse_Timer()
    Dim ProgStep As Integer
    Dim position_temp As POINTAPI  '* เก็บค่าตำแหน่งปัจจุบันของเมาส์
    'ตรวจดูว่าระหว่างจับเวลาเพื่อคลิกเมาส์มีการเลือ่นเมาส์หรือไม่
    Call GetCursorPos(position_temp)
    If ((position_temp.X <> mouse_position.X) Or (position_temp.Y <> mouse_position.Y)) Then
        '*เมื่อเมาส์เคลื่อน
        pgbMyBar.Value = 0 '* reset progress bar
        TimerLoopMousemove.Enabled = True '*เริ่มวนลูปตรวจการเคลื่อนที่แล้วหยุดของเมาส์อีกครั้ง
        TimerClickMouse.Enabled = False '*หยุดการจับเวลาคลิกเมาส์
        Exit Sub
    End If
    ProgStep = mouse_click_period 'กำหนด Step  ของ progress bar
    pgbMyBar.Max = mouse_click_period * 3 'กำหนด max ของ progress bar
    pgbMyBar.Value = pgbMyBar.Value + ProgStep '*เพิ่ม progress bar อีก 1 Step
    If pgbMyBar.Value >= pgbMyBar.Max Then
    pgbMyBar.Value = 0
    Call DoMouseEvent '*ส่ง mouse event
    TimerLoopMousemove.Enabled = True '*เริ่มวนลูปตรวจการเคลื่อนที่แล้วหยุดของเมาส์อีกครั้ง
    TimerClickMouse.Enabled = False '*หยุดจับเวลาการคลิกเมาส์
    End If
End Sub

'**** timer วนตรวจว่า เมาส์เคลื่อนที่หรือไม่ ถ้าหยุดเคลื่อนที่แล้วให้เรียก TimerClickMouse
Private Sub TimerLoopMousemove_Timer()
    Dim position_temp As POINTAPI  '* เก็บค่าตำแหน่งปัจจุบันของเมาส์
    mouse_stop = False
    Call GetCursorPos(position_temp)
    If ((position_temp.X <> mouse_position.X) Or (position_temp.Y <> mouse_position.Y)) Then
            Do Until (mouse_stop) '*วนลูปจนกว่า mouse จะหยุด
                mouse_position = position_temp
                Sleep (150)
                Call GetCursorPos(position_temp)
                If ((position_temp.X = mouse_position.X) And (position_temp.Y = mouse_position.Y)) Then mouse_stop = True
            Loop
            TimerClickMouse.Enabled = True  '*จับเวลาเพื่อคลิกเมาส์
            TimerLoopMousemove.Enabled = False '*หยุดทำงานจนกว่าจะ คลิกเมาส์ หรือ มีการเลือ่นเมาส์
    End If
End Sub

