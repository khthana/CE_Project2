Attribute VB_Name = "FormMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Sub SpyWindow()
    Dim lHwnd As Long 'temp hwnd
    lHwnd = 0
    Do
         '* ตรวจการกดปุ่มเลื่อน mouse cursor
        Call MoveMouseCursor
        '*ถ้าคลิกเมาส์ให้เรียก Trackmouse เพื่อหา hwnd จาก mouse position
        If (GetAsyncKeyState(vbKeyLButton) Or mouse_click) Then
            mouse_click = False
            lHwnd = TrackMouse(lHwnd)
        End If
        If gbCancle = True Or lHwnd = 0 Then Exit Do
        
         '*ตรวจสอบว่า hwnd ที่ได้มาเป็นของ form ของ Assistive browser หรือไม่
        If (lHwnd <> form_hwnd) And (GetParent(lHwnd) <> form_hwnd) Then
            old_hwnd = m_hwnd '*เก็บค่าเก่าก่อนเปลี่ยน
            m_hwnd = lHwnd
            lbHwnd.Caption = lHwnd
        End If
        DoEvents
    Loop
End Sub


Private Sub B_clear_Click()
    TxDisplay.text = ""
End Sub

Private Sub B_CutCopy_Click(Index As Integer)
    Call SetForegroundWindow(m_hwnd)
    Call StayOnTop(Me.hwnd, True)
    ctrl = True
    Select Case Index
        Case 0: 'SendKeys ("^X") '* ตัด    ^ = ctrl
            SendChar ("x")
        Case 1: 'SendKeys ("^C") '* คัดลอก
            SendChar ("c")
        Case 2: 'SendKeys ("^V") '* วาง
            SendChar ("v")
    End Select
End Sub

Private Sub B_exit_Click()
        gbCancle = True
        Unload Me
End Sub

Private Sub cmdResize_Click()
    If cmdResize.Caption = "<<ย่อ" Then
        cmdResize.Caption = "ขยาย>>"
        FormMain.Width = 7000
        cmdResize.Left = FrameTask.Width - cmdResize.Width * 1.15
        B_exit.Left = cmdResize.Left - B_exit.Width
        '* ย้าย process bar และ mouse control
        pgbMyBar.Top
        '* ซ่อน image move window
        Image1.Visible = False
        Image2.Visible = False
        Image3.Visible = False
        Image4.Visible = False
        Image6.Visible = False
        Image7.Visible = False
        Image8.Visible = False
        Image9.Visible = False
        '* ซ่อน Menu
        mAbout.Visible = False
    Else
        cmdResize.Caption = "<<ย่อ"
        FormMain.Width = 9750
        cmdResize.Left = FrameTask.Width - cmdResize.Width * 1.1
        B_exit.Left = cmdResize.Left - B_exit.Width
        '* ซ่อน image move window
        Image1.Visible = True
        Image2.Visible = True
        Image3.Visible = True
        Image4.Visible = True
        Image6.Visible = True
        Image7.Visible = True
        Image8.Visible = True
        Image9.Visible = True
        '* ซ่อน Menu
        mAbout.Visible = True
    End If
End Sub

Private Sub ComboProgram_Click()
    Dim pg As String
    pg = ComboProgram.text 'List(Int(ComboProgram.Appearance) + 1)
    If pg = "เลือกโปรแกรม.." Then
        loadFlag = True
        saveFlag = False
        caller = Me.Name
        BrowseFile.File.Pattern = "*.exe"
        BrowseFile.Show
    Else
        AdodcProgram.Recordset.MoveFirst
        AdodcProgram.Recordset.Find "Program = '" & pg & "'"
        pg = LabelPG
        Shell pg, vbNormalFocus
    End If
End Sub

