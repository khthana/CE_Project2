'****ถ้ามีการเปลี่ยนแปลง text ให้ทำนายคำที่เป็นไปได้
Private Sub TxDisplay_Change()
    Dim ch, s1 As String
    Dim i As Long, j, position As Long
    Dim strPartial As String, strTotal As String
    Dim LenNew As Integer
    
    TextHistory.Visible = False '* ซ่อน history text
    With TxDisplay
        'Lookup list item matching text so far
        strPartial = .text
        i = SendMessage(.hwnd, CB_FINDSTRING, -1, ByVal strPartial)
        'If match found, append unmatched characters
        If i <> CB_ERR Then
            strTotal = .List(i) '*Get full text of matching list item
            TextHistory.text = strTotal
            TextHistory.Visible = True '* ถ้าเจอใน history ให้แสดงคำออกมา
        End If
    End With
    
    '* เริ่มหาคำใกล้เคียงจาก dictionary
    ch = TxDisplay.text
    If ch <> "" Then
        '*ตรวจ อักขระ พิเศษก่อน 20H - 40H
        For i = 1 To Len(ch)
            s1 = Mid(ch, i, 1)
            If ((Asc(s1) >= &H20) And (Asc(s1) <= &H40)) And _
            ((Asc(s1) >= &H7B) And (Asc(s1) <= &H7E)) Then
                FindWordFlag = False
                Exit For
            End If
        Next i
        
        '*ถ้าไม่มีอักขระพิเศษให้เริ่มทำการค้นหา
        If FindWordFlag <> False Then
            LenNew = Len(ch)
            If LenNew <= LenOld Then
                s1 = Left(ch, 1)
                Adodc1.Recordset.MoveFirst
                Select Case Asc(s1)
                    Case 65, 66: Adodc1.Recordset.MoveFirst
                    Case 67, 68: Adodc1.Recordset.Move (9845 - 500) '* -500 เผื่อว่ามีการแทรกคำใน database
                    Case 69, 70, 71: Adodc1.Recordset.Move (21117 - 500)
                    Case 71, 72, 73, 74, 75, 76: Adodc1.Recordset.Move (30839 - 500)
                    Case 77, 78, 79: Adodc1.Recordset.Move (40745 - 500)
                    Case 80, 81, 82: Adodc1.Recordset.Move (48828 - 500)
                    Case 83: Adodc1.Recordset.Move (59785 - 500)
                    Case 84, 85: Adodc1.Recordset.Move (67178 - 500)
                    Case Is >= 86, Is <= 90: Adodc1.Recordset.Move (75698 - 500)
                    Case Is >= &HA1, Is <= &HBA, &HCF: Adodc1.Recordset.Move (80395 - 500)
                    Case Is >= &HBB, Is <= &HCE: Adodc1.Recordset.Move (89103 - 500)
                End Select
            End If
            ch = "'" & ch & "%'"  '* % มีค่าเท่ากับ * ใช้ในการหาคำใน database
            Adodc1.Recordset.Find "Word like " & ch, 0, adSearchForward, 1
            LenOld = LenNew
        End If
    End If
    If LabelDic.Caption <> "" Then
        LabelPredict.Caption = Adodc1.Recordset.Fields(1).Value
        Exit Sub
    End If

End Sub

