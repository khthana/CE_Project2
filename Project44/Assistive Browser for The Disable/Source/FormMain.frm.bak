'* นำค่าเริ่มต้นกำหนดให้กับ function
Sub SetStartValueFunction()
    Call SetStartValue 'กำหนดค่าเริ่มต้นของตัวแปรต่างๆ
    
    TimerClickMouse.Interval = mouse_click_period 'กำหนด period เมาส์
    '* set port ของอุปกรณ์ switch 2 ปุ่ม
    MSComm1.Settings = "9600,n,8,1"
    MSComm1.CommPort = 2
    MSComm1.InputLen = 1
    MSComm1.PortOpen = True
    MSComm1.RThreshold = 1
End Sub

Sub LoadListHistory()
    Dim all_word As Long
    Dim i As Long
        TxDisplay.Clear
        all_word = AdodcHis.Recordset.RecordCount
        If all_word <> 0 Then
            AdodcHis.Recordset.MoveFirst
            For i = 1 To all_word
                TxDisplay.AddItem (AdodcHis.Recordset.Fields.Item(1).Value)
                AdodcHis.Recordset.MoveNext
            Next i
            AdodcHis.Recordset.MoveFirst
        End If
End Sub
'************************************************************************************
'* Function ตรวจการกดปุ่มบังคับเมาส์ ขึ้น-ลง พร้อม return ค่า Direction
'************************************************************************************

Function CheckKeyUpDown() As String
    Dim click_temp As Boolean '*เก็บ click ก่อน CheckDirection ถ้าไม่มีการกดปุ่ม
        If GetAsyncKeyState(KeyUpDown) Then
            TimerDB.Enabled = False
            If StateKeyMoveMouse = True Then 'ถ้ามีการกดมาครั้งหนึ่งแล้ว
                StateKeyMoveMouse = False '* reset StateKeyMoveMouse
                If ((TimerDelayDb >= MinTimeDb) And (TimerDelayDb <= MaxTimeDb)) Then 'ถ้ากดอีกครั้งในช่วงเวลาที่กำหนด
                    click = False
                    db = True 'กดในเวลาถือว่าเป็น double click
                    UpFlag = Not UpFlag '* กลับทิศทาง บน-ล่าง
                Else
                    click = True ' กดเกินเวลาถือว่าเป็นคลิกอีกครั้งไม่ติดกัน
                    StateKeyMoveMouse = True ' กำหนดสถานะถือว่าเป็นการกดครั้งใหม่
                End If
                '* ตรวจสอบ directtion แล้วส่งค่า direction กลับ
                Call CheckDirection
                CheckKeyUpDown = Direction
                TimerDelayDb = 0 '* ลบค่า TimerDelayDb เพราะเพื่อตรวจจับ double click ครั้งต่อไป
                db = False '* เพื่อตรวจจับ double click ครั้งต่อไป
            Else 'ถ้าเพิ่งกดครั้งแรก (StateKeyUpDown=false)
                StateKeyMoveMouse = True  'ไว้บอกสถานะว่าเคยกดแล้วเพื่อใช้ตรวจสอบกับการกดครั้งที่ 2
                click = True  'ให้ถือว่าเป็นการคลิกธรรมดาก่อน
                Call CheckDirection
                CheckKeyUpDown = Direction
            End If

            If StateKeyMoveMouse = True Then
                TimerDelayDb = 0
                TimerDB.Enabled = True
            End If
            '*กำจัดการยกตัวของปุ่มซึ่งจะส่งค่าเสมือนปุ่มถูกกดทำให้เกิด error
            Do While GetAsyncKeyState(KeyUpDown)
                'หยุดชั่วครู่แล้วเลือ่นเมาส์
                Sleep SleepTime
                Call DoneMoveCursor
            Loop
        Else 'ถ้าไม่ได้กดปุ่มให้ clear click ก่อนแล้วเรียก CheckDirection
            Call CheckDirection
            CheckKeyUpDown = Direction
        End If
End Function


'************************************************************************************
'* Function ตรวจการกดปุ่มบังคับเมาส์ ซ้าย-ขวา พร้อม return ค่า Direction
'************************************************************************************

Function CheckKeyLeftRight() As String
    Dim click_temp As Boolean '*เก็บ click ก่อน CheckDirection ถ้าไม่มีการกดปุ่ม
        If GetAsyncKeyState(KeyLeftRight) Then
            TimerDB.Enabled = False
            If StateKeyMoveMouse = True Then 'ถ้ามีการกดมาครั้งหนึ่งแล้ว
                StateKeyMoveMouse = False '* reset StateKeyMoveMouse
                If ((TimerDelayDb >= MinTimeDb) And (TimerDelayDb <= MaxTimeDb)) Then 'ถ้ากดอีกครั้งในช่วงเวลาที่กำหนด
                    click = False
                    db = True 'กดในเวลาถือว่าเป็น double click
                    LeftFlag = Not LeftFlag '* กลับทิศ ซ้าย-ขวา
                Else
                    click = True ' กดเกินเวลาถือว่าเป็นคลิกอีกครั้งไม่ติดกัน
                    StateKeyMoveMouse = True ' กำหนดสถานะถือว่าเป็นการกดครั้งใหม่
                End If
                '* ตรวจสอบ directtion แล้วส่งค่า direction กลับ
                Call CheckDirection
                CheckKeyLeftRight = Direction
                TimerDelayDb = 0 '* ลบค่า TimerDelayDb เพราะเพื่อตรวจจับ double click ครั้งต่อไป
                db = False '* เพื่อตรวจจับ double click ครั้งต่อไป
            Else 'ถ้าเพิ่งกดครั้งแรก (StateKeyUpDown=false)
                StateKeyMoveMouse = True  'ไว้บอกสถานะว่าเคยกดแล้วเพื่อใช้ตรวจสอบกับการกดครั้งที่ 2
                click = True  'ให้ถือว่าเป็นการคลิกธรรมดาก่อน
                Call CheckDirection
                CheckKeyLeftRight = Direction
            End If

            If StateKeyMoveMouse = True Then
                TimerDelayDb = 0
                TimerDB.Enabled = True
            End If
            '*กำจัดการยกตัวของปุ่มซึ่งจะส่งค่าเสมือนปุ่มถูกกดทำให้เกิด error
            Do While GetAsyncKeyState(KeyLeftRight)
                'หยุดชั่วครู่แล้วเลือ่นเมาส์
                Sleep SleepTime
                Call DoneMoveCursor
            Loop
        Else 'ถ้าไม่ได้กดปุ่มให้ clear click ก่อนแล้วเรียก CheckDirection
            Call CheckDirection
            CheckKeyLeftRight = Direction
        End If
End Function

'************************************************************************************
'* Function ตรวจการกดปุ่มบังคับเมาส์ด้วยปุ่ม 1 ปุ่ม พร้อม return ค่า Direction
'************************************************************************************

Function CheckOneKey() As String
    Dim click_temp As Boolean '*เก็บ click ก่อน CheckDirection1Key ถ้าไม่มีการกดปุ่ม
        If GetAsyncKeyState(OneKey) Then
            TimerDB.Enabled = False
            If StateKeyMoveMouse = True Then 'ถ้ามีการกดมาครั้งหนึ่งแล้ว
                StateKeyMoveMouse = False '* reset StateKeyMoveMouse
                If ((TimerDelayDb >= MinTimeDb) And (TimerDelayDb <= MaxTimeDb)) Then 'ถ้ากดอีกครั้งในช่วงเวลาที่กำหนด
                    click = False
                    db = True 'กดในเวลาถือว่าเป็น double click
                    'LeftFlag = Not LeftFlag '* กลับทิศ ซ้าย-ขวา
                Else
                    click = True ' กดเกินเวลาถือว่าเป็นคลิกอีกครั้งไม่ติดกัน
                    StateKeyMoveMouse = True ' กำหนดสถานะถือว่าเป็นการกดครั้งใหม่
                End If
                '* ตรวจสอบ directtion แล้วส่งค่า direction กลับ
                Call CheckDirection1Key
                CheckOneKey = Direction
                TimerDelayDb = 0 '* ลบค่า TimerDelayDb เพราะเพื่อตรวจจับ double click ครั้งต่อไป
                db = False '* เพื่อตรวจจับ double click ครั้งต่อไป
            Else 'ถ้าเพิ่งกดครั้งแรก (StateKeyUpDown=false)
                StateKeyMoveMouse = True  'ไว้บอกสถานะว่าเคยกดแล้วเพื่อใช้ตรวจสอบกับการกดครั้งที่ 2
                click = True  'ให้ถือว่าเป็นการคลิกธรรมดาก่อน
                Call CheckDirection1Key
                CheckOneKey = Direction
            End If

            If StateKeyMoveMouse = True Then
                TimerDelayDb = 0
                TimerDB.Enabled = True
            End If
            '*กำจัดการยกตัวของปุ่มซึ่งจะส่งค่าเสมือนปุ่มถูกกดทำให้เกิด error
            Do While GetAsyncKeyState(OneKey)
                'หยุดชั่วครู่แล้วเลือ่นเมาส์
                Sleep SleepTime
                Call DoneMoveCursor
            Loop
        Else 'ถ้าไม่ได้กดปุ่มให้ clear click ก่อนแล้วเรียก CheckDirection1Key
            Call CheckDirection1Key
            CheckOneKey = Direction
        End If
End Function


'*****************************************************************************
'*****************************************************************************
'                      กลุ่ม function ควบคุมการเคลื่อนที่ของ mouse cursor
'*****************************************************************************
'*****************************************************************************

'* ตวรจการกดปุ่มบังคับ mouse cursor พร้อมทั้งเลื่อน mouse cursor
Sub MoveMouseCursor() ' Start sub
    Dim Count As Integer ' For-next counter
        '* ถ้าไม่ใช่การควบคุมด้วยปุ่ม 1 ปุ่ม ให้ check ปุ่มทั้ง 2 ปุ่ม
        If OnekeyFlag <> True Then
                If GetAsyncKeyState(KeyUpDown) Then
                    UpDownFlag = True
                ElseIf GetAsyncKeyState(KeyLeftRight) Then
                    LeftRightFlag = True
                Else
                    UpDownFlag = False
                    LeftRightFlag = False
                End If
                
                If UpDownFlag Then
                    Direction = CheckKeyUpDown
                ElseIf LeftRightFlag Then
                    Direction = CheckKeyLeftRight
                Else
                    '*clear direction
                    If Direction <> "0000" Then
                        OldDirection = Direction
                        Direction = "0000"
                    End If
                End If
        Else '* ตั้งให้เป็นการควบคุมด้วยปุ่ม 1 ปุ่ม
                If GetAsyncKeyState(OneKey) Then
                    Direction = CheckOneKey
                Else
                    If Direction <> "0000" Then
                        OldDirection = Direction
                        Direction = "0000"
                    End If
                End If
        End If
                
            '*สั่งให้เลื่อนตำแหน่งเมาส์
            Call DoneMoveCursor
    
    End Sub

'*สั่งให้มีการเคลื่อน mouse cursor โดยถูกเรียกจาก CheckKeyUpDown และ CheckKeyLeftRight
Sub DoneMoveCursor() ' Start sub
        Dim Count As Integer
        
        For Count = 1 To 4
                OldValue(Count) = KeyValue(Count)  'เก็บค่าไว้ใน OldValue ทิ้ง
                KeyValue(Count) = False 'ลบค่าเก่าทิ้ง
        Next
        Select Case Direction
              Case "1000": KeyValue(1) = True 'Up
              Case "0100": KeyValue(2) = True 'Down
              Case "0010": KeyValue(3) = True 'Left
              Case "0001": KeyValue(4) = True 'Right
        End Select
        If (Direction <> "0000") Then ' If any move key(s) are pressed then
            GetCursorPos position ' Get the current mouse cursor position
            For Count = 1 To 4 ' Do all 4 movement actions
                If KeyValue(Count) Then ' If move key is pressed then,
                    If Not OldValue(Count) Then MoveSpeed(Count) = 0 ' If key has just been pressed then set movement speed to null
                    If MoveSpeed(Count) < MaxSpeed Then ' If movement speed is lower then 100 then,
                        MoveSpeed(Count) = MoveSpeed(Count) + AddSpeed ' Increase movement speed
                    Else
                        MoveSpeed(Count) = MaxSpeed ' Else, set movement speed as maximum speed limit
                    End If
                    Select Case Count ' Select movement direction
                        Case MoveUp: position.Y = position.Y - MoveSpeed(MoveUp) ' Decrease "Y" position
                        Case MoveDown: position.Y = position.Y + MoveSpeed(MoveDown) ' Increase "Y" position
                        Case MoveLeft: position.X = position.X - MoveSpeed(MoveLeft) ' Decrease "X" position
                        Case MoveRight: position.X = position.X + MoveSpeed(MoveRight) ' Increase "X" position
                    End Select
                End If
            Next Count ' Next movement action
            SetCursorPos position.X, position.Y ' Set new mouse cursor position
            mouse_event MOUSEEVENTF_MOVE, 0, 0, 0, 0 ' Inform other programs that mouse has moved
        End If
    End Sub

'* หาทิศทางการเคลื่อนที่ของเมาส์และแสดงภาพทิศทาง
Sub CheckDirection()
    Direction = OldDirection
    '* ถ้าบังคับ ขึ้น-ลง
    If UpDownFlag Then
        If UpFlag Then
            Direction = "1000" '*ขึ้น
            PictureUp.Visible = True
            PictureDown.Visible = False
        Else
            Direction = "0100" '*ลง
            PictureDown.Visible = True
            PictureUp.Visible = False
        End If
    '* ถ้าบังคับ ซ้าย-ขวา
    ElseIf LeftRightFlag Then
        If LeftFlag Then
            Direction = "0010" '* ซ้าย
            PictureLeft.Visible = True
            PictureRight.Visible = False
        Else
            Direction = "0001" '* ขวา
            PictureRight.Visible = True
            PictureLeft.Visible = False
        End If
    Else
        Direction = "0000"
    End If
End Sub

'*ฟังก์ชันตรวจทิศทางของการควบคุมเมาส์ ด้วยปุ่มเพียง 1 ปุ่ม
Function CheckDirection1Key() As String
    Direction = OldDirection
    '* ซ่อนภาพ direction ก่อน
    If db Then
        PictureUp.Visible = False
        PictureDown.Visible = False
        PictureLeft.Visible = False
        PictureRight.Visible = False
        Select Case Direction
            Case "0000":
                    Direction = "1000"
                    PictureUp.Visible = True
            Case "1000":
                    Direction = "0100"
                    PictureDown.Visible = True
            Case "0100":
                    Direction = "0010"
                    PictureLeft.Visible = True
            Case "0010":
                    Direction = "0001"
                    PictureRight.Visible = True
            Case "0001":
                    Direction = "1000"
                    PictureUp.Visible = True
        End Select
    End If
End Function

Sub SetNewValue()
    TimerClickMouse.Interval = mouse_click_period 'กำหนด period เมาส์
End Sub

'************************************* SetColor ***********************************
Sub SetColorForm()
    FormMain.BackColor = ColorForm
    FrameMove.BackColor = ColorForm
    FrameMove2.BackColor = ColorForm
    FrameMouseEvent.BackColor = ColorForm
    FrameMouseButton.BackColor = ColorForm
    Op_click.BackColor = ColorForm
    Op_dbclick.BackColor = ColorForm
    Op_drag.BackColor = ColorForm
    Op_mouse_left.BackColor = ColorForm
    Op_mouse_right.BackColor = ColorForm
End Sub

Sub SetColorEsc()
    Dim i As Integer
    B_Esc.BackColor = ColorEsc
    For i = 1 To 12
        B_F(i).BackColor = ColorEsc
    Next
End Sub

Sub SetColorPrint()
    Dim i As Integer
    For i = 13 To 15
        B_F(i).BackColor = ColorPrint
    Next
End Sub

Sub SetColorTab()
    Dim i As Integer
    For i = 0 To 6
        B_co1(i).BackColor = ColorTab
    Next
    For i = 0 To 5
        B_co2(i).BackColor = ColorTab
    Next
        B_co1(5).BackColor = &H8000000F
        B_co2(4).BackColor = &H8000000F
End Sub

Sub SetColorChar()
    Dim i As Integer
    For i = 0 To 11
        B_r1(i).BackColor = ColorChar
    Next i
    For i = 0 To 12
        B_r2(i).BackColor = ColorChar
    Next i
    For i = 0 To 10
        B_r3(i).BackColor = ColorChar
    Next i
    For i = 0 To 9
        B_r4(i).BackColor = ColorChar
    Next i
End Sub

Sub SetColorSpace()
    B_space.BackColor = ColorSpace
End Sub

Sub SetColorInsert()
    Dim i As Integer
    For i = 0 To 5
        B_com(i).BackColor = ColorInsert
    Next i
End Sub

Sub SetColorNum()
    Dim i As Integer
    For i = 0 To 10
        B_num(i).BackColor = ColorNum
    Next i
End Sub

Sub SetColorOperator()
    Dim i As Integer
    For i = 1 To 4
        B_numc(i).BackColor = ColorOperator
    Next i
End Sub

Sub SetColorNumlock()
