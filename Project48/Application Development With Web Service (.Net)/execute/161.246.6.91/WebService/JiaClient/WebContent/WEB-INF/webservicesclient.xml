<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE webservicesclient PUBLIC "-//IBM Corporation, Inc.//DTD J2EE Web services client 1.0//EN" "http://www.ibm.com/webservices/dtd/j2ee_web_services_client_1_0.dtd">
<webservicesclient>
    <service-ref>
	<description>WSDL Service JiaService</description>
	<service-ref-name>service/JiaService</service-ref-name>
	<service-interface>WS.JiaService</service-interface>
        <wsdl-file>WEB-INF/wsdl/Jia.wsdl</wsdl-file>
        <jaxrpc-mapping-file>WEB-INF/Jia_mapping.xml</jaxrpc-mapping-file>
        <service-qname>
            <namespaceURI>http://WS</namespaceURI>
            <localpart>JiaService</localpart>
        </service-qname>
        <port-component-ref>
            <service-endpoint-interface>WS.Jia</service-endpoint-interface>
        </port-component-ref>
    </service-ref>
</webservicesclient>
