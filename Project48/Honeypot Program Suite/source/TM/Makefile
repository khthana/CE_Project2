	@mkdir -p .obj/honeypot && $(COPY_FILE) --parents $(SOURCES) $(HEADERS) $(FORMS) $(DIST) .obj/honeypot/ && $(COPY_FILE) --parents images/cache.png images/encrypted.png images/find.png images/kcontrol.png images/window_list.png images/agt_print.png images/package_settings.png images/kfloppy.png images/windows_users.png images/forward.png images/next-sail.png images/previos-sail.png images/xmag.png images/tartitle.png images/reload.png images/configure.png .obj/honeypot/ && $(COPY_FILE) --parents honeywallmm.ui.h userpass.ui.h wizardform.ui.h .obj/honeypot/ && ( cd `dirname .obj/honeypot` && $(TAR) honeypot.tar honeypot && $(GZIP) honeypot.tar ) && $(MOVE) `dirname .obj/honeypot`/honeypot.tar.gz . && $(DEL_FILE) -r .obj/honeypot

