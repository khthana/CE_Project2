<!DOCTYPE UI><UI version="3.3" stdsetdef="1">
<class>WizardForm</class>
<widget class="QWizard">
    <property name="name">
        <cstring>WizardForm</cstring>
    </property>
    <property name="enabled">
        <bool>true</bool>
    </property>
    <property name="geometry">
        <rect>
            <x>0</x>
            <y>0</y>
            <width>503</width>
            <height>392</height>
        </rect>
    </property>
    <property name="caption">
        <string>Setup Configuration Wizard</string>
    </property>
    <widget class="QWidget">
        <property name="name">
            <cstring>WizardPage</cstring>
        </property>
        <attribute name="title">
            <string>Setting working path</string>
        </attribute>
        <widget class="QLayoutWidget">
            <property name="name">
                <cstring>layout3</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>40</x>
                    <y>40</y>
                    <width>410</width>
                    <height>220</height>
                </rect>
            </property>
            <grid>
                <property name="name">
                    <cstring>unnamed</cstring>
                </property>
                <widget class="QPushButton" row="1" column="0">
                    <property name="name">
                        <cstring>savePath</cstring>
                    </property>
                    <property name="text">
                        <string>Save</string>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Save Configuration</string>
                    </property>
                </widget>
                <widget class="QLayoutWidget" row="0" column="0" rowspan="1" colspan="2">
                    <property name="name">
                        <cstring>layout2</cstring>
                    </property>
                    <grid>
                        <property name="name">
                            <cstring>unnamed</cstring>
                        </property>
                        <widget class="QLabel" row="0" column="0">
                            <property name="name">
                                <cstring>textLabel1</cstring>
                            </property>
                            <property name="text">
                                <string>Path of snort_inline.conf</string>
                            </property>
                            <property name="buddy" stdset="0">
                                <cstring>lineEdit14</cstring>
                            </property>
                            <property name="whatsThis" stdset="0">
                                <string>Path to collect snort_inline configuration
ex. /etc/snort/</string>
                            </property>
                        </widget>
                        <widget class="QLabel" row="1" column="0">
                            <property name="name">
                                <cstring>textLabel2</cstring>
                            </property>
                            <property name="text">
                                <string>Path of snort_inline's rules</string>
                            </property>
                            <property name="buddy" stdset="0">
                                <cstring>lineEdit15</cstring>
                            </property>
                            <property name="whatsThis" stdset="0">
                                <string>Path to collect all snort_inline rules
ex. /etc/snort/rules/</string>
                            </property>
                        </widget>
                        <widget class="QLineEdit" row="0" column="1">
                            <property name="name">
                                <cstring>confPath</cstring>
                            </property>
                            <property name="text">
                                <string></string>
                            </property>
                            <property name="toolTip" stdset="0">
                                <string>Configuration of snort_inline path</string>
                            </property>
                        </widget>
                        <widget class="QLabel" row="2" column="0">
                            <property name="name">
                                <cstring>textLabel3</cstring>
                            </property>
                            <property name="text">
                                <string>Path of cages</string>
                            </property>
                            <property name="buddy" stdset="0">
                                <cstring>lineEdit16</cstring>
                            </property>
                            <property name="whatsThis" stdset="0">
                                <string>Path to save all cage
ex. /home/vmware/</string>
                            </property>
                        </widget>
                        <widget class="QLineEdit" row="1" column="1">
                            <property name="name">
                                <cstring>rulePath</cstring>
                            </property>
                            <property name="text">
                                <string></string>
                            </property>
                            <property name="toolTip" stdset="0">
                                <string>Path to keep rules file</string>
                            </property>
                        </widget>
                        <widget class="QLineEdit" row="2" column="1">
                            <property name="name">
                                <cstring>cagePath</cstring>
                            </property>
                            <property name="text">
                                <string></string>
                            </property>
                            <property name="toolTip" stdset="0">
                                <string>Path to keep original cages</string>
                            </property>
                        </widget>
                    </grid>
                </widget>
                <widget class="QPushButton" row="1" column="1">
                    <property name="name">
                        <cstring>resetPath</cstring>
                    </property>
                    <property name="text">
                        <string>Reset</string>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Clear Configuration</string>
                    </property>
                </widget>
            </grid>
        </widget>
    </widget>
    <widget class="QWidget">
        <property name="name">
            <cstring>WizardPage</cstring>
        </property>
        <attribute name="title">
            <string>Database connections</string>
        </attribute>
        <widget class="QButtonGroup">
            <property name="name">
                <cstring>connectbuttonGroup</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>224</x>
                    <y>10</y>
                    <width>250</width>
                    <height>246</height>
                </rect>
            </property>
            <property name="title">
                <string>Connection</string>
            </property>
            <grid>
                <property name="name">
                    <cstring>unnamed</cstring>
                </property>
                <widget class="QLabel" row="6" column="0">
                    <property name="name">
                        <cstring>textLabel11</cstring>
                    </property>
                    <property name="text">
                        <string>Port:</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>spinBox5</cstring>
                    </property>
                </widget>
                <widget class="QLabel" row="0" column="0">
                    <property name="name">
                        <cstring>textLabel5</cstring>
                    </property>
                    <property name="text">
                        <string>Name:</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>lineEdit31</cstring>
                    </property>
                </widget>
                <widget class="QLabel" row="2" column="0">
                    <property name="name">
                        <cstring>textLabel7</cstring>
                    </property>
                    <property name="text">
                        <string>Database Name:</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>lineEdit32</cstring>
                    </property>
                </widget>
                <widget class="QLabel" row="1" column="0">
                    <property name="name">
                        <cstring>textLabel6</cstring>
                    </property>
                    <property name="text">
                        <string>Driver</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>comboBox11</cstring>
                    </property>
                </widget>
                <widget class="QLineEdit" row="0" column="1">
                    <property name="name">
                        <cstring>nameLineEdit</cstring>
                    </property>
                    <property name="text">
                        <string></string>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Name</string>
                    </property>
                </widget>
                <widget class="QComboBox" row="1" column="1">
                    <property name="name">
                        <cstring>driverComboBox</cstring>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Type of driver</string>
                    </property>
                </widget>
                <widget class="QLineEdit" row="2" column="1">
                    <property name="name">
                        <cstring>dbnameLineEdit</cstring>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Database name</string>
                    </property>
                </widget>
                <widget class="QLineEdit" row="3" column="1">
                    <property name="name">
                        <cstring>usernameLineEdit</cstring>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Username to connect database</string>
                    </property>
                </widget>
                <widget class="QLineEdit" row="4" column="1">
                    <property name="name">
                        <cstring>passwordLineEdit</cstring>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string>Password of user</string>
                    </property>
                </widget>
                <widget class="QLabel" row="3" column="0">
                    <property name="name">
                        <cstring>textLabel8</cstring>
                    </property>
                    <property name="text">
                        <string>Username:</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>lineEdit33</cstring>
                    </property>
                </widget>
                <widget class="QLabel" row="4" column="0">
                    <property name="name">
                        <cstring>textLabel9</cstring>
                    </property>
                    <property name="text">
                        <string>Password:</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>lineEdit34</cstring>
                    </property>
                </widget>
                <widget class="QLabel" row="5" column="0">
                    <property name="name">
                        <cstring>textLabel10</cstring>
                    </property>
                    <property name="text">
                        <string>Hostname:</string>
                    </property>
                    <property name="buddy" stdset="0">
                        <cstring>lineEdit35</cstring>
                    </property>
                </widget>
                <widget class="QLineEdit" row="5" column="1">
                    <property name="name">
                        <cstring>hostnameLineEdit</cstring>
                    </property>
                    <property name="toolTip" stdset="0">
                        <string></string>
                    </property>
                </widget>
                <widget class="QLineEdit" row="6" column="1">
                    <property name="name">
                        <cstring>portLineEdit</cstring>
                    </property>
                </widget>
            </grid>
        </widget>
        <widget class="QPushButton">
            <property name="name">
                <cstring>editPushButton</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>310</x>
                    <y>266</y>
                    <width>90</width>
                    <height>30</height>
                </rect>
            </property>
            <property name="text">
                <string>Edit</string>
            </property>
            <property name="toolTip" stdset="0">
                <string>Edit database connection</string>
            </property>
        </widget>
        <widget class="QListBox">
            <property name="name">
                <cstring>dbListBox</cstring>
            </property>
            <property name="geometry">
                <rect>
                    <x>14</x>
                    <y>4</y>
                    <width>190</width>
                    <height>290</height>
                </rect>
            </property>
        </widget>
    </widget>
</widget>
<connections>
    <connection>
        <sender>resetPath</sender>
        <signal>clicked()</signal>
        <receiver>cagePath</receiver>
        <slot>clear()</slot>
    </connection>
    <connection>
        <sender>resetPath</sender>
        <signal>clicked()</signal>
        <receiver>confPath</receiver>
        <slot>clear()</slot>
    </connection>
    <connection>
        <sender>resetPath</sender>
        <signal>clicked()</signal>
        <receiver>rulePath</receiver>
        <slot>clear()</slot>
    </connection>
    <connection>
        <sender>cagePath</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>confPath</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>rulePath</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>nameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>driverComboBox</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>dbnameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>usernameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>passwordLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>hostnameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>portLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>editPushButton</sender>
        <signal>clicked()</signal>
        <receiver>WizardForm</receiver>
        <slot>editdb()</slot>
    </connection>
    <connection>
        <sender>savePath</sender>
        <signal>clicked()</signal>
        <receiver>WizardForm</receiver>
        <slot>saveConfig()</slot>
    </connection>
    <connection>
        <sender>dbListBox</sender>
        <signal>selectionChanged()</signal>
        <receiver>WizardForm</receiver>
        <slot>datachange()</slot>
    </connection>
</connections>
<tabstops>
    <tabstop>confPath</tabstop>
    <tabstop>rulePath</tabstop>
    <tabstop>cagePath</tabstop>
    <tabstop>savePath</tabstop>
    <tabstop>resetPath</tabstop>
    <tabstop>nameLineEdit</tabstop>
    <tabstop>driverComboBox</tabstop>
    <tabstop>dbnameLineEdit</tabstop>
    <tabstop>usernameLineEdit</tabstop>
