	@mkdir -p .obj/setup && $(COPY_FILE) --parents $(SOURCES) $(HEADERS) $(FORMS) $(DIST) .obj/setup/ && $(COPY_FILE) --parents images/header.png .obj/setup/ && $(COPY_FILE) --parents wizardform.ui.h .obj/setup/ && ( cd `dirname .obj/setup` && $(TAR) setup.tar setup && $(GZIP) setup.tar ) && $(MOVE) `dirname .obj/setup`/setup.tar.gz . && $(DEL_FILE) -r .obj/setup

