.moc/moc_wizardform.cpp: $(MOC) .ui/wizardform.h
	$(MOC) .ui/wizardform.h -o .moc/moc_wizardform.cpp

.obj/qmake_image_collection.o: .ui/qmake_image_collection.cpp
