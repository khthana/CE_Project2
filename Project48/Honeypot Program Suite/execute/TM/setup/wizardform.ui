<connections>
    <connection>
        <sender>resetPath</sender>
        <signal>clicked()</signal>
        <receiver>cagePath</receiver>
        <slot>clear()</slot>
    </connection>
    <connection>
        <sender>resetPath</sender>
        <signal>clicked()</signal>
        <receiver>confPath</receiver>
        <slot>clear()</slot>
    </connection>
    <connection>
        <sender>resetPath</sender>
        <signal>clicked()</signal>
        <receiver>rulePath</receiver>
        <slot>clear()</slot>
    </connection>
    <connection>
        <sender>cagePath</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>confPath</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>rulePath</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>newPushButton</sender>
        <signal>clicked()</signal>
        <receiver>WizardForm</receiver>
        <slot>newConnect()</slot>
    </connection>
    <connection>
        <sender>nameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>driverComboBox</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>dbnameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>usernameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>passwordLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>hostnameLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>portLineEdit</sender>
        <signal>textChanged(const QString&amp;)</signal>
        <receiver>WizardForm</receiver>
        <slot>checkInput()</slot>
    </connection>
    <connection>
        <sender>connectPushButton</sender>
        <signal>clicked()</signal>
        <receiver>WizardForm</receiver>
        <slot>connectdb()</slot>
    </connection>
    <connection>
        <sender>delPushButton</sender>
        <signal>clicked()</signal>
        <receiver>WizardForm</receiver>
        <slot>disconnectdb()</slot>
    </connection>
    <connection>
        <sender>savePath</sender>
        <signal>clicked()</signal>
        <receiver>WizardForm</receiver>
        <slot>saveConfig()</slot>
    </connection>
    <connection>
        <sender>dbListBox</sender>
        <signal>selectionChanged()</signal>
        <receiver>WizardForm</receiver>
        <slot>datachange()</slot>
    </connection>
</connections>
