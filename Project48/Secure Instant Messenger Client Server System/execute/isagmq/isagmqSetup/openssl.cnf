[ ca ]
default_ca 		= exampleca

[ exampleca ]
dir 			= /root/isagmq
certificate 		= $dir/rootcert.pem
database 		= $dir/index.txt
new_certs_dir 		= $dir
private_key 		= $dir/rootkey.pem
serial			= $dir

default_crl_days	= 7
default_days 		= 365
default_md 		= sha1

crl			= $dir/isagmq/crl.pem #the current CRL
crl_dir			= $dir/isagmq/crl

policy 			= exampleca_policy
x509_extensions 	= certificate_extensions

[ exampleca_policy ]
commonName 		= supplied
stateOrProvinceName 	= supplied
countryName 		= supplied
emailAddress 		= supplied
organizationName 	= supplied
organizationalUnitName 	= optional

[ certificate_extensions ]
basicConstraints 	= CA:false

[ req ]
default_bits 		= 1024
default_keyfile		= /root/isagmq/rootkey.pem
default_md 		= sha1

prompt 			= no
distinguished_name	= root_ca_distinguished_name

x509_extensions 	= root_ca_extensions

[ root_ca_distinguished_name ]
commonName		= Care_CA
stateOrProvinceName	= Bangkok
countryName		= TH
emailAddress		= careMail@exampleca.org
organizationName	= Root Certificate Authority

[ root_ca_extensions ]
basicConstraints 	= CA:true

