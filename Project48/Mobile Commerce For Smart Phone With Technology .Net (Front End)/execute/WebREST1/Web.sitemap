<?xml version="1.0" encoding="utf-8" ?>
<siteMap xmlns="http://schemas.microsoft.com/AspNet/SiteMap-File-1.0" >

  <siteMapNode title="" url="" description="foo" roles="*" >
    <siteMapNode title="Home"
					 url="~/WebRest/Home.aspx"
					 description="Home"
					 roles="Consultant,ProjectManager,ProjectAdministrator" />

    <siteMapNode title="Map"
                 url="~/WebRest/Map.aspx"
					 description="Show Map"
					 roles="ProjectManager,ProjectAdministrator" >

    </siteMapNode>

    <siteMapNode title="Restaurant"
                 url="~/WebRest/Restaurant.aspx"
				 description="List of Restaurant projects"
				 roles="ProjectManager,ProjectAdministrator" >

      <siteMapNode title="Menu"
				    url="~/WebRest/Menu.aspx"
				    description="List of Menu Food"
				    roles="ProjectManager,ProjectAdministrator" />


      <siteMapNode title="Promotion"
				    url="~/WebRest/Promotion.aspx"
				    description="List of Promotion"
				    roles="ProjectManager,ProjectAdministrator" />


      <siteMapNode title="Add Book"
            url="~/WebRest/AddBook.aspx"          
            description="Add book"
            roles="ProjectManager,ProjectAdministrator" />


    </siteMapNode>

    <siteMapNode title="Building"
                 url="~/WebRest/building.aspx"
				 description="show building"
				 roles="ProjectAdministrator" >


    </siteMapNode>

  </siteMapNode>
</siteMap>
