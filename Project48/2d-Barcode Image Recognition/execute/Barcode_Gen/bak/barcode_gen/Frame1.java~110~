    public void jButton4_actionPerformed(ActionEvent e) {
        //convert string to byte[]
        byte[] input = this.TextInput.getText().getBytes();

        // nozip
        byte[] datain = input;
        int bytecount = datain.length;

        // zip
        /*byte[] output = new byte[255];

        Deflater deflate = new Deflater(Deflater.BEST_COMPRESSION);
        deflate.setInput(input);
        deflate.finish();
        int bytecount = deflate.deflate(output);
        byte[] output2 = new byte[bytecount];
        for(int i=0;i<output2.length;i++) output2[i] = output[i];
        byte[] datain = output2;*/

        // gzip
        /*byte[] datain = new byte[1];
        try
        {
            java.io.ByteArrayOutputStream bytearray = new ByteArrayOutputStream();
            GZIPOutputStream outgzip = new GZIPOutputStream(bytearray);
            outgzip.write(input);
            outgzip.finish();
            datain = bytearray.toByteArray();
        }
        catch(Exception e1)
        {

            return;
        }
        int bytecount = datain.length;*/

        if (datain.length > 223)
        {
            TextOutput.setText("Error data size = " + datain.length +
                               " is over 223 bytes");
            return;
        }
        //calculate redundance
        int re = 0;
        while((datain.length+(2*re))>=(re*16)) re++;

        //encoding
        RS.RSAlgorithm rs = new RS.RSAlgorithm(255, 8, re, 0);
        for(int i=0;i<datain.length;i++) rs.messageSend.coefficient[i] = (int)datain[i];
        rs.messageSend.degree = rs.degree(rs.messageSend);
        rs.calculateGenerator();
        rs.calculateCodeSend();

        //arrange in bit
        int bitlen = (rs.codeSend.degree+1)*8;
        int width = (int)Math.ceil(Math.sqrt((double)bitlen));
                if (width%2==1) width++;
        boolean[] bb = new boolean[bitlen];
        for(int i=0;i<rs.codeSend.degree+1;i++)
        {
            bb[i*8+0] = ((rs.codeSend.coefficient[i] >> 0) & 1)>0;
            bb[i*8+1] = ((rs.codeSend.coefficient[i] >> 1) & 1)>0;
            bb[i*8+2] = ((rs.codeSend.coefficient[i] >> 2) & 1)>0;
            bb[i*8+3] = ((rs.codeSend.coefficient[i] >> 3) & 1)>0;
            bb[i*8+4] = ((rs.codeSend.coefficient[i] >> 4) & 1)>0;
            bb[i*8+5] = ((rs.codeSend.coefficient[i] >> 5) & 1)>0;
            bb[i*8+6] = ((rs.codeSend.coefficient[i] >> 6) & 1)>0;
            bb[i*8+7] = ((rs.codeSend.coefficient[i] >> 7) & 1)>0;
        }

        // report status
        int re2 = (int)Math.ceil((double)width*width / 8 / 16);
        TextOutput.setText("b:"+bitlen+" r:"+re+" w:"+width + " r2:"+re2 + " bytecount:"+bytecount);

        // generate image

        Image im = createImage((width+2)*20,(width+2)*20);
        Graphics g = im.getGraphics();
        g.setColor(Color.white);
        g.fillRect(0,0,(width+2)*20,(width+2)*20);

        g.setColor(Color.BLACK);
        for(int x=0;x<width+2;x++)
        {
            if(x%2==0)g.fillRect(x*20,0*20,20,20);
            g.fillRect(x*20,(width+1)*20,20,20);
        }
        for(int y=0;y<width+2;y++)
        {
            g.fillRect(0*20,y*20,20,20);
            if(y%2==1)g.fillRect((width+1)*20,y*20,20,20);
        }
        int index = 0;
        for(int x=0;x<width;x++)
            for(int y=0;y<width;y++)
            {
                if(index<bb.length)
                {
                    if (bb[index] == true) g.fillRect((x + 1) * 20,
                            (y + 1) * 20, 20, 20);
                }
                index++;
            }
        g.dispose();

        // save file
        BufferedImage bi = new BufferedImage((width+2)*20,(width+2)*20,BufferedImage.TYPE_INT_RGB);
        Graphics2D g2 = bi.createGraphics();
        g2.drawImage(im, 0, 0, null);

        g2.dispose();
        try
        {
            ImageIO.write(bi, "jpg", new File("c:\\imageTest.jpg"));
        }
        catch(IOException ioe)
        {
            System.out.println("write: " + ioe.getMessage());
        }
        //Runtime runtime = Runtime.getRuntime();
        try
        {
            Runtime.getRuntime().exec("mspaint");
            //Process p = null;
            //p = runtime.exec("cmd.com");
        }
        catch(IOException ioe)
                {}

    }
