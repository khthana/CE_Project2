  public void appButt_actionPerformed(ActionEvent e) {
    String errmsg="";
    boolean correctArg=true;
    String pass0 = String.valueOf(txtPassword0.getPassword());
    String pass1 = String.valueOf(txtPassword1.getPassword());
    if (txtName.getText().length()<4) {errmsg+= "please insert your name longer than this \n"; correctArg=false;}
    if (txtUsername.getText().length()<4) {errmsg+= "please insert your username longer than this \n"; correctArg=false;}
    if (txtPassword0.getPassword().length <6) {errmsg+= "please insert your password longer than this \n"; correctArg=false;}
    if (pass0.indexOf(pass1)!=0) {errmsg+= "both passwords are not the same \n"; correctArg=false;}
    if (txtAddress.getText().length()<8) {errmsg+= "please insert your address longer than this \n"; correctArg=false;}
    if (txtPhone.getText().length()<9) {errmsg+= "please insert your phone longer than this \n"; correctArg=false;}
    if (txtEmail.getText().indexOf("@")<0 || txtEmail.getText().indexOf(".")<0) {errmsg+= "please insert valid email \n"; correctArg=false;}
    if (txtWebsite.getText().indexOf("http:")<0 || txtEmail.getText().indexOf(".")<0) {errmsg+= "please insert valid website \n"; correctArg=false;}

    if (correctArg==false){
      JOptionPane.showMessageDialog(null,errmsg,"details are invalid" ,JOptionPane.WARNING_MESSAGE);
    }else
    try{
      CallServices cs = new CallServices("GIS_OwnerServices", "insertOwner");
      int res = cs.intInvoke(new Object[] {txtName.getText(),
                             txtAddress.getText(),
                             txtPhone.getText(), txtEmail.getText(),
                             txtWebsite.getText(),
                             txtUsername.getText(), pass0});
      if (res>100) {
        JOptionPane.showMessageDialog(null, "ownid=" + res,
                                      "Apply for organization complete",
                                      JOptionPane.INFORMATION_MESSAGE);
        txtName.setText("") ;
        txtAddress.setText("") ;
        txtPhone.setText("") ;
        txtWebsite.setText("") ;
        txtEmail.setText("") ;
        txtUsername.setText("") ;
        txtPassword0.setText("") ;
        txtPassword1.setText("") ;

      }
      else {
        errmsg="ERROR CODE: "+res;
        JOptionPane.showMessageDialog(null, errmsg,
                                      "Apply for organization uncomplete",
                                      JOptionPane.ERROR_MESSAGE);
      }
    }catch(Exception ea){
      ea.printStackTrace();
    }

  }


