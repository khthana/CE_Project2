  public frmData() {
    try {
      //setDefaultCloseOperation(EXIT_ON_CLOSE);
      jbInit();
    }
    catch (Exception exception) {
      exception.printStackTrace();
    }
  }

  /**
   * Component initialization.
   *
   * @throws java.lang.Exception
   */
  private void jbInit() throws Exception {
    contentPane = (JPanel) getContentPane();
    contentPane.setLayout(xYLayout1);
    setSize(new Dimension(400, 550));
    setTitle("Frame Title");
    contentPane.setBackground(Color.white);
    contentPane.setBorder(titledBorder1);
    contentPane.setOpaque(true);
    jLabel1.setText("ID :");
    lblID.setBackground(Color.white);
    lblID.setEditable(false);
    jScrollPane1.setBorder(titledBorder3);
    jScrollPane2.setBorder(titledBorder4);
    cmdApply.setBackground(Color.white);
    cmdApply.setForeground(Color.blue);
    cmdApply.setBorder(titledBorder5);
    cmdApply.setText("Apply this data");
    cmdApply.addActionListener(new frmData_cmdApply_actionAdapter(this));
    jLabel2.setText("Data:");
    cmdUpdate.setBackground(Color.white);
    cmdUpdate.setForeground(SystemColor.activeCaption);
    cmdUpdate.setBorder(titledBorder7);
    cmdUpdate.setText("Update");
    cmdUpdate.addActionListener(new frmData_cmdUpdate_actionAdapter(this));
    cmdInsert.setBackground(Color.white);
    cmdInsert.setForeground(SystemColor.activeCaption);
    cmdInsert.setBorder(titledBorder6);
    cmdInsert.setText("Insert");
    cmdInsert.addActionListener(new frmData_cmdInsert_actionAdapter(this));
    txtData.setBackground(new Color(255, 255, 247));
    txtData.setText("data");
    txtData.setLineWrap(true);
    txtData.setWrapStyleWord(true);
    lstColumn.setBackground(new Color(247, 255, 255));
    lstColumn.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
    lstColumn.addMouseListener(new frmData_lstColumn_mouseAdapter(this));
    cmdCheckSyntax.setBackground(Color.white);
    cmdCheckSyntax.setForeground(Color.magenta);
    cmdCheckSyntax.setBorder(titledBorder8);
    cmdCheckSyntax.setOpaque(true);
    cmdCheckSyntax.setText("Check Syntax");
    cmdCheckSyntax.addActionListener(new frmData_cmdCheckSyntax_actionAdapter(this));
    contentPane.add(jLabel1, new XYConstraints(7, 5, 43, 28));
    contentPane.add(lblID, new XYConstraints(44, 9, 97, -1));
    contentPane.add(jScrollPane2, new XYConstraints(7, 275, 370, 186));
    jScrollPane2.getViewport().add(txtData);
    contentPane.add(jLabel2, new XYConstraints(8, 258, 53, 14));
    contentPane.add(jScrollPane1, new XYConstraints(7, 44, 371, 210));
    jScrollPane1.getViewport().add(lstColumn);
    contentPane.add(cmdInsert, new XYConstraints(7, 494, 176, 23));
    contentPane.add(cmdUpdate, new XYConstraints(209, 494, 168, 23));
    contentPane.add(cmdApply, new XYConstraints(141, 466, 236, 22));
    contentPane.add(cmdCheckSyntax, new XYConstraints(7, 466, 130, 22));
  }



  public void callMeAsInsert(int layerid,int id,String col[], String dat[]){
    cmdApply.setVisible(true) ;
    cmdUpdate.setVisible(false) ;
    cmdInsert.setVisible(true) ;
    txtData.setEditable(true);
    callMe(id,col,dat);
    currLayerId=layerid;
  }

  public void callMeAsUpdate(int layerid,int id,String col[], String dat[]){
    cmdApply.setVisible(true) ;
    cmdUpdate.setVisible(true) ;
    cmdInsert.setVisible(false) ;
    txtData.setEditable(true);
    callMe(id,col,dat);
    currLayerId=layerid;
  }

  public void callMeAsView(int id,String col[], String dat[]){
    cmdApply.setVisible(false) ;
    cmdUpdate.setVisible(false) ;
    cmdInsert.setVisible(false) ;
    txtData.setEditable(false);
    callMe(id,col,dat);
  }

  private void callMe(int id,String col[], String dat[]){
    this.setVisible(true);
    size = col.length;
    column = new String[size];
    columnname=new String[size];
    data = new String[size];
    currId=id;
    for (int i=0; i<size; i++){
      column[i]=col[i];
      columnname[i]="[ "+column[i].toUpperCase()+" ] : " + dat[i];
      data[i]=dat[i];
    }
    lstColumn.removeAll();
    lstColumn.setListData(columnname);
    lblID.setText(""+id);
  }

  public void lstColumn_mouseClicked(MouseEvent e) {
    int index=lstColumn.getSelectedIndex();
    txtData.setText(data[index]);
  }

  public void cmdApply_actionPerformed(ActionEvent e) {
    int index=lstColumn.getSelectedIndex();
    data[index]=txtData.getText();
    columnname[index]="[ "+column[index].toUpperCase()+" ] : " + data[index];
    lstColumn.removeAll();
    lstColumn.setListData(columnname);


  }

  public void cmdCheckSyntax_actionPerformed(ActionEvent e) {
    int op=0;
    int cs=0;
    for (int i=0;i<txtData.getText().length(); i++){
      if (txtData.getText().charAt(i)=='(') op++;
      if (txtData.getText().charAt(i)==')') cs++;
    }
    if (op==cs) JOptionPane.showMessageDialog(null, "Syntax correct",
                                          "syntax checking",
                                          JOptionPane.INFORMATION_MESSAGE);
      else JOptionPane.showMessageDialog(null, "Syntax Error",
                                          "syntax checking",
                                          JOptionPane.ERROR_MESSAGE);

  }


  public void cmdInsert_actionPerformed(ActionEvent e) {
    int csize = column.length;
    String xmldoc = new String("");
    xmldoc+=("<?xml version=\"1.0\"?>");
    xmldoc+=("<insertinformation>");

    xmldoc+=("  <layer id='"+currLayerId+"' >");
    xmldoc+=("    <row>");
    for (int i=0; i<csize; i++){
      xmldoc+=("      <attribute name='"+column[i]+"'>"+data[i]+"</attribute>");
    }
    xmldoc+=("    </row>");
    xmldoc+=("  </layer >");
    xmldoc+=("</insertinformation>");
    try{
      CallServices cs = new CallServices("GIS_InformationServices", "insertInformation");
      int res = cs.intInvoke(new Object[] {mp.getSessionkey(), xmldoc});

      if (res>100)
            JOptionPane.showMessageDialog(null,
                                          "Insert Information Complete",
                                          "Insert Information",
                                          JOptionPane.INFORMATION_MESSAGE);

          else JOptionPane.showMessageDialog(null,  "Error code: " + res,
                                          "Insert Information",
                                          JOptionPane.ERROR_MESSAGE);

    }catch(Exception er){
      er.printStackTrace();
    }

  }

  public void cmdUpdate_actionPerformed(ActionEvent e) {
    int csize = column.length;
    String xmldoc = new String("");
    xmldoc+=("<?xml version=\"1.0\"?>");
    xmldoc+=("<insertinformation>");

    xmldoc+=("  <layer id='"+currLayerId+"' >");
    xmldoc+=("    <row id='"+currId+"'>");
    for (int i=0; i<csize; i++){
      xmldoc+=("      <attribute name='"+column[i]+"'>"+data[i]+"</attribute>");
    }
    xmldoc+=("    </row>");
    xmldoc+=("  </layer >");
    xmldoc+=("</insertinformation>");
    try{
      CallServices cs = new CallServices("GIS_InformationServices", "updateInformation");
      int res = cs.intInvoke(new Object[] {mp.getSessionkey(), xmldoc});

      if (res>100)
            JOptionPane.showMessageDialog(null,
                                          "Update Information Complete",
                                          "Update Information",
                                          JOptionPane.INFORMATION_MESSAGE);

          else JOptionPane.showMessageDialog(null,  "Error code: " + res,
                                          "Update Information",
                                          JOptionPane.ERROR_MESSAGE);

    }catch(Exception er){
      er.printStackTrace();
    }

  }

}

