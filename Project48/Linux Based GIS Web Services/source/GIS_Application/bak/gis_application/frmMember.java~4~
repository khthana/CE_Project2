  public void callMe(){
    this.setVisible(true) ;
    try{
      CallServices cs=new CallServices("GIS_MemberServices","listMember") ;
      String res = cs.strInvoke(new Object[]{mp.getOwnerID()});
      GisXmlReader gxr= new GisXmlReader(res);
      lstActive.removeAll();
      int size=gxr.child("member").count();
      activeMemberId =new int[size];
      activeMember =new String[size];
      for (int i=0; i<size;i++){
        activeMemberId[i]=Integer.parseInt(gxr.child("member",i).attribute("id"));
        activeMember[i]=gxr.child("member",i).value() ;
      }
      lstActive.setListData(activeMember);

      cs=new CallServices("GIS_MemberServices","listNewMember") ;
      res = cs.strInvoke(new Object[]{mp.getOwnerID() });
      gxr= new GisXmlReader(res);
      lstInactive.removeAll();
      size=gxr.child("member").count();
      inactiveMemberId =new int[size];
      inactiveMember =new String[size];
      for (int i=0; i<size;i++){
        inactiveMemberId[i]=Integer.parseInt(gxr.child("member",i).attribute("id"));
        inactiveMember[i]=gxr.child("member",i).value() ;
      }
      lstInactive.setListData(inactiveMember);

    }catch(Exception e){
      e.printStackTrace() ;
    }

  }

  public void lstActive_mouseClicked(MouseEvent e) {
