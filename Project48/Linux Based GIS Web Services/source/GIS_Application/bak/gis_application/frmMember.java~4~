  public void viewDetail(int id){
    try{
      String name ="null";
      String address ="null";
      String phone ="null";
      String email ="null";
      CallServices cs=new CallServices("GIS_MemberServices","detailMember") ;
      String res = cs.strInvoke(new Object[]{id});
      GisXmlReader gxr= new GisXmlReader(res);
      for (int i=0; i<gxr.child("owner").count(); i++){
        name    = gxr.child("owner",i).child("name").value();
        address = gxr.child("owner",i).child("address").value();
        phone   = gxr.child("owner",i).child("phone").value();
        email   = gxr.child("owner",i).child("email").value();
      }
      txtName.setText(name) ;
      txtAddress.setText(address) ;
      txtPhone.setText(phone) ;
      txtEmail.setText(email) ;

      if(mp.getMemberID() == id) {}
      else {}
    }catch(Exception e){
      e.printStackTrace() ;
    }
  }

  public void cmdActive_actionPerformed(ActionEvent e) {
    try{
      CallServices cs=new CallServices("GIS_MemberServices","activateMember") ;
      int res = cs.intInvoke(new Object[]{mp.getSessionkey(),selectedId,true});
      callMe();
      if (res>100)
            JOptionPane.showMessageDialog(null,lblSelectedItem.getText() + "\n is activated",
                                      "Activate Member",
                                      JOptionPane.INFORMATION_MESSAGE );

      else JOptionPane.showMessageDialog(null, "Error code: " + res,
                                      "Activate Member",
                                      JOptionPane.ERROR_MESSAGE);

    }catch(Exception ea){
      ea.printStackTrace() ;
    }
  }

