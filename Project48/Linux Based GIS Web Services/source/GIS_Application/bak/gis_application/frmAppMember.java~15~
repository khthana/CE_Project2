  public void callMe(){
    this.setVisible(true) ;
    try{
      CallServices cs=new CallServices("GIS_OwnerServices","listOwner") ;
      String res = cs.strInvoke(new Object[]{});
      //System.out.println(res);
      GisXmlReader gxr= new GisXmlReader(res);
      lstOrg.removeAllItems();
      int size=gxr.child("owner").count();
      ownid=new int[size];
      for (int i=0; i<size;i++){
        ownid[i]=Integer.parseInt(gxr.child("owner",i).attribute("id"));
        lstOrg.addItem(gxr.child("owner",i).value() );
      }
    }catch(Exception e){
      e.printStackTrace() ;
    }

  }

  public void appButt_actionPerformed(ActionEvent e) {
    String errmsg="";
    boolean correctArg=true;
    String pass0 = String.valueOf(txtPassword0.getPassword());
    String pass1 = String.valueOf(txtPassword1.getPassword());
    if (txtName.getText().length()<6) {errmsg+= "please insert your name longer than this \n"; correctArg=false;}
    if (txtUsername.getText().length()<6) {errmsg+= "please insert your username longer than this \n"; correctArg=false;}
    if (txtPassword0.getPassword().length <6) {errmsg+= "please insert your password longer than this \n"; correctArg=false;}
    if (pass0.indexOf(pass1)!=0) {errmsg+= "both passwords are not the same \n"; correctArg=false;}
    if (txtAddress.getText().length()<8) {errmsg+= "please insert your address longer than this \n"; correctArg=false;}
    if (txtPhone.getText().length()<9) {errmsg+= "please insert your phone longer than this \n"; correctArg=false;}
    if (txtEmail.getText().length()<6) {errmsg+= "please insert your email longer than this \n"; correctArg=false;}
      else if (txtEmail.getText().indexOf("@")<0 || txtEmail.getText().indexOf(".")<0) {errmsg+= "please insert valid email \n"; correctArg=false;}

    if (correctArg==false){
      JOptionPane.showMessageDialog(null,errmsg,"details are invalid" ,JOptionPane.WARNING_MESSAGE);
    }
    try{
      CallServices cs = new CallServices("GIS_MemberServices", "insertMember");
      int res = cs.intInvoke(new Object[] {txtName.getText(),
                             txtAddress.getText(),
                             txtPhone.getText(), txtEmail.getText(),
                             txtUsername.getText(), pass0, selectedOwnid});
      if (res>100) JOptionPane.showMessageDialog(null,"memid="+res,"Apply for member complete" ,JOptionPane.INFORMATION_MESSAGE);
    }catch(Exception ea){
      ea.printStackTrace();
    }

  }

