  public void callMe(String layerID, int indx, String layername){

    this.setVisible(true) ;
    txtLayerName.setText(layername);
    theIndex=indx;
    thisIndex=indx;
    thisLayer=Integer.parseInt(layerID);
    try{
      CallServices cs=new CallServices("GIS_InformationServices","detailColumn") ;
      String res = cs.strInvoke(new Object[]{mp.getSessionkey(), thisLayer });
      System.out.println(res);
      GisXmlReader gxr = new GisXmlReader(res);
      int colsize=gxr.child("layer").child("column").count()-1;
      col   = new String[colsize];
      conx  = new String[colsize];
      conxx = new String[colsize];
      chooseLabel.removeAll();
      chooseLabel.addItem("");

      for (int i=0; i<colsize; i++) {
        col[i]=gxr.child("layer").child("column",i).attribute("name");
        conx[i]=ma.layer[thisIndex].getShow(i);
        conxx[i]="";
        chooseLabel.addItem(col[i]);
      }


      lstAttr.removeAll();
      lstAttr.setListData(conx);
      previewText.setText("Click To Preview");

      ShowFill.setBackground(ma.layer[thisIndex].fill);
      ShowStoke.setBackground(ma.layer[thisIndex].stroke);
      colorText.setBackground(ma.layer[thisIndex].text);
      txtSize.setText(""+ma.layer[thisIndex].txtSize);
      chooseLabel.setSelectedIndex(ma.layer[thisIndex].chLabel);
      ChooseCon.setSelectedIndex(ma.layer[thisIndex].chAllOper);

    }catch(Exception e){
      e.printStackTrace() ;
    }
  }

