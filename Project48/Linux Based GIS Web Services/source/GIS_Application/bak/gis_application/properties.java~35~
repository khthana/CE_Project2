  public void applyValue_actionPerformed(ActionEvent e) {

    int index = lstAttr.getSelectedIndex() ;
    if(index>=0){
      ma.layer[thisIndex].chOper[index]=operator.getSelectedIndex();
      ma.layer[thisIndex].strOper[index]=(String) operator.getItemAt(operator.getSelectedIndex());
      ma.layer[thisIndex].value[index]=SValue.getText();

      int attrIndex=ChooseCon.getSelectedIndex();
      ma.layer[thisIndex].chAllOper=attrIndex;
      ma.layer[thisIndex].strAllOper=(String)ChooseCon.getItemAt(attrIndex );

      conx[index]=ma.layer[thisIndex].getShow(index);
      lstAttr.removeAll();
      lstAttr.setListData(conx);

    }
  }

  public void SProperties_actionPerformed(ActionEvent e) {
    ma.layer[thisIndex].fill=ShowFill.getBackground();
    ma.layer[thisIndex].stroke=ShowStoke.getBackground();
    ma.layer[thisIndex].text=colorText.getBackground();
    ma.layer[thisIndex].txtSize=Integer.parseInt(txtSize.getText());
    ma.layer[thisIndex].chLabel=chooseLabel.getSelectedIndex();
    int index=chooseLabel.getSelectedIndex();
    if (index<0) index=0;
    ma.layer[thisIndex].strLabel=(String)chooseLabel.getItemAt(index);
    //JOptionPane.showMessageDialog(null,ma.layer[thisIndex].getXml());
    this.setVisible(false);


    //JOptionPane.showMessageDialog(null,xmlxx);
//    ms.layerXml[theIndex]=xmlxx;
  }

