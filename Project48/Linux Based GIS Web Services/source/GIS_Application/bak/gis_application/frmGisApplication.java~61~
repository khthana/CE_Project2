  public void cmdSignIn_actionPerformed(ActionEvent e) {
    try{
      CallServices cs = new CallServices("GIS_UserServices","login");
      String password=String.valueOf(txtPassword.getPassword())  ;
      txtPassword.setText("");
      String username=txtUsername.getText();
      String sessionkey=cs.strInvoke(new Object[]{ username,password }) ;
      MyProfile mp = new MyProfile(sessionkey);
      //JOptionPane.showMessageDialog(null,"sessionkey="+sessionkey,"log in success" ,JOptionPane.INFORMATION_MESSAGE);
      System.out.println(mp.getMemberID() );
      System.out.println(mp.getOwnerID()  );
      System.out.println(mp.getName() );
      System.out.println(mp.getOwnername());

      System.out.println(mp.getAddress());
      System.out.println(mp.getPhone());
      System.out.println(mp.getEmail());
      System.out.println(mp.getSessionkey());
      System.out.println(mp.getPlayroll());


    }catch (Exception err){
      err.printStackTrace() ;
    }
  }

  public void cmdSignOut_actionPerformed(ActionEvent e) {
    try{
          MyProfile mp = new MyProfile();
          CallServices cs = new CallServices("GIS_UserServices","logout");
          String sessionkey=cs.strInvoke(new Object[]{ mp.getSessionkey() }) ;
          System.out.println("logout = " +sessionkey);

        }catch (Exception err){
          err.printStackTrace() ;
    }
  }

