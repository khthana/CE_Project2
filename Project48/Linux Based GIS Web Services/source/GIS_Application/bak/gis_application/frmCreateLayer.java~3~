  public void cmdAdd_actionPerformed(ActionEvent e) {
    attrNum++;
    lblNumAttr.setText(""+attrNum);
  }

  public void cmdSub_actionPerformed(ActionEvent e) {
    if(attrNum>1)attrNum--;
    lblNumAttr.setText(""+attrNum);
  }

  public void initNumAttr(){
    attrName=new String[attrNum];
    datatype=new String[attrNum];
    for (int i=0; i<attrNum; i++){
      attrName[i]="attributeName_"+i;
      datatype[i]="varchar(20)";
    }
    lstAttr.removeAll();
    lstAttr.setListData(attrName);
  }

  public void cmdNumAttr_actionPerformed(ActionEvent e) {
    initNumAttr();
  }

  public void lstAttr_mouseClicked(MouseEvent e) {
    int index = lstAttr.getSelectedIndex();
    txtAttrName.setText(attrName[index]);
    txtDatatype.setText(datatype[index]);
  }

  public void jButton1_actionPerformed(ActionEvent e) {
    int index = lstAttr.getSelectedIndex();
    attrName[index]=txtAttrName.getText();
    datatype[index]=txtDatatype.getText();
  }
