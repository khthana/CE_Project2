  public void getInformation(){
    try{
      CallServices cs=new CallServices("GIS_InformationServices","detailColumn") ;
      String res = cs.strInvoke(new Object[]{mp.getSessionkey(), selectedItem });
      System.out.println(res);
      GisXmlReader gxr = new GisXmlReader(res);
      int colsize=gxr.child("layer").child("column").count()-1;
      col = new String[colsize];
      for (int i=0; i<colsize; i++) {col[i]=gxr.child("layer").child("column",i).attribute("name");
        System.out.print(col[i]+" | ");
      }
      System.out.println("");
      cs=new CallServices("GIS_InformationServices","detailGeomInformation") ;
      res = cs.strInvoke(new Object[]{mp.getSessionkey(), selectedItem });
      gxr = new GisXmlReader(res);
      System.out.println(res);
      int rowsize=gxr.child("layer").child("row").count();
      row = new String[rowsize][colsize];
      geomData=new String[rowsize];
      for (int r=0; r<rowsize; r++){
        row[r][0]=gxr.child("layer").child("row", r).attribute("id");
        System.out.print(row[r][0] + ", ");
        for (int c = 1; c < colsize; c++){
          row[r][c] = gxr.child("layer").child("row", r).child("data", c-1).value();
          System.out.print(row[r][c] + ", ");
        }
        geomData[r]=gxr.child("layer").child("row", r).child("data", colsize-1).value();
        System.out.println("");
      }
      setTable(row,col);

    }catch(Exception e){
      e.printStackTrace() ;
    }
  }

  public void callMe(){
    this.setVisible(true);
    try{
      CallServices cs=new CallServices("GIS_LayerServices","listMyLayer") ;
      String res = cs.strInvoke(new Object[]{mp.getSessionkey() });
      //System.out.println(res);
      GisXmlReader gxr= new GisXmlReader(res);
      lstLayer.removeAll();
      int size=gxr.child("layer").count();
      layerId =new int[size];
      itemName =new String[size];
      geomtype =new String[size];
      layerName =new String[size];
      for (int i=0; i<size;i++){
        String pub = "[-] ";
        String status = gxr.child("layer",i).attribute("status");
        if (status.indexOf("pub")>=0) pub="[+] ";
        layerId[i]=Integer.parseInt(gxr.child("layer",i).attribute("id"));
        geomtype[i] = gxr.child("layer",i).attribute("geomtype");
        layerName[i] = gxr.child("layer",i).value();
        itemName[i]= pub+layerName[i];
      }
      lstLayer.setListData(itemName);

      if (mp.getPlayroll().toLowerCase().indexOf("gis")>=0 ||
          mp.getPlayroll().toLowerCase().indexOf("map")>=0 )
        cmdCreate.setVisible(true);
      else cmdCreate.setVisible(false);


    }catch(Exception e){
      e.printStackTrace() ;

    }

  }

