  public void cmdPublic_actionPerformed(ActionEvent e) {
    try{
      CallServices cs=new CallServices("GIS_LayerServices","publicLayer") ;
      int res = cs.intInvoke(new Object[]{mp.getSessionkey(),selectedItem,true});
      callMe();
      if (res>100)
            JOptionPane.showMessageDialog(null,lblLayerName.getText() + "\n is public",
                                      "Layer Accessibility",
                                      JOptionPane.INFORMATION_MESSAGE );

      else JOptionPane.showMessageDialog(null,  "nError code: " + res,
                                      "Layer Accessibility",
                                      JOptionPane.ERROR_MESSAGE);

    }catch(Exception ea){
      ea.printStackTrace() ;
    }

  }

  public void cmdPrivate_actionPerformed(ActionEvent e) {
    try{
          CallServices cs=new CallServices("GIS_LayerServices","publicLayer") ;
          int res = cs.intInvoke(new Object[]{mp.getSessionkey(),selectedItem,false});
          callMe();
          if (res>100)
