  public void cmdInsertData_actionPerformed(ActionEvent e) {
    int size = col.length;
    String c[]=new String[size];
    String r[]=new String[size];
    int index=tbData.getSelectedRow();
    for (int i=0; i<size-1; i++){
      c[i]=col[i+1];
      r[i]=row[index][i+1];
    }
    c[size-1]="geom";
    r[size-1]=geomData[index];
    int id=Integer.parseInt(row[index][0]);
    frmData.callMeAsInsert(showdataItem,id,c,r);
  }

