                                          JOptionPane.INFORMATION_MESSAGE );

          else JOptionPane.showMessageDialog(null,  "nError code: " + res,
                                          "Layer Accessibility",
                                          JOptionPane.ERROR_MESSAGE);

        }catch(Exception ea){
          ea.printStackTrace() ;
    }
  }

