  public void appButt_actionPerformed(ActionEvent e) {
    String errmsg="";
    boolean correctArg=true;
    if (txtName.getText().length()<6) {errmsg+= "please insert your name longer than this \n"; correctArg=false;}
    if (txtAddress.getText().length()<8) {errmsg+= "please insert your address longer than this \n"; correctArg=false;}
    if (txtPhone.getText().length()<9) {errmsg+= "please insert your phone longer than this \n"; correctArg=false;}
    if (txtEmail.getText().length()<6) {errmsg+= "please insert your email longer than this \n"; correctArg=false;}
      else if (txtEmail.getText().indexOf("@")<0 || txtEmail.getText().indexOf(".")<0) {errmsg+= "please insert valid email \n"; correctArg=false;}

    if (correctArg==false){
      JOptionPane.showMessageDialog(null,errmsg,"details are invalid" ,JOptionPane.WARNING_MESSAGE);
    }else {
      try{
        CallServices cs = new CallServices("GIS_MemberServices", "updateMember");
        int res = cs.intInvoke(new Object[] {mp.getSessionkey() , txtName.getText()
                               , txtAddress.getText(), txtPhone.getText()
                               , txtEmail.getText()});
        if (res>100) JOptionPane.showMessageDialog(null,"memid="+res,"Update this profile complete" ,JOptionPane.INFORMATION_MESSAGE);
        else JOptionPane.showMessageDialog(null,"err no "+res,"error" ,JOptionPane.ERROR_MESSAGE);

      }catch(Exception ea){
        ea.printStackTrace();
      }
    }
  }

  public void cmdPassChange_actionPerformed(ActionEvent e) {
    String errmsg="";
    boolean correctArg=true;
    String passx = String.valueOf(txtPasswordx.getPassword());
    String pass0 = String.valueOf(txtPassword0.getPassword());
    String pass1 = String.valueOf(txtPassword1.getPassword());
    if (txtPasswordx.getPassword().length <6) {errmsg+= "please insert your old password longer than this \n"; correctArg=false;}
    if (txtPassword0.getPassword().length <6) {errmsg+= "please insert your new password longer than this \n"; correctArg=false;}
    if (pass0.indexOf(pass1)!=0) {errmsg+= "both new passwords are not the same \n"; correctArg=false;}
    if (correctArg==false){
      JOptionPane.showMessageDialog(null,errmsg,"Aguememts of changing password may not correct" ,JOptionPane.WARNING_MESSAGE);
    }else {
      try{
        CallServices cs = new CallServices("GIS_MemberServices", "renewPassword");
        int res = cs.intInvoke(new Object[] {mp.getSessionkey(),passx, pass0});
        if (res>100) JOptionPane.showMessageDialog(null,"memid="+res,"password change complete" ,JOptionPane.INFORMATION_MESSAGE);
        else JOptionPane.showMessageDialog(null,"err no "+res,"error" ,JOptionPane.ERROR_MESSAGE);

      }catch(Exception ea){
        ea.printStackTrace();
      }
    }

  }

