      else JOptionPane.showMessageDialog(null,  "nError code: " + res,
                                      "Activate Organization",
                                      JOptionPane.ERROR_MESSAGE);

    }catch(Exception ea){
      ea.printStackTrace() ;
    }

  }

  public void cmdDelete_actionPerformed(ActionEvent e) {
    try{
      int confirm =JOptionPane.showConfirmDialog(null,"Do you want to delete this?","Delete Owner",JOptionPane.WARNING_MESSAGE);
      //System.out.println("con="+confirm);
      if (confirm==0){

        CallServices cs = new CallServices("GIS_OwnerServices", "deleteOwner");
        int res = cs.intInvoke(new Object[] {mp.getSessionkey(), selectedId});
        callMe();
        if (res > 100)
          JOptionPane.showMessageDialog(null,
                                        lblSelectedItem.getText() + "\n is removed",
                                        "Remove Organization",
                                        JOptionPane.INFORMATION_MESSAGE);

        else
          JOptionPane.showMessageDialog(null, "nError code: " + res,
                                        "Remove Organization",
                                        JOptionPane.ERROR_MESSAGE);
      }
    }catch(Exception ea){
      ea.printStackTrace() ;
    }

  }

