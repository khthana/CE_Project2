  public void callMe(){
    this.setVisible(true) ;
    try{
      CallServices cs=new CallServices("GIS_OwnerServices","listOwner") ;
      String res = cs.strInvoke(new Object[]{});
      GisXmlReader gxr= new GisXmlReader(res);
      lstActive.removeAll();
      int size=gxr.child("owner").count();
      activeOwnerId =new int[size];
      activeOwner =new String[size];
      for (int i=0; i<size;i++){
        activeOwnerId[i]=Integer.parseInt(gxr.child("owner",i).attribute("id"));
        activeOwner[i]=gxr.child("owner",i).value() ;
      }
      lstActive.setListData(activeOwner);

      cs=new CallServices("GIS_OwnerServices","listNewOwner") ;
      res = cs.strInvoke(new Object[]{mp.getSessionkey()});
      gxr= new GisXmlReader(res);
      lstInactive.removeAll();
      size=gxr.child("owner").count();
      inactiveOwnerId =new int[size];
      inactiveOwner =new String[size];
      for (int i=0; i<size;i++){
        inactiveOwnerId[i]=Integer.parseInt(gxr.child("owner",i).attribute("id"));
        inactiveOwner[i]=gxr.child("owner",i).value() ;
      }
      lstInactive.setListData(inactiveOwner);

    }catch(Exception e){
      e.printStackTrace() ;
    }

  }

