    public void Add_actionPerformed(ActionEvent e) {
        int check = 1;
        Vector v = new Vector();
        for (int i = 0; i < jList5.getModel().getSize(); i++) {
            v.addElement(jList5.getModel().getElementAt(i));

            if (theList.getSelectedValue() == jList5.getModel().getElementAt(i)) {
                check = 0;
                System.out.println(theList.getSelectedValue()+" = "+jList5.getModel().getElementAt(i));
            }
            else
            { System.out.println(theList.getSelectedValue()+" != "+jList5.getModel().getElementAt(i));}
        }
        if (check == 1) {
            v.addElement(theList.getSelectedValue());
            jList5.setListData(v);
        }

    }

    public void Del_actionPerformed(ActionEvent e) {
        Vector v = new Vector();
