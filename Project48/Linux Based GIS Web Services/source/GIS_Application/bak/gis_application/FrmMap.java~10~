                  jComboBox1.addItem("view2");
                  jComboBox1.addItem("view3");


                 for (int i = 0; i < gxr.child("layer").count(); i++) {
                     System.out.println(KeepID[i]);
                 }*/

        } catch (Exception ea) {
            System.out.print(ea.getStackTrace());
        }

