    public void showmap_actionPerformed(ActionEvent actionEvent) {

        //   System.out.println(jList5.getModel().getSize());
        /////////Keep Layer name In Array//////////////////
        String CLayer[];
        String ID[];
        CLayer = new String[jList5.getModel().getSize()];
        for (int i = 0; i < jList5.getModel().getSize(); i++) {
            CLayer[i] = jList5.getModel().getElementAt(i).toString();
        }
        ID = new String[CLayer.length];
        for (int i = 0;i < CLayer.length; i++)
        {
            for (int j =0; j< KeepID.length;j++)
            {
                if(CLayer[i]==KeepName[j])
                {
                    ID[i] = KeepID[j];
                }
            }
        }
        /////////////////End Keep//////////////////////////
        frame.setIDLayer(ID);
        frame.setSelectedLayer(CLayer);
        frame.setVisible(true);
    }

    public void VList_actionPerformed(ActionEvent actionEvent) {

        ///////////////////////Clear List1//////////////////////
        int aa =1;

        while(aa != 0)
        {
            int i;
            Vector v = new Vector();
            for (i = 0; i < theList.getModel().getSize(); i++) {

                if (theList.getModel().getElementAt(i).toString() != "") {
                    v.clear();
                }
            }
            if (i == theList.getModel().getSize())
            {aa = 0;}
            theList.setListData(v);
        }
        ///////////////////////End Clear///////////////////////
        ///////////////////////Clear List2//////////////////////
        int aa2 =1;

        while(aa2 != 0)
        {
            int i;
            Vector v = new Vector();
            for (i = 0; i < jList5.getModel().getSize(); i++) {

                if (jList5.getModel().getElementAt(i).toString() != "") {
                    v.clear();
                }
            }
            if (i == jList5.getModel().getSize())
            {aa2 = 0;}
            jList5.setListData(v);
        }
        ///////////////////////End Clear///////////////////////

        try {
            /////////////////Check Can See/////////////////////////////
            CallServices cs = new CallServices("GIS_LayerServices","listLayer");
            String resV =cs.strInvoke(new Object[] {mp.getSessionkey() });

            /////////////////End Check/////////////////////////////////
            System.out.println(resV);
            //////////////////Keep Table Name/////////////////////////
            GisXmlReader gxr = new GisXmlReader(resV);

            /////Create Array///////////

            KeepName = new String[gxr.child("layer").count()];
            KeepID = new String[gxr.child("layer").count()];
            KeepOrg = new String[gxr.child("layer").count()];
            ////////////////////////////

            for (int i = 0; i < gxr.child("layer").count(); i++) {
                KeepID[i] = gxr.child("layer", i).attribute("id");
                KeepName[i] = gxr.child("layer", i).attribute("name");
                KeepOrg[i] = gxr.child("layer", i).attribute("owner");
            }
            int y = 0;
            //      System.out.println(theList.getModel().getSize());
            //       System.out.println(gxr.child("layer").count());
            while (y < gxr.child("layer").count()) {
                //           JCheckBox cb=null;
                //           cb=new JCheckBox(KeepName[y],true);
                String ohm = KeepName[y] + "  of [" + KeepOrg[y] + "]";
                Vector v = new Vector();

                for (int i = 0; i < theList.getModel().getSize(); i++) {
                    v.addElement(theList.getModel().getElementAt(i));
                }
                v.addElement("- "+ohm);
                theList.setListData(v);

                y++;
            }

            /*      JCheckBox view1 = new JCheckBox();
