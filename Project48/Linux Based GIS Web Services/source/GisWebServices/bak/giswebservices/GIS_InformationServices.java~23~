     private int updateInfo(String tablename,int id, String[] columnnames, String[] datas, String geom){
          try{
              GisDBConnect gdb = new GisDBConnect() ;
              int size=columnnames.length;
              String set=("");
              for (int i=0; i<size-1; i++){
                  set += " "+columnnames[i]+"='"+datas[i]+"', ";
              }
              set += " "+columnnames[size-1]+"='"+datas[size-1]+"' ";
              if (geom.length() >10){
                  set+=", geom=GeomFromText('" + geom + "', -1) ";
              }
              String sqlstr ="";
              sqlstr += "UPDATE " + tablename + " ";
              sqlstr += "SET " + set + " ";
              sqlstr += "WHERE id=" + id + " ";
              gdb.exeSQL(sqlstr);

              return 101;
          }catch(Exception e){
              return 14;
          }

      }

