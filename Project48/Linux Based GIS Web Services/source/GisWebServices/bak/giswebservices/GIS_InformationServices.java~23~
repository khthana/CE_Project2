    //************************************************ INSERT INFO
    public int insertInformation(String sessionkey, String xmlInsert){
        try{
            GisDBConnect gdbs=new GisDBConnect();
            gdbs.exeSQL("UPDATE session SET time=60 WHERE sessID='"+sessionkey+"' ");
        }catch(Exception e){}


        int memid=0;
        int res=0;
        try{
            GisDBConnect gdb = new GisDBConnect();
            gdb.query("SELECT memid, ownid, level FROM sessionview WHERE sessid='"+sessionkey+"'");
            gdb.getReturn().next();
            int level = gdb.getReturn().getInt("level") ;
            //int ownid = gdb.getReturn().getInt("ownid") ;
            memid = gdb.getReturn().getInt("memid") ;
            if (level>4) return 6;
        }catch(Exception e){
            return 6;
        }

        try{
            GisDBConnect gdb = new GisDBConnect();
            GisXmlReader gxr=new GisXmlReader(xmlInsert) ;
            String layerid=gxr.child("layer").attribute("id");
            String sqlstr = "SELECT tbname FROM writableview ";
            sqlstr += " WHERE memid="+memid+ " AND lid=" + layerid;
            gdb.query(sqlstr);
            gdb.getReturn().next();
            String tbname = gdb.getReturn().getString("tbname") ;


            int nrow = gxr.child("layer").child("row").count();

            gdb.exeSQL("BEGIN");
            for (int r=0; r<nrow; r++){
                int nattr=gxr.child("layer").child("row",r).child("attribute").count();
                LinkedList lstcol= new LinkedList();
                LinkedList lstdata= new LinkedList();
                String geom="null";
                for (int a=0; a<nattr; a++){
                    try{
                        String colname = gxr.child("layer").child("row", r).
                                         child("attribute", a).attribute("name");
                        String value = gxr.child("layer").child("row",
                                       r).child("attribute", a).value();
                        if (colname.compareToIgnoreCase("id")!=0 && colname.compareToIgnoreCase("geom")!=0) {
                            lstcol.add(colname);
                            lstdata.add(value);
                        }
                        if (colname.compareToIgnoreCase("geom")==0) geom=value;
                    }catch(Exception ee){}
                }//-------attr
                int csize = lstcol.size();
                String columnname[] = new String[csize];
                String values[] = new String[csize];
                for (int i=0; i<csize; i++){
                    columnname[i]=(String)lstcol.get(i);
                    values[i]=(String)lstdata.get(i);
                }
                //-----------call insert
                res=insertInfo(tbname,columnname,values,geom);
            }//-----------row
            gdb.exeSQL("END");
            return res;
        }catch(Exception e){
            return 27;
        }
    }

    private int insertInfo(String tablename, String[] columnnames, String[] datas, String geom){


        try{
            GisDBConnect gdb = new GisDBConnect() ;
            int size=columnnames.length;
            String columns=("");
            String values =("");
            for (int i=0; i<size-1; i++){
                columns += columnnames[i]+", ";
                values  += " '" +datas[i]+"', ";
            }
            columns += columnnames[size-1]+" ";
            values  += " '" +datas[size-1]+"' ";
            if (geom.length() >10){
                columns += ", geom ";
                values += ", GeomFromText('" + geom + "', -1) ";
            }
            String sqlstr ="";
            sqlstr += "INSERT INTO " + tablename + " ";
            sqlstr += "(" + columns + ") ";
            sqlstr += "VALUES (" + values + ") ";
            gdb.exeSQL(sqlstr);

            return 101;
        }catch(Exception e){
            return 14;
        }

    }

