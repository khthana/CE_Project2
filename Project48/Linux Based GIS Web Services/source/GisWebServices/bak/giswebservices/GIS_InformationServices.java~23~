    //************************************************ DETAIL INFO
    public String detailInformation(String sessionkey, int layerID) {

        String sqlstr;
        int level = 7;
        long memid = 0;

        //------------to update session
        try{
            GisDBConnect gdbs=new GisDBConnect();
            gdbs.exeSQL("UPDATE session SET time=60 WHERE sessID='"+sessionkey+"' ");
        }catch(Exception e){}

        try{ // try check level of member
            GisDBConnect gdb = new GisDBConnect() ;
            sqlstr = "SELECT ownid, memid, level FROM sessionview ";
            sqlstr+= "WHERE sessid='"+sessionkey+"';";
            gdb.query(sqlstr);
            while (gdb.getReturn().next() ){
                level=gdb.getReturn().getInt("level");
                memid=gdb.getReturn().getInt("memid");
            }
        }catch(Exception e){return "3";} //Must login before call this services

        if (level<7) sqlstr="SELECT lid, lname FROM layerview WHERE memid=" + memid + " AND lid=" + layerID;
        else sqlstr="SELECT lid, lname FROM publiclayerview WHERE lid=" + layerID;

        String lname= new String("");

        try{// check about accessible layer of member
            GisDBConnect gdb = new GisDBConnect() ;
            gdb.query(sqlstr);
            gdb.getReturn().next();
            int lid=0;
            lid=gdb.getReturn().getInt("lid");
            lname=gdb.getReturn().getString("lname") ;
            if (lid!=layerID) return "26";
        }catch(Exception e){
            return "26";
        }

        // get column header
        LinkedList columnList = new LinkedList();
        LinkedList datatypeList = new LinkedList();
        String column[] = new String[1]; column[0]="";
        String datatype[]= new String[1]; datatype[0]="";

        int size=0;
        String tbname="tb_"+layerID;
        try{
            GisDBConnect gdb = new GisDBConnect() ;

            sqlstr="SELECT  colname, datatype FROM columnview WHERE tbname='" + tbname + "' ";
            gdb.query(sqlstr);

            while (gdb.getReturn().next()){
                columnList.add(gdb.getReturn().getString("colname"));
                datatypeList.add(gdb.getReturn().getString("datatype"));
                size++;
            }
            column = new String[size];
            datatype = new String[size];
            for (int i=0; i<size; i++){
                column[i]=(String)columnList.get(i);
                datatype[i]=(String)datatypeList.get(i);
            }
        }catch(Exception e){
            return "26";
        }

        // get data
        try{
            GisDBConnect gdb = new GisDBConnect() ;
            String allcol=" ";
            for (int i=0; i<size; i++)  allcol+= " , " +column[i];

            sqlstr  = "SELECT id " + allcol ;
            sqlstr += " FROM " + tbname;
            gdb.query(sqlstr);

            String xmlstr="<?xml version=\"1.0\"?>\r\n";
            xmlstr += "<information>\r\n";
            xmlstr += "  <layer id='"+layerID+"' name='"+lname+"'>\r\n";

            int i=0;
            while (gdb.getReturn().next()){
                int id=gdb.getReturn().getInt("id");
                xmlstr += "    <row id='"+id+"'>\r\n";
                for (int j=0; j<size; j++){
                    String name=column[j];
                    String val =gdb.getReturn().getString(name) ;
                    xmlstr += "      <data name='"+name+"'>"+val+"</data>\r\n";
                }
                xmlstr += "      <data name='geom'>null</data>\r\n";
                xmlstr += "    </row>\r\n";
                i++;
            }

            xmlstr += "  </layer>\r\n";
            xmlstr += "</information>\r\n";
            return xmlstr;
        }catch(Exception e){
            return "26"+sqlstr;
        }

    }

