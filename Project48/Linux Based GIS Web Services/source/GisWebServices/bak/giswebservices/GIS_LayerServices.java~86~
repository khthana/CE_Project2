    //************************************************************* SEARCH LAYER
     public String searchLayer (String sessionkey, String likeName, String likeOwner){
        //int ownID=0;
        int memID=0;
        int level=7;
        String sqlstr = new String("");
        String xmllayer=new String("");
        String option = new String("");
        if (likeName.length()>0) option+=" AND lower(lname) LIKE '%" + likeName.toLowerCase()  + "%' ";
        if (likeOwner.length()>0) option+=" AND lower(ownname) LIKE '%" + likeOwner.toLowerCase()  + "%' ";
        //----------------------------------- check authen
        try{
              GisDBConnect gdb=new GisDBConnect();
              gdb.query("SELECT memid,ownid, level FROM sessionview WHERE sessid='"+sessionkey+"'");
              gdb.getReturn().next();
              //ownID = gdb.getReturn().getInt("ownid") ;
              memID = gdb.getReturn().getInt("memid") ;
              level = gdb.getReturn().getInt("level") ;
        }catch(Exception e){
              level=7;
        }

        //----------------------------------- estabish condition to query
        if (level<7) sqlstr="SELECT * FROM layerview WHERE memid=" + memID;
        else sqlstr="SELECT * FROM publiclayerview WHERE true ";
        sqlstr += option + " ORDER BY lname";

        //----------------------------------- query
       try{
            xmllayer += "<?xml version=\"1.0\"?>\r\n";
            xmllayer += "<listlayer>\r\n";

            GisDBConnect gdb=new GisDBConnect();
            GisDBConnect gdbx=new GisDBConnect();
            gdb.query(sqlstr);
            while (gdb.getReturn().next() ){
                try{
                    int lid = gdb.getReturn().getInt("lid");
                    String lname = gdb.getReturn().getString("lname");
                    String owner = gdb.getReturn().getString("ownname");
                    String tbname = gdb.getReturn().getString("tbname");
                    String geomtype = gdb.getReturn().getString("geomtype");
                    xmllayer += "  <layer id='"+lid+"' name='"+lname+"' owner='"+owner+"' geomtype='"+geomtype+"' >\r\n";
                    gdbx.query("SELECT * FROM columnview WHERE tbname='"+tbname.toLowerCase()+"' ;") ;
                    xmllayer += "    <attribute datatype='integer'>id</attribute>\r\n";
                    while (gdbx.getReturn().next()){
                        String columnname=gdbx.getReturn().getString("colname");
                        String datatype=gdbx.getReturn().getString("datatype");
                        xmllayer += "    <attribute datatype='"+datatype+"'>"+columnname+"</attribute>\r\n";
                    }
                }catch(Exception e){

                }
                xmllayer += "  </layer>\r\n";
            }
            xmllayer += "</listlayer>\r\n";
            return xmllayer;
        }catch (Exception e){}

        return sqlstr;

     }

     //********************************************************* DELETE LAYER
    public int deleteLayer(String sessionkey, int layerID){
        int level=7;
        int ownid=0;
        GisDBConnect gdb;

         //-------------- check is logging in owner
         try{
             gdb = new GisDBConnect();
             gdb.query("SELECT level,ownid FROM sessionview WHERE sessid='"+sessionkey+"'");
             gdb.getReturn().next();
             level = gdb.getReturn().getInt("level") ;
             ownid = gdb.getReturn().getInt("ownid") ;
             if (level>2) return 5;
         }catch(Exception e){
             return 4;
         }

         try{
              String sqlstr=new String("");
              String tbname="null";

              gdb = new GisDBConnect();

              sqlstr = "SELECT tbname FROM layer WHERE lid="+layerID+" AND ownid="+ownid;
              gdb.query(sqlstr);
              gdb.getReturn().next();
              tbname = gdb.getReturn().getString("tbname") ;

              if (tbname.toLowerCase().indexOf("tb_")>0){

                  gdb.exeSQL("BEGIN");
                  sqlstr = "DELETE FROM layer WHERE lid=" + layerID + " AND ownid=" + ownid;
                  gdb.exeSQL(sqlstr);

                  sqlstr = "DROP SEQUENCE " + tbname + "_seq ";
                  gdb.exeSQL(sqlstr);

                  sqlstr = "DROP TABLE " + tbname;
                  gdb.exeSQL(sqlstr);
                  gdb.exeSQL("END");
              }
           }catch(Exception e){
               return 16;
           }

        return layerID;
    }

    //******************************************************** UPDATE LAYER
    public int updateLayer(String sessionkey, int layerID, String layerName){
         int level=7;
         int ownid=0;
         GisDBConnect gdb;

          //-------------- check is logging in root
          try{
              gdb = new GisDBConnect();
              gdb.query("SELECT level,ownid FROM sessionview WHERE sessid='"+sessionkey+"'");
              gdb.getReturn().next();
              level = gdb.getReturn().getInt("level") ;
              ownid = gdb.getReturn().getInt("ownid") ;
              if (level>2) return 5;
          }catch(Exception e){
              return 4;
          }

          //-------------- check for real owner
          try{
              gdb = new GisDBConnect();
              gdb.query("SELECT ownid FROM layer WHERE lid=" + layerID);
              gdb.getReturn().next();
              int ownerx=1;
              ownerx=gdb.getReturn().getInt("ownid") ;
              if (ownid!=ownerx) return 11;
          }catch(Exception e){
              return 11;
          }

          //------------- continue update
          try{
               String sqlstr = "UPDATE layer ";
               sqlstr+=" SET name='" + layerName + "' ";
               sqlstr+=" WHERE lid=" + layerID + " AND ownid=" + ownid;
               gdb.exeSQL(sqlstr);

            }catch(Exception e){
                return 15;
            }

         return layerID;
     }

