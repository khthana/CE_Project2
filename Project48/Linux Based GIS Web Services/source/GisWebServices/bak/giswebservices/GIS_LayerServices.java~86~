    //*********************************************************** INSERT LAYER
    public int insertLayer(String sessionkey,String name, boolean isPublic, String geomType,
                           String xmlTable){

        GisDBConnect gdb;
        int id=0;
        String sqlstr = new String();

        //----------------------------------- check authen
        try{
              gdb=new GisDBConnect();
              gdb.query("SELECT ownid, level FROM sessionview WHERE sessid='"+sessionkey+"'");
              gdb.getReturn().next();
              id = gdb.getReturn().getInt("ownid") ;
              int level = gdb.getReturn().getInt("level") ;
              if (level>2) return 5;
        }catch(Exception e){
              //return 3;
        }

        //------------------------------- check layer integrity
        try{
            gdb=new GisDBConnect();
            boolean hasThisLayer=false;
            sqlstr = "SELECT * FROM layer WHERE ";
            sqlstr+= " LOWER(name)='"+name.toLowerCase()+"' AND ";
            sqlstr+= " ownid="+id;
            while (gdb.getReturn().next() ){
                hasThisLayer=true;
            }
            if (hasThisLayer==true) return 9;

        }catch(Exception e){
              //return 9;
        }


        //------------------------------ create layer
        try{
            gdb=new GisDBConnect();
            int isPub=0;
            if (isPublic==true) isPub=1;

            gdb.exeSQL("BEGIN") ;
            //---sql command insert to LAYER---
            sqlstr = "INSERT INTO LAYER";
            sqlstr += "(name, public, geomtype, ownID)";
            sqlstr += "VALUES ('";
            sqlstr += name + "', " + isPub + ", '" + geomType + "', " + id + ");" ;

            gdb.exeSQL(sqlstr) ;

            //---get LID---
            gdb.query("SELECT last_value FROM layer_seq;");
            gdb.getReturn().next() ;
            int layerID =  gdb.getReturn().getInt("last_value") ;

            gdb.query("SELECT tbname, geomtype FROM LAYER WHERE LID=" + layerID + " ;");
            gdb.getReturn().next() ;
            String tbname = gdb.getReturn().getString(1) ;
            String geomtype = gdb.getReturn().getString(2) ;
            String seqnum = tbname+"_seq";

            //---read xml---
            GisXmlReader gxr = new GisXmlReader(xmlTable) ;

            gdb.exeSQL("create sequence " + seqnum + " minvalue 1001;");

            sqlstr="CREATE TABLE " + tbname + " ( ID int default nextval('" + seqnum + "') , ";
            for (int i=0; i<gxr.child("attribute").count() ; i++){
                sqlstr += gxr.child("attribute",i).value()   + " " + gxr.child("attribute",i).attribute("datatype")   + " , ";
            }

            sqlstr +=" PRIMARY KEY (ID) );";

            gdb.exeSQL(sqlstr) ;

            sqlstr = "SELECT AddGeometryColumn ('GISWSDB','" + tbname.toLowerCase()   +"' , 'geom' , -1 , '" + geomtype.toUpperCase()  + "' , 2) ;";
            gdb.exeSQL(sqlstr) ;
            gdb.exeSQL("END") ;

            return layerID;
        }catch (Exception e){
            return 16 ;
        }
    }

