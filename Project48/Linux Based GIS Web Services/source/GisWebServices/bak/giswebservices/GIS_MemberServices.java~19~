    //********************************************************************** LIST MEMBER
    public String listMember (int ownID){

        try{
            String xmlRes = new String("<?xml version=\"1.0\"?>\r\n");
            xmlRes += "<memberlist>\r\n";

            GisDBConnect gdb = new GisDBConnect();

            gdb.query("SELECT memid, name FROM member WHERE ownid="+ownID+" active=1;");
            while (gdb.getReturn().next() ){
                int id=gdb.getReturn().getInt("memid");
                String memname=gdb.getReturn().getString("name");
                xmlRes += "  <member id='"+id+"'>"+memname+"</member>\r\n";

            }
            xmlRes += "</memberlist>\r\n";
            return xmlRes;
        }catch(Exception e){
            return "0";
        }

    }

