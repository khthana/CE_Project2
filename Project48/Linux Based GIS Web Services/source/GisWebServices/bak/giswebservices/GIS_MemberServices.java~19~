      //************************************************************** UPDATE MEMBER
      public int updateMember(String sessionkey,String name, String address,
                              String phone, String email){

          int memid=0;
          int level=7;
          GisDBConnect gdb;

          //-------------- check is logging in
          try{
              gdb = new GisDBConnect();
              gdb.query("SELECT memid, level FROM sessionview WHERE sessid='"+sessionkey+"'");
              gdb.getReturn().next();
              memid = gdb.getReturn().getInt("memid") ;
              level = gdb.getReturn().getInt("level") ;
              if (level>5) return 5;
          }catch(Exception e){
              return 3;
          }

          //-------------- update
          try{
              String sqlstr=new String("");
              sqlstr += "UPDATE member SET ";
              if(name.length() >0) sqlstr += "name='" + name + "', ";
              if(address.length() >0) sqlstr += "address='" + address + "', ";
              if(phone.length() >0) sqlstr += "phone='" + phone + "', ";
              if(email.length() >0) sqlstr += "email='" + email + "', ";
              sqlstr += "memid=" + memid + " ";
              sqlstr += "WHERE memid=" + memid;
              gdb.exeSQL(sqlstr);
           }catch(Exception e){
               return 15;
           }
          return memid;
      }

      //************************************************************ PERMIT MEMBER
      public int activateMember(String sessionkey,int memID,boolean isActive){

          int level=7;
          int active=0;
          int ownid=0;
          if (isActive==true) active=1;
          GisDBConnect gdb;

          //-------------- check is logging in
          try{
              gdb = new GisDBConnect();
              gdb.query("SELECT ownid,level FROM sessionview WHERE sessid='"+sessionkey+"'");
              gdb.getReturn().next();
              level = gdb.getReturn().getInt("level") ;
              ownid = gdb.getReturn().getInt("ownid") ;
              if (level>2) return 5;
          }catch(Exception e){
              return 3;
          }

          //-------------- update
          try{

              String sqlstr=new String("");;

              sqlstr = "UPDATE member SET ";
              sqlstr += "active=" + active + " ";
              sqlstr += "WHERE memid=" + memID + " AND level>3 ";
              if (level==2) sqlstr += " AND ownid" + ownid;
              gdb.exeSQL(sqlstr);

           }catch(Exception e){
               return 17;
           }

          return memID;
      }

