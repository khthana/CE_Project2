			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="multiplyMatrixResponse">
		<xsd:complexType/>
	</xsd:element>

	<xsd:element name="getValue">
		<xsd:complexType/>
	</xsd:element>
	<xsd:element name="getValueResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="value" type="xsd:int"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
</types>

<message name="multiplyMatrixInputMessage">
	<part element="tns:multiplyMatrix" name="parameters"/>
</message>
<message name="multiplyMatrixOutputMessage">
	<part element="tns:multiplyMatrixResponse" name="parameters"/>
</message>
<message name="GetValueInputMessage">
	<part element="tns:getValue" name="parameters"/>
</message>
<message name="GetValueOutputMessage">
	<part element="tns:getValueResponse" name="parameters"/>
</message>

