<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema 
    targetNamespace="http://www.globus.org/namespaces/2003/12/managed_job/types"
    xmlns:gram="http://www.globus.org/namespaces/2004/02/rsl/gram"
    xmlns:mj-types="http://www.globus.org/namespaces/2003/12/managed_job/types"
    xmlns:ogsi="http://www.gridforum.org/namespaces/2003/03/OGSI"
    attributeFormDefault="qualified"
    elementFormDefault="qualified"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:complexType name="JobStatusType">
    <xsd:annotation>
      <xsd:documentation>
        Type containing information about the current state of the job and, if
        the job failed, fault information.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="jobState" type="mj-types:JobStateType"/>
      <xsd:element name="fault" type="ogsi:ExtensibilityType"
          minOccurs="0"
          maxOccurs="1"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:simpleType name="JobStateType">
    <xsd:annotation>
      <xsd:documentation>
        Job states for a Managed Job.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="Unsubmitted" /> 
      <xsd:enumeration value="StageIn" />
      <xsd:enumeration value="Pending" />
      <xsd:enumeration value="Active"  />
      <xsd:enumeration value="StageOut" />
      <xsd:enumeration value="Suspended" />
      <xsd:enumeration value="Done" />
      <xsd:enumeration value="Failed" />
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="OutputType">
    <xsd:annotation>
        <xsd:documentation>
            Type of a output stream service.
        </xsd:documentation>
    </xsd:annotation>

    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="stdout"/>
      <xsd:enumeration value="stderr"/>
    </xsd:restriction>
  </xsd:simpleType>

  <xsd:simpleType name="ScriptType">
    <xsd:annotation>
      <xsd:documentation>
        Script methods which may be called the Managed Job Services. Faults
        will be associated with one of these script methods.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="submit"/> 
      <xsd:enumeration value="poll" />
      <xsd:enumeration value="cancel" />
      <xsd:enumeration value="signal"  />
      <xsd:enumeration value="make_scratchdir" />
      <xsd:enumeration value="remove_scratchdir" />
      <xsd:enumeration value="stage_in" />
      <xsd:enumeration value="stage_out" />
      <xsd:enumeration value="cache_cleanup" />
      <xsd:enumeration value="remote_io_file_create" />
      <xsd:enumeration value="proxy_relocate" />
      <xsd:enumeration value="proxy_update" />
      <xsd:enumeration value="file_cleanup" />
    </xsd:restriction>
  </xsd:simpleType>

  <!--
  <xsd:complexType name="ManagedJobUserIdLocal">
    <xsd:annotation>
        <xsd:documentation>
            Type wrapper for the ManagedJobUserIdLocal service data 
            value.
        </xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:element name="ManagedJobUserIdLocal" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  -->

  <!-- Fault types -->
  <xsd:complexType name="FaultType">
    <xsd:annotation>
      <xsd:documentation>
        This is the base fault for runtime errors that occur while managing
        a job. It extends the OGSI FaultType.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="ogsi:FaultType">
        <xsd:sequence>
          <xsd:element name="stateWhenFailureOccurred"
              type="mj-types:JobStateType"/>
          <xsd:element name="script" type="mj-types:ScriptType"/>
          <xsd:element name="gt2ErrorCode" type="xsd:int"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="CacheFaultType">
    <!--
      This fault replaces the GT2 error codes
      GLOBUS_GRAM_PROTOCOL_ERROR_OPENING_CACHE,
      GLOBUS_GRAM_PROTOCOL_ERROR_OPENING_CACHE_USER_PROXY,
      GLOBUS_GRAM_PROTOCOL_ERROR_INVALID_CACHE, and
      GLOBUS_GRAM_PROTOCOL_ERROR_WRITING_REMOTE_IO_URL.
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that an error occurred accessing the GASS
        Cache. This fault type contains the path to the GASS Cache
        as one of its elements.

        Some typical causes of this problem are gass cache program not
        installed in the GLOBUS_LOCATION path, or the user's
        home directory is non-existent or full.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType">
        <xsd:sequence>
          <xsd:element name="cachePath" type="xsd:string" minOccurs="1"
              maxOccurs="1"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="CredentialSerializationFaultType">
    <!--
      This fault replaces the GT2 error codes
      GLOBUS_GRAM_PROTOCOL_ERROR_DELEGATION_FAILED,
      GLOBUS_GRAM_PROTOCOL_ERROR_OPENING_USER_PROXY,
      GLOBUS_GRAM_PROTOCOL_ERROR_USER_PROXY_NOT_FOUND,
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the managed job service was unable to
        serialize or deserialize a delegated credential.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="InsufficientCredentialsFaultType">
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the managed job service was unable to
        perform some action on behalf of the owner of the job submission
        because the owner has delegated insufficient credentials.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="InternalFaultType">
    <!--
      This fault replaces the GT2 error codes
      GLOBUS_GRAM_PROTOCOL_ERROR_INVALID_SCRIPT_REPLY,
      GLOBUS_GRAM_PROTOCOL_ERROR_BAD_SCRIPT_ARG_FILE, and
      GLOBUS_GRAM_PROTOCOL_ERROR_TEMP_SCRIPT_FILE_FAILED.
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that an internal operation failed.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="InvalidCredentialsFaultType">
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the managed job service was unable to
        use a delegated credential.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="RepeatedlyStartedFaultType">
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the start method of the Managed Job
        service could not run because the job had already been started.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="SLAFaultType">
    <!--
      This fault replaces the GT2 error codes
          GLOBUS_GRAM_PROTOCOL_ERROR_BAD_RSL_ENVIRONMENT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_ARGUMENTS,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_CACHE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_COUNT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_DIRECTORY,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_DRYRUN
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_ENVIRONMENT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_EXECUTABLE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_FILE_CLEANUP,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_FILE_STAGE_IN,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_FILE_STAGE_IN_SHARED,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_FILE_STAGE_OUT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_GASS_CACHE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_HOST_COUNT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_JOBTYPE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_MAX_CPU_TIME,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_MAX_MEMORY,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_MAXTIME,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_MAX_WALL_TIME,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_MIN_MEMORY,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_MYJOB,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_PARADYN,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_PROJECT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_PROXY_TIMEOUT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_QUEUE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_REMOTE_IO_URL,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_RESERVATION_HANDLE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_RESTART,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_SAVE_STATE,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_SCHEDULER_SPECIFIC,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_SCRATCH,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_START_TIME,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_STDERR,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_STDERR_POSITION,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_STDIN, 
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_STDOUT,
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_STDOUT_POSITION, and
          GLOBUS_GRAM_PROTOCOL_ERROR_RSL_TWO_PHASE_COMMIT
        -->
    <xsd:annotation>
      <xsd:documentation>
        Fault for runtime errors which are directly related to a particular
        part of the SLA document passed to the createService method. This
        fault type contains the fragment of the SLA related to the fault
        as one of its elements.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType">
        <xsd:sequence>
          <xsd:element name="sla" type="ogsi:ExtensibilityType"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="StreamServiceCreationFaultType">
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the Managed Job
        Service could not create the services required to stream standard
        output or stdandard error.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:FaultType">
        <xsd:sequence>
          <xsd:element name="streamService" type="mj-types:OutputType"
              minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="UnresolvedSubstitutionReferencesFaultType">
    <!-- 
      This fault replaces the GT2 error code
      GLOBUS_GRAM_PROTOCOL_ERROR_RSL_EVALUATION_FAILED
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that an element in the SLA
        contains a reference to an undefined subsitution. This
        fault type contains elements that have the value of substitutions
        which could not be resolved.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
    <xsd:extension base="mj-types:FaultType">
      <xsd:sequence>
        <xsd:element name="substitutionName" type="xsd:string"
              minOccurs="1" maxOccurs="unbounded"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="DatabaseAccessFaultType">
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the Managed Job service was unable to
        store persistent state information into the recovery database.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:InternalFaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="ExecutionFailedFaultType">
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the Managed Job service was unable to
        begin the execution of the job.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:SLAFaultType"/>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="FilePermissionsFaultType">
    <!--
      This fault replaces the GT2 error code
      GLOBUS_GRAM_PROTOCOL_ERROR_EXECUTABLE_PERMISSIONS
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that the ManagedJob service does not have
        permissions to access a file referenced in the SLA.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:SLAFaultType">
        <xsd:sequence>
          <xsd:element name="path" type="xsd:string"
              minOccurs="1" maxOccurs="1"/>
          </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="InvalidPathFaultType">
    <!--
      This fault replaces the GT2 error codes
      GLOBUS_GRAM_PROTOCOL_ERROR_BAD_DIRECTORY,
      GLOBUS_GRAM_PROTOCOL_ERROR_EXECUTABLE_NOT_FOUND,
      GLOBUS_GRAM_PROTOCOL_ERROR_STDIN_NOT_FOUND, and
      GLOBUS_GRAM_PROTOCOL_ERROR_INVALID_SCRATCH
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that a file or directory path
        referenced in the SLA contains an invalid path.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:SLAFaultType">
        <xsd:sequence>
          <xsd:element name="path" type="xsd:string"
              minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="StagingFaultType">
    <!--
      This fault replaces the GT2 error codes
      GLOBUS_GRAM_PROTOCOL_ERROR_STAGING_EXECUTABLE,
      GLOBUS_GRAM_PROTOCOL_ERROR_STAGING_STDIN,
      GLOBUS_GRAM_PROTOCOL_ERROR_STAGE_IN_FAILED, and
      GLOBUS_GRAM_PROTOCOL_ERROR_STAGE_OUT_FAILED
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that part of the file staging
        requirements of the SLA could not be completed.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:SLAFaultType">
        <xsd:sequence>
          <xsd:element name="stageToCache" type="xsd:boolean"
                minOccurs="1" maxOccurs="1"/>
          <xsd:element name="source" type="xsd:string"
                minOccurs="1" maxOccurs="1"/>
          <xsd:element name="destination" type="xsd:string"
                minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <xsd:complexType name="UnsupportedFeatureFaultType">
    <!--
      This fault replaces the GT2 error codes
      GLOBUS_GRAM_PROTOCOL_JOBTYPE_NOT_SUPPORTED, and
      GLOBUS_GRAM_PROTOCOL_UNIMPLEMENTED.
    -->
    <xsd:annotation>
      <xsd:documentation>
        This fault indicates that an error occurred because
        the RSL depended on a feature not implemented by
        a particular GRAM scheduler.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="mj-types:SLAFaultType">
        <xsd:sequence>
          <xsd:element name="feature" type="xsd:string"
                minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>

  <!-- Persistance Data Types -->
  <xsd:complexType name="StagingPersistenceDataType">
    <xsd:sequence>
      <xsd:element name="stagingData"
                   minOccurs="0"
                   maxOccurs="unbounded"
                   type="mj-types:StagingDataType">
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="StagingDataType">
    <xsd:sequence>
      <xsd:element name="sourceUrl" type="xsd:string"/>
      <xsd:element name="destinationUrl" type="xsd:string"/>
      <xsd:element name="stagingType" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="StatePersistenceDataType">
    <xsd:sequence>
      <xsd:element name="started" type="xsd:boolean"/>
      <xsd:element name="state" type="xsd:int"/>
      <xsd:element name="status" type="xsd:int"/>
      <xsd:element name="failureCode" type="xsd:string"/>
      <xsd:element name="jobId" type="xsd:string"/>
      <xsd:element name="rsl" type="xsd:string"/>
      <xsd:element name="cacheTag" type="xsd:string"/>
      <xsd:element name="commitTimeout" type="xsd:int"/>
      <xsd:element name="scratchDirectory" type="xsd:string"/>
      <xsd:element name="credentialPath" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>
