    <sd:serviceData element="xsd:anyType" maxOccurs="1" minOccurs="1" mutability="mutable" name="ManagedJobSLA"/>
    <sd:serviceData element="xsd:string" maxOccurs="1" minOccurs="1" mutability="mutable" name="ManagedJobUserIdLocal"/>
    <sd:serviceData element="ogsa-types:ExtensibilityType" maxOccurs="1" minOccurs="1" mutability="mutable" name="UserIdGridCredentials"/>
