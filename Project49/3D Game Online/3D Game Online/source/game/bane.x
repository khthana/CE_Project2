	<HEAD>
		<title>
			ดาวน์โหลดไฟล์แนบ
		</title>
		<META NAME="Description" CONTENT="S! Mail บริการฟรีอีเมล์ ใช้งานง่ายจากสนุกดอทคอม ให้พื้นที่ถึง 1 GB ใช้งานง่ายเพราะเป็นภาษาไทย มีระบบการตรวจสอบไวรัสที่มีประสิทธิภาพ พร้อมลูกเล่นมากมาย เพื่อให้คุณได้ใช้ตามความต้องการ">
		<META NAME="KeyWords" CONTENT="ฟรีอีเมล์, อีเมล์, อี-เมล์, 1 GB, 1 กิ๊ก, email, e-mail, mail, yahoo, hotmail, Gmail, G mail, G-mail">
		<LINK href='/extensions/themes/Sanook/Styles/default.css' type="text/css" rel="stylesheet">
			<script>
		function GetRadWindow()
			{
				var oWindow = null;
				if (window.radWindow) oWindow = window.radWindow;
				else if (window.frameElement.radWindow) oWindow = window.frameElement.radWindow;
				return oWindow;
			}		
		function setWindow()
			{
				var oWindow = GetRadWindow();
				oWindow.SetTitle ("Attachment Option");				
				oWindow.SetStatus("");				
			}	
		function Cancel_Clicked()
			{
				var oWindow = GetRadWindow();
				oWindow.Close();
			}			
						
        var	timerID = null

        function showtime()
        {
	        // Update process
	        if (document.getElementById)
	        {
		        x = document.getElementById('waitMessage');
		        text = x.innerHTML;
		        x.innerHTML = '';
		        x.innerHTML = text + '.';
		        
		        if (x.innerHTML.length > 30)
		        {
					x.innerHTML = 'Please wait ';
		        }
	        }	        
	        timerID = setTimeout("showtime()", 1000)	        
        }                   
        
        function ShowLoading()
        {
            showtime();           
            if (document.getElementById)
	        {
		        x = document.getElementById('waitMessage');
		        x.innerHTML = '';
		        x.innerHTML = 'Please wait ';
	        }
	        else if (document.all)
	        {
		        x = document.all['waitMessage'];
		        x.innerHTML = 'Please wait ';
	        }
	        else if (document.layers)
	        {
		        x = document.layers['waitMessage'];
		        text2 = 'Please wait ';
		        x.document.open();
		        x.document.write(text2);
		        x.document.close();
	        }
	     }
			</script>
	</HEAD>
