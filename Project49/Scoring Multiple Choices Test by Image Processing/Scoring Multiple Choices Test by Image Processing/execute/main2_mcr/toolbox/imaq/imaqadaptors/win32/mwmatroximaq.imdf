        <Property constraint="bounded" default="2.6" deviceSpecific="true" max="2.6" min="1.6"
            name="WhiteReference" readOnly="never" type="double"/>
        <Property constraint="enum" default="2.8" deviceSpecific="true" name="InputGain"
            readOnly="whileRunning" type="string">
            <EnumConstraintValue id="14" name="1.0"/>
            <EnumConstraintValue id="10" name="1.3"/>
            <EnumConstraintValue id="11" name="2.0"/>
            <EnumConstraintValue id="12" name="2.8"/>
            <EnumConstraintValue id="13" name="4.0"/>
        </Property>
        <Property constraint="bounded" default="1" deviceSpecific="true" max="16" min="1"
            name="XScaleFactor" readOnly="never" type="int"/>
        <Property constraint="bounded" default="1" deviceSpecific="true" max="16" min="1"
