    public String departGroup(String sessionkey,String groupname)
    {
        UserServices service = new UserServices();
        int memberid = service.checkSession(sessionkey);
         if (memberid != -1)
         {
             try
             {
                 GisDBConnect gdb = new GisDBConnect();
                 gdb.query("SELECT groupid,moderatorid FROM campusgroup WHERE name='" + groupname +
                           "';");
                 gdb.getReturn().next();
                 int groupid = gdb.getReturn().getInt("groupid");
                 int moderatorid = gdb.getReturn().getInt("moderatorid");

                 if(memberid == moderatorid)
                 {
                     System.out.println("Error : A moderator cannot depart from group");
                     return "Error : A moderator cannot depart from group";
                 }

                 gdb.exeSQL("DELETE FROM membergroup WHERE memberid='" + memberid +
                            "' AND groupid='" + groupid + "';");
                 System.out.println("OK");
                 return "OK";
             }
             catch (Exception ex) {
                 System.out.println("Error : "+ex.getMessage());
                 return "Error : "+ex.getMessage();
             }
         }
         System.out.println("Error : Session error");
         return "Error : Session error";
    }


