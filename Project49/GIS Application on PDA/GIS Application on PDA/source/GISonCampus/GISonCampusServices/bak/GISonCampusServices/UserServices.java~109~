                      GisDBConnect gdb3 = new GisDBConnect();
                      gdb2.query("SELECT contactid FROM contact WHERE ownerid="+memberid+" AND mateid="+mateid+";");
                      gdb3.query("SELECT contactid FROM contact WHERE ownerid="+mateid+" AND mateid="+memberid+";");
                      if(gdb2.getReturn().next())
                      {
                          GisDBConnect gdb = new GisDBConnect();
                          gdb.exeSQL("DELETE FROM contact WHERE contactid=" + gdb2.getReturn().getString("contactid")+ ";");
                      }
                      else if(gdb3.getReturn().next())
                      {
