    public int checkSession(String sessionkey) {
        try{
            GisDBConnect gdbs=new GisDBConnect();
            gdbs.exeSQL("UPDATE session SET timeout=60 WHERE sessionid='"+sessionkey+"' ");
        }catch(Exception e){}

         GisDBConnect gdb;
         int memberid;

         try
         {
             gdb = new GisDBConnect();
             gdb.query("SELECT memberid FROM session WHERE sessionid='"+sessionkey+"'");
             gdb.getReturn().next();
             memberid = gdb.getReturn().getInt("memberid") ;
          }
          catch(Exception e)
          {
              return -1;
          }
          return memberid;
    }

