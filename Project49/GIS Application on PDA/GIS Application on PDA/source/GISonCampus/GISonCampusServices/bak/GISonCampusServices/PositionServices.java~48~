                gdb.query("SELECT username FROM member WHERE memberid=" +
                          contactid + ";");
                gdb.getReturn().next();
                String username = gdb.getReturn().getString("username");

                gdb.query("SELECT * FROM position WHERE elementid=" + elementid +
                          "order by positionid desc;");

                xmlRes += "<element id='" + elementid + "' objectid='" +
