    public PositionServices(){}

   public String updatePosition(String sessionkey,String posX,String posY)
   {
       UserServices service = new UserServices();
        int memberid = service.checkSession(sessionkey);
        if(memberid != -1){
        try
        {
            GisDBConnect gdb = new GisDBConnect();

            gdb.query("SELECT elementid FROM element WHERE type=0 AND id="+memberid+";");
            gdb.getReturn() .next() ;
            int elementid = gdb.getReturn().getInt("elementid");

            gdb.query("SELECT positionid FROM position order by positionid desc;");
            gdb.getReturn() .next() ;
            int positionid = gdb.getReturn().getInt("positionid")+1;
            Date time = new Date();
            gdb.exeSQL("INSERT INTO position  VALUES("
                        + positionid +","+elementid+ ", " + posX + ","+posY+","+time.getTime()+");") ;
             System.out.println("OK");
            return "OK";
        }
        catch(Exception e){
            System.out.println("Error : "+e.getMessage());
            return "Error : "+e.getMessage();
        }}
       System.out.println("Error : No Session");
        return "Error : No Session";

   }

