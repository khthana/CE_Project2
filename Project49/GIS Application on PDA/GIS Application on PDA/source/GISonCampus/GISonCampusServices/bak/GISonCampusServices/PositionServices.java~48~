   public String getMyRecordPosition(String sessionkey)
   {
       UserServices service = new UserServices();
        int memberid = service.checkSession(sessionkey);
        if(memberid != -1){
        try
        {
            GisDBConnect gdb = new GisDBConnect();

            gdb.query("SELECT elementid FROM element WHERE type=0 AND id="+memberid+";");
            gdb.getReturn() .next() ;
            int elementid = gdb.getReturn().getInt("elementid");

            gdb.query("SELECT username FROM member WHERE memberid="+memberid+";");
            gdb.getReturn() .next() ;
            String username = gdb.getReturn().getString("username");


            gdb.query("SELECT * FROM position WHERE elementid="+elementid+"order by positionid desc;");

            String xmlRes = new String("<?xml version='1.0' encoding='UTF-8'?>\r\n");
             xmlRes += "<positions>\r\n";

             xmlRes += "<element id='"+elementid+"' objectid='"+memberid+"'"+
                        " type='0' label='"+username+"'>\n";

            while(gdb.getReturn().next())
            {
                xmlRes += "     <position>\n"+
                          "          <posx>"+gdb.getReturn().getString("posx")+"</posx>\n"+
                          "          <posy>"+gdb.getReturn().getString("posy")+"</posy>\n"+
                          "          <time>"+gdb.getReturn().getString("time")+"</time>\n"+
                          "     </position>\n";

            }
            xmlRes += "</element>\n";

           xmlRes += "</positions>";
           System.out.println(xmlRes);
            return xmlRes;
        }
        catch(Exception e){
            System.out.println("Error : "+e.getMessage());
            return "Error : "+e.getMessage();
        }}
       System.out.println("Error : No Session");
        return "Error : No Session";

   }

   public String getContactsPosition(String sessionkey)
   {
       UserServices service = new UserServices();
        int memberid = service.checkSession(sessionkey);
        if(memberid != -1){
        try
        {
            String xmlRes = new String(
                        "<?xml version='1.0' encoding='UTF-8'?>\r\n");
                xmlRes += "<positions>\r\n";


            GisDBConnect gdb2 = new GisDBConnect();

            gdb2.query("SELECT * FROM contact WHERE (ownerid="+memberid+" OR mateid="+memberid+") AND active=true;");
            while(gdb2.getReturn() .next())
            {
                int contactid;
                if(gdb2.getReturn().getInt("ownerid") == memberid)
                {
                    contactid = gdb2.getReturn().getInt("mateid");
                }
                else
                {
                    contactid = gdb2.getReturn().getInt("ownerid");
