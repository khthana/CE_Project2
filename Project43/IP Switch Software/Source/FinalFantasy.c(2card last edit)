	PacketSetHwFilter(lpAdapter, NDIS_PACKET_TYPE_PROMISCUOUS);
	PacketSetHwFilter(lpAdapter2,NDIS_PACKET_TYPE_PROMISCUOUS);

	// set a 512K buffer in the driver
	PacketSetBuff(lpAdapter,512000); // 512000
	PacketSetBuff(lpAdapter2,512000);

	// set a 1 second read timeout
	PacketSetReadTimeout(lpAdapter,1000);
	PacketSetReadTimeout(lpAdapter2,1000);
	
	//allocate and initialize a packet structure that will be used to
	//receive the packets.
	if((lpPacket = PacketAllocatePacket())==NULL){
		printf("\nError:failed to allocate the LPPACKET structure.");
		return (-1);
	}
	if((lpPacket2 = PacketAllocatePacket())==NULL){
		printf("\nError:failed to allocate the LPPACKET structure.");
		return (-1);
	} 
	PacketInitPacket(lpPacket,(char*)buffer,256000); //max size of buffer=256000 byte(or char)
	PacketInitPacket(lpPacket2,(char*)bufferb,256000); //max size of buffer=256000 byte(or char)

	//main capture loop
	while(!kbhit()) // check keyboard hit; if not hit return =0;
	{         
		// capture the packets		
		if(PacketReceivePacket(lpAdapter,lpPacket,TRUE)==FALSE){
			printf("Error: PacketReceivePacket failed");
			return (-1);
		}
		if(PacketReceivePacket(lpAdapter2,lpPacket2,TRUE)==FALSE){
			printf("Error: PacketReceivePacket failed");
			return (-1);
		}
		//printf("cpu_time = %d\n",cpu_time);
//		round=round + 1;
//		printf("round %d\n",round);
//		printf("use time per loop = %f\n",clock()-cpu_time);
//		cpu_time = clock (); 
		port=0; TablePackets(lpPacket);		
		port=1; TablePackets(lpPacket2); 
	}
	//print the capture statistics
	PacketGetStats(lpAdapter,&stat);
	printf("\n\n%s",AdapterList[0]);
	printf(" %d packets received. %d Packets lost\n",stat.bs_recv,stat.bs_drop);
	PacketGetStats(lpAdapter2,&stat);
	printf("%s",AdapterList[1]);
	printf(" %d packets received. %d Packets lost\n\n",stat.bs_recv,stat.bs_drop);

	PacketFreePacket(lpPacket);
	PacketFreePacket(lpPacket2);

	// close the adapter and exit
	PacketCloseAdapter(lpAdapter);
	PacketCloseAdapter(lpAdapter2);

	// Display Table row 1-5
	for (i=0;i<5;i++){
		printf("tableA[%d] = ",i);
		for (m=0;m<20;m++){
			printf("%02x ",tableA[i][m]);
            if (m==19) printf("\n");
		} 
	}   printf("\n");
	for (i=0;i<5;i++){
		printf("tableB[%d] = ",i);
		for (m=0;m<20;m++){
			printf("%02x ",tableB[i][m]);
            if (m==19) printf("\n");
		} 
	} 
	return (0);
}
