	printf("AdapterList[0]=%s AdapterList[1]=%s\n\n",AdapterList[0],AdapterList[1]);
	printf("Press Anykey to stop\n");
	printf("Runing....\n");
	
	if (!lpAdapter || (lpAdapter->hFile == INVALID_HANDLE_VALUE))
	{
		dwErrorCode=GetLastError();
		printf("Unable to open the driver, Error Code : %lx\n",dwErrorCode); 

		return(-1);
	}	

	if (!lpAdapter2 || (lpAdapter2->hFile == INVALID_HANDLE_VALUE))
	{
		dwErrorCode=GetLastError();
		printf("Unable to open the driver, Error Code : %lx\n",dwErrorCode); 

		return(-1);
	}
	
