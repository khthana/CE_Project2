                       for (xx=0;xx<rowB;xx++)
					      for (ww=0;ww<6;ww++){  // check MAC source in It's table (tableB)
						    if (tem[ww]==tableB[xx][ww]){ 
				    	       if (ww==5) { // Found MAC in tableB
							      xx=rowB; // Send ARP Forword to port0 (RTL8139)
								  for(zz=0;zz<=Snaplen;zz++)
     								packetbuff[zz] = *(BYTE *)pChar++;
								  // Send Packet Forword to port 0 (RTL8139)
								  PacketInitPacket(lpPacket3,packetbuff,Snaplen);
								  PacketSetNumWrites(lpAdapter3,1);
								  PacketSendPacket(lpAdapter3,lpPacket3,FALSE);
							   }
							}
						    else ww=6;
						  }
					}
					else { // ****** Built ARP Use MAC+IP From Packet ******
					   for (xx=0;xx<rowB;xx++)
					      for (ww=0;ww<6;ww++){  // check MAC source in It's self tableB
						    if (tem[ww]==tableB[xx][ww]){ 
				    	       if (ww==5) { // Found MAC in tableB
							      xx=rowB; // Send ARP Forword to port0 (RTL8139)
								  packetbuff[12]=0x08;	
								  packetbuff[13]=0x06;	
								  packetbuff[14]=0x00;	
								  packetbuff[15]=0x01; 
								  packetbuff[16]=0x08;	
								  packetbuff[17]=0x00;	
								  packetbuff[18]=0x06;	
								  packetbuff[19]=0x04; 
								  packetbuff[20]=0x00;						   
								  for(zz=0;zz<6;zz++) { 
									packetbuff[zz]=0xff;      // MAC Destination (MAC Header)
									packetbuff[zz+6]=tem[zz]; // MAC Source (MAC Header)
									packetbuff[zz+22]=tem[zz];// MAC Sender(ARP Header) 
									packetbuff[zz+32]=0x00;   // MAC Target (ARP Header)									
								  }
								  for(zz=0;zz<4;zz++) {	
									packetbuff[zz+28]=tem[zz+6]; // IP Sender  (ARP Header)
									packetbuff[zz+38]=tem[zz+16];  // IP Target  (ARP Header)
								  }
								  packetbuff[21]=0x01;         // ARP -> (1) request to port 0
								  for(zz=42;zz<61;zz++)
									packetbuff[zz]=0x20;
								  // ***** Send ARP request *****
								  PacketInitPacket(lpPacket3,packetbuff,60);
								  PacketSetNumWrites(lpAdapter3,1); 
								  PacketSendPacket(lpAdapter3,lpPacket3,FALSE);
								}
							}
						    else ww=6;
						  }	         
					} // end else	
				  } // end if (found!=0)
				} // end if (send!=0)
			} // end if port=1
		} // end if check=0									
