REGEDIT
; This .REG file may be used by your SETUP program.
;   If a SETUP program is not available, the entries below will be
;   registered in your InitInstance automatically with a call to
;   CWinApp::RegisterShellFileTypes and COleObjectFactory::UpdateRegistryAll.

HKEY_CLASSES_ROOT\.osg = Ongsig.Document
HKEY_CLASSES_ROOT\Ongsig.Document\shell\open\command = ONGSIG.EXE %1
HKEY_CLASSES_ROOT\Ongsig.Document\shell\open\ddeexec = [open("%1")]
HKEY_CLASSES_ROOT\Ongsig.Document\shell\open\ddeexec\application = ONGSIG
    ; note: the application is optional
    ;  (it defaults to the app name in "command")

HKEY_CLASSES_ROOT\Ongsig.Document = Ongsig Document
HKEY_CLASSES_ROOT\Ongsig.Document\protocol\StdFileEditing\server = ONGSIG.EXE
HKEY_CLASSES_ROOT\Ongsig.Document\protocol\StdFileEditing\verb\0 = &Edit
HKEY_CLASSES_ROOT\Ongsig.Document\Insertable =
HKEY_CLASSES_ROOT\Ongsig.Document\CLSID = {8A5F6383-F56B-11D4-B029-0050BF0BFEF1}

HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1} = Ongsig Document
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\DefaultIcon = ONGSIG.EXE,1
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\LocalServer32 = ONGSIG.EXE
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\ProgId = Ongsig.Document
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\MiscStatus = 32
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\AuxUserType\3 = ongsig
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\AuxUserType\2 = Ongsig
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\Insertable = 
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\verb\1 = &Open,0,2
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\verb\0 = &Edit,0,2
HKEY_CLASSES_ROOT\CLSID\{8A5F6383-F56B-11D4-B029-0050BF0BFEF1}\InprocHandler32 = ole32.dll
