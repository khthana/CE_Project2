IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&Signature"
    BEGIN
        MENUITEM "&New signature",              ID_SIGNATURE_NEWSIGNATURE
        MENUITEM "&Remove signature",           ID_SIGNATURE_REMOVESIGNATURE
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "Cu&t\tCtrl+X",                ID_EDIT_CUT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About IsagSign...",          ID_APP_ABOUT
    END
END

