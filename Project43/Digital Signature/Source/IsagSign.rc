/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_NEWSIG DIALOGEX 0, 0, 340, 223
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add new signature"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_NAME,77,18,139,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_SURNAME,77,44,139,14,ES_AUTOHSCROLL
    CONTROL         "MD4",IDC_MD4,"Button",BS_AUTORADIOBUTTON,77,72,31,8
    CONTROL         "MD5",IDC_MD5,"Button",BS_AUTORADIOBUTTON,124,72,34,8
    CONTROL         "SHA-1",IDC_SHA1,"Button",BS_AUTORADIOBUTTON,172,72,36,8
    COMBOBOX        IDC_SIGSIZE,77,98,52,66,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    CONTROL         "Use Picture for Signature",IDC_USEPIC,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,15,130,99,9
    PUSHBUTTON      "Browse...",IDC_BROWSE,187,169,50,14,WS_DISABLED
    DEFPUSHBUTTON   "OK",IDOK,283,17,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,283,44,50,14
    LTEXT           "Name",IDC_STATIC,16,21,20,8
    LTEXT           "Surname",IDC_STATIC,16,46,28,8
    CONTROL         "",IDC_THUMNAIL,"Static",SS_BITMAP | SS_CENTERIMAGE | 
                    WS_DISABLED,20,151,150,50,WS_EX_DLGMODALFRAME | 
                    WS_EX_CLIENTEDGE
    GROUPBOX        "User Data",IDC_STATIC,7,7,259,209
    GROUPBOX        "Signature Picture",IDC_TXTSIGPIC,14,141,244,66,
                    WS_DISABLED
    LTEXT           "Hash Algorithm",IDC_STATIC,16,72,47,10
    LTEXT           "Signature Size",IDC_STATIC,16,99,44,8
    LTEXT           "bits",IDC_STATIC,135,100,12,8
    GROUPBOX        "Note:",IDC_STATIC,273,72,60,144
    LTEXT           "Long signature size will use long time to generate.",
                    IDC_STATIC,279,86,48,37
END

IDD_WAIT DIALOG DISCARDABLE  0, 0, 187, 98
STYLE DS_CENTER | WS_POPUP | WS_VISIBLE
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Please Wait this may take a few minute...",IDC_STATIC,
                    21,41,141,8
END


