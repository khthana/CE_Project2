  public String convertTagToMore(String s) {
    int b = 0;
    while (s.indexOf('<',0)!=-1) {
      int a = s.indexOf('<',b);
      b = a;
      s = s.substring(0,a)+"$lt;"+s.substring(a+1);
    }
    b = 0;
    while (s.indexOf('>',0)!=-1) {
      int a = s.indexOf('>',b);
      b = a;
      s = s.substring(0,a)+"$gt;"+s.substring(a+1);
    }
    return s;
  }
