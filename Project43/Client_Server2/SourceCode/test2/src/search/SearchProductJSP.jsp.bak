<%!
    HttpSession session;
    quote.Quote quote;
    customer.Customer customer;
    String username;
    String attributeRef[][];
    String tmp="";
    String s;
    String message = "";
    String userType;

  public boolean checkAttribute(HttpServletRequest request) {
  System.out.println("in checkAttribute");
    String b1Value;
    String b2Value;
    String textValue;
    String quantity = request.getParameter("quantity");
  System.out.println("quantityy  = "+quantity);
  if (quantity==null) {return false;}
    if (quantity!=null) {
    if (quantity.equals("all")) {
    } else {
    if (quantity.equals("between")) {
      b1Value = request.getParameter("quantityB1");
      b2Value = request.getParameter("quantityB2");
      try {
        Integer.valueOf(b1Value.trim()).intValue();
        Integer.valueOf(b2Value.trim()).intValue();
      } catch (Exception e) {
        message = "quantity for search must be whole number";
        return false;
      }
    } else {
    if (quantity.equals("equal")||quantity.equals("more")||quantity.equals("lower")) {
      textValue = request.getParameter("quantityText");
      try {
        Integer.valueOf(textValue.trim()).intValue();
      } catch (Exception e) {
        message = "quantity for search must be whole number";
        return false;
      }
    }}}
    }

    String importPrice = request.getParameter("importPrice");
    if (importPrice!=null) {
    if (importPrice.equals("all")) {
    } else {
    if (importPrice.equals("between")) {
      b1Value = request.getParameter("importPriceB1");
      b2Value = request.getParameter("importPriceB2");
      try {
        Double.valueOf(b1Value.trim()).doubleValue();
        Double.valueOf(b2Value.trim()).doubleValue();
      } catch (Exception e) {
        message = "Import Price for search must be number";
        return false;
      }
    } else {
    if (importPrice.equals("equal")||importPrice.equals("more")||importPrice.equals("lower")) {
      textValue = request.getParameter("importPriceText");
      try {
        Double.valueOf(textValue.trim()).doubleValue();
      } catch (Exception e) {
        message = "Import Price for search must be number";
        return false;
      }
    }}}
    }

    String sellPrice = request.getParameter("sellPrice");
    if (sellPrice!=null) {
    if (sellPrice.equals("all")) {
    } else {
    if (sellPrice.equals("between")) {
      b1Value = request.getParameter("sellPriceB1");
      b2Value = request.getParameter("sellPriceB2");
      try {
        Double.valueOf(b1Value.trim()).doubleValue();
        Double.valueOf(b2Value.trim()).doubleValue();
      } catch (Exception e) {
        message = "Sell Price for search must be number";
        return false;
      }
    } else {
    if (sellPrice.equals("equal")||sellPrice.equals("more")||sellPrice.equals("lower")) {
      textValue = request.getParameter("sellPriceText");
      try {
        Double.valueOf(textValue.trim()).doubleValue();
      } catch (Exception e) {
        message = "Sell Price for search must be number";
        return false;
      }
    }}}
    }

    String lowSellQuantity = request.getParameter("lowSellQuantity");
    if (lowSellQuantity!=null) {
    if (lowSellQuantity.equals("all")) {
    } else {
    if (lowSellQuantity.equals("between")) {
      b1Value = request.getParameter("lowSellQuantityB1");
      b2Value = request.getParameter("lowSellQuantityB2");
      try {
        int lowQuan1 = Integer.valueOf(b1Value).intValue();
        int lowQuan2 = Integer.valueOf(b2Value).intValue();
        if (lowQuan1>0 || lowQuan2>0) {
          message = "Low Sell Quantity for search must lower or equal zero";
          return false;
        }
      } catch (Exception ex) {
        message = "Low Sell quantity for search must be whole number";
        return false;
      }
    } else {
    if (lowSellQuantity.equals("equal")||lowSellQuantity.equals("more")||lowSellQuantity.equals("lower")) {
      textValue = request.getParameter("lowSellQuantityText");
      try {
        int lowQuan = Integer.valueOf(textValue).intValue();
        if (lowQuan>0) {
          message = "Low Sell Quantity for search must lower or equal zero";
          return false;
        }
      } catch (Exception ex) {
        message = "Low Sell Quantity for search must be whole number";
        return false;
      }
    }}}
    }

    String lastReceiveDate = request.getParameter("lastReceiveDate");
    if (lastReceiveDate!=null) {
    if (lastReceiveDate.equals("all")) {
    } else {
    if (lastReceiveDate.equals("between")) {
      b1Value = request.getParameter("lastReceiveDateB1");
      String s = b1Value;
      int a = s.indexOf('/',0);
      int b = s.indexOf('/',a+1);
      try {
        int d = Integer.valueOf(s.substring(0,a)).intValue();
        if (d>31) {
          message = "Date for search must lower or equal 31";
          return false;
        }
      } catch (Exception ex) {
        message = "Date for search must be whole number";
        return false;
      }
      try {
        int m = Integer.valueOf(s.substring(a+1,b)).intValue();
        if (m>12) {
          message = "Month for search must lower or equal 12";
          return false;
        }
      } catch (Exception ex) {
        message = "Month for search must be whole number";
        return false;
      }
      try {
        int y = Integer.valueOf(s.substring(b+1)).intValue();
        if (y<1900) {
          message = "Year for search must larger 1900";
          return false;
        }
      } catch (Exception ex) {
        message = "Year for search must be whole number";
        return false;
      }
      b2Value = request.getParameter("lastReceiveDateB2");
      s = b2Value;
      a = s.indexOf('/',0);
      b = s.indexOf('/',a+1);
      try {
        int d = Integer.valueOf(s.substring(0,a)).intValue();
        if (d>31) {
          message = "Date for search must lower or equal 31";
          return false;
        }
      } catch (Exception ex) {
        message = "Date for search must be whole number";
        return false;
      }
      try {
        int m = Integer.valueOf(s.substring(a+1,b)).intValue();
        if (m>12) {
          message = "Month for search must lower or equal 12";
          return false;
        }
      } catch (Exception ex) {
        message = "Month for search must be whole number";
        return false;
      }
      try {
        int y = Integer.valueOf(s.substring(b+1)).intValue();
        if (y<1900) {
          message = "Year for search must larger 1900";
          return false;
        }
      } catch (Exception ex) {
        message = "Year for search must be whole number";
        return false;
      }

    } else {
    if (lastReceiveDate.equals("equal")||lastReceiveDate.equals("more")||lastReceiveDate.equals("lower")) {
      textValue = request.getParameter("lastReceiveDateText");
      String s = textValue;
      int a = s.indexOf('/',0);
      int b = s.indexOf('/',a+1);
      try {
        int d = Integer.valueOf(s.substring(0,a)).intValue();
        if (d>31) {
          message = "Date for search must lower or equal 31";
          return false;
        }
      } catch (Exception ex) {
        message = "Date for search must be whole number";
        return false;
      }
      try {
        int m = Integer.valueOf(s.substring(a+1,b)).intValue();
        if (m>12) {
          message = "Month for search must lower or equal 12";
          return false;
        }
      } catch (Exception ex) {
        message = "Month for search must be whole number";
        return false;
      }
      try {
        int y = Integer.valueOf(s.substring(b+1)).intValue();
        if (y<1900) {
          message = "Year for search must larger 1900";
          return false;
        }
      } catch (Exception ex) {
        message = "Year for search must be whole number";
        return false;
      }
    }}}
    }
  return true;
  }

%>
<%
  session = request.getSession(true);
  quote = (quote.Quote) session.getValue("quote");
  if (quote!=null) {
    customer = (customer.Customer)quote.getCustomer();
    username = (String)customer.getPrimaryKey();
    userType = quote.getUserType();
  }
  String category = SearchProductJSPBeanId.getCategory();
  session = request.getSession(true);
  if (checkAttribute(request)) {
    getServletConfig().getServletContext().getRequestDispatcher("/SearchProductServletAlias").forward(request,response);
  } else {
    out.println(message);
  }
  if (!category.equals("Anything")) {
    out.println(" Category is "+category);
  }
