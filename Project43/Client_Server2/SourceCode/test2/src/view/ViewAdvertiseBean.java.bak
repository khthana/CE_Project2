  public ViewAdvertiseBean() {
    try {
      Context ic = new InitialContext();
      java.lang.Object objref = ic.lookup("MyPicture");
      pictureHome = (PictureHome) PortableRemoteObject.narrow(objref,
                     PictureHome.class);
      objref = ic.lookup("MyLoadFileAdvertise");
      loadFileAdvertiseHome = (LoadFileAdvertiseHome) PortableRemoteObject.narrow(objref,
                               LoadFileAdvertiseHome.class);
      System.out.println("obtained picture Home object");
    } catch (Exception re) {
      System.err.println ("Couldn't locate entity Home");
      re.printStackTrace();
    }
  }
  public Collection getProductShow() {
    try {
      String condition = " where show = 'yes'";
      Collection c = pictureHome.findByCondition(condition);
      return c;
    } catch (Exception ex) {
      ex.printStackTrace();
      return null;
    }
  }

