  public String convertMoreToTag(String s) {
    int b = 0;
    while (s.indexOf("$lt;",0)!=-1) {
      int a = s.indexOf("$lt;",b);
      b = a;
      s = s.substring(0,a)+"<"+s.substring(a+4);
    }
     b = 0;
    while (s.indexOf("$gt;",0)!=-1) {
      int a = s.indexOf("$gt;",b);
      b = a;
      s = s.substring(0,a)+">"+s.substring(a+4);
    }
    return s;
  }
  public String changeSpace(String s) {
    while (s.indexOf(' ',0)!=-1) {
      int a = s.indexOf(' ',0);
      s = s.substring(0,a)+"%20"+s.substring(a+1);
    }
    return s;
  }

  public boolean getHavePic() { return havePic; }
  public void setHavePic(boolean havePic) { this.havePic = havePic; }
///////////////////   GET & SET  Method  /////////////////////////
  public String getFilePic1() { return changeSpace(filePic1); }
