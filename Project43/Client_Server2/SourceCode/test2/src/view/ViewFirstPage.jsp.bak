    base.BaseAttribute baseAttribute;
    blueprint.Blueprint blueprint;
    customer.Customer customer;
    quote.Quote quote;
    buy.BuyHome buyHome;
    product.ProductHome productHome;
%>
<body bgcolor="#FFFFFF" text="#000000">
<table width="100%" border="0">
  <tr bgcolor="#FFFFCC"> 
    <td> 
