    }
    catch(SQLException e) {
      throw new EJBException("Error executing SQL DELETE FROM BUY WHERE USERNAME = ? AND PRODUCT_ID = ? AND RECEIPT_NO = ?: " + e.toString());
    }
    finally {
      try {
        if (statement != null) {
          statement.close();
