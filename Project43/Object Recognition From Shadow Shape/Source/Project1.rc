    BUTTON      ID_BUTTON_CLEAR
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Data...",               ID_BUTTON_LOAD
        MENUITEM "&Save Data",                  ID_BUTTON_SAVE
        MENUITEM "Save &As...",                 ID_BUTTON__SAVE_AS
        MENUITEM "Load &Image...",              ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
    END
    POPUP "&Setting"
    BEGIN
        MENUITEM "Set &Base Point 's Minimum...", ID_BUTTON_SET
    END
    POPUP "&Network"
    BEGIN
        MENUITEM "S&how NetWork...",            ID_BUTTON_SHOW
        MENUITEM "Clea&r Network",              ID_BUTTON_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "&Training...",                ID_BUTTON_TRAIN
        MENUITEM "&Classification",             ID_BUTTON_CLASS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Project1...",          ID_APP_ABOUT
    END
END


