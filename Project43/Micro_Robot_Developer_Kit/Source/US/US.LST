 121          unsigned char _I2CReceiveByte(void) // lastone == 1 for last unsigned char
 122          {
 123   1      	register unsigned char i, res;
 124   1      	res = 0;
 125   1      	SCL_PIN = 1;
 126   1      	for (i=0;i<8;i++)         // each bit at a time, MSB first
 127   1      	{
 128   2      		while (!SCL_PIN) {}
 129   2      		res *= 2;
 130   2       		if (SDA_PIN)
 131   2      		{
 132   3      			res++;
 133   3      		}
 134   2      		while (SCL_PIN) {}
 135   2      	}
 136   1      	SDA_PIN = 0;         // send ACK according to 'lastone'
 137   1      	while (!SCL_PIN) {}
 138   1      	while (SCL_PIN) {}
 139   1      	SDA_PIN = 1;
 140   1      	SCL_PIN = 1;
 141   1      	return res;
 142   1      }
