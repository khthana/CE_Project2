 144          void I2CSendByte(unsigned char bt)
 145          {
 146   1        register unsigned char i;
 147   1        for (i=0; i<8; i++)
 148   1        {
 149   2          if (bt & 0x80) SDA_PIN = 1;      // send each bit, MSB first
