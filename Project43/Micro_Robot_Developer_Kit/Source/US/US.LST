 151   2          _I2CSCLHigh();
 152   2          _I2CBitDelay();
 153   2          SCL_PIN = 0;
 154   2          _I2CBitDelay();
 155   2      	bt = bt << 1;
 156   2        }
 157   1        SDA_PIN = 1;                       // listen for ACK
 158   1        _I2CSCLHigh();
 159   1        _I2CBitDelay();
 160   1        if (SDA_PIN)
 161   1          _i2c_error &= 0x01;          // ack didn't happen, may be nothing out there
 162   1        SCL_PIN = 0;
 163   1        _I2CBitDelay();
 164   1      }
