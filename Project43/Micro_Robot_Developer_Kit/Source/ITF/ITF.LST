 152          unsigned char _I2CReceiveByte(void) // lastone == 1 for last unsigned char
 153          {
 154   1      	register unsigned char i, res;
 155   1      	res = 0;
 156   1      	SCL_PIN = 1;
 157   1      	for (i=0;i<8;i++)         // each bit at a time, MSB first
 158   1      	{
 159   2      		while (!SCL_PIN) {}
 160   2      		res *= 2;
 161   2       		if (SDA_PIN)
 162   2      		{
 163   3      			res++;
 164   3      		}
 165   2      		while (SCL_PIN) {}
 166   2      	}
 167   1      	SDA_PIN = 0;         // send ACK according to 'lastone'
 168   1      	while (!SCL_PIN) {}
 169   1      	while (SCL_PIN) {}
 170   1      	SDA_PIN = 1;
 171   1      	SCL_PIN = 1;
 172   1      	return res;
 173   1      }
