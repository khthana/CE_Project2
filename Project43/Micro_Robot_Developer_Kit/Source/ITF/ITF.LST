 175          void I2CSendByte(unsigned char bt)
 176          {
 177   1        register unsigned char i;
 178   1        for (i=0; i<8; i++)
 179   1        {
C51 COMPILER V3.20,  SN-50203013  ITF                                                      05/16/01  12:10:42  PAGE 4   

 180   2          if (bt & 0x80) SDA_PIN = 1;      // send each bit, MSB first
 181   2          else SDA_PIN = 0;
