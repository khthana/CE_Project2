 172   1        _I2CSCLHigh();
 173   1        _I2CBitDelay();
 174   1        if (SDA_PIN)
 175   1          _i2c_error &= 0x01;          // ack didn't happen, may be nothing out there
 176   1        SCL_PIN = 0;
 177   1        _I2CBitDelay();
 178   1      }
