 158          void I2CSendByte(unsigned char bt)
 159          {
 160   1        register unsigned char i;
 161   1        for (i=0; i<8; i++)
 162   1        {
 163   2          if (bt & 0x80) SDA_PIN = 1;      // send each bit, MSB first
