 123          void I2CSendByte(unsigned char bt)
 124          {
 125   1        register unsigned char i;
 126   1        for (i=0; i<8; i++)
 127   1        {
 128   2          if (bt & 0x80) SDA_PIN = 1;      // send each bit, MSB first
 129   2          else SDA_PIN = 0;
 130   2          _I2CSCLHigh();
 131   2          _I2CBitDly();
 132   2          SCL_PIN = 0;
 133   2          _I2CBitDly();
 134   2          bt = bt << 1;
 135   2        }
 136   1        SDA_PIN = 1;							// listen for ACK
 137   1        _I2CSCLHigh();
 138   1        _I2CBitDly();
 139   1        if (SDA_PIN)
 140   1          _i2c_error += 0x01;					// ack didn't happen, may be nothing out there
 141   1        SCL_PIN = 0;
 142   1        _I2CBitDly();
 143   1      }
