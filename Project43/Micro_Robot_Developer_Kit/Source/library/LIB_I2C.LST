 110   2      		{
 111   3      			res++;
 112   3      		}
 113   2      		while (SCL_PIN) {}
 114   2      	}
 115   1      	SDA_PIN = 0;         // send ACK according to 'lastone'
 116   1      	while (!SCL_PIN) {}
 117   1      	while (SCL_PIN) {}
