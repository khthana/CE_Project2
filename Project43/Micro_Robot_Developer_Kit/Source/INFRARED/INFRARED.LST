 248          void int0_int(void) interrupt 0
 249          {
 250   1      	ACK = 0;
 251   1      	command = I2CReceiveCode();
 252   1      //	WriteI2C(0x55,i);
 253   1      //	i++;
 254   1      	switch (command)
 255   1      	{
 256   2      	case GET_IR01 : WriteI2C(CONTROLLER,(unsigned char)IN01); break;
 257   2      	case GET_IR02 : WriteI2C(CONTROLLER,(unsigned char)IN02); break;
 258   2      	case GET_IR03 : WriteI2C(CONTROLLER,(unsigned char)IN03); break;
 259   2      	case GET_IR04 : WriteI2C(CONTROLLER,(unsigned char)IN04); break;
