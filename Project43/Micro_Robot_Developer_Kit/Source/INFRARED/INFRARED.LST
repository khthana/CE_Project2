 180          void I2CSendByte(unsigned char bt)
 181          {
 182   1        register unsigned char i;
 183   1        for (i=0; i<8; i++)
 184   1        {
 185   2          if (bt & 0x80) SDA_PIN = 1;      // send each bit, MSB first
 186   2          else SDA_PIN = 0;
 187   2          _I2CSCLHigh();
 188   2          _I2CBitDelay();
 189   2          SCL_PIN = 0;
 190   2          _I2CBitDelay();
 191   2      	bt = bt << 1;
 192   2        }
 193   1        SDA_PIN = 1;                       // listen for ACK
 194   1        _I2CSCLHigh();
 195   1        _I2CBitDelay();
 196   1        if (SDA_PIN)
 197   1          _i2c_error += 0x01;          // ack didn't happen, may be nothing out there
 198   1        SCL_PIN = 0;
 199   1        _I2CBitDelay();
 200   1      }
 201          
 202          void I2CSendAddr(unsigned char addr, unsigned char rd)
 203          {
 204   1        SCL_PIN = 1;
 205   1        _I2CBitDelay();
 206   1        SDA_PIN = 0;               // generate start
 207   1        _I2CBitDelay();
 208   1        SCL_PIN = 0;
 209   1        _I2CBitDelay();
 210   1        I2CSendByte(addr+rd);  // send address byte
 211   1      }
 212          
 213          void I2CSendStop(void)
 214          {
 215   1      	SDA_PIN = 0;
 216   1      	_I2CBitDelay();
 217   1      	_I2CSCLHigh();
 218   1      	_I2CBitDelay();
 219   1      	SDA_PIN = 1;
 220   1      	_I2CBitDelay();
 221   1      }
