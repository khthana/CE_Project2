 126          void _I2CBitDelay(void)         // wait 4.7uS, or thereabouts
 127          {                             // tune to xtal. This works at 11.0592MHz
 128   1      	TempDelay = 0;
 129   1      	TempDelay = 0;
 130   1      	TempDelay = 0;
 131   1      	TempDelay = 0;
 132   1      	return;
 133   1      }
 134          
 135          void _I2CSCLHigh(void)        // set SCL high, and wait for it to go high
 136          {
 137   1      	register int err;
 138   1      	SCL_PIN = 1;
 139   1      	while (!SCL_PIN)
 140   1      	{
 141   2      		err++;
 142   2      		if (!err)
 143   2      		{
 144   3      			_i2c_error &= 0x02;     // SCL stuck, something's holding it down
 145   3      			return;
 146   3      		}
 147   2      	}
 148   1      }
 149          
 150          void _I2CSlaveStop(void)
 151          {
 152   1      	while (SDA_PIN) {}
 153   1      	while (!SCL_PIN) {}
 154   1      	while (!SDA_PIN) {}
 155   1      }
 156          
 157          unsigned char _I2CReceiveByte(void) // lastone == 1 for last unsigned char
 158          {
 159   1      	register unsigned char i, res;
 160   1      	res = 0;
 161   1      	SCL_PIN = 1;
 162   1      	for (i=0;i<8;i++)         // each bit at a time, MSB first
 163   1      	{
 164   2      		while (!SCL_PIN) {}
 165   2      		res *= 2;
 166   2       		if (SDA_PIN)
 167   2      		{
 168   3      			res++;
 169   3      		}
 170   2      		while (SCL_PIN) {}
 171   2      	}
 172   1      	SDA_PIN = 0;         // send ACK according to 'lastone'
 173   1      	while (!SCL_PIN) {}
 174   1      	while (SCL_PIN) {}
 175   1      	SDA_PIN = 1;
 176   1      	SCL_PIN = 1;
 177   1      	return res;
 178   1      }
