 223          unsigned char I2CReceiveDataByte(void)
 224          {
 225   1      	unsigned char address,ret;
 226   1      
 227   1      	while ((SDA_PIN)&&(SCL_PIN)) {}
 228   1      	if ((!SDA_PIN) && (SCL_PIN))
 229   1      	{
 230   2      		while (SCL_PIN) {}
 231   2      		address = _I2CReceiveByte();
 232   2      		if (address == ADDRESS)
 233   2      		{
 234   3      			ret = _I2CReceiveByte();
 235   3      			_I2CSlaveStop();
 236   3      		}
 237   2      	}
 238   1      	return ret;
 239   1      }
