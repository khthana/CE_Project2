 264   2      	case GET_IR09 : WriteI2C(CONTROLLER,(unsigned char)IN09); break;
 265   2      	case GET_IR10 : WriteI2C(CONTROLLER,(unsigned char)IN10); break;
 266   2      	case GET_IR11 : WriteI2C(CONTROLLER,(unsigned char)IN11); break;
 267   2      	case GET_IR12 : WriteI2C(CONTROLLER,(unsigned char)IN12); break;
 268   2      	case GET_STATUS :
 269   2      					output_hi = 0x00;
 270   2      					output_lo = 0x00;
 271   2      					out_00 = IN01;	out_01 = IN02;
 272   2      					out_02 = IN03;	out_03 = IN04;
 273   2      					out_04 = IN05;	out_05 = IN06;
 274   2      					out_06 = IN07;	out_07 = IN08;
 275   2      					out_08 = IN09;	out_09 = IN10;
 276   2      					out_10 = IN11;	out_11 = IN12;
 277   2      
 278   2      					WriteI2C(CONTROLLER,output_hi);
 279   2      					delay(10,10);
 280   2      					WriteI2C(CONTROLLER,output_lo);
 281   2      					break;
 282   2      	case TEST_DATA :
 283   2      					WriteI2C(CONTROLLER,107);	//ascii = 107	hex = 6B	char = 'k'
 284   2      					delay(10,10);
 285   2      					WriteI2C(CONTROLLER,111);	//ascii = 111	hex = 6F	char = 'o'
 286   2      					break;
 287   2      	case ENA_INT :	enable_interrupt = 1;
 288   2      					break;
 289   2      	case DIS_INT :	enable_interrupt = 0;
 290   2      					break;
 291   2      	}
 292   1      	delay(10,50);
 293   1      	while (!INT) {}
 294   1      	ACK = 1;
 295   1      }
