function TTravellerManager.ViewProfile(
  const TravellerID: WideString): OleVariant;
var
  dbConnection : IOlalaTourDBConnector;
  SQLCmd : WideString;
begin
  dbConnection := CoOlalaTourDBConnector_.Create;
  SQLCmd := 'SELECT * FROM Traveller WHERE TravellerID = ''' + TravellerID + '''';
  Result := dbConnection.QueryCmd(SQLCmd);
end;

initialization
