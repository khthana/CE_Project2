    objctx : ObjectContext;
  end;

implementation

uses ComServ;

////////////////// IObjectControl Methods Implementation ///////////////////////
function TTravellerManager.Activate: HRESULT;
var
  imtx : IMTxAS;
begin
  try
    imtx := CoAppServer.Create;
    objctx := imtx.GetObjectContext;
    if objctx = nil then
    begin
      ShowMessage('objctx = nil');
      Result := 0;
    end
    else
      Result := S_OK;
  except
    ShowMessage('Error on TMSSQL2K_OlalaTour_Connect.Activate');
    Result := 0;
  end;
end;

function TTravellerManager.CanBePooled: Longint;
begin
  Result := 1;
end;

procedure TTravellerManager.Deactivate;
begin
  objctx := nil;
end;

//////////////////// TTravellerManager Methods Implementation //////////////////

function TTravellerManager.Create(const FirstName, LastName, Address,
  TelephoneNo, EmailAddress: WideString; Gender: Smallint; const BirthDate,
  Religion, FoodTypeID: WideString): WideString;
var
  dbConnection : IOlalaTourDBConnector;
  SQLCmd, StrGuid : WideString;
  Guid : TGuid;
begin
  try
    CoCreateGuid(Guid);
    StrGuid := GUIDToString(Guid);
    dbConnection := CoOlalaTourDBConnector_.Create;
    SQLCmd := 'INSERT INTO Traveller ' +
              'VALUES (''' + StrGuid + ''',''' +
              FirstName + ''', ''' +
              LastName + ''', ''' +
              Address + ''', ''' +
              TelephoneNo + ''', ''' +
              EmailAddress + ''', ' +
              IntToStr(Gender) + ', ''' +
              BirthDate + ''', ''' +
              Religion + ''', ' +
              'Null, Null' + ', ''' +
              FoodTypeID + ''')';
    ShowMessage(SQLCmd);
    dbConnection.ExecSQLCmd(SQLCmd);
    Result := StrGuid;
    objctx.SetComplete;
    ShowMessage('SetComplete in TTravellerManager.Create');
  except
    Result := '';
    objctx.SetAbort;
    ShowMessage('SetAbort in TMemberManager.Create');
  end;
end;

function TTravellerManager.GetAirlineCustomerID(
  const TravellerID: WideString): WideString;
var
  dbConnection : IOlalaTourDBConnector;
  SQLCmd : WideString;
  OleVar : OleVariant;
begin
  dbConnection := CoOlalaTourDBConnector_.Create;
  SQLCmd := 'SELECT AirlineCustomerID FROM Traveller WHERE TravellerID = ''' +
    TravellerID + '''';
  OleVar := dbConnection.QueryCmd(SQLCmd);
  if OleVar.EOF then
    Result := ''
  else
    Result := VarToStr(OleVar.Fields.Item[0].Value);
end;

function TTravellerManager.GetBusCompanyCustomerID(
