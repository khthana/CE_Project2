type
  TTravellerManager = class(TMtsAutoObject, ITravellerManager, IObjectControl)
  protected
    function Create(const FirstName, LastName, Address, TelephoneNo,
      EmailAddress: WideString; Gender: Smallint; const BirthDate,
      Religion, FoodTypeID: WideString): WideString; safecall;
    function GetAirlineCustomerID(const TravellerID: WideString): WideString;
      safecall;
    function GetBusCompanyCustomerID(
      const TravellerID: WideString): WideString; safecall;
    procedure Modify(const TravellerID, FirstName, LastName, Address,
      TelephoneNo, EmailAddress: WideString; Gender: Smallint;
      const BirthDate, Religion, FoodTypeID: WideString); safecall;
    function QueryData(const FirstNameKeyword, LastNameKeyword, AddressKeyword,
      TelephoneNoKeyword, EmailAddressKeyword, GenderKeyword,
      BirthDateKeyword, ReligionKeyword: WideString;
      IsBusCompanyCustomerID, IsAirlineCustomerID: Shortint;
