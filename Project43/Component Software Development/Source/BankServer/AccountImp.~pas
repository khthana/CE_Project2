function TAccount.withdraw(const ID: WideString; IDType: SYSINT;
  Amount: Currency; const Password: WideString): WideString;
var
  mssql,subBalance: IMSSQL2K_Bank;
  v: OleVariant;
  sSQL,sqlID,sqlType,pass: WideString;
  balance: Currency;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  subBalance:= CoMSSQL2K_Bank.Create;
//  subCredit:=  CoMSSQL2K_Bank.Create;
  sqlID:= '';
  sqlType:='';
  pass:='';

  if (IDType=1) then
  begin
    sqlID:='ACCOUNTID';
    sqlType:= 'BALANCE';
    pass:= ' and PASSWORD = '''+Password+'''';
  end;

  if (IDType=2) then
  begin
    sqlID:= 'CREDITCARDID';
    sqlType:= 'CREDIT';
  end;

    if (IDType=3) then
  begin
    sqlID:= 'DEBITCARDID';
    sqlType:= 'BALANCE';
  end;


  sSQL:= 'Select '+sqlType+' From ACCOUNT Where '+
         sqlID+' = '''+ID+''''+ pass;

  try
    v:= mssql.Query(sSQL);
    v.MoveFirst;
    balance:= v.fields.item[0].value;
    v.Close;

    if Amount>0 then
    begin
      balance:=balance-Amount;
      if balance>0 then
      begin
        sSQL:= 'update ACCOUNT set '+sqlType+' = '+CurrToStr(balance)+
               ' where '+sqlID+' ='''+ID+'''';

        subBalance.ExecSQL(sSQL);
        Result:= 'Withdraw OK';
      end else
            begin
              Result:='Money not enough';
            end;
    end else
          begin
            Result:='Invalid amount';
          end;

    objctx.SetComplete;
  except
    Result:= 'Can''t withdraw';
    objctx.SetAbort;
  end;
end;

procedure TAccount.setAccountName(const AccountID,
  newAccountName: WideString);
var
  mssql: IMSSQL2K_Bank;
  sSQL: WideString;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  sSQL:= 'update ACCOUNT set ACCOUNTNAME = '+newAccountName+' where ACCOUNTID ='''+ AccountID+'''';

  try
    mssql.ExecSQL(sSQL);
    objctx.SetComplete;
  except
    objctx.SetAbort;
  end;
end;

procedure TAccount.setPassword(const AccountID, oldPassword,
  newPassword: WideString);
var
  mssql: IMSSQL2K_Bank;
  sSQL: WideString;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  sSQL:= 'update ACCOUNT set PASSWORD = '''+newPassword+''''+
         ' where ACCOUNTID ='''+ AccountID+''''+
         ' and PASSWORD ='''+oldPassword+'''';

  try
    mssql.ExecSQL(sSQL);
    objctx.SetComplete;
  except
    objctx.SetAbort;
  end;
end;

initialization
  TAutoObjectFactory.Create(ComServer, TAccount, Class_Account,
    ciMultiInstance, tmBoth);
end.
