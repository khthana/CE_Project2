unit AccountImp;

interface

uses
  ActiveX, MtsObj, ComObj, BankManager_TLB, StdVcl, SysUtils,
  ADODB_TLB, COMSVCSLib_TLB, Dialogs, Windows, MSSQL2K_BankPrj_TLB;

type
  TAccount = class(TMtsAutoObject, IAccount, IObjectControl)
  protected
    function deposit(const AccountID: WideString;
      Amount: Currency): WideString; safecall;
    function getAccountName(const AccountID: WideString): WideString; safecall;
    function getBalance(const AccountID: WideString): Currency; safecall;
    function getCredit(const CreditCardID: WideString): Currency; safecall;
    function withdraw(const ID: WideString; IDType: SYSINT; Amount: Currency;
      const Password: WideString): WideString; safecall;
    procedure setAccountName(const AccountID, newAccountName: WideString);
      safecall;
    procedure setPassword(const AccountID, oldPassword,
      newPassword: WideString); safecall;
    { Protected declarations }
    
    // IObjectControl Methods Definition
    function Activate: HRESULT; stdcall;
    function CanBePooled: Longint; stdcall;
    procedure Deactivate; stdcall;

    private
      objctx : ObjectContext;
      
  end;

implementation

uses ComServ;

////////////////// IObjectControl Methods Implementation ///////////////////////

function TAccount.Activate: HRESULT;
var
  imtx : IMTxAS;
begin
  try
    imtx := CoAppServer.Create;
    objctx := imtx.GetObjectContext;
    if objctx = nil then
    begin
      Result := 0;
    end
    else
      Result := S_OK;
  except
    Result := 0;
  end;
end;

function TAccount.CanBePooled: Longint;
begin
  Result := 1;
end;

procedure TAccount.Deactivate;
begin
  objctx := nil;
end;

///////////// TAccount Methods Implementation //////////////////////////////////

function TAccount.deposit(const AccountID: WideString;
  Amount: Currency): WideString;
var
  mssql,addBalance: IMSSQL2K_Bank;
  v: OleVariant;
  sSQL: WideString;
  balance: Currency;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  addBalance:= CoMSSQL2K_Bank.Create;
  
  sSQL:= 'Select BALANCE From ACCOUNT Where '+
         ' ACCOUNTID = '''+ AccountID+'''';
         
  try
    v:= mssql.Query(sSQL);
    v.MoveFirst;
    balance:= v.fields.item[0].value;
    v.Close;
    
    if Amount>0 then
    begin
    balance:=balance+Amount;

    sSQL:= 'update ACCOUNT set BALANCE = '+CurrToStr(balance)+
           ' where ACCOUNTID ='''+ AccountID+'''';

    addBalance.ExecSQL(sSQL);
    Result:= 'Deposit OK';
    end else
          begin
            Result:='Invalid amount';
          end;

    objctx.SetComplete;
  except
    Result:= 'Can''t deposit';
    objctx.SetAbort;
  end;
end;

function TAccount.getAccountName(const AccountID: WideString): WideString;
var
  mssql: IMSSQL2K_Bank;
  v: OleVariant;
  sSQL: WideString;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  sSQL:= 'Select ACCOUNTNAME From ACCOUNT Where ACCOUNTID = '''+ AccountID+'''';
  try
    v:= mssql.Query(sSQL);
    v.MoveFirst;
    Result:= v.fields.item[0].value;
    v.Close;
    objctx.SetComplete;
  except
    Result:= 'Not Found';
    objctx.SetAbort;
  end;
end;

function TAccount.getBalance(const AccountID: WideString): Currency;
var
  mssql: IMSSQL2K_Bank;
  v: OleVariant;
  sSQL: WideString;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  sSQL:= 'Select BALANCE From ACCOUNT Where ACCOUNTID = '''+ AccountID+'''';
  try
