function TAccount.getCredit(const CreditCardID: WideString): Currency;
var
  mssql: IMSSQL2K_Bank;
  v: OleVariant;
  sSQL: WideString;
begin
  mssql:= CoMSSQL2K_Bank.Create;
  sSQL:= 'Select CREDIT From ACCOUNT Where CREDITCARDID = '''+ CreditCardID+'''';
  try
    v:= mssql.Query(sSQL);
    v.MoveFirst;
    Result:= v.fields.item[0].value;
    v.Close;
    objctx.SetComplete;
