{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
function TBankController.GetServerProperties: TBankControllerProperties;
begin
  Result := FProps;
end;
{$ENDIF}

function  TBankController.payByDebitCard(const DebitCardID: WideString; 
                                         const DestinationAccountID: WideString; Amount: Currency): WideString;
begin
  Result := DefaultInterface.payByDebitCard(DebitCardID, DestinationAccountID, Amount);
end;

function  TBankController.payByCreditCard(const CreditCardID: WideString; 
                                          const DestinationAccountID: WideString; Amount: Currency): WideString;
begin
  Result := DefaultInterface.payByCreditCard(CreditCardID, DestinationAccountID, Amount);
end;

function  TBankController.transfer(const SourceID: WideString; 
                                   const DestinationAccountID: WideString; Amount: Currency; 
                                   const Password: WideString): WideString;
begin
  Result := DefaultInterface.transfer(SourceID, DestinationAccountID, Amount, Password);
end;

function  TBankController.checkTransfer(const DestinationAccountID: WideString; 
                                        const TransactionID: WideString; Amount: Currency): WordBool;
begin
  Result := DefaultInterface.checkTransfer(DestinationAccountID, TransactionID, Amount);
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
constructor TBankControllerProperties.Create(AServer: TBankController);
begin
  inherited Create;
  FServer := AServer;
end;

function TBankControllerProperties.GetDefaultInterface: IBankController;
begin
  Result := FServer.DefaultInterface;
end;

{$ENDIF}

procedure Register;
begin
  RegisterComponents('Servers',[TAccount, TBankTransaction, TBankController]);
end;

end.
