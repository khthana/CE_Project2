function TPlaceManager.Create(const PlaceName, Country, State, Province,
  Description, ImageFilePath, PlacePropertyIDList, PlacePropertyTypeList,
  AdminID: WideString): WideString;
var
  dbConnector : IOlalaTourDBConnector;
  SQLCmd, tmpPlacePropertyID, tmpPlacePropertyType, strGuid : WideString;
  CurIDPos, CurTypePos : Integer;
  ActivityManager : IActivityManager;
  CategoryManager : ICategoryManager;
  FestivalManager : IFestivalManager;
  SystemLogManager : ISystemLogManager;
  Guid : TGuid;
begin
  dbConnector := CoOlalaTourDBConnector_.Create;
  CoCreateGuid(Guid);
  strGuid := GUIDToString(Guid);
  CurIDPos := 1;
  CurTypePos := 1;
  try
    SQLCmd := 'INSERT INTO Place Values (''' + strGuid + ''', ''' +
      PlaceName + ''', ''' + Country + ''', ''' + State + ''', ''' +
      Province + ''', ''' + Description + ''', ''' + ImageFilePath + ''')';

    ShowMessage(SQLCmd);
    dbConnector.ExecSQLCmd(SQLCmd);

    tmpPlacePropertyID := Copy(PlacePropertyIDList, CurIDPos, 38);
    tmpPlacePropertyType := Copy(PlacePropertyTypeList, CurTypePos, 1);
    While tmpPlacePropertyID <> '' do
    begin
      if tmpPlacePropertyType = 'A' then
      begin
        ActivityManager := CoActivityManager.Create;
        ActivityManager.Add(strGuid, tmpPlacePropertyID);
      end
      else if tmpPlacePropertyType = 'C' then
      begin
        CategoryManager := CoCategoryManager.Create;
        CategoryManager.Add(strGuid, tmpPlacePropertyID);
      end
      else if tmpPlacePropertyType = 'F' then
      begin
        FestivalManager := CoFestivalManager.Create;
        FestivalManager.Add(strGuid, tmpPlacePropertyID);
      end;
      CurIDPos := CurIDPos + 38;
      CurTypePos := CurTypePos + 1;
      tmpPlacePropertyID := Copy(PlacePropertyIDList, CurIDPos, 38);
      tmpPlacePropertyType := Copy(PlacePropertyTypeList, CurTypePos, 1);
    end;
    SystemLogManager := CoSystemLogManager.Create;
    SystemLogManager.Add('Create PlaceName ' + PlaceName + ': Place ID '+
      strGuid , AdminID); 
    objctx.SetComplete;
    ShowMessage('SetComplete in TPlaceManager.Create');
  except
    objctx.SetAbort;
    ShowMessage('SetAbort in TPlaceManager.Create');
  end;
end;

function TPlaceManager.Modify(const PlaceID, PlaceName, Country, State,
  Province, Description, ImageFilePath, AdminID: WideString): Smallint;
var
  dbConnection : IOlalaTourDBConnector;
  SystemLogManager : ISystemLogManager;
  SQLCmd, StrUpdate : WideString;
begin
  dbConnection := CoOlalaTourDBConnector_.Create;
  StrUpdate := '';
  if PlaceName <> '' then StrUpdate := StrUpdate + ' PlaceName = ''' +
    PlaceName + '''';
  if Country <> '' then
  begin
    if StrUpdate <> '' then StrUpdate := StrUpdate + ',';
    StrUpdate := StrUpdate + ' Country = ''' + Country + '''';
  end;
  if State <> '' then
  begin
    if StrUpdate <> '' then StrUpdate := StrUpdate + ',';
    StrUpdate := StrUpdate + ' State = ''' + State + '''';
  end;
  if Province <> '' then
  begin
    if StrUpdate <> '' then StrUpdate := StrUpdate + ',';
    StrUpdate := StrUpdate + ' Province = ''' + Province + '''';
  end;
  if Description <> '' then
  begin
    if StrUpdate <> '' then StrUpdate := StrUpdate + ',';
    StrUpdate := StrUpdate + ' Description = ''' + Description + '''';
  end;
  if ImageFilePath <> '' then
  begin
    if StrUpdate <> '' then StrUpdate := StrUpdate + ',';
    StrUpdate := StrUpdate + ' ImageFilePath = ''' + ImageFilePath + '''';
  end;

  if StrUpdate <> '' then
  begin
    StrUpdate := ' Set ' + StrUpdate;
    SQLCmd := 'UPDATE Place' + StrUpdate +
      ' WHERE PlaceID = ''' + PlaceID + '''' ;
    try
      ShowMessage(SQLCmd);
      dbConnection.ExecSQLCmd(SQLCmd);
      // Write to SystemLog
      SystemLogManager := CoSystemLogManager.Create;
      SystemLogManager.Add('Modify PlaceID ' + PlaceID, AdminID);

      objctx.SetComplete;
      ShowMessage('SetComplete in TPlaceManager.Modify');
    except
      objctx.SetAbort;
      ShowMessage('SetAbort in TPlaceManager.Modify');
    end;
  end;
end;

initialization
  TAutoObjectFactory.Create(ComServer, TPlaceManager, Class_PlaceManager,
    ciMultiInstance, tmBoth);
end.
