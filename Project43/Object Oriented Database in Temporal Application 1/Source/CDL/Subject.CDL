	method UpdateNewSj(Oid:%Integer,SjCode:%String,SjName:%String,SjNameE:%String)
	{
		returntype = %String;
		classmethod;
		description = "®–∑”°“√Update Ë«π∑’Ë‡ªÁπTemporal¢ÕßSubjectÀ¡¥‡≈¬";
		not final;
		public;
		sqlproc = 0;
		code =
		{
			new message,Temp
			set sub=##class(Subject).%OpenId(Oid)
			set message=##class(Subject).UpdateSSjCode(Oid,SjCode,$h,2980013)
			set message="SjCode="_message
			set Temp=##class(Subject).UpdateSSjName(Oid,SjName,$h,2980013)
			set message=message_"!SjName="_Temp
			set Temp=##class(Subject).UpdateSSjNameE(Oid,SjNameE,$h,2980013)
			set message=message_"!SjNameE="_Temp
			quit message
		}
	}

