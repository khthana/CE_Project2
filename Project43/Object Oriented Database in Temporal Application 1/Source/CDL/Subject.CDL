	method UpdateSSjCode(Oid:%Integer,NewSub:%String,paFromDate:%Date,paToDate:%Date)
	{
		returntype = %String;
		classmethod;
		not final;
		public;
		sqlproc = 0;
		code =
		{
			new SubjectOBJ,SubAttr,message,ok
			set message=""
			set SubjectOBJ=##class(Subject).%OpenId(Oid)
			if NewSub'=SubjectOBJ.SjCode.GetAt(SubjectOBJ.SjCode.Count()).Val do
			. set SubAttr=SubjectOBJ.SjCode
			. set message=SubjectOBJ.VSStringUpdate(SubAttr,NewSub,paFromDate,paToDate)
			. write !,message
			. set ok=SubjectOBJ.%Save()
			do SubjectOBJ.%Close()
			quit message
		}
	}

