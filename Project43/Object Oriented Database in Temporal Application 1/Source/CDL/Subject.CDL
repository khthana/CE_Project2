	method VSStringInsert(&Attr:%List,Val:%String,FromDate:%Date,ToDate:%Date)
	{
		returntype = %String;
		classmethod;
		not final;
		public;
		sqlproc = 0;
		code =
		{
			new Temp,check,message,TempFromDate,tempcount,count,i
			set message="Sequenced Insert Successful"
			set tempcount=0
			set count=Attr.Count()
			set check=$$CheckFromDateToDate(FromDate,ToDate)
			if check=0 do
			. set check=$$CheckSequencedDuplicate(Attr,FromDate,ToDate)
			. if check=0 do
			.. set Temp=##class(TempString).%New()
			.. set Temp.Val=Val
			.. set Temp.FromDate=FromDate
			.. set Temp.ToDate=ToDate
			.. if count=0 do
			... do Attr.Insert(Temp)
			... quit
			.. else  do
			... for i=1:1:count do
			.... set TempFromDate=Attr.GetAt(i).FromDate
			.... set TempToDate=Attr.GetAt(i).ToDate
			.... if ToDate'>TempFromDate do
			..... if tempcount=0 do
			...... set tempcount=i
			...... quit
			..... quit
			.... if i=count do
			..... if FromDate'<TempToDate do
			...... do Attr.Insert(Temp)
			...... quit
			..... quit
			.... quit
			... quit
			.. if tempcount'=0 do
			... do Attr.InsertAt(Temp,tempcount)
			... quit
			.. quit
			. else  do 
			.. set message="Have Sequenced Duplicate" 
			.. quit
			. quit
			else  do
			. set message="FromDate>ToDate" 
			quit message
			
			:CheckFromDateToDate(FromDate,ToDate)
			new result
			if FromDate>ToDate do  
			. set result=1
			. quit
			else  do
			. set result=0
			. quit
			quit result
			
			:CheckSequencedDuplicate(Attr,FromDate,ToDate)
			new SDup,count,TempFromDate,TempToDate,i
			set count=Attr.Count()
			set SDup=0
			for i=1:1:count do
			. set TempFromDate=Attr.GetAt(i).FromDate
			. set TempToDate=Attr.GetAt(i).ToDate
			. if FromDate<TempToDate do
			.. if TempFromDate<ToDate do
			... set SDup=1
			... quit
			.. quit
			. quit
			quit SDup
		}
	}


	query SelTId(())
	{
		type = %SQLQuery(CONTAINID=1,ROWSPEC="ID"); 
		sqlquery =
		{
			:SELECT ID
			:FROM Subject
		}
		sqlproc = 0;
		sqlview = 0;
	}

	storage Default
	{
		type = %CacheStorage;
		datalocation = ^ooSubjectD;
		indexlocation = ^ooSubjectI;
		idlocation = ^ooSubjectD;
		defaultdata = SubjectDefaultData;
		data SubjectDefaultData
		{
			structure = listnode;
			value (1)  = ScFac;
			value (2)  = SjCode;
			value (3)  = SjCrd;
			value (4)  = SjCrdL;
			value (5)  = SjCrdP;
			value (6)  = SjName;
			value (7)  = SjNameE;
			value (8)  = SjTime;
			value (9)  = SjXTbeg;
			value (10)  = SjXTend;
			value (11)  = SjXday;
			value (12)  = SjFac;
			value (13)  = SubType;
		}
	}

