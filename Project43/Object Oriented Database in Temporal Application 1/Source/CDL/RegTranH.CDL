	query FindGPA((Sd:Student,Year:%String,Term:%String))
	{
		type = %SQLQuery(CONTAINID=1,ROWSPEC="ThSd->ID,ID,ThTerm:%String,ThYear:%String"); 
		sqlquery =
		{
			:SELECT ThSd->ID, ID, ThTerm, ThYear
			:FROM RegTranH
			:WHERE (ThSd = :Sd) AND (:Year IS NULL or ThYear <= :Year) AND (:Term IS NULL or ThTerm <= :Term)
			:ORDER BY ThYear DESC, ThTerm DESC
		}
		sqlproc = 0;
		sqlview = 0;
	}

	query FindRegSd((Year:%Integer,Term:%Integer))
	{
		type = %SQLQuery(CONTAINID=1,ROWSPEC="ID,ThYear:%Integer,ThTerm:%Integer"); 
		sqlquery =
		{
			:SELECT ID, ThYear, ThTerm
			:FROM RegTranH
			:WHERE (ThYear = :Year) AND (ThTerm = :Term)
			:ORDER BY ThYear DESC, ThTerm DESC
		}
		sqlproc = 0;
		sqlview = 0;
	}

	query FindSdResult((SdOID:Student,ThYear:%String,ThTerm:%String))
	{
		type = %SQLQuery(CONTAINID=1,ROWSPEC="ThSd->ID,ID,ThYear:%String,ThTerm:%String"); 
		sqlquery =
		{
			:SELECT ID, ThSd->ID, ThYear, ThTerm
			:FROM RegTranH
			:WHERE (ThSd = :SdOID) AND (:ThYear IS NULL or ThYear <= :ThYear) AND (:ThTerm IS NULL or ThTerm <= :ThTerm)
			:ORDER BY ThYear DESC, ThTerm DESC
		}
		sqlproc = 0;
		sqlview = 0;
	}

	query FindSdResult2((SdOID:Student,ThYear:%String,ThTerm:%String))
	{
		type = %SQLQuery(CONTAINID=1,ROWSPEC="ThSd->ID,ID,ThYear:%String,ThTerm:%String"); 
		sqlquery =
		{
			:SELECT ID, ThSd->ID, ThYear, ThTerm
			:FROM RegTranH
			:WHERE (ThSd = :SdOID) AND (:ThYear IS NULL or ThYear >= :ThYear) AND (:ThTerm IS NULL or ThTerm <= :ThTerm)
			:ORDER BY ThYear ASC, ThTerm ASC
		}
		sqlproc = 0;
		sqlview = 0;
	}

