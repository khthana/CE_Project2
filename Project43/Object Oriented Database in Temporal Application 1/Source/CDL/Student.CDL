	method UpdateSSdName2(Oid:%Integer,NewVal:%String,paFromDate:%String,paToDate:%String)
	{
		returntype = %String;
		classmethod;
		not final;
		public;
		sqlproc = 0;
		code =
		{
			new StudentOBJ,SubAttr,message,ok,f,t
			set StudentOBJ=##class(Student).%OpenId(Oid)
			set SubAttr=StudentOBJ.SdName
			set f=$zdateh(paFromDate)
			set t=$zdateh(paToDate)
			set message=StudentOBJ.VSStringUpdate(SubAttr,NewVal,f,t)
			write !,message
			set ok=StudentOBJ.%Save()
			do StudentOBJ.%Close()
			quit message
			
		}
	}

