					set m.ToDate=To
					do Per.%Save()
					set st="Update Complete"
				}
				if (To>NextFrom) set st="No No, Don't Overlap the others"
			}
			if (SelectNO'=1)&(SelectNO'=i) {
				set PreTo=n.GetAt(SelectNO-1).ToDate
				set NextFrom=n.GetAt(SelectNO+1).FromDate
				if (PreTo'>From)&(To'>NextFrom) {
					set m.AddNo=AddNo
					set m.Soi=Soi
					set m.Street=Street
					set m.MooTee=MooTee
					set m.Tumbon=Tumbon
					set m.Amphur=Amphur
					set m.Province=Province
					set m.ZipCode=ZipCode
					set m.FromDate=From
					set m.ToDate=To
					do Per.%Save()
					set st="Update Complete"
				}
				if (PreTo>From)!(To>NextFrom) set st="No No, Don't Overlap the others"
			}
			if (SelectNO=i)&(i'=1) {
				set PreTo=n.GetAt(SelectNO-1).ToDate
				if (PreTo'>From) {
					set m.AddNo=AddNo
					set m.Soi=Soi
					set m.Street=Street
					set m.MooTee=MooTee
					set m.Tumbon=Tumbon
					set m.Amphur=Amphur
					set m.Province=Province
					set m.ZipCode=ZipCode
					set m.FromDate=From
					set m.ToDate=2980013
					do Per.%Save()
					set st="Update Complete"
				}
				if (PreTo>From) set st="No No, Don't Overlap the others"
			}
			if (SelectNO=1)&(i=1) {
