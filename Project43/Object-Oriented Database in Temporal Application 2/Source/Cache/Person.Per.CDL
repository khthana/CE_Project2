	method GovLevelUpdate(PropertyList:%Library.String,Property:%Library.String,ID:%Library.Integer,SelectNO:%Library.Integer,PropVal:%Library.String,SalStep:%Library.String,From:%Library.Date,To:%Library.Date)
	{
		returntype = %Library.String;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			new st,PreTo,NextFrom,i,m,n,Per,RPropertyList,PropClass,Total,Pos,PosName,j,Step
			set Per=##class(Person.Per).%OpenId(ID)
			set RPropertyList = "R"_PropertyList_"s"
			set PropClass = "Person."_PropertyList
			if To=2781687 set To=2980013
			set n = $$GetProperty^%apiOBJ(Per,RPropertyList)
			set i = $$GetProperty^%apiOBJ(Per,RPropertyList).Count()
			set m = $$GetProperty^%apiOBJ(Per,RPropertyList).GetAt(SelectNO)
			set Total = ##class(Person.Per).TotalAmount(PropertyList)
			for j = 1:1:Total {
				set Pos = $System.OBJ.OpenId(PropClass,j)
			set PosName = $$GetProperty^%apiOBJ(Pos,Property)
			set Step = $$GetProperty^%apiOBJ(Pos,"SalStep")
			if (PosName = PropVal)&(SalStep=Step) {set j=Total}
			}
			if (SelectNO=1)&(i'=1) {
				set NextFrom=n.GetAt(SelectNO+1).FromDate
				if (To'>NextFrom) {
					do SetProperty^%apiOBJ(m,PropertyList,Pos)
					set m.FromDate=From
					set m.ToDate=To
					do Per.%Save()
					set st="Update Complete"
				}
				if (To>NextFrom) set st="No No, Don't Overlap the others"
			}
			if (SelectNO'=1)&(SelectNO'=i) {
				set PreTo=n.GetAt(SelectNO-1).ToDate
				set NextFrom=n.GetAt(SelectNO+1).FromDate
				if (PreTo'>From)&(To'>NextFrom) {
					do SetProperty^%apiOBJ(m,PropertyList,Pos)
					set m.FromDate=From
					set m.ToDate=To
					do Per.%Save()
					set st="Update Complete"
				}
				if (PreTo>From)!(To>NextFrom) set st="No No, Don't Overlap the others"
			}
			if (SelectNO=i)&(i'=1) {
				set PreTo=n.GetAt(SelectNO-1).ToDate
				if (PreTo'>From) {
					do SetProperty^%apiOBJ(m,PropertyList,Pos)
					set m.FromDate=From
					set m.ToDate=2980013
					do Per.%Save()
					set st="Update Complete"
				}
				if (PreTo>From) set st="No No, Don't Overlap the others"
			}
			if (SelectNO=1)&(i=1) {
				do SetProperty^%apiOBJ(m,PropertyList,Pos)
				set m.FromDate=From
				set m.ToDate=2980013
				do Per.%Save()
				set st="Update Complete"
			}
			do Pos.%Close()
			do Per.%Close()
			quit st
		]
	}

