			set Per=##class(Person.Per).%OpenId(ID)
			set m=$$GetProperty^%apiOBJ(Per,PropertyList)
			set i=m.Count()
			if To=2781687 set To=2980013
			for j=1:1:i {
				set tmpp=m.GetAt(j)
				set oldFrom=tmpp.FromDate
				set oldTo=tmpp.ToDate
				if NameDel=$$GetProperty^%apiOBJ(tmpp,Property) {
					if (From>oldFrom)&(To<oldTo) {
						set label="Person."_PropertyList
