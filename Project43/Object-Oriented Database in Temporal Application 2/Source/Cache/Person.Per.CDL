						 set l.FromDate=otdl
						 set tf.FromDate=otdf
						 set tl.FromDate=otdl}
					set f.ToDate=f.FromDate+$r(500)
					set l.ToDate=l.FromDate+$r(500)
					set tf.ToDate=f.ToDate
					set tl.ToDate=l.ToDate
					set otdf=f.ToDate set ever=1
					set otdl=l.ToDate set ever=1
					if i=temp
