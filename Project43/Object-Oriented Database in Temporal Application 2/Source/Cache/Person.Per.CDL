					set l.ELastName=##class(%Library.PopulateUtils).LastName()
					set tf.TFirstName="??????"
					set tl.TLastName="?????"
					do Per.EFirstName.Insert(f),f.%Close()
					do Per.ELastName.Insert(l),l.%Close()
					do Per.TFirstName.Insert(tf),tf.%Close()
					do Per.TLastName.Insert(tl),tl.%Close()
				}
				do Per.%Save()
				do Per.%Close()
			}
			quit
		]
	}

