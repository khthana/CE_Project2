	method Update(PropertyList:%Library.String,Property:%Library.String,ID:%Library.Integer,SelectNO:%Library.String,NewName:%Library.String,From:%Library.Date,To:%Library.Date)
	{
		returntype = %Library.String;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			new st,PreTo,NextFrom,i,m,n
			if To=2781687 set To=2980013
			set Per=##class(Person.Per).%OpenId(ID)
			set i=$$GetProperty^%apiOBJ(Per,PropertyList).Count()
			set n=$$GetProperty^%apiOBJ(Per,PropertyList)
			set m=$$GetProperty^%apiOBJ(Per,PropertyList).GetAt(SelectNO)
			if (SelectNO=1)&(i'=1) {
				set NextFrom=n.GetAt(SelectNO+1).FromDate
				if (To'>NextFrom) {
					do SetProperty^%apiOBJ(m,Property,NewName)
					set m.FromDate=From
					set m.ToDate=To
					do Per.%Save()
					set st="Update Complete"
				}
				if (To>NextFrom) set st="No No, Don't Overlap the others"
			}
			if (SelectNO'=1)&(SelectNO'=i) {
				set PreTo=n.GetAt(SelectNO-1).ToDate
				set NextFrom=n.GetAt(SelectNO+1).FromDate
				if (PreTo'>From)&(To'>NextFrom) {
					do SetProperty^%apiOBJ(m,Property,NewName)
					set m.FromDate=From
					set m.ToDate=To
					do Per.%Save()
					set st="Update Complete"
				}
				if (PreTo>From)!(To>NextFrom) set st="No No, Don't Overlap the others"
			}
			if (SelectNO=i)&(i'=1) {
				set PreTo=n.GetAt(SelectNO-1).ToDate
				if (PreTo'>From) {
					do SetProperty^%apiOBJ(m,Property,NewName)
					set m.FromDate=From
					set m.ToDate=2980013
					do Per.%Save()
					set st="Update Complete"
				}
				if (PreTo>From) set st="No No, Don't Overlap the others"
			}
			if (SelectNO=1)&(i=1) {
				do SetProperty^%apiOBJ(m,Property,NewName)
				set m.FromDate=From
				set m.ToDate=2980013
				do Per.%Save()
				set st="Update Complete"
			}
			do Per.%Close()
			quit st
		]
	}

