						do SetProperty^%apiOBJ(objTemp,Property,NameDel)
						set objTemp.FromDate=To
						set objTemp.ToDate=oldTo
						do m.InsertAt(objTemp,j+1)
						set m.GetAt(j).ToDate=From
						do objTemp.%Close()
						goto byeDel
					}
					elseif (From>oldFrom)&(To'<oldTo)&(From<oldTo)&(i'=1) {
						set m.GetAt(j).ToDate=From
					}
					elseif (From'>oldFrom)&(To<oldTo)&(To>oldFrom)&(i'=1) {
						set m.GetAt(j).FromDate=To
					}
					elseif (From'>oldFrom)&(To'<oldTo)&(i'=1) {
						do m.RemoveAt(j)
						if j=i set m.GetAt(i-1).ToDate=2980013
						goto byeDel
					}
				}
			}
