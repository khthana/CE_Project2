	method GetSalary(ID:%Library.Integer)
	{
		returntype = %Library.String;
		classmethod = 0;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			new Per,Today,Prefix,i,j,From,To,SalRate,Salary,ChildAd,OtherAd,CoperDe,TaxDe,OtherDe
			set Per = ##class(Person.Per).%OpenId(ID)
			set Today = $h
			set Prefix = Per.RGovLevels
			set i = Prefix.Count()
			for j = 1:1:i {
			set From = Prefix.GetAt(j).FromDate
			set To = Prefix.GetAt(j).ToDate
			if (From '> Today)&(To '< Today) {
			set SalRate = Per.RGovLevels.GetAt(j).GovLevel.SalRate
			set j = i
			}
			}
			set i=Per.SalAdd.Count()
			for j = 1:1:i {
				set From = Per.SalAdd.GetAt(j).FromDate
			set To = Per.SalAdd.GetAt(j).ToDate
			if (From '> Today)&(To '< Today) {
			set ChildAd = Per.SalAdd.GetAt(j).ChildAd
			set OtherAd = Per.SalAdd.GetAt(j).OtherAd
			set CoperDe = Per.SalAdd.GetAt(j).CoperDe
			set TaxDe = Per.SalAdd.GetAt(j).TaxDe
			set OtherDe = Per.SalAdd.GetAt(j).OtherDe
			set j = i
			}
			}
			set Salary = SalRate+ChildAd+OtherAd-CoperDe-TaxDe-OtherDe
			quit Salary	
			
		]
	}

