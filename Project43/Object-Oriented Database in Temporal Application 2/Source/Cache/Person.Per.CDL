			set i=Per.Address.Count()
			set n=Per.Address
			set m=n.GetAt(SelectNO)
			if (SelectNO=1)&(i'=1) {
				set NextFrom=n.GetAt(SelectNO+1).FromDate
				if (To'>NextFrom) {
					set m.AddNo=AddNo
					set m.Soi=Soi
					set m.Street=Street
					set m.MooTee=MooTee
					set m.Tumbon=Tumbon
					set m.Amphur=Amphur
					set m.Province=Province
					set m.ZipCode=ZipCode
