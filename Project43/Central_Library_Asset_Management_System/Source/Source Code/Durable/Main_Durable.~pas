procedure TFr_Durable.Ed_Length_GuaranteeExit(Sender: TObject);
var Date_Buy,Month_Buy,Year_Buy : word;
     m,y : Word;
begin
     if (Ed_Length_Guarantee.Text = '') or (Ed_Length_Guarantee.Text='0') then exit;
     try
          StrToInt(Ed_Length_Guarantee.Text);
     except
          showmessage('กรุณาใส่ระยะเวลารับประกันเป็นตัวเลข');
          exit;
     end;
     DecodeDate(Ed_Date_Buy.Date,Year_Buy,Month_Buy,Date_Buy);
     if Cb_TypeGuarantee.Text = 'เดือน' then
     begin
          m := (Month_Buy+StrToInt(Ed_Length_Guarantee.Text)) mod 12;
          if m = 0 then m:= 12;
          y := 543 + Year_Buy + ((Month_Buy+StrToInt(Ed_Length_Guarantee.Text)) div 12);
     end
     else
     begin
          m := Month_Buy ;
          y := 543 + Year_Buy + StrToInt(Ed_Length_Guarantee.Text);
     end;
     Ed_Date_Expire1.Text := IntToStr(Date_Buy-1)+'/'+IntToStr(m)+'/'+IntToStr(y);
end;

