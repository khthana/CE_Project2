          end;
     end;
     with DataModule1.Qr_Transaction do
     begin
          Close;
          SQL.Text := 'select Durable_ID from Give where Durable_ID = ' +char(39)+Trim(Ed_Repair_ID.Text) +char(39);
          Open;
          if FieldValues['Durable_ID'] <> Null then
          begin
               showmessage('ครุภัณฑ์ชิ้นนี้บริจาคไปแล้ว');
               exit;
          end;
     end;
     if Trim(Ed_Company_Name2.Text) = '' then
     begin
          showmessage('กรุณาเลือกบริษัทที่ส่งซ่อม');
          exit;
     end;
     if Ed_Date_Repair.Date > Ed_Date_Take.Date then
     begin
        showmessage('วันที่คาดว่าจะได้รับต้องไม่ก่อนวันที่ส่งซ่อม');
        exit;
     end;
     if Trim(Ed_Officer_Name2.Text) = '' then
     begin
        showmessage('กรุณาเลือกผู้ส่งซ่อม');
        exit;
     end;
     with DataModule1.Qr_Transaction do
     begin
          Close;
          SQL.Text := 'select Company_ID from Company where Company_Name = ' +char(39) +Trim(Ed_Company_Name2.Text) +char(39);
          Open;
          if FieldValues['Company_ID'] = null then
          begin
               showmessage('กรุณาเลือกบริษัทจากรายการ');
               exit;
          end
          else
                Company_ID := FieldValues['Company_ID'];
          Close;
          SQL.Text := 'select Officer_ID from Officer where Officer_Name = ' +char(39) +Trim(Ed_Officer_Name2.Text) +char(39);
          Open;
          if FieldValues['Officer_ID'] = null then
          begin
               showmessage('กรุณาเลือกชื่อเจ้าหน้าที่จากรายการ');
               exit;
          end
          else
                Officer_ID := FieldValues['Officer_ID'];
     end;
     Temp := 'คุณแน่ใจหรือไม่ที่จะส่งซ่อมครุภัณฑ์เลขที่ ' + Trim(Ed_Repair_ID.Text);
     if MessageDlg(Temp,mtConfirmation,[mbYes,mbNo],0) = mrNo then exit;
     DataModule1.Database1.StartTransaction;
     try
          with DataModule1.Qr_Transaction do
          begin
               Close;
               SQL.Clear;
               Params.Clear;
               SQL.Add(' Insert Into Repair (Durable_ID,Date_Repair,Company_ID,Date_Take,Officer_ID,Contact_Name,Condition,Attach_Item)');
               SQL.Add(' values(:Durable_ID,:Date_Repair,:Company_ID,:Date_Take,:Officer_ID,:Contact_Name,:Condition,:Attach_Item)');
               Parambyname('Durable_ID').AsString := Trim(Ed_Repair_ID.Text);
               Parambyname('Date_Repair').AsDateTime := Ed_Date_Repair.Date;
               Parambyname('Company_ID').AsInteger := Company_ID;
               Parambyname('Date_Take').AsDateTime := Ed_Date_Take.Date;
