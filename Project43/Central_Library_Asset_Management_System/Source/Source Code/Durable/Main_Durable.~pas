     with DataModule1.Qr_Transaction do
     begin
          Close;
          SQL.Text := 'select Durable_ID from Repair where Durable_ID = ' +char(39)+Trim(Ed_Give_ID.Text) +char(39);
          Open;
          if FieldValues['Durable_ID'] <> Null then
          begin
               showmessage('ครุภัณฑ์ชิ้นนี้กำลังส่งซ่อม');
               exit;
          end;
     end;
     with DataModule1.Qr_Transaction do
     begin
          Close;
          SQL.Text := 'select Durable_ID from Give where Durable_ID = ' +char(39)+Trim(Ed_Give_ID.Text) +char(39);
          Open;
          if FieldValues['Durable_ID'] <> Null then
          begin
               showmessage('ครุภัณฑ์ชิ้นนี้บริจาคไปแล้ว');
               exit;
          end;
     end;
     if Trim(Ed_Give_Document.Text) = '' then
     begin
          showmessage('กรุณาใส่เลขที่เอกสาร');
          exit;
     end;
     if Trim(Mm_Receiver.Text) = '' then
     begin
        showmessage('กรุณาใส่ผู้รับบริจาค');
        exit;
     end;
     Temp := 'คุณแน่ใจหรือไม่ที่จะบริจาคครุภัณฑ์เลขที่ ' + Trim(Ed_Give_ID.Text);
     if MessageDlg(Temp,mtConfirmation,[mbYes,mbNo],0) = mrNo then exit;
     DataModule1.Database1.StartTransaction;
     try
          with DataModule1.Qr_Transaction do
          begin
               Close;
               SQL.Clear;
               Params.Clear;
               SQL.Add(' Insert Into Give (Durable_ID,Date_Give,Document_ID,Give_Name,Reason)');
               SQL.Add(' values(:Durable_ID,:Date_Give,:Document_ID,:Give_Name,:Reason)');
               Parambyname('Durable_ID').AsString := Trim(Ed_Give_ID.Text);
               Parambyname('Date_Give').AsDateTime := Ed_Date_Give.Date;
               Parambyname('Document_ID').AsString := Trim(Ed_Give_Document.Text);
               Parambyname('Give_Name').AsString := Trim(Mm_Receiver.Text);
               Parambyname('Reason').AsString := Trim(Mm_Give_Reason.Text);
               execSQL;
               Close;
               SQL.Clear;
               Params.Clear;
               SQL.Add(' Update Durable Set Status = ''บริจาค'',Date_Change = :Date_Change where Durable_ID = '+char(39)+Trim(Ed_Give_ID.Text)+Char(39));
               ParamByName('Date_Change').AsDateTime := Ed_Date_Give.Date;
               ExecSQL;
          end;
          DataModule1.Database1.Commit;
          showmessage('การบริจาคเรียบร้อยเรียบร้อย');
          Durable_Update := True;
     except
          showmessage('!!!มีข้อผิดพลาดเกิดขึ้น!!!');
          DataModule1.Database1.Rollback;
     raise;
     end;
     Clear_Give;
