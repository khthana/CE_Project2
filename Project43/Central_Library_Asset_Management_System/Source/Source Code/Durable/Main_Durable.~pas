          begin
               showmessage('ครุภัณฑ์ชิ้นนี้กำลังส่งซ่อมอยู่');
               exit;
          end;
     end;
     with DataModule1.Qr_Transaction do
     begin
          Close;
          SQL.Text := 'select Durable_ID from Over1 where Durable_ID = ' +char(39)+Trim(Ed_Repair_ID.Text) +char(39);
