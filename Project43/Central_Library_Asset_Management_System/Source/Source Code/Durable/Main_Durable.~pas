procedure TFr_Durable.Bt_InsertClick(Sender: TObject);
begin
     Fr_Company.Ed_Company_Name.Text:='';
     Fr_Company.Mm_Address.Text:='';
     Fr_Company.Ed_Phone1.Text:='';
     Fr_Company.Ed_Phone2.Text:='';
     Fr_Company.Ed_Phone3.Text:='';
     Fr_Company.Ed_Fax.Text:='';
     Fr_Company.Update_Flag := False;
     Fr_Company.ShowModal;
end;

procedure TFr_Durable.Bt_UpdateClick(Sender: TObject);
begin
     if Cb_Company_Name.Text = '' then
     begin
          Showmessage('กรุณาเลือกบริษัทที่จะแก้ไข');
          exit;
     end;
     with DataModule1.Qr_Transaction do
     begin
          Close;
          SQL.Clear;
          SQL.Add('Select * From Company');
          SQL.Add('Where Company_Name = '+Char(39) +Cb_Company_Name.Text+Char(39));
          Open;
          Fr_Company.Ed_Company_Name.Text:= FieldValues['Company_Name'];
          Fr_Company.Mm_Address.Text:=FieldValues['Address'];
          Fr_Company.Ed_Phone1.Text:=FieldValues['Phone1'];
          Fr_Company.Ed_Phone2.Text:=FieldValues['Phone2'];
          Fr_Company.Ed_Phone3.Text:=FieldValues['Phone3'];
          Fr_Company.Ed_Fax.Text:=FieldValues['Fax'];
          Fr_Company.Company_ID:=FieldValues['Company_ID'];
          Fr_Company.Update_Flag := True;
          Fr_Company.ShowModal;
     end;
end;

procedure TFr_Durable.Bt_DeleteClick(Sender: TObject);
var Temp : String;
begin
     if Cb_Company_Name.Text = '' then
     begin
          Showmessage('กรุณาเลือกบริษัทที่จะลบ');
          exit;
     end;
     Temp := 'คุณแน่ใจหรือไม่ที่จะลบ ' + Cb_Company_Name.Text;
     if MessageDlg(Temp,mtConfirmation,[mbYes,mbNo],0) = mrNo then exit;
     with DataModule1.Qr_Transaction do
     begin
          // Find Durable That Link With This Company
          Close;
          SQL.Clear;
          SQL.Add('Select Durable_ID From Durable');
          SQL.Add('Where Company_ID = ' + IntToStr(Cb_Company_Name.KeyValue));
          Open;
          if FieldValues['Durable_ID'] <> Null then
          begin
               Showmessage('ไม่สามารถลบบริษัทได้เนื่องจากยังมีครุภัณฑ์อ้างถึง');
               Exit;
          end;
          Close;
          SQL.Clear;
          SQL.Add('Select Durable_ID From Repair');
          SQL.Add('Where Company_ID = ' + IntToStr(Cb_Company_Name.KeyValue));
          Open;
          if FieldValues['Durable_ID'] <> Null then
          begin
               Showmessage('ไม่สามารถลบบริษัทได้เนื่องจากยังมีครุภัณฑ์อ้างถึง');
               Exit;
          end;
          Close;
          SQL.Clear;
          SQL.Add('Select Durable_ID From Repair_History');
          SQL.Add('Where Company_ID = ' + IntToStr(Cb_Company_Name.KeyValue));
          Open;
          if FieldValues['Durable_ID'] <> Null then
          begin
               Showmessage('ไม่สามารถลบบริษัทได้เนื่องจากยังมีครุภัณฑ์อ้างถึง');
               Exit;
          end;
     end;
     DataModule1.Database1.StartTransaction;
     try
         with DataModule1.Qr_Transaction do
         begin
              close;
              Params.Clear;
              SQL.Clear;
              SQL.Add('Delete From Company');
              SQL.Add('Where Company_Name = :Name');
              ParamByName('Name').AsString := Cb_Company_Name.Text;
