procedure TFr_Durable.Ed_Date_ExpireExit(Sender: TObject);
var  Month_Buy,Year_Buy,Month_Expire,Year_Expire : Integer;
     Year1,Month1,Day1 : Word;
     Date1 : TDateTime;
     Temp : Integer;
begin

     if Ed_Date_Expire1.Text = '' then
     begin
          Ed_Length_GuaranteeExit(Sender);
          exit;
     end;
     try
          StrToDate(Ed_Date_Expire1.Text);
     except
          showmessage('ระบุวันที่ในรูปแบบ วว/ดด/25ปป');
          Ed_Length_GuaranteeExit(Sender);
          exit;
     end;
     DecodeDate(StrToDate(Ed_Date_Expire1.Text),Year1,Month1,Day1);
     Date1 := EncodeDate(Year1-543,Month1,Day1);
     if (Ed_Date_Buy.Date) > (EncodeDate(Year1-543,Month1,Day1)) then
     begin
          showmessage('วันหมดประกันต้องไม่ก่อนวันซื้อ');
          Ed_Length_GuaranteeExit(Sender);
          exit;
     end;
     Month_Expire := StrToInt(FormatDateTime('mm',Date1));
     Year_Expire := StrToInt(FormatDateTime('yyyy',Date1));
     Month_Buy := StrToInt(FormatDateTime('mm',Ed_Date_Buy.Date));
     Year_Buy := StrToInt(FormatDateTime('yyyy',Ed_Date_Buy.Date));
     if Month_Buy = Month_Expire then
     begin
          Cb_TypeGuarantee.ItemIndex := 0;
          Ed_Length_Guarantee.Text := IntToStr(Year_Expire-Year_Buy);
     end
     else
     begin
          Temp := (Year_Expire-Year_Buy) * 12;
          if Month_Expire >= Month_Buy then
               Temp:= Temp + Month_Expire - Month_Buy
          else Temp:= Temp - (Month_Buy - Month_Expire);
          Cb_TypeGuarantee.ItemIndex := 1;
          Ed_Length_Guarantee.Text := IntToStr(Temp);
     end;
end;

