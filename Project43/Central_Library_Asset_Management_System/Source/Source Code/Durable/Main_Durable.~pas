               Parambyname('Attach_Item').AsString := Trim(Mm_Attach_Item.Text);
               execSQL;
               Close;
               SQL.Clear;
               Params.Clear;
               SQL.Add(' Update Durable Set Status = ''ส่งซ่อม'',Date_Change = :Date_Change where Durable_ID = '+char(39)+Trim(Ed_Repair_ID.Text)+Char(39));
               ParamByName('Date_Change').AsDateTime := Ed_Date_Repair.Date;
               ExecSQL;
          end;
          DataModule1.Database1.Commit;
          showmessage('เพิ่มข้อมูลการส่งซ่อมเรียบร้อย');
          Repair_Update := True;
          Durable_Update := True;
     except
          showmessage('!!!มีข้อผิดพลาดเกิดขึ้น!!!');
          DataModule1.Database1.Rollback;
     raise;
     end;
     Clear_Repair;
