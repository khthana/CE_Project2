<?xml version="1.0"?> 
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml"> 
<wml> 
  <card id="card1" > 
    <p align="center"> 
      <big><b>Welcome To Mail Manager</b></big> 
    </p> 
     
    <do type = "unknown" label = "Check Mail">
	  	<go href = "http://127.0.0.1:8080/servlet/MainMail1"
		  		method = "post" >
				<postfield name = "DataLink" value = "$Item" />
				<postfield name = "DoWhat" value = "writeMainMail" />
		  </go>
    </do>
  </card> 
</wml>
