<?xml version="1.0"?> 
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN" "http://www.wapforum.org/DTD/wml_1.1.xml"> 

 
<wml> 
<template> 
        <do type="prev"><prev/></do> 
  </template>
 <card id="Cardselect" title="Select Parameter"> 
   <do type="accept" label="Next">
	<go href="http://localhost:8080/servlet/aml3">
   <postfield name="Parameter1" value="$Color" />
   <postfield name="Type" value="$Type" />
   <postfield name="Size" value="$Size"/>
			</go>
			</do> 

    <p align="center"> 

      Color<select name ="Color" title = "Color" multiple="false">
   	   <option  value="Red"> Red</option> 
   	   <option value="Green"> Green </option> 
   	   <option value="Blue"> Blue </option>
        </select>
     

 Type<select name ="Type" multiple="false">
			 
   		<option value="A"> A</option> 
   	   <option value="B"> B </option> 
   	   <option value="C"> C </option>
      
      </select>
      Size<select name ="Size" multiple="false">
		 
   		<option value="Short"> Short</option> 
   	   <option value="Long"> Long </option> 
   	  
      </select>
   </p> 
  </card> 
 </wml> 
