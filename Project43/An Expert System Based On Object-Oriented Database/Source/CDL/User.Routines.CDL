	method CDomain(Domain:%String)
	{
		classmethod;
		description =
		{
			Create Class : Domain Class  contain Domain and Property of Domain and Goals and List of Parameter
			
			Class Name : Domain
			Property
			1. FrameName 
			2. Translation
			3. Goals
			4. GoalsTranslation
			5. GoalsType
			6. Source
			7. Destination
			8. Parameter (List)
		}
		not final;
		public;
		sqlproc = 0;
		code =
		[
			; Create Domain Class
			New pdef,cdef
			New CName
			New PName,PTranslation,PGoals
			New PParameters,PRules,PSource,PDestination
			New arr1,arr2,arr3
			
			Set CName=Domain
			Set PName=CName_".Name"
			Set PTranslation=CName_".FrameTranslation"
			Set PGoals=CName_".Goals"
			Set PParameters=CName_".Parameters"
			Set PRules=CName_".Rules"
			Set PSource=CName_".Source"
			Set PDestination=CName_".Destination"
			
			Set cdef=##class(%ClassDefinition).%New(CName)
			Set cdef.Persistent=1
			Set cdef.Super="%Persistent"
			
			Set pdef=##class(%PropertyDefinition).%New(PName)
			Set pdef.Type="%String"
			Do cdef.Properties.Insert(pdef)
			
			Set arr1=##class(%ArrayOfDataTypes).%New()
			Do arr1.SetAt(100,"MAXLEN")
			
			Set pdef=##class(%PropertyDefinition).%New(PTranslation)
			Set pdef.Type="%String"
			Set pdef.Parameters=arr1
			Do cdef.Properties.Insert(pdef)
			
			Set pdef=##class(%PropertyDefinition).%New(PGoals)
			Set pdef.Type="Goals"
			Set pdef.Collection="list"
			Do cdef.Properties.Insert(pdef)
			
			Set pdef=##class(%PropertyDefinition).%New(PParameters)
			Set pdef.Type="Parameters"
			Set pdef.Collection="list"
			Do cdef.Properties.Insert(pdef)
			
			Set pdef=##class(%PropertyDefinition).%New(PRules)
			Set pdef.Type="Rules"
			set pdef.Collection="list"
			Do cdef.Properties.Insert(pdef)
			
			Set pdef=##class(%PropertyDefinition).%New(PSource)
			Set pdef.Type="%String"
			Do cdef.Properties.Insert(pdef)
			
			Set arr2=##class(%ArrayOfDataTypes).%New()
			Do arr2.SetAt(100,"MAXLEN")
			Do arr2.SetAt(",Own,Member","DISPLAYLIST")
			Do arr2.SetAt(",Own,Member","VALUELIST")
			
			Set pdef=##class(%PropertyDefinition).%New(PDestination)
			Set pdef.Type="%String"
			Set pdef.Parameters=arr2
			Do cdef.Properties.Insert(pdef)
			
			Do arr1.%Close()
			Do arr2.%Close()
			Do pdef.%Close()
			Do cdef.%Save()
			Do cdef.%Close()
			Do Compile^%apiOBJ(CName)
			Quit
		]
	}

