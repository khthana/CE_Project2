			Set pdef=##class(%PropertyDefinition).%New(PName)
			Set pdef.Type="%String"
			Set pdef.Parameters=arr
			Do cdef.Properties.Insert(pdef)
			
			Do arr.%Close()
			Do pdef.%Close()
			Do cdef.%Save()
			Do cdef.%Close()
			Quit
			
		]
	}

