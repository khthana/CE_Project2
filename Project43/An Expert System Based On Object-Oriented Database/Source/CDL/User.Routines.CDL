		}
		not final;
		public;
		sqlproc = 0;
		code =
		[
			New cdef,pdef,arr
			New CName,PName
			
			Set CName=EKBName
			Set PName=CName_"."_Slots
			
			Set cdef=##class(%ClassDefinition).%New(CName)
			Set cdef.Persistent=1
