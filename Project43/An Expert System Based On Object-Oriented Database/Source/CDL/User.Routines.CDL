	method InsertEKBToAllDomain(Name:%String,Slots:%String,Oid:%Integer)
	{
		classmethod;
		not final;
		public;
		sqlproc = 0;
		code =
		[
			New pers,embd
			
			;New Embeddable
			Set embd=##class(EKB).%New()
			Set embd.Name=Name
			Set embd.Slots=Slots
			Set pers=##class(AllDomain).%OpenId(Oid)
			Do pers.EKB.Insert(embd)
			
			Do pers.%Save()
			Do embd.%Close()
			Do pers.%Close()
			
			Quit
			
		]
	}

