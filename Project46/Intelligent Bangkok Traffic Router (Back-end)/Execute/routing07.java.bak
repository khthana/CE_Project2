              indicateBestRoute = indicateBestRoute;
            else
            {
              indicateBestRoute = indicateBestRoute + q;
              q = 0;
            }
          }
        }
        q++;
      }
    }

    // end considering only (1)money
    //-------------------------------------------------------------
