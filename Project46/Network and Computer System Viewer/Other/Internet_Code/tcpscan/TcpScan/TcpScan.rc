                    ES_READONLY
    LTEXT           "Comment:",IDC_STATIC,13,65,35,10
    EDITTEXT        IDC_EDIT_COMMENT,65,65,110,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "&Add",IDOK,85,90,45,14
