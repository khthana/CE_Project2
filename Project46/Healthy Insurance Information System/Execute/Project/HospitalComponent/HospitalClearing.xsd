<?xml version="1.0" standalone="yes" ?>
<xs:schema id="HospitalClearing" targetNamespace="http://www.tempuri.org/HospitalClearing.xsd" xmlns:mstns="http://www.tempuri.org/HospitalClearing.xsd" xmlns="http://www.tempuri.org/HospitalClearing.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
	<xs:element name="HospitalClearing" msdata:IsDataSet="true" msdata:Locale="th-TH">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="CLEARING">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="PID" type="xs:string" />
							<xs:element name="BILL_ID" type="xs:string" />
							<xs:element name="DATE_BILL" type="xs:string" />
							<xs:element name="DISEASE" type="xs:string" minOccurs="0" />
							<xs:element name="COST_MEDICINE" type="xs:int" minOccurs="0" />
							<xs:element name="COST_DOCTOR" type="xs:int" minOccurs="0" />
							<xs:element name="COST_ROOM" type="xs:int" minOccurs="0" />
