							<xs:element name="HOSPSUB" type="xs:string" minOccurs="0" />
							<xs:element name="HOSPSTATUS" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
		<xs:unique name="Constraint1" msdata:PrimaryKey="true">
			<xs:selector xpath=".//mstns:CLEARING" />
			<xs:field xpath="mstns:PID" />
			<xs:field xpath="mstns:BILL_ID" />
			<xs:field xpath="mstns:DATE_BILL" />
		</xs:unique>
	</xs:element>
</xs:schema>