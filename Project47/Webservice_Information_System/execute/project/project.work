<?xml version="1.0" encoding="UTF-8"?>

<application>
  <option name="excludedirs" value="cvs;sccs;rcs;" />
  <option name="excludefiles" value="\..*|.*\.[0-9]+|wlw_[0-9]+\..*" />
  <option name="excludefilesFromEar" value="[default]" />
  <option name="name" value="project" />
  <option name="version" value="1" />
  <projects>
    <project name="Schemas">
      <option name="project.path" value="./Schemas" />
      <option name="type" value="urn:com-bea-ide:project.type:Schema" />
      <components>
        <component name="workshop.workspace.project.build.SchemaBuilderPrefs" />
      </components>
    </project>
    <project name="projectWeb">
      <option name="project.path" value="./projectWeb" />
      <option name="type" value="urn:com-bea-ide:project.type:WebApp" />
    </project>
  </projects>
  <node name="roles" />
</application>

