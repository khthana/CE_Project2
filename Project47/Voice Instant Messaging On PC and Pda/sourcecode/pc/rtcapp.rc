IDR_MENU_APP MENU DISCARDABLE 
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Log in",                      ID_FILE_LOGON
        MENUITEM "Log out",                     ID_FILE_LOGOFF, GRAYED
        MENUITEM SEPARATOR
        POPUP "My Status"
        BEGIN
            MENUITEM "Offline",                     ID_FILE_PRESENCESTATUS_OFFLINE

            MENUITEM "Online",                      ID_FILE_PRESENCESTATUS_ONLINE

            MENUITEM "Away",                        ID_FILE_PRESENCESTATUS_AWAY

            MENUITEM "Idle",                        ID_FILE_PRESENCESTATUS_IDLE

            MENUITEM "Busy",                        ID_FILE_PRESENCESTATUS_BUSY

            MENUITEM "Be Right Back",               ID_FILE_PRESENCESTATUS_BERIGHTBACK

            MENUITEM "On the Phone",                ID_FILE_PRESENCESTATUS_ONTHEPHONE

            MENUITEM "Out to Lunch",                ID_FILE_PRESENCESTATUS_OUTTOLUNCH

        END
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        ID_FILE_EXIT
    END
    POPUP "Contacts"
    BEGIN
        MENUITEM "Add a Contact...",            ID_CONTACTS_ADDBUDDY
        MENUITEM "Block/Unblock",               ID_CONTACTS_BLOCK
    END
    POPUP "Actions"
    BEGIN
        MENUITEM "Send an Instant Message...",  ID_ACTION_MESSAGE
        MENUITEM "Start Audio/Video Conversation...", ID_ACTION_CALL
    END
    POPUP "Settings"
    BEGIN
        MENUITEM "Display Name...",             ID_SETTINGS_DISPLAYNAME
    END
END

IDR_MENU_IM MENU DISCARDABLE 
BEGIN
    POPUP "File"
