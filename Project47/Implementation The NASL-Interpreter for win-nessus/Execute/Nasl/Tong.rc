    PUSHBUTTON      "&Open",IDC_OPEN,326,22,43,14
    PUSHBUTTON      "&Lexer File",IDC_LEX_FILE,115,22,65,14
    PUSHBUTTON      "&Parser File",IDC_PARSE_FILE,184,22,65,14
