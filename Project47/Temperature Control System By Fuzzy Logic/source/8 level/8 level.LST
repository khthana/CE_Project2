  64          // DELAY - with an 11.059MHz crystal. Calling 24us, and count 16us.
  65          void delay(int seconds) {
  66   1              for (k=0; k<seconds; k++);
  67   1      }
  68          // OW_RESET - Reset the one-wire bus and returns the presence detect.
  69          unsigned char ow_reset(void) {
  70   1              unsigned char presence;
  71   1      
  72   1              DQ = 0;                                         //pull DQ line low
  73   1              delay(29);                                      // leave it low for 480us
  74   1              DQ = 1;                                         // allow line to return high
  75   1              delay(3);                                       // wait for presence
  76   1              presence = DQ;                          // get presence signal
  77   1              delay(25);                                      // wait for end of timeslot
  78   1              return(presence);                       // presence signal returned
  79   1      }                                                               // 0=presence, 1 = no part
  80          // READ_BIT - reads a bit from the one-wire bus.
  81          unsigned char read_bit(void) {
  82   1              bit dat;
  83   1              DQ = 0;                                         // pull DQ low to start timeslot
  84   1              _nop_ ();
  85   1              _nop_ ();
  86   1              DQ = 1;                                         // then return high
  87   1              _nop_ ();
  88   1              _nop_ ();
  89   1              _nop_ ();
  90   1              _nop_ ();
  91   1              dat = DQ;       
  92   1              for(k=0; k<8; k++) _nop_();     // delay 15us from start of timeslot
  93   1              return(dat);                            // return value of DQ line
  94   1      }
  95          // WRITE_BIT - writes a bit to the one-wire bus, passed in bitval.
  96          void write_bit(char bitval) {
  97   1              DQ = 0;                                         // pull DQ low to start timeslot
  98   1              if(bitval==1) DQ =1;            // return DQ high if write 1
  99   1              delay(5);                                       // hold value for remainder of timeslot
 100   1              DQ = 1;
 101   1      }
 102          // READ_BYTE - reads a byte from the one-wire bus.
 103          unsigned char read_byte(void) {
 104   1              unsigned char value = 0;
 105   1      
 106   1              for (j=0; j<8; j++) {
 107   2                      if(read_bit()) value|=0x01<<j; // reads byte in, one byte at a time and then shifts it left
 108   2                      delay(6);                               // wait for rest of timeslot
 109   2              }
 110   1              return(value);
 111   1      }
 112          // WRITE_BYTE - writes a byte to the one-wire bus.
 113          void write_byte(char val) {
 114   1              unsigned char temp;
 115   1      
 116   1              for (j=0; j<8; j++) {           // writes byte, one bit at a time
 117   2                      temp = val>>j;                  // shifts val right 'i' spaces
C51 COMPILER V7.03   8_LEVEL                                                               04/20/2005 06:30:12 PAGE 3   

 118   2                      temp &= 0x01;                   // copy that bit to temp
 119   2                      write_bit(temp);                // write bit in temp into
 120   2              }
 121   1              delay(5);
 122   1      }
 123          // READ_TEMP - read temperature by skiprom
 124          char Read_Temp(char* sensor) {
 125   1              char get[2];//secode[8];
 126   1              char temp_lsb,temp_msb;
 127   1      
 128   1              ow_reset();
 129   1              write_byte(0x55);                                                                       // math ROM
 130   1              for (i=0;i<8;i++) write_byte(sensor[i]);
 131   1              write_byte(0x44);                                                                       // Convert T
 132   1              ES = 1;
 133   1              delay(20000);
 134   1              ES = 0;
 135   1              ow_reset();
 136   1              write_byte(0x55);                                                                       // math ROM
 137   1              for (i=0;i<8;i++) write_byte(sensor[i]);
 138   1              write_byte(0xBE);                                                                       // Read Scratch Pad
 139   1              for (i=0; i<2; i++) get[i]=read_byte();
 140   1              temp_msb = get[1];                                                                      // Sign byte + lsbit
 141   1              temp_lsb = get[0];                                                                      // Temp data plus lsb
 142   1              if (temp_msb <= 0x80) temp_lsb = (temp_lsb/2);          // shift to get whole degree
 143   1              temp_msb = temp_msb & 0x80;                                             // mask all but the sign bit
 144   1              if (temp_msb >= 0x80) temp_lsb = (~temp_lsb)+1;         // twos complement
 145   1              if (temp_msb >= 0x80) temp_lsb = (temp_lsb/2);          // shift to get whole degree
 146   1              if (temp_msb >= 0x80) temp_lsb = ((-1)*temp_lsb);       // add sign bit
 147   1              return(temp_lsb);
 148   1      }
