 220          void onoff() interrupt 1                        // timer 0 interrupt TF0
 221          {
 222   1              if (start==1 && TmpLev>0)
 223   1              {
 224   2                      start=0;
 225   2                      CH=0;//turn off light
 226   2                      Remain=0xFFFF-(MapTable[TmpLev]-PhaseLen);
 227   2                      TH0 = ((unsigned short)Remain >> 8);//load remain timer
 228   2                      TL0 = Remain;
 229   2                  TR0 = 1;//enable timer 
 230   2              }
 231   1              else 
 232   1              {
 233   2                      CH=1;//turn on light
 234   2                      TmpLev=CHLevel;
 235   2              }
 236   1      }
 237          void synchronize() interrupt 2          //external interrupt 
 238          {
 239   1              start=1;        
 240   1              TH0 = ((unsigned short)MapTable[TmpLev] >> 8);//load timer
 241   1              TL0 = MapTable[TmpLev];
C51 COMPILER V7.03   8_LEVEL                                                               04/20/2005 06:30:12 PAGE 5   

 242   1              TR0 = 1;//Enable timer 0*/
 243   1      }
 244          void GetPhaseLen(void)
 245          {
 246   1              // Init Timer 0
 247   1              TMOD |= 0x01;   // Timer 0, Mode 1, 16-bit timer
 248   1              TR0 = 0;                // Disable timer 0
 249   1              TH0 = 0;                // Reload timer
 250   1              TL0 = 0;
 251   1      
 252   1              // Wait for falling edge
 253   1              while (!sync) {}
 254   1              while (sync) {}
 255   1              TR0 = 1;                // Enable timer 0
 256   1      
 257   1              // Wait for rising edge
 258   1              while (!sync) {}
 259   1              TR0 = 0;                // Disable timer 0
 260   1      }
 261          
 262          unsigned short GetAvgPhaseLen(void)
 263          {
 264   1              unsigned short avg;
 265   1              //unsigned char i;
 266   1      
 267   1              GetPhaseLen();
 268   1              avg = ((unsigned short)TH0 << 8) | (unsigned short)TL0;         // TH0 or TL0 
 269   1              for (i=0;i<19;i++) // Use 20 samples
 270   1              {       
 271   2                      GetPhaseLen();
 272   2                      avg = (avg + (((unsigned short)TH0 << 8) | (unsigned short)TL0)) / 2;
 273   2              }
 274   1              return avg;
 275   1      }
