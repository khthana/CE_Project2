						while(i < MAX_MESSAGE  )
						{
							if(find_infor[i] == '\0')
										break;
							buffer[FIX_HEADER + i + 1] = find_infor[i];
							i++;
						}	
						
						ssl_write(ssl, buffer, sizeof(buffer));
								
					}
