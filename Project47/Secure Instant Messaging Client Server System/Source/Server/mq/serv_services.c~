//*******************************************************************************************
//						      Accept Authorization Function
//*******************************************************************************************
//
// This function for accepting authorization reply from the owner 
//		and manipulating it repect to reply
//
// TOS = 0x5E CMD = 0x55 - receive authorization reply from user
// TOS = 0x5E CMD = 0x56 - reply complete result to user;
// TOS = 0x06 CMD = 0x62 or write_error - reply all errors occur during processing
//------------------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------------------
// Input =  (ContactID , answer , User Status)
// Output = complete or error message
//	
//------------------------------------------------------------------------------------------


void accept_authorize(SSL *ssl, unsigned char *buffer_read, char user_id[])
{
	MYSQL_ROW row;
	unsigned char buffer[MAX_MESSAGE];
	unsigned char temp[MAX_MESSAGE];
  	char query[MAX_MESSAGE];
	char contact_id[10];
	int i ;
	int len2;
	char ans[2];
	char user_id_status[2];
	char contact_id_status[2];
	int check_query;
	int check_get_data;
	int check_contact_id;
	int check_status;
	int check_confirm;
	int con_status_ok;
	int valid;


	for(i =0 ;i< MAX_MESSAGE ; i++)
	{
		query[i] = '\0';
		temp[i] = '\0';
		buffer[i] = '\0';
	}
	for(i=0;i < 10;i++) contact_id[i] = '\0';

	
	if ((buffer_read[0] == 0x5e) && (buffer_read[5] == 0x55))
	{
		
		//***********************************************************************
		// --1st Process--
		//		- Get data form packet and check its validity
		//-----------------------------------------------------------------------
		//
		// There are 3 subprocess to do
		//  1. Check ContactID that consists of allowed charater 
		//	2. Check the answer that consists of ('Y','y','N','n') Y-yes , N-no
		//	3. Check UserID status that consists of ('A','B','O') 
		//
		// input  = Packet
		// output = (ContactID , answer , User's Status )
		//			if all is valid - check_contact_id = 1
		//							- check_confirm = 1
		//							- check_status = 1
		//***********************************************************************											

		check_get_data = get_data(buffer_read,temp,7);
		fprintf(stdout,"Accepting :%s\n",temp);
		if(check_get_data == 0) valid= 0;
		else
		{
			for(i = 0 ; i<10 ; i++)
			{
				if(temp[i] == '#') break;
				contact_id[i] = temp[i];					
			}

			len2 = strlen(contact_id);
			check_contact_id = check_userid(contact_id);

			if(	(buffer_read[7+len2+1] == 0x6e) || (buffer_read[7+len2+1] == 0x4e) ||
				(buffer_read[7+len2+1] == 0x79) || (buffer_read[7+len2+1] == 0x59) )
			{
				ans[0] = buffer_read[7+len2+1];
				ans[1] = '\0';
				check_confirm = 1;
			}
			else check_confirm =0;
			
			if (buffer_read[7+len2+3] == 0x41 ||buffer_read[7+len2+3] == 0x42 ||  buffer_read[7+len2+3] == 0x4F )
			{
				user_id_status[0] = buffer_read[7+len2+3];
				user_id_status[1] = '\0';
				check_status = 1;
			}
			else check_status = 0;   
		}

		if((check_contact_id == 1) && (check_confirm == 1) && (check_status==1))
		{

			//***********************************************************************
			// --2nd Process--
			//		- Connect to DB to do everything
			//-----------------------------------------------------------------------
			//
			// There are 3 subprocess to do
			//  1. Get current status of ContactID -> contact_id_status
			//	2. Update DB (ContactID,UserID,UserID status)
			//	3. Insert or Update DB (UserID,ContactID,ContactID status)
			//
			// input  = Query
			// output = Success or Error 
			//
			//***********************************************************************											


			isagmq_db = do_connect (DEF_HOST_NAME, DEF_USER_NAME, DEF_PASSWORD, DEF_DB_NAME,
								DEF_PORT_NUM, DEF_SOCKET_NAME,CLIENT_FOUND_ROWS);
			
			if(isagmq_db == NULL)
			{
				fprintf(stdout, "%s   ", user_id);
				fprintf(stdout, "Connect to Database Error");
				strcpy(temp,"Can't connect to DB...$");
				write_error(ssl,temp);
			}
			else
			{
				//-----------------------------------------------------------------------
				// --1st SupProcess--
				//		- Get ContactID Status
				//-----------------------------------------------------------------------

				strcpy(query,"SELECT STATUS FROM contact_list WHERE CONTACT_ID = '");
				strcat(query,contact_id);
				strcat(query,"'");
				strcat(query," AND STATUS NOT IN ('D','X','W')");
				strcat(query," GROUP BY STATUS");
				check_query = process_query(isagmq_db, query);
				fprintf(stdout,"Query :%s\n",query);

				if( check_query == 1 )
				{
					mysql_query(isagmq_db,query);
					res_set = mysql_store_result(isagmq_db);

					if((row = mysql_fetch_row(res_set)) != NULL)
					{
						//Get Current Status of Contact ID 
						strcpy(contact_id_status,row[0]);
						con_status_ok =1;
						fprintf(stdout,"\n user_id : %s user_id_status : %s contact_id : %s contact_id_status : %s  answer : %s\n"
						,user_id,user_id_status,contact_id,contact_id_status,ans);

					}
				}
				else 
				{
					con_status_ok = 0;
				}

				//-----------------------------------------------------------------------
				// --2nd SupProcess--
				//		-  Update (ContactID,UserID,UserID status)
				//		-  This case is Yes answer
				//-----------------------------------------------------------------------

				if( ((ans[0] == 0x79) || (ans[0] == 0x59)) && con_status_ok == 1)
				{
					strcpy(query, "UPDATE contact_list SET STATUS = '");
					strcat(query,user_id_status);
					strcat(query,"'");
					strcat(query," WHERE USER_ID ='");
					strcat(query,contact_id);
					strcat(query,"'");
					strcat(query," AND CONTACT_ID ='");
					strcat(query,user_id);
					strcat(query,"'");
					strcat(query," AND STATUS = 'W'");
					fprintf(stdout,"Query :%s\n",query);

					check_query = process_query_row(isagmq_db, query);

					if( check_query == 1 )
					{
						for(i =0 ;i< MAX_MESSAGE ; i++)	query[i] = '\0';

						//-----------------------------------------------------------------------
						// --3rd SupProcess--
						//		-  Update (UserID,ContactID,ContactID status)
						//
						//	Note: We have to check before about row to be inserted that is exist
						//		  If exist then just update otherwise insert.
						//-----------------------------------------------------------------------
					
						if(!check_db5("SELECT CONTACT_ID FROM contact_list WHERE USER_ID = '", user_id, 
							"' AND CONTACT_ID = '", contact_id, "Delete contact"))
						{

							strcpy(query, "UPDATE contact_list SET STATUS = '");
							strcat(query,contact_id_status);
							strcat(query,"'");
							strcat(query," WHERE USER_ID ='");
							strcat(query,user_id);
							strcat(query,"'");
							strcat(query," AND CONTACT_ID ='");
							strcat(query,contact_id);
							strcat(query,"'");
							strcat(query," AND STATUS = 'W'");
							fprintf(stdout,"Query :%s\n",query);

							check_query = process_query_row(isagmq_db, query);

							if( check_query == 1 )
							{
								fprintf(stdout, "%s   ", user_id);
								fprintf(stdout, "Authorization  OK...\n");

								buffer[0] = 0x55;
								buffer[1] = 0x00;
								buffer[2] = 0x01;
								buffer[3] = 0x00;
								buffer[4] = 0x07;
								buffer[5] = 0x56;
								buffer[6] = 0xff;

								strcpy(temp, "Authorization Completed OK...$");
																			
								for(i=0;i < 255;i++) 
								{
									if(temp[i] == NULL) break;
									buffer[i+7] =  temp[i];
								}

								ssl_write(ssl, buffer, sizeof(buffer));

							}
							else if (check_query == 0)
							{
								fprintf(stdout,"Can't update : NOT FOUND\n");
								strcpy(temp,"Update Authorization Incompleted...$");
								write_error(ssl,temp);
							}
							else
							{
								fprintf(stdout,"Can't authorize this user : %s \n",contact_id);
								strcpy(temp,"Authorize Incompleted...$");
								write_error(ssl,temp);
							}

						}
						else
						{
							strcpy(query, "INSERT INTO contact_list VALUES('");
							strcat(query, user_id);
							strcat(query, "', '");
							strcat(query, contact_id);
							strcat(query, "', '");
							strcat(query, contact_id_status);
							strcat(query, "')"); 
							fprintf(stdout,"Query :%s\n",query);

							check_query = process_query(isagmq_db, query);

							if( check_query == 1 || check_query == 0)
							{
								fprintf(stdout, "%s   ", user_id);
								fprintf(stdout, "Authorization  OK...\n");

								buffer[0] = 0x55;
								buffer[1] = 0x00;
								buffer[2] = 0x01;
								buffer[3] = 0x00;
								buffer[4] = 0x07;
								buffer[5] = 0x56;
								buffer[6] = 0xff;

								strcpy(temp, "Authorization Completed OK...$");
																			
								for(i=0;i < 255;i++) 
								{
									if(temp[i] == NULL) break;
									buffer[i+7] =  temp[i];
								}

								ssl_write(ssl, buffer, sizeof(buffer));

							}
							else
							{
								fprintf(stdout,"Can't insert \n");
								strcpy(temp,"Authorize Incompleted...$");
								write_error(ssl,temp);
							}

						}
																	
					}
					else if (check_query == 0)
					{
						fprintf(stdout,"Can't update : NOT FOUND\n");
						strcpy(temp,"Update Authorization Incompleted...$");
						write_error(ssl,temp);
					}
					else
					{
						fprintf(stdout,"DB ERROR\n");
						strcpy(temp,"Update Authorization Incompleted...$");
						write_error(ssl,temp);
					}

				}

				//-----------------------------------------------------------------------
				// --2nd SupProcess--
				//		-  Update (ContactID,UserID,UserID status)
				//		-  This case is No answer
				//
				// Note : In this case there just update only
				//-----------------------------------------------------------------------

				else if(((ans[0] == 0x6e) || (ans[0] == 0x4e))  && con_status_ok == 1)
				{
					strcpy(query, "UPDATE contact_list SET STATUS = 'U'");
					strcat(query," WHERE USER_ID ='");
					strcat(query,contact_id);
					strcat(query,"'");
					strcat(query," AND CONTACT_ID ='");
					strcat(query,user_id);
					strcat(query,"'");
					strcat(query," AND STATUS = 'W'");
					fprintf(stdout,"Query :%s\n",query);

					check_query = process_query_row(isagmq_db, query);
					if( check_query == 1)
					{
						fprintf(stdout, "%s   ", user_id);
						fprintf(stdout, "Deny Authorization  OK...\n");

						buffer[0] = 0x55;
						buffer[1] = 0x00;
						buffer[2] = 0x01;
						buffer[3] = 0x00;
						buffer[4] = 0x07;
						buffer[5] = 0x56;
						buffer[6] = 0xff;

						strcpy(temp, "Deny Authorization Completed OK...$");

						for(i=0;i < 255;i++) 
						{
							if(temp[i] == NULL) break;
							buffer[i+7] =  temp[i];
						}

						ssl_write(ssl, buffer, sizeof(buffer));
																	

					}
					else if (check_query == 0)
					{
						fprintf(stdout,"Can't update : NOT FOUND\n");
						strcpy(temp,"Update Authorization Incompleted...$");
						write_error(ssl,temp);
					}

					else
					{
						fprintf(stdout,"DB ERROR\n");
						strcpy(temp, "Update Authorization Incompleted...$");
						write_error(ssl,temp);
					}
				}
				do_disconnect(isagmq_db); 
			}

		//-----------------------------------------------------------------------
		//-- 2nd Process--
		//			
		//***********************************************************************

		}
		else
		{
			fprintf(stdout,"Invalid Answer \n");
			strcpy(temp,"Invalid Answer...$");
			write_error(ssl,temp);
		}
	
	//-----------------------------------------------------------------------
	//-- 1st Process--
	//			
	//***********************************************************************

	}
	else
	{
		fprintf(stdout,"Invalid Packet\n");
		strcpy(temp,"Invalid Packet...$");
		write_error(ssl,temp);

	}


}


