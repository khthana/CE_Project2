				strcpy(temp,"");

                while((row = mysql_fetch_row(res_set)) != NULL)
		        {
						//***********************************************************************
						// --2nd Process--
						//		- Connect to DB to get profile of pending UserID
						//-----------------------------------------------------------------------
						// Profile contains :
