//*******************************************************************************************
//							     Set Status Function
//*******************************************************************************************

// This function for unblocking the blocked contactlist user
// TOS = 0x51 CMD = 0x51 - receive changing status request from user
// TOS = 0x55 CMD = 0x52 - reply complete result to user;
// TOS = 0x06 CMD = 0x62 or write_error - reply all errors occur during processing
//------------------------------------------------------------------------------------------

//------------------------------------------------------------------------------------------
// Input =  (user_status) -- the status user request must be in ('A','B','O')
//									- A is "Away"
//									- B is "Busy"
//									- O is "Online"
// Output = (complete or error message)
//------------------------------------------------------------------------------------------


void set_status(SSL *ssl, unsigned char *buffer_read, char user_id[])
{

	unsigned char buffer[MAX_MESSAGE];
	unsigned char temp[MAX_MESSAGE];
	char mess[MAX_MESSAGE];
  	char query[MAX_MESSAGE];
	char status[2];
  	unsigned int i;
  	int check_query;

	for(i =0 ;i<2 ; i++) status[i] = '\0';

	for(i =0 ;i<MAX_MESSAGE ; i++)
	{
		buffer[i]= '\0';
		temp[i] = '\0';
		query[i] = '\0';
		mess[i] = '\0';
	}

	//***********************************************************************
	// Start of Set Status Process
	//***********************************************************************											

	if((buffer_read[0] == 0x51) && (buffer_read[5] == 0x51))
    {
		//***********************************************************************
		// --1st Process--
		//		- to check input stauts must be in ('A','B','O')
		//-----------------------------------------------------------------------
		//		A = 0x41 a = 0x61 B = 0x42 b = 0x62 O = 0x4f o = 0x6f
		//
		// input  = status in buffer_read[7]
		// output = valid status -> status[0]
		//		  = invalid status -> error message
		//***********************************************************************											

		if((buffer_read[7] == 0x61) || (buffer_read[7] == 0x41) ||
		   (buffer_read[7] == 0x62) || (buffer_read[7] == 0x42) ||
     	   (buffer_read[7] == 0x6f) || (buffer_read[7] == 0x4f) )
		{
			status[0] = buffer_read[7];

			//***********************************************************************
			// --2nd Process--
			//		- Connect DB and Change requested status
			//-----------------------------------------------------------------------
			// input  = Query to change status
			// output = complete change
			//		  = invalid status -> error message
			//***********************************************************************											

			isagmq_db = do_connect (DEF_HOST_NAME, DEF_USER_NAME, DEF_PASSWORD, DEF_DB_NAME,
	        	    		DEF_PORT_NUM, DEF_SOCKET_NAME, CLIENT_FOUND_ROWS);

    		if(isagmq_db == NULL)
       		{
            	fprintf(stdout, "Can't Connect to Database Error");
				strcpy(mess,"Can not connnect to DB..$");
				write_error(ssl,mess);

       		}
			else
			{
				strcpy(query, "UPDATE contact_list SET STATUS = '");
				strcat(query,status);
				strcat(query,"'");
				strcat(query," WHERE CONTACT_ID ='");
				strcat(query,user_id);
				strcat(query,"'");
				strcat(query," AND STATUS  NOT IN ('W','X')");
				fprintf(stdout,"Query  :%s\n",query);

				check_query = process_query_row(isagmq_db, query);

				if( check_query == 1 )
				{
						fprintf(stdout, "%s   ", user_id);
						fprintf(stdout, "Set Status  OK...\n");

						buffer[0] = 0x51;
						buffer[1] = 0x00;
						buffer[2] = 0x01;
						buffer[3] = 0x00;
						buffer[4] = 0x07;
						buffer[5] = 0x52;
						buffer[6] = 0xff;

						strcpy(temp, "Setting Status Completed OK...$");
											
						for(i=0;i < 255;i++) 
						{
							if(temp[i] == NULL) break;
							buffer[i+7] =  temp[i];
						}

						ssl_write(ssl, buffer, sizeof(buffer));

				}
				else if (check_query == 0)
				{
					fprintf(stdout,"Can't update nickname : NOT FOUND");
					strcpy(mess,"Can't update nickname..$");
					write_error(ssl,mess);
				}
				else
				{
					fprintf(stdout,"DB system error %s\n", user_id);
					strcpy(mess,"Query Process Error..$");
					write_error(ssl,mess);
				}
	 
			}

			do_disconnect(isagmq_db);
			//-----------------------------------------------------------------------
			//-- 2nd Process--
			//			
			//***********************************************************************
		}	
		else
		{
			fprintf(stdout,"Invalid Status\n");
			strcpy(mess,"Invalid Status..$");
			write_error(ssl,mess);

		}
		//-----------------------------------------------------------------------
		//-- 1st Process--
		//			
