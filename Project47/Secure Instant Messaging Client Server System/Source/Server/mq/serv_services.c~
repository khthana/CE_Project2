void format_string(char des[] ,char src[])
{
	int i,current;
	int len;
	
	len = strlen(src);
	
	for(i=0 ; i< len*2 ; i++) des[i] = '\0';
        current=0;
        
	for(i=0 ; i< len ; i++)
        {
                if(src[i] == 0x27)
                {
                        des[current] = 0x27;
                        current++;
                        des[current] = 0x27;
                };
                des[current] = src[i];
                current++;
        }
}


