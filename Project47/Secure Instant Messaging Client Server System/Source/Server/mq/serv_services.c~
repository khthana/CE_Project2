//*******************************************************************************************

// This function for unblocking the blocked contactlist user
// TOS = 0x04 CMD = 0x41 - receive changing nickname request from user
// TOS = 0x04 CMD = 0x42 - reply complete result to user;
// TOS = 0x06 CMD = 0x62 or write_error - reply all errors occur during processing
//------------------------------------------------------------------------------------------

//------------------------------------------------------------------------------------------
// Input =  (new_nickname) -- It must not be longer than 255 characters
// Output = (complete or error message)
//------------------------------------------------------------------------------------------


void change_nick_name(SSL *ssl, unsigned char *buffer_read, char user_id[]){
	unsigned char buffer[MAX_MESSAGE];
	unsigned char temp[MAX_MESSAGE];
	unsigned char nick_name[MAX_MESSAGE];	
	unsigned char db_nick_name[MAX_MESSAGE];

  	char mess[MAX_MESSAGE];
  	char query[MAX_MESSAGE];
  	unsigned int i;
  	int check_query;
	int check_nick_name;
	int valid_data =0;
	for(i =0 ;i<MAX_MESSAGE ; i++)
	{
		buffer[i]= '\0';
		temp[i] = '\0';
		query[i] = '\0';
		mess[i] = '\0';
		nick_name[i]= '\0';
		db_nick_name[i] = '\0';
	}

	//***********************************************************************
	// Start Process of Change Nick Name
	//***********************************************************************											

	if((buffer_read[0] == 0x04) && (buffer_read[5] == 0x41))
    {

		//***********************************************************************
		// --1st Process--
		//		- to check input nickname must not be longer than 255 char 
		//		  and every characters are valid according to the definition
		//-----------------------------------------------------------------------
		//
		// There are 3 things to check .
		//	1. nickname must not be null
		//	2. nickname must not be longer than 255
		//	3. nickname must consist of allowed charater (>32 && <127 in Decimal)
		//
		// input  = nickname
		// output = valid nickname -> valid_data = 1;
		//		  = invalid nickname -> valid_data =0;
		//***********************************************************************											
		for(i = 0 ; i < MAX_MESSAGE - 7 ; i++)
		{
			if(buffer_read[i+7] == NULL) break;
			nick_name[i] = buffer_read[i+7];
		}
		if (i ==0 || i==1)
		{
			fprintf(stdout,"New nickname is NULL : Invalid \n");
			valid_data =0;
		}
		else if(i >254)
		{
			fprintf(stdout,"New nickname is too long : Invalid \n");
			valid_data =0;
		}
		else
		{
			nick_name[i-1] = '\0';
			check_nick_name = check_nick(nick_name);

			if(check_nick_name == 1) 
			{	
				format_string(db_nick_name , nick_name);
				valid_data = 1 ;
			}
			else valid_data = 0;
		}

		if( valid_data == 0 )
		{
			fprintf(stdout,"Your Nickname is invalid\n");
			strcpy(mess,"Invalid nick name...$");
			write_error(ssl,mess);
		}
		else
		{

			fprintf(stdout,"Nickname : %s\n",nick_name);
			fprintf(stdout,"DB Nickname : %s\n",db_nick_name);

			//***********************************************************************
			// --2nd Process--
			//		- Connect DB and change to new nickname
			//-----------------------------------------------------------------------
			// The difference between nick_name & db_nick_name is
			//	nick_name is valid for program but it may be not valid
			//	for DB becaust there will be some restricted chars for
			//	DB (MySQL) such as " ' " : apostrophe
			//
			// input  = Query DB (new_nickname -> db_nick_name)
			// output = Complete changing
			//		  = Error message
			//***********************************************************************											

			isagmq_db = do_connect (DEF_HOST_NAME, DEF_USER_NAME, DEF_PASSWORD, DEF_DB_NAME,
	        	    		DEF_PORT_NUM, DEF_SOCKET_NAME,CLIENT_FOUND_ROWS);

    		if(isagmq_db == NULL)
       		{
				fprintf(stdout, "%s   ", user_id);
            	fprintf(stdout, "Change Connect to Database Error");
				strcpy(mess,"Can not connect to DB...$");
				write_error(ssl,mess);

       		}
			else
			{
				strcpy(query, "UPDATE user SET NICK_NAME = ");
				strncat(query, "'", 1);
				strcat(query, db_nick_name);
				strncat(query, "'", 1);
				strcat(query, " WHERE USER_ID = '");
				strncat(query, user_id, FIX_USER_ID);	
				strcat(query, "'");
				fprintf(stdout,"Query :%s\n",query);
				check_query = process_query_row(isagmq_db, query);

				if( check_query == 1)
				{
					fprintf(stdout, "%s   ", user_id);
					fprintf(stdout, "Change Nick Name OK...\n");

					buffer[0] = 0x04;
					buffer[1] = 0x00;
					buffer[2] = 0x01;
					buffer[3] = 0x00;
					buffer[4] = 0x07;
					buffer[5] = 0x42;
					buffer[6] = 0xff;

					strcpy(temp, "Change Nick Name OK...$");
										
					for(i=0;i < 255;i++) 
					{
						buffer[i+7] =  temp[i];
					}

					ssl_write(ssl, buffer, sizeof(buffer));
				}
				else if (check_query == 0)
				{
					fprintf(stdout,"Can't change to new nickname : NOT FOUND\n");
					strcpy(mess,"Can't change nick name...$");
					write_error(ssl,mess);
				}
				else
				{
					fprintf(stdout,"DB system error \n");
					strcpy(mess,"DB ERROR...$");
					write_error(ssl,mess);
				}

			//-----------------------------------------------------------------------
			//-- 2nd Process--
			//			
			//***********************************************************************
	 
			}

			do_disconnect(isagmq_db);
		}	
		//-----------------------------------------------------------------------
		//-- 1st Process--
		//			
		//***********************************************************************
	}
	else
	{
		fprintf(stdout, "%s   ", user_id);
	  	fprintf(stdout, "Incorrect Packet\n");
		strcpy(mess,"Invalid packet...$");
		write_error(ssl,mess);

	}
		
}

