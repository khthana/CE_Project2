//*******************************************************************************************
//						      Delete Contact List Function
//*******************************************************************************************
//
// This function for adding other users into contactlist 
//
// TOS = 0x0B CMD = 0xB0 - Request to delete contact list from user
// TOS = 0x0B CMD = 0xB1 - Reply success result to user
// TOS = 0x06 CMD = 0x62 or write_error - reply all errors occur during processing
//------------------------------------------------------------------------------------------
//
//------------------------------------------------------------------------------------------
// Input =  (ContactID)
// Output = complete or error message
//	
//------------------------------------------------------------------------------------------

void delete_contactlist(SSL *ssl, unsigned char *buffer_read, char user_id[]){
	unsigned char buffer[MAX_MESSAGE];
	unsigned char temp[MAX_MESSAGE];
	
  	unsigned char query[MAX_MESSAGE];
	char mess[MAX_MESSAGE];
	unsigned int i;
	unsigned char contact_id[10];
  	int check_query;	
	int valid;
	int point=0;

	for(i=0;i <= 10;i++)
	{
		contact_id[i] = '\0';	
	}
	for(i=0;i < MAX_MESSAGE ;i++)
	{
		buffer[i] = '\0';	
		temp[i] = '\0';	
		query[i] = '\0';	
		mess[i] = '\0';
	}

	//***********************************************************************
	// Start Process of Delete Contactlist with User ID
	//***********************************************************************											
	
    if ((buffer_read[0] == 0x0b) && (buffer_read[5] == 0xb1))
    {

		//***********************************************************************
		// --1st Process--
		//		- Get data form packet and check its validity
		//-----------------------------------------------------------------------
		//
		// There are 2 subprocess to do
		//  1. Check length of contactID is not longer than 10 characters
		//	2. Check contactID that contain only allowable character
		//
		// input  = Packet
		// output = valid ContactID -> id
		//							-> valid =1
		//		  = invalid -> valid = 0
		//***********************************************************************											

		point = get_data(buffer_read,contact_id,7);

		if(point != 0)
		{
			if(strlen(contact_id) < 11 && check_userid(contact_id) !=0) 
				valid = 1;
			else valid = 0;
		}
		else valid =0;


		if(valid == 1)
		{
			//***********************************************************************
			// --2nd Process--
			//		- Connect to DB to do everything
			//-----------------------------------------------------------------------
			//
			// There are 3 subprocess to do
			//  1. Query DB to check the existence of ContactID
			//	2. Delete (UserID , ContactID)
			//	3. Update (ContactID,UserID,'X')
			//
			// input  = Query
			// output = Success or Error 
			//
			//***********************************************************************		
			
			isagmq_db = do_connect (DEF_HOST_NAME, DEF_USER_NAME, DEF_PASSWORD, DEF_DB_NAME,
	                		DEF_PORT_NUM, DEF_SOCKET_NAME,CLIENT_FOUND_ROWS);

       		if(isagmq_db == NULL)
       		{
				fprintf(stdout, "%s   ", user_id);
            	fprintf(stdout, "Delete Contactlist Connect to Database Error");
				strcpy(temp,"Can't connect Database...$");
				write_error(ssl,temp);
       		}
			else
			{
				for(i = 0;i < MAX_MESSAGE;i++) 
				{
	     			query[i] = '\0';
				}

				//-----------------------------------------------------------------------
				// --1st SupProcess--
				//		- Check the existence of ContactID
				//-----------------------------------------------------------------------

				if(!check_db5("SELECT CONTACT_ID FROM contact_list WHERE USER_ID = '", user_id, "' AND CONTACT_ID = '", contact_id, "Delete contact"))
				{
					//-----------------------------------------------------------------------
					// --2nd SupProcess--
					//		- Delete (UserID , ContactID)
					//
					// Note : Not to be worry about the same of the User ID and your ID 
					//		  becuase program retrict the same value
					//        between USER ID and CONTACT ID
					//-----------------------------------------------------------------------

					strcpy(query, "DELETE FROM contact_list WHERE CONTACT_ID = ");
					strncat(query, contact_id, FIX_USER_ID);
					strcat(query," AND USER_ID = '");
					strncat(query, user_id, FIX_USER_ID);
					strcat(query,"'" );
					fprintf(stdout, "Query :%s\n", query);
					check_query = process_query(isagmq_db, query);

					if(check_query < 0) 
					{
						fprintf(stdout, "Delete Contactlist Error\n");
						strcpy(mess,"Not Found..$"); 
						write_error(ssl,mess); 
					}
					else
					{

						fprintf(stdout, "%s   ", user_id);
						fprintf(stdout, "Deleted Contactlist Complete...\n");

						//-----------------------------------------------------------------------
						// --3nd SupProcess--
						//		- Update (ContactID,UserID,'X')
						//	
						//	- Must have to check that (ContactID,UserID) exist before blocking
						//-----------------------------------------------------------------------
						
						if(!check_db5("SELECT USER_ID FROM contact_list WHERE USER_ID = '", 
										contact_id, "' AND CONTACT_ID = '",user_id, "Blocking"))
						{

							strcpy(query, "UPDATE contact_list SET STATUS = 'X'");
							strcat(query," WHERE USER_ID = '");
							strcat(query, contact_id);
							strcat(query,"'");
							strcat(query," AND CONTACT_ID = '");
							strcat(query, user_id);
							strcat(query,"'" );
							fprintf(stdout, "Query :%s\n", query);

							check_query = process_query_row(isagmq_db, query);

							if(check_query == 1)
							{
								fprintf(stdout,"Delete and Block Complete\n");

								for(i=0;i < MAX_MESSAGE;i++) 
								{
									temp[i] = '\0';
									buffer[i] = '\0';
								}

									buffer[0] = 0x0b;
									buffer[1] = 0x00;
									buffer[2] = 0x01;
									buffer[3] = 0x00;
									buffer[4] = 0x07;
									buffer[5] = 0xb2;
									buffer[6] = 0xff;

								strcpy(temp, "Delete contactlist OK...$");


								for(i=0;i < 255;i++) 
								{
									buffer[i+7] =  temp[i];
								}

								ssl_write(ssl, buffer, sizeof(buffer));
							}
							else if (check_query == 0)
							{
								fprintf(stdout,"Blocking Update Incomplete\n", user_id);
								strcpy(mess,"Can't update blocking status...$");
								write_error(ssl,mess);
							}
							else
							{
								fprintf(stdout,"Blocking :DB system error %s\n");
								strcpy(mess,"Blocking : DB system error...$");
								write_error(ssl,mess);
							}

						}
						else
						{
							fprintf(stdout, "Blocking from Delete Request Error : NOT FOUND\n");
							strcpy(mess,"Blocking Incomplete :Not Found..$"); 
							write_error(ssl,mess); 
						}

						//-----------------------------------------------------------------------
						// --End of 3nd SupProcess--
						//-----------------------------------------------------------------------

					}

				}

				else 
				{
					fprintf(stdout, "%s   ", user_id);
					fprintf(stdout,"DB system error %s\n", user_id);
					strcpy(mess,"Your requested User ID doesn't exist...$");
					write_error(ssl,mess);
				}

				do_disconnect(isagmq_db); 		
				//-----------------------------------------------------------------------
				//-- 2nd Process--
				//			
				//***********************************************************************

			 }
		}
		else
	    {
			fprintf(stdout,"Invalid UserID\n");
			strcpy(mess,"Invalid UserID..$");
			write_error(ssl,mess);
		}		
		//-----------------------------------------------------------------------
		//-- 1st Process--
		//			
		//***********************************************************************


	}
	else
	{
		//buffer_read Error (Incorrect Packet)
		fprintf(stdout,"Invalid Packet! \n");
		strcpy(mess,"Invalid Packet..$");
		write_error(ssl,mess);

	}
	
}

